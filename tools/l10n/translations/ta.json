 "InfoPlist.strings": {
  "CFBundleDisplayName": "Timbre",
  "NSMicrophoneUsageDescription": "சுருதியை அளவிட Timbre உங்கள் இசைக்கருவியையோ குரலையோ கேட்கிறது. ஆடியோ உங்கள் சாதனத்திலேயே செயலாக்கப்படுகிறது; அது ஒருபோதும் சேமிக்கப்படுவதோ பதிவேற்றப்படுவதோ இல்லை."
 }
}
