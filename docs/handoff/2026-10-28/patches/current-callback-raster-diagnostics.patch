+    func testEveryGlyphDeletionBackingDamageAndSinglePixelChangeReject() throws {
+        let support = try Support()
+        for fixture in support.catalog.fixtures {
+            let original = try support.crop(fixture)
+            let png = try support.canvas(fixture)
+            let count = fixture.width * fixture.height
+            let glyphs = Set(fixture.roles.flatMap { Check.indices($0.glyphMask, count: count) })
+            let cores = Set(fixture.roles.flatMap { Check.indices($0.coreMask, count: count) })
+            let backing = Check.indices(fixture.backgroundMask, count: count)
+            var controls: [[UInt8]] = []
+            for gray in [UInt8(20), UInt8(245)] {
+                controls.append(Array(repeating: [gray, gray, gray, 255], count: count).flatMap { $0 })
+            }
+            var low = original
+            for pixel in cores { Support.paint(&low, pixel: pixel, rgba: [100, 100, 100, 255]) }
+            controls.append(low)
+            var badBacking = original
+            for pixel in backing { Support.paint(&badBacking, pixel: pixel, rgba: [160, 160, 160, 255]) }
+            controls.append(badBacking)
+            var one = original
+            one[0] = one[0] == 255 ? 254 : one[0] + 1
+            controls.append(one)
+            for component in Support.components(glyphs, width: fixture.width, height: fixture.height) {
+                var deleted = original
+                for pixel in component { Support.paint(&deleted, pixel: pixel, rgba: [100, 100, 100, 255]) }
+                controls.append(deleted)
+            }
+            for changed in controls {
+                let damaged = try support.canvas(fixture, crop: changed)
+                XCTAssertNil(support.inspect(fixture, first: damaged, second: damaged), fixture.key)
+                XCTAssertNil(support.inspect(fixture, first: png, second: damaged), fixture.key)
+            }
+        }
+    }
