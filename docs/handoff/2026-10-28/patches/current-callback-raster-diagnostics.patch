+#!/usr/bin/env python3
+"""Portable source contracts only; no claim of Swift/UIKit/XCTest execution."""
+from pathlib import Path
+import unittest
+ROOT = Path(__file__).resolve().parents[2]
+SOURCE = ROOT / 'ios/TimbreUITests/CurrentCallbackCapture.swift'
+TESTS = ROOT / 'ios/TimbreUITests/CurrentCallbackCaptureTests.swift'
+
+class CollectorContracts(unittest.TestCase):
+    def test_same_issue_element_is_snapshotted_around_two_fresh_pngs(self):
+        s = SOURCE.read_text()
+        self.assertEqual(s.count('let element = issue.element'), 1)
+        self.assertEqual(s.count('element.snapshot()'), 2)
+        self.assertEqual(s.count('XCUIScreen.main.screenshot().pngRepresentation'), 2)
+        positions = [s.index('before = try attributes'), s.index('let first = XCUIScreen'),
+                     s.index('let second = XCUIScreen'), s.index('after = try attributes')]
+        self.assertEqual(positions, sorted(positions))
+        for forbidden in ['firstMatch', '.matching(', '.descendants(', '.children', '.dictionaryRepresentation',
+                          'UIImage', 'UITraitCollection', 'UIAccessibility.', 'ProcessInfo.processInfo.environment']:
+            self.assertNotIn(forbidden, s)
+
+    def test_raw_payloads_and_internal_hashes_never_import_runtime_images(self):
+        s = SOURCE.read_text()
+        for required in ['let digest = sha256(data)', 'emit(data, type: "public.png"',
+                         'XCTAttachment(data: data, uniformTypeIdentifier: type)', 'fileprivate init(metadata:',
+                         'static func collect(issue: XCUIAccessibilityAuditIssue', '-> Capture {']:
+            self.assertIn(required, s)
+        for forbidden in ['Data(contentsOf:', 'JSONDecoder', 'expectedDigest', 'expectedSHA', 'return true', 'return false\n']:
+            self.assertNotIn(forbidden, s)
+
+    def test_state_unknown_traits_and_bounds_are_explicit(self):
+        s = SOURCE.read_text()
+        for required in ['snapshot.isEnabled', 'snapshot.isSelected', 'before != after',
+                         'unknown-not-exposed-by-xctest', 'maximumCaptureSeconds = 5.0',
+                         'maximumPNGBytes = 32 * 1024 * 1024', '$0.isFinite && $0 >= 0',
+                         'callback-snapshot-pair-missing', 'callback-identity-incomplete']:
+            self.assertIn(required, s)
+        self.assertNotIn('hasFocus', s)
+
+    def test_four_native_tests_and_no_private_path_strings(self):
+        self.assertEqual(TESTS.read_text().count('    func test'), 4)
+        for p in [SOURCE, TESTS, ROOT / 'docs/ci/current-callback-capture.md']:
+            s = p.read_text()
+            for forbidden in ['/' + 'workspace' + '/', '/' + 'home' + '/' + 'agent' + '/', 'ghp_', 'Bearer ']:
+                self.assertNotIn(forbidden, s)
+        for p in [SOURCE, TESTS]:
+            self.assertTrue(all(len(line) <= 160 for line in p.read_text().splitlines()))
+
+if __name__ == '__main__':
+    unittest.main(verbosity=2)
