@@ -0,0 +1,41 @@
+#!/usr/bin/env python3
+"""Copy only catalog-pinned original native PNGs into a disposable native-test resource folder."""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+CATALOG_SHA256 = 'c56439643b1aedbd93a1570d722a434f1fd232c15e42bb306edcd97670f7f4c7'
+
+
+def materialize(catalog, screenshots, output):
+    data = catalog.read_bytes()
+    if hashlib.sha256(data).hexdigest() != CATALOG_SHA256:
+        raise ValueError('Catalog hash mismatch')
+    document = json.loads(data)
+    copies = {}
+    for fixture in document['fixtures']:
+        name = fixture['referencePNG']
+        if Path(name).name != name:
+            raise ValueError('Not a plain filename')
+        original = (screenshots / name).read_bytes()
+        digest = hashlib.sha256(original).hexdigest()
+        if digest != fixture['referencePNGSHA256']:
+            raise ValueError('Original callback PNG hash mismatch')
+        copies[digest + '.png'] = original
+    output.mkdir(parents=True, exist_ok=True)
+    for name, original in copies.items():
+        destination = output / name
+        if destination.exists() and destination.read_bytes() != original:
+            raise ValueError('Refusing to overwrite a different original')
+        destination.write_bytes(original)
+    print(json.dumps({'originals': len(copies), 'bytes': sum(map(len, copies.values())), 'hashesVerified': True}))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    parser.add_argument('--catalog', type=Path, required=True)
+    parser.add_argument('--screenshots', type=Path, required=True)
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    materialize(args.catalog, args.screenshots, args.output)
