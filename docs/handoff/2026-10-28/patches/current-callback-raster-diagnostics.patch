index 0000000000000000000000000000000000000000..82bf94b04634788244877af328ce8e499a906aa6
--- /dev/null
+++ b/tools/ci/current_contrast_raster_model.py
@@ -0,0 +1,175 @@
+"""Portable diagnostic mirror; native Core Graphics behavior requires native tests."""
+import base64
+import hashlib
+import io
+import json
+import math
+import zlib
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageCms
+
+MAXIMUM_CAPTURE_SECONDS = 5.0
+CATALOG_SHA256 = 'c56439643b1aedbd93a1570d722a434f1fd232c15e42bb306edcd97670f7f4c7'
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def source_profile(data):
+    """Original PNG declarations, not an image decoder's assigned default profile."""
+    if len(data) > 32 * 1024 * 1024 or data[:8] != b'\x89PNG\r\n\x1a\n':
+        raise ValueError('Bounded PNG required')
+    offset, profile, saw_image = 8, None, False
+    while offset <= len(data) - 12:
+        size = int.from_bytes(data[offset:offset + 4], 'big')
+        if size > len(data) - offset - 12:
+            raise ValueError('Truncated chunk')
+        end = offset + size + 12
+        kind, payload = data[offset + 4:offset + 8], data[offset + 8:end - 4]
+        checksum = int.from_bytes(data[end - 4:end], 'big')
+        if zlib.crc32(kind + payload) != checksum:
+            raise ValueError('Bad chunk CRC')
+        if offset == 8 and (kind != b'IHDR' or size != 13):
+            raise ValueError('IHDR required')
+        if kind in (b'sRGB', b'iCCP'):
+            if profile is not None or saw_image:
+                raise ValueError('Duplicate or late profile')
+            if kind == b'sRGB':
+                if size != 1 or payload[0] > 3:
+                    raise ValueError('Invalid sRGB')
+                profile = ('srgb', None)
+            else:
+                zero = payload.find(b'\0')
+                if size > 1024 * 1024 or not 1 <= zero <= 79 or zero + 2 >= size or payload[zero + 1] != 0:
+                    raise ValueError('Invalid iCCP')
+                decoder = zlib.decompressobj()
+                try:
+                    icc = decoder.decompress(payload[zero + 2:], 1024 * 1024 + 1)
+                except zlib.error as error:
+                    raise ValueError('Invalid compressed profile') from error
+                if not decoder.eof or not 128 <= len(icc) <= 1024 * 1024:
+                    raise ValueError('Invalid or oversized ICC profile')
+                profile = ('icc', icc)
+        elif kind == b'IDAT':
+            saw_image = True
+        elif kind == b'IEND':
+            if size or end != len(data) or not saw_image or profile is None:
+                raise ValueError('Incomplete profiled PNG')
+            return profile
+        elif kind == b'IHDR' and offset != 8:
+            raise ValueError('Duplicate IHDR')
+        elif kind in (b'cICP', b'mDCV', b'cLLI', b'acTL'):
+            raise ValueError('Unsupported HDR/alternative declaration/animation')
+        offset = end
+    raise ValueError('Incomplete PNG')
+
+
+def rgba(data):
+    profile_kind, profile = source_profile(data)
+    image = Image.open(io.BytesIO(data))
+    if image.getexif().get(274, 1) != 1 or max(image.size) > 4096:
+        raise ValueError('Unsupported orientation/size')
+    alpha = np.asarray(image.convert('RGBA'))[:, :, 3]
+    if profile_kind == 'icc':
+        try:
+            image = ImageCms.profileToProfile(image.convert('RGB'), ImageCms.ImageCmsProfile(io.BytesIO(profile)), ImageCms.createProfile('sRGB'), outputMode='RGB', renderingIntent=1)
+        except (ImageCms.PyCMSError, OSError, ValueError) as error:
+            raise ValueError('Invalid or unsupported embedded RGB profile') from error
+    elif profile_kind == 'srgb':
+        image = image.convert('RGB')
+    else:
+        raise ValueError('Unknown profile')
+    return np.dstack([np.asarray(image), alpha])
+
+
+def mask(encoded, shape):
+    data = base64.b64decode(encoded, validate=True)
+    count = math.prod(shape)
+    if len(data) != (count + 7) // 8:
+        raise ValueError('Bad mask')
+    return np.unpackbits(np.frombuffer(data, np.uint8), bitorder='big')[:count].reshape(shape).astype(bool)
+
+
+def ratios(fixture, pixels):
+    values = pixels[:, :, :3].astype(float) / 255
+    luminance = np.where(values <= .04045, values / 12.92, ((values + .055) / 1.055) ** 2.4) @ [.2126, .7152, .0722]
+    backing = luminance[mask(fixture['backgroundMask'], pixels.shape[:2])]
+    result = {}
+    for role in fixture['roles']:
+        foreground = luminance[mask(role['coreMask'], pixels.shape[:2])]
+        if foreground.min() > backing.max():
+            ratio = (foreground.min() + .05) / (backing.max() + .05)
+        elif backing.min() > foreground.max():
+            ratio = (backing.min() + .05) / (foreground.max() + .05)
+        else:
+            raise ValueError('Overlapping luminances')
+        if ratio < 4.5:
+            raise ValueError('Contrast below 4.5')
+        result[role['name']] = float(ratio)
+    return result
+
+
+def load(root):
+    data = (root / 'catalog.json').read_bytes()
+    if sha(data) != CATALOG_SHA256:
+        raise ValueError('Unreviewed catalog')
+    document = json.loads(data)
+    if document['maximumChannelDelta'] != 0 or len(document['fixtures']) != 10:
+        raise ValueError('Unexpected policy')
+    for fixture in document['fixtures']:
+        data = (root / fixture['resource']).read_bytes()
+        if sha(data) != fixture['resourceSHA256']:
+            raise ValueError('Foreign resource')
+        pixels = rgba(data)
+        if sha(pixels.tobytes()) != fixture['rgbaSHA256']:
+            raise ValueError('Foreign normalized pixels')
+        fixture['_pixels'] = pixels
+    return document
+
+
+def contains(outer, inner):
+    return outer[0] <= inner[0] and outer[1] <= inner[1] and outer[0]+outer[2] >= inner[0]+inner[2] and outer[1]+outer[3] >= inner[1]+inner[3]
+
+
+def valid_rect(rect):
+    return len(rect) == 4 and all(math.isfinite(v) for v in rect) and rect[2] > 0 and rect[3] > 0
+
+
+def overlaps(a, b):
+    return a[0] < b[0]+b[2] and b[0] < a[0]+a[2] and a[1] < b[1]+b[3] and b[1] < a[1]+a[3]
+
+
+def inspect(document, before, after, first, second, context_before, context_after, elapsed):
+    """Arrays are test-only inputs; runtime transport supplies original callback PNGs."""
+    if before != after or context_before != context_after or not math.isfinite(elapsed) or not 0 <= elapsed <= MAXIMUM_CAPTURE_SECONDS:
+        return None
+    context = context_before
+    if context['matches'] != 1 or before['screen'] != context['screen']:
+        return None
+    if not all(valid_rect(r) for r in [before['frame'], context['viewport'], context['clearBounds']]):
+        return None
+    if context['viewport'][:2] != [0, 0] or not contains(context['viewport'], context['clearBounds']) or not contains(context['clearBounds'], before['frame']):
+        return None
+    found = [f for f in document['fixtures'] if all(before[k] == f[k] for k in ['screen', 'identifier', 'label', 'elementType', 'frame']) and f['viewport'] == context['viewport']]
+    if len(found) != 1:
+        return None
+    fixture = found[0]
+    if first.shape != (2622, 1206, 4) or second.shape != first.shape:
+        return None
+    left, top, right, bottom = fixture['supportRect']
+    support = [left / 3, top / 3, (right-left)/3, (bottom-top)/3]
+    if not contains(context['clearBounds'], support) or not contains(fixture['clearBounds'], support):
+        return None
+    if any(not valid_rect(rect) or overlaps(rect, support) for rect in context['blockedRects']):
+        return None
+    a, b = first[top:bottom, left:right], second[top:bottom, left:right]
+    if not np.all(a[:, :, 3] == 255) or not np.array_equal(a, b) or not np.array_equal(a, fixture['_pixels']):
+        return None
+    try:
+        values = ratios(fixture, a)
+    except ValueError:
+        return None
+    return {'minimumRatio': min(values.values()), 'roles': values, 'auditAuthorization': False}
