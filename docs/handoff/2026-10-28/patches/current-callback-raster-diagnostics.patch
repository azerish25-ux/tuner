index 0000000000000000000000000000000000000000..9d4d345d75ca858955625fb29f384edf5b0848db
--- /dev/null
+++ b/ios/TimbreUITests/CurrentCallbackCapture.swift
@@ -0,0 +1,172 @@
+import CryptoKit
+import Foundation
+import XCTest
+
+/// Inactive diagnostic proposal. The only capture entry point takes the actual audit issue, never imported pixels.
+enum CurrentCallbackCapture {
+    static let maximumCaptureSeconds = 5.0
+    static let maximumPNGBytes = 32 * 1024 * 1024
+
+    struct Frame: Codable, Equatable {
+        let x: Double
+        let y: Double
+        let width: Double
+        let height: Double
+        var isValid: Bool { [x, y, width, height].allSatisfy(\.isFinite) && width > 0 && height > 0 }
+    }
+
+    /// Accessibility element state, not target rendering/environment traits.
+    struct ElementState: Codable, Equatable {
+        let isEnabled: Bool
+        let isSelected: Bool
+    }
+
+    struct Element: Codable, Equatable {
+        let elementType: UInt64
+        let identifier: String
+        let label: String
+        let frame: Frame
+        let elementState: ElementState
+    }
+
+    struct PNGMetadata: Codable {
+        let attachmentName: String
+        let byteCount: Int
+        let sha256: String
+        let uptimeStart: Double
+        let uptimeEnd: Double
+    }
+
+    struct Metadata: Codable {
+        let schema: Int
+        let captureID: String
+        let auditContextID: String
+        let screenKey: String
+        let callbackIndex: Int
+        let auditType: UInt64
+        let status: String
+        let uptimeStart: Double
+        let uptimeEnd: Double
+        let before: Element?
+        let after: Element?
+        let pngs: [PNGMetadata]
+        let problems: [String]
+        let targetRenderingTraits: String
+    }
+
+    /// Read-only in-memory output. No public/memberwise constructor or decoded/imported-image path.
+    final class Capture {
+        let metadata: Metadata
+        let firstPNG: Data?
+        let secondPNG: Data?
+        fileprivate init(metadata: Metadata, firstPNG: Data?, secondPNG: Data?) {
+            self.metadata = metadata; self.firstPNG = firstPNG; self.secondPNG = secondPNG
+        }
+    }
+
+    /// Call once inside the existing issue handler. All app/overlay/context queries remain outside that callback.
+    /// Returns diagnostic evidence only, never the Bool consumed by performAccessibilityAudit's issue handler.
+    @MainActor
+    static func collect(issue: XCUIAccessibilityAuditIssue, screenKey: String, callbackIndex: Int,
+                        auditContextID: UUID, attach: (XCTAttachment) -> Void) -> Capture {
+        let captureID = UUID().uuidString.lowercased()
+        let prefix = "ax-current-callback-" + captureID
+        let start = ProcessInfo.processInfo.systemUptime
+        var problems: [String] = []
+        if issue.auditType != .contrast { problems.append("issue-not-exact-contrast") }
+        if screenKey.isEmpty || callbackIndex < 1 { problems.append("missing-callback-context") }
+        // Retain the exact issue-supplied object; never query for its identifier or choose a different element.
+        let element = issue.element
+        var before: Element?
+        var after: Element?
+        if let element {
+            do { before = try attributes(of: element.snapshot()) }
+            catch { problems.append("before-snapshot-unavailable") }
+        } else { problems.append("issue-element-unavailable") }
+
+        let firstStart = ProcessInfo.processInfo.systemUptime
+        let first = XCUIScreen.main.screenshot().pngRepresentation
+        let firstEnd = ProcessInfo.processInfo.systemUptime
+        let secondStart = ProcessInfo.processInfo.systemUptime
+        let second = XCUIScreen.main.screenshot().pngRepresentation
+        let secondEnd = ProcessInfo.processInfo.systemUptime
+
+        if let element {
+            do { after = try attributes(of: element.snapshot()) }
+            catch { problems.append("after-snapshot-unavailable") }
+        }
+        let end = ProcessInfo.processInfo.systemUptime
+        problems += tupleProblems(before: before, after: after)
+        if !validTiming([start, firstStart, firstEnd, secondStart, secondEnd, end]) {
+            problems.append("capture-time-bound-or-order-invalid")
+        }
+        let firstValid = validPNGEnvelope(first), secondValid = validPNGEnvelope(second)
+        if !firstValid { problems.append("first-png-missing-invalid-or-oversized") }
+        if !secondValid { problems.append("second-png-missing-invalid-or-oversized") }
+        // Hash the unchanged bytes after both captures and snapshots, avoiding hashing between the two frames.
+        var pngs: [PNGMetadata] = []
+        let payloads: [(Int, Data, Bool, Double, Double)] = [
+            (1, first, firstValid, firstStart, firstEnd),
+            (2, second, secondValid, secondStart, secondEnd),
+        ]
+        for (index, data, valid, lower, upper) in payloads where valid {
+            let name = prefix + "-" + String(index) + ".png"
+            let digest = sha256(data)
+            pngs.append(PNGMetadata(attachmentName: name, byteCount: data.count, sha256: digest,
+                                    uptimeStart: lower, uptimeEnd: upper))
+            emit(data, type: "public.png", name: name, attach: attach)
+            emit(Data((digest + "  " + name + "\n").utf8), type: "public.plain-text", name: name + ".sha256", attach: attach)
+        }
+        let metadata = Metadata(schema: 1, captureID: captureID, auditContextID: auditContextID.uuidString.lowercased(),
+            screenKey: screenKey, callbackIndex: callbackIndex, auditType: issue.auditType.rawValue,
+            status: problems.isEmpty ? "captured-diagnostic-only" : "incomplete",
+            uptimeStart: start, uptimeEnd: end, before: before, after: after, pngs: pngs, problems: problems,
+            targetRenderingTraits: "unknown-not-exposed-by-xctest")
+        let encoder = JSONEncoder(); encoder.outputFormatting = [.sortedKeys]
+        if let data = try? encoder.encode(metadata) {
+            emit(data, type: "public.json", name: prefix + ".json", attach: attach)
+        } else {
+            emit(Data("metadata-encoding-failed; diagnostic incomplete\n".utf8), type: "public.plain-text",
+                 name: prefix + "-incomplete.txt", attach: attach)
+        }
+        return Capture(metadata: metadata, firstPNG: firstValid ? first : nil, secondPNG: secondValid ? second : nil)
+    }
+
+    @MainActor
+    private static func attributes(of snapshot: any XCUIElementSnapshot) -> Element {
+        let frame = snapshot.frame
+        return Element(elementType: UInt64(snapshot.elementType.rawValue), identifier: snapshot.identifier, label: snapshot.label,
+            frame: Frame(x: Double(frame.minX), y: Double(frame.minY), width: Double(frame.width), height: Double(frame.height)),
+            elementState: ElementState(isEnabled: snapshot.isEnabled, isSelected: snapshot.isSelected))
+    }
+
+    static func tupleProblems(before: Element?, after: Element?) -> [String] {
+        guard let before, let after else { return ["callback-snapshot-pair-missing"] }
+        var problems: [String] = []
+        if !before.frame.isValid || !after.frame.isValid { problems.append("callback-frame-invalid") }
+        if before.identifier.isEmpty || before.label.isEmpty { problems.append("callback-identity-incomplete") }
+        if before != after { problems.append("callback-element-tuple-changed") }
+        return problems
+    }
+
+    static func validTiming(_ values: [Double]) -> Bool {
+        guard values.count == 6, values.allSatisfy({ $0.isFinite && $0 >= 0 }),
+              let first = values.first, let last = values.last, last - first <= maximumCaptureSeconds else { return false }
+        return zip(values, values.dropFirst()).allSatisfy { $0.0 <= $0.1 }
+    }
+
+    /// Header/size check only; decoding, ICC normalization, exact raster and glyph/contrast review belong to the pure helper.
+    static func validPNGEnvelope(_ data: Data) -> Bool {
+        data.count >= 8 && data.count <= maximumPNGBytes && data.starts(with: [137, 80, 78, 71, 13, 10, 26, 10])
+    }
+
+    static func sha256(_ data: Data) -> String {
+        SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func emit(_ data: Data, type: String, name: String, attach: (XCTAttachment) -> Void) {
+        let attachment = XCTAttachment(data: data, uniformTypeIdentifier: type)
+        attachment.name = name; attachment.lifetime = .keepAlways
+        attach(attachment)
+    }
+}
