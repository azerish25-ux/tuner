+    func testMissingTamperedCatalogAndAllExcludedIdentitiesReject() throws {
+        let support = try Support()
+        let data = try support.resource("catalog.json")
+        XCTAssertNil(Check.loadCatalog(data: data) { _ in nil })
+        XCTAssertNil(Check.loadCatalog(data: data) { _ in Data([1, 2, 3]) })
+        var changed = data
+        changed.append(10)
+        XCTAssertNil(Check.loadCatalog(data: changed) { try? support.resource($0) })
+        let fixture = try XCTUnwrap(support.catalog.fixtures.first)
+        let png = try support.canvas(fixture)
+        for label in ["Jingle", "Bells", "Ode to", "Joy", "28", "E7", "Start", "Ear training", "Hear two notes. Name the gap."] {
+            let identity = support.identity(fixture, label: label)
+            XCTAssertNil(support.inspect(fixture, first: png, second: png, before: identity, after: identity))
+        }
+        XCTAssertFalse(support.catalog.fixtures.contains { ["Jingle", "Bells", "Ode to"].contains($0.label) })
+    }
