@@ -0,0 +1,50 @@
+import Foundation
+import XCTest
+
+/// Pure metadata/transport contracts only. Actual audit callback execution still requires native CI.
+final class CurrentCallbackCaptureTests: XCTestCase {
+    typealias C = CurrentCallbackCapture
+
+    func testExactTupleIncludesStateAndHasNoTolerance() {
+        let original = element()
+        XCTAssertTrue(C.tupleProblems(before: original, after: original).isEmpty)
+        for changed in [element(identifier: "foreign"), element(label: "Foreign"), element(type: 9),
+                        element(x: 10.0000001), element(enabled: false), element(selected: true)] {
+            XCTAssertEqual(C.tupleProblems(before: original, after: changed), ["callback-element-tuple-changed"])
+        }
+    }
+
+    func testMissingAnonymousAndInvalidFramesRemainIncomplete() {
+        XCTAssertFalse(C.tupleProblems(before: nil, after: element()).isEmpty)
+        XCTAssertFalse(C.tupleProblems(before: element(), after: nil).isEmpty)
+        XCTAssertFalse(C.tupleProblems(before: element(identifier: ""), after: element(identifier: "")).isEmpty)
+        XCTAssertFalse(C.tupleProblems(before: element(label: ""), after: element(label: "")).isEmpty)
+        XCTAssertFalse(C.Frame(x: .nan, y: 0, width: 10, height: 10).isValid)
+        XCTAssertFalse(C.Frame(x: 0, y: 0, width: 0, height: 10).isValid)
+    }
+
+    func testTimingRequiresSixOrderedFiniteNonnegativeObservationsWithinFiveSeconds() {
+        XCTAssertTrue(C.validTiming([1, 1.1, 1.2, 1.3, 1.4, 1.5]))
+        for values in [[1.0], [-1, 0, 1, 2, 3, 4], [1, 2, 1, 3, 4, 5],
+                       [1, 2, 3, 4, 5, 6.01], [1, 2, 3, 4, 5, Double.infinity]] {
+            XCTAssertFalse(C.validTiming(values))
+        }
+    }
+
+    func testDigestCoversUnchangedDataButPNGHeaderIsNotImageProof() {
+        let header = Data([137, 80, 78, 71, 13, 10, 26, 10])
+        XCTAssertTrue(C.validPNGEnvelope(header)) // Deliberately not proof that a PNG can decode.
+        XCTAssertFalse(C.validPNGEnvelope(Data()))
+        XCTAssertFalse(C.validPNGEnvelope(Data("not a PNG".utf8)))
+        XCTAssertEqual(C.sha256(Data("abc".utf8)), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
+        var changed = header; changed.append(0)
+        XCTAssertNotEqual(C.sha256(header), C.sha256(changed))
+    }
+
+    private func element(identifier: String = "fixture.title", label: String = "Fixture", type: UInt64 = 48,
+                         x: Double = 10, enabled: Bool = true, selected: Bool = false) -> C.Element {
+        C.Element(elementType: type, identifier: identifier, label: label,
+            frame: C.Frame(x: x, y: 20, width: 100, height: 30),
+            elementState: C.ElementState(isEnabled: enabled, isSelected: selected))
+    }
+}
