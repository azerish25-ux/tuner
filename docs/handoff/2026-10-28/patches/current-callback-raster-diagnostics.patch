+    func testActualUntaggedPNGDecodePathRejectsAssignedDefaultProfile() throws {
+        let support = try Support()
+        let fixture = try XCTUnwrap(support.catalog.fixtures.first)
+        let tagged = try support.canvas(fixture)
+        let untagged = try Support.removingColorProfileChunks(tagged)
+        XCTAssertNotEqual(untagged, tagged)
+        // This remains a real, decodable PNG; only its explicit source color declaration is gone.
+        let container = try XCTUnwrap(CGImageSourceCreateWithData(untagged as CFData, nil))
+        XCTAssertNotNil(CGImageSourceCreateImageAtIndex(container, 0, nil))
+        XCTAssertNil(Check.decodePNG(untagged))
+        XCTAssertNil(support.inspect(fixture, first: untagged, second: untagged))
+        XCTAssertNil(support.inspect(fixture, first: tagged, second: untagged))
+        // An actual embedded non-sRGB profile must be validated and then converted, not relabeled.
+        let linear = try XCTUnwrap(CGColorSpace(name: CGColorSpace.linearSRGB))
+        let image = try Support.image([128, 128, 128, 255], width: 1, height: 1, space: linear)
+        let decoded = try XCTUnwrap(Check.decodePNG(Support.png(image)))
+        let converted = try XCTUnwrap(Check.sRGBPixels(decoded))
+        for channel in converted.prefix(3) { XCTAssertEqual(Double(channel), 188, accuracy: 1) }
+    }
