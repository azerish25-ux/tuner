diff --git a/tools/ci/build_current_contrast_fixtures.py b/tools/ci/build_current_contrast_fixtures.py
new file mode 100644
index 0000000000000000000000000000000000000000..3c62835a1457e3a5ea614dac24876f719222ffdb
--- /dev/null
+++ b/tools/ci/build_current_contrast_fixtures.py
@@ -0,0 +1,153 @@
+#!/usr/bin/env python3
+"""Build inactive current-raster candidates from hash-verified native callback PNGs.
+
+The source revision is provenance, never an equality gate. This tool cannot approve
+coverage or change audit outcomes. Review the support plots before any integration.
+"""
+import argparse
+import base64
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageDraw, PngImagePlugin
+
+EXCLUDED_KEYS = {'tab-3-songs-2', 'tab-3-songs-3', 'tab-3-songs-8'}
+PADDING_PIXELS = 8
+
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def unpack(data, width, height):
+    raw = np.frombuffer(base64.b64decode(data, validate=True), dtype=np.uint8)
+    return np.unpackbits(raw, bitorder='big')[:width * height].reshape(height, width).astype(bool)
+
+
+def pack(mask):
+    return base64.b64encode(np.packbits(mask.ravel(), bitorder='big')).decode()
+
+
+def luma(rgb):
+    value = rgb.astype(float) / 255
+    return np.where(value <= .04045, value / 12.92, ((value + .055) / 1.055) ** 2.4) @ [.2126, .7152, .0722]
+
+
+def ratio_extrema(foreground, background):
+    if foreground.min() > background.max():
+        return float((foreground.min() + .05) / (background.max() + .05))
+    if background.min() > foreground.max():
+        return float((background.min() + .05) / (foreground.max() + .05))
+    return 1.0
+
+
+def build(old_catalog, fresh_review, screenshots, out, review):
+    old = json.loads(old_catalog.read_bytes())
+    fresh = json.loads(fresh_review.read_bytes())
+    current = {row.get('referenceTemplateKey'): row for row in fresh['callbacks'] if row.get('referenceTemplateKey')}
+    out.mkdir(parents=True, exist_ok=True)
+    review.mkdir(parents=True, exist_ok=True)
+    fixtures = []
+    plot_files = []
+    for fixture in old['fixtures']:
+        if fixture['key'] in EXCLUDED_KEYS:
+            continue
+        row = current[fixture['key']]
+        assert row['freshCallbackIdentityObserved'] and row['exactReferenceFrame']
+        filename = row['originalFile']
+        assert Path(filename).name == filename
+        original = (screenshots / filename).read_bytes()
+        assert sha(original) == row['originalSHA256']
+        image = Image.open(screenshots / filename)
+        assert image.mode == 'RGB' and image.size == (1206, 2622)
+        assert image.info.get('srgb') == 0 and not image.info.get('icc_profile')
+        assert image.getexif().get(274, 1) == 1
+        left, top, right, bottom = row['pixelRect']
+        pad = PADDING_PIXELS
+        support = [left - pad, top - pad, right + pad, bottom + pad]
+        assert support[0] >= 0 and support[1] >= 0 and support[2] <= 1206 and support[3] < 791 * 3
+        crop = image.crop(support)
+        pixels = np.asarray(crop)
+        height, width = pixels.shape[:2]
+        old_width, old_height = right - left, bottom - top
+
+        def expand(encoded):
+            result = np.zeros((height, width), dtype=bool)
+            result[pad:pad + old_height, pad:pad + old_width] = unpack(encoded, old_width, old_height)
+            return result
+
+        backing = expand(fixture['backgroundMask'])
+        roles = []
+        luminances = luma(pixels)
+        overlay = pixels.copy()
+        overlay[backing] = [0, 220, 255]
+        for role in fixture['roles']:
+            core = expand(role['coreMask'])
+            glyph = expand(role['glyphMask'])
+            assert core.any() and not np.any(core & backing)
+            ratio = ratio_extrema(luminances[core], luminances[backing])
+            assert ratio >= 4.5
+            roles.append({'name': role['name'], 'coreMask': pack(core), 'glyphMask': pack(glyph), 'minimumRatio': ratio})
+            overlay[core] = [255, 0, 255]
+        # A pinned whole support raster includes antialiasing and margin, not just the core mask.
+        info = PngImagePlugin.PngInfo()
+        info.add(b'sRGB', b'\0')
+        temporary = out / 'temporary.png'
+        crop.save(temporary, pnginfo=info, optimize=True)
+        data = temporary.read_bytes()
+        resource = sha(data) + '.png'
+        temporary.rename(out / resource)
+        rgba = np.concatenate([pixels, np.full((height, width, 1), 255, dtype=np.uint8)], axis=2).tobytes()
+        fixtures.append({
+            'key': fixture['key'], 'screen': row['screen'], 'identifier': row['identifier'],
+            'label': row['label'], 'elementType': row['elementType'], 'frame': row['frame'],
+            'viewport': [0, 0, 402, 874], 'clearBounds': [0, 0, 402, 791],
+            'imageSize': [1206, 2622], 'supportRect': support, 'paddingPixels': pad,
+            'referenceSourceSHA': fresh['actualTestedMergeSHA'],
+            'referencePNG': filename, 'referencePNGSHA256': row['originalSHA256'],
+            'resource': resource, 'resourceSHA256': sha(data), 'rgbaSHA256': sha(rgba),
+            'roles': roles, 'backgroundMask': pack(backing),
+            'minimumRatio': min(role['minimumRatio'] for role in roles),
+            'coverageReview': 'pending-independent-expanded-support-review',
+        })
+        # Side-by-side raw support and sampled core/backing; AX frame is outlined, not used as crop.
+        panel = Image.new('RGB', (width * 2 + 12, height + 26), '#222222')
+        panel.paste(crop, (0, 26))
+        panel.paste(Image.fromarray(overlay), (width + 12, 26))
+        draw = ImageDraw.Draw(panel)
+        draw.text((2, 3), fixture['key'] + '  ' + row['label'], fill='white')
+        draw.rectangle([pad, pad + 26, width - pad - 1, height - pad - 1 + 26], outline='#ff8800')
+        plot = review / (fixture['key'] + '.png')
+        panel.resize((panel.width * 2, panel.height * 2)).save(plot)
+        plot_files.append(plot.name)
+    assert len(fixtures) == 10
+    excluded = list(old['excluded']) + [
+        {'key': key, 'reason': 'Overlapping title-line support requires independent review; not in this catalog.'}
+        for key in sorted(EXCLUDED_KEYS)
+    ] + [{'reason': 'Every anonymous callback and all unrecognized identities, including E7, reject.'}]
+    document = {
+        'version': 1, 'status': 'inactive-review-candidate', 'maximumChannelDelta': 0,
+        'referenceSourceSHA': fresh['actualTestedMergeSHA'],
+        'referenceRunID': fresh['runID'], 'referenceJobID': fresh['jobID'],
+        'fixtures': fixtures, 'excluded': excluded,
+        'claim': 'Current sampled raster only; no audit filter, app equivalence or WCAG conformance claim.',
+    }
+    data = (json.dumps(document, sort_keys=True, separators=(',', ':')) + '\n').encode()
+    (out / 'catalog.json').write_bytes(data)
+    (out / 'catalog.sha256').write_text(sha(data) + '\n')
+    (review / 'support-index.json').write_text(json.dumps({
+        'catalogSHA256': sha(data), 'plots': plot_files, 'fixtures': [
+            {key: f[key] for key in ('key', 'label', 'frame', 'supportRect', 'minimumRatio', 'coverageReview', 'referencePNG', 'referencePNGSHA256')}
+            for f in fixtures
+        ]}, indent=2) + '\n')
+    print(json.dumps({'fixtures': len(fixtures), 'catalogSHA256': sha(data), 'resourceBytes': sum(p.stat().st_size for p in out.iterdir()), 'coverageApproved': False}))
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser()
+    for name in ['old-catalog', 'fresh-review', 'screenshots', 'output', 'review-output']:
+        parser.add_argument('--' + name, type=Path, required=True)
+    args = parser.parse_args()
+    build(args.old_catalog, args.fresh_review, args.screenshots, args.output, args.review_output)
diff --git a/tools/ci/current_contrast_raster_model.py b/tools/ci/current_contrast_raster_model.py
