+/// Separate required native check against full, original, hash-verified callback PNGs.
+/// A compact synthetic canvas is useful unit input, not provenance for a live callback.
+@MainActor
+final class CurrentCallbackOriginalRasterTests: XCTestCase {
+    func testFullOriginalPNGsThroughNativeColorManagement() throws {
+        let support = try Support()
+        for fixture in support.catalog.fixtures {
+            let bundle = Bundle(for: Self.self)
+            let url = try XCTUnwrap(bundle.url(forResource: fixture.referencePNGSHA256, withExtension: "png",
+                subdirectory: "CurrentContrastOriginals"), "Materialize verified originals; do not skip missing evidence")
+            let bytes = try Data(contentsOf: url)
+            XCTAssertEqual(CurrentCallbackRasterCheck.sha256(bytes), fixture.referencePNGSHA256)
+            let result = try XCTUnwrap(support.inspect(fixture, first: bytes, second: bytes))
+            XCTAssertGreaterThanOrEqual(result.minimumRatio, 4.5)
+            XCTAssertFalse(result.auditAuthorization)
+        }
+    }
+}
+
+@MainActor
+private struct Support {
+    typealias Check = CurrentCallbackRasterCheck
+    let catalog: Check.Catalog
+    init() throws {
+        let data = try Self.load("catalog.json")
+        catalog = try XCTUnwrap(Check.loadCatalog(data: data) { try? Self.load($0) })
+    }
+    private static func load(_ name: String) throws -> Data {
+        let bundle = Bundle(for: CurrentCallbackRasterCheckTests.self)
+        let url = try XCTUnwrap(bundle.url(forResource: name, withExtension: nil, subdirectory: "CurrentContrastFixtures"))
+        return try Data(contentsOf: url)
+    }
+    func resource(_ name: String) throws -> Data { try Self.load(name) }
+    func identity(_ fixture: Check.Fixture, screen: String? = nil, identifier: String? = nil,
+                  label: String? = nil, elementType: Int? = nil, frame: CGRect? = nil,
+                  enabled: Bool = true, selected: Bool = false) -> Check.Identity {
+        Check.Identity(screen: screen ?? fixture.screen, identifier: identifier ?? fixture.identifier,
+            label: label ?? fixture.label, elementType: elementType ?? fixture.elementType,
+            frame: frame ?? Check.rect(fixture.frame), isEnabled: enabled, isSelected: selected)
+    }
+    func context(_ fixture: Check.Fixture) -> Check.Context {
+        Check.Context(auditContextID: UUID(uuidString: "00000000-0000-0000-0000-000000000001")!, screen: fixture.screen, viewport: Check.rect(fixture.viewport),
+            clearBounds: Check.rect(fixture.clearBounds), blockedRects: [], exactIdentityMatches: 1)
+    }
+    func inspect(_ fixture: Check.Fixture, first: Data, second: Data,
+                 before: Check.Identity? = nil, after: Check.Identity? = nil,
+                 contextBefore: Check.Context? = nil, contextAfter: Check.Context? = nil,
+                 elapsed: Double = 1) -> Check.Measurement? {
+        Check.inspect(before: before ?? identity(fixture), after: after ?? identity(fixture),
+            beforePNG: first, afterPNG: second, contextBeforeAudit: contextBefore ?? context(fixture),
+            contextAfterAudit: contextAfter ?? context(fixture), elapsedSeconds: elapsed, catalog: catalog)
+    }
+    func crop(_ fixture: Check.Fixture) throws -> [UInt8] {
+        let source = try XCTUnwrap(Check.decodePNG(resource(fixture.resource)))
+        return try XCTUnwrap(Check.sRGBPixels(source))
+    }
+    func canvas(_ fixture: Check.Fixture, crop: [UInt8]? = nil, space: CGColorSpace? = nil) throws -> Data {
+        let patch: [UInt8] = try crop ?? self.crop(fixture)
+        let width = fixture.imageSize[0]
+        let height = fixture.imageSize[1]
+        var pixels = [UInt8](repeating: 0, count: width * height * 4)
+        for offset in stride(from: 3, to: pixels.count, by: 4) { pixels[offset] = 255 }
+        for y in 0..<fixture.height {
+            let destination = ((fixture.supportRect[1] + y) * width + fixture.supportRect[0]) * 4
+            let start = y * fixture.width * 4
+            pixels.replaceSubrange(destination..<(destination + fixture.width * 4), with: patch[start..<(start + fixture.width * 4)])
+        }
+        return try Self.png(Self.image(pixels, width: width, height: height, space: space))
+    }
+    static func image(_ pixels: [UInt8], width: Int, height: Int, space: CGColorSpace? = nil) throws -> CGImage {
+        let provider = try XCTUnwrap(CGDataProvider(data: Data(pixels) as CFData))
+        let colorSpace: CGColorSpace = try space ?? XCTUnwrap(CGColorSpace(name: CGColorSpace.sRGB))
+        return try XCTUnwrap(CGImage(width: width, height: height, bitsPerComponent: 8, bitsPerPixel: 32,
+            bytesPerRow: width * 4, space: colorSpace,
+            bitmapInfo: CGBitmapInfo(rawValue: CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue),
+            provider: provider, decode: nil, shouldInterpolate: false, intent: .relativeColorimetric))
+    }
+    static func png(_ image: CGImage, orientation: Int = 1) throws -> Data {
+        let result = NSMutableData()
+        let destination = try XCTUnwrap(CGImageDestinationCreateWithData(result, "public.png" as CFString, 1, nil))
+        let options: [CFString: Any] = [kCGImagePropertyOrientation: orientation]
+        CGImageDestinationAddImage(destination, image, options as CFDictionary)
+        XCTAssertTrue(CGImageDestinationFinalize(destination))
+        return result as Data
+    }
+    static func removingColorProfileChunks(_ png: Data) throws -> Data {
+        let bytes = [UInt8](png)
+        var result = Data(bytes.prefix(8))
+        var offset = 8
+        while offset <= bytes.count - 12 {
+            let count = (Int(bytes[offset]) << 24) | (Int(bytes[offset + 1]) << 16)
+                | (Int(bytes[offset + 2]) << 8) | Int(bytes[offset + 3])
+            guard count <= bytes.count - offset - 12 else { throw NSError(domain: "PNGTest", code: 1) }
+            let end = offset + count + 12
+            let type = String(bytes: bytes[(offset + 4)..<(offset + 8)], encoding: .ascii)
+            if type != "sRGB" && type != "iCCP" && type != "gAMA" && type != "cHRM" {
+                result.append(contentsOf: bytes[offset..<end]) // Existing CRCs remain valid.
+            }
+            offset = end
+        }
+        return result
+    }
+
+    static func paint(_ pixels: inout [UInt8], pixel: Int, rgba: [UInt8]) {
+        pixels.replaceSubrange((pixel * 4)..<(pixel * 4 + 4), with: rgba)
+    }
+    static func components(_ mask: Set<Int>, width: Int, height: Int) -> [[Int]] {
+        var remaining = mask
+        var result: [[Int]] = []
+        while let seed = remaining.first {
+            remaining.remove(seed)
+            var pending = [seed]
+            var component: [Int] = []
+            while let pixel = pending.popLast() {
+                component.append(pixel)
+                for dy in -1...1 {
+                    for dx in -1...1 where dx != 0 || dy != 0 {
+                        let x = pixel % width + dx
+                        let y = pixel / width + dy
+                        if x >= 0, y >= 0, x < width, y < height, remaining.remove(y * width + x) != nil {
+                            pending.append(y * width + x)
+                        }
+                    }
+                }
+            }
+            result.append(component)
+        }
+        return result
+    }
+}
