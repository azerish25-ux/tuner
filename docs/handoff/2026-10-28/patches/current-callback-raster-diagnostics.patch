+"""Bounded portable fixture/mutation checks; never a claim that native Swift ran."""
+import copy
+import io
+import json
+import sys
+import subprocess
+import zlib
+import unittest
+from pathlib import Path
+
+import numpy as np
+from PIL import Image, ImageCms, PngImagePlugin
+from scipy.ndimage import label
+
+sys.path.insert(0, str(Path(__file__).parent))
+import current_contrast_raster_model as model
+
+ROOT = Path(__file__).resolve().parents[2]
+RESOURCES = ROOT / 'ios/TimbreUITests/CurrentContrastFixtures'
+
+
+class CurrentContrastRasterTests(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.catalog = model.load(RESOURCES)
+
+    def fixture(self, f):
+        identity = {key: f[key] for key in ['screen', 'identifier', 'label', 'elementType', 'frame']}
+        identity.update(isEnabled=True, isSelected=False)
+        context = dict(screen=f['screen'], viewport=f['viewport'], clearBounds=f['clearBounds'], blockedRects=[], matches=1)
+        image = np.zeros((2622, 1206, 4), dtype=np.uint8)
+        image[:, :, 3] = 255
+        l, t, r, b = f['supportRect']
+        image[t:b, l:r] = f['_pixels']
+        return identity, context, image
+
+    def check(self, identity, context, image, after=None, second=None, after_context=None, elapsed=1):
+        return model.inspect(self.catalog, identity, identity if after is None else after,
+                             image, image if second is None else second, context,
+                             context if after_context is None else after_context, elapsed)
+
+    def test_all_ten_exact_expanded_supports_pass_diagnostic_only(self):
+        for f in self.catalog['fixtures']:
+            ident, context, image = self.fixture(f)
+            result = self.check(ident, context, image)
+            self.assertIsNotNone(result, f['key'])
+            self.assertFalse(result['auditAuthorization'])
+            self.assertAlmostEqual(result['minimumRatio'], f['minimumRatio'], places=8)
+            self.assertGreaterEqual(result['minimumRatio'], 4.5)
+            self.assertEqual(f['coverageReview'], 'pending-independent-expanded-support-review')
+
+    def test_every_component_blank_low_contrast_backing_and_margin_mutations_reject(self):
+        negatives = 0
+        for f in self.catalog['fixtures']:
+            ident, context, image = self.fixture(f)
+            l, t, r, b = f['supportRect']
+            crop = image[t:b, l:r]
+            core = np.logical_or.reduce([model.mask(role['coreMask'], crop.shape[:2]) for role in f['roles']])
+            glyph = np.logical_or.reduce([model.mask(role['glyphMask'], crop.shape[:2]) for role in f['roles']])
+            backing = model.mask(f['backgroundMask'], crop.shape[:2])
+            mutations = []
+            for color in [20, 245]:
+                value = crop.copy(); value[:, :, :3] = color; mutations.append(value)
+            value = crop.copy(); value[core, :3] = 100; mutations.append(value)
+            value = crop.copy(); value[backing, :3] = 160; mutations.append(value)
+            value = crop.copy(); value[0, 0, 0] ^= 1; mutations.append(value)
+            value = crop.copy(); value[0, 0, 3] = 0; mutations.append(value)
+            value = np.roll(crop, 1, axis=1); mutations.append(value)
+            mutations.append(crop[::-1, ::-1])
+            components, count = label(glyph, structure=np.ones((3, 3)))
+            for component in range(1, count + 1):
+                value = crop.copy(); value[components == component, :3] = 100; mutations.append(value)
+            for value in mutations:
+                changed = image.copy(); changed[t:b, l:r] = value
+                self.assertIsNone(self.check(ident, context, changed), f['key'])
+                self.assertIsNone(self.check(ident, context, image, second=changed), f['key'])
+                negatives += 2
+        self.assertGreaterEqual(negatives, 250)
+        print(f'Validated {negatives} raster negatives (including every pinned component deletion).')
+
+    def test_minimum_contrast_boundary_uses_worst_pixel_not_an_average(self):
+        import base64
+        def encoded(bits):
+            return base64.b64encode(np.packbits(np.asarray(bits, dtype=bool), bitorder='big')).decode()
+        fixture = dict(backgroundMask=encoded([False, True]), roles=[dict(name='ink', coreMask=encoded([True, False]))])
+        passing = np.array([[[118, 118, 118, 255], [255, 255, 255, 255]]], dtype=np.uint8)
+        self.assertGreaterEqual(model.ratios(fixture, passing)['ink'], 4.5)
+        failing = passing.copy(); failing[0, 0, :3] = 119
+        with self.assertRaises(ValueError): model.ratios(fixture, failing)
+
+    def test_identity_state_context_bounds_duplicates_and_timing_reject(self):
+        for f in self.catalog['fixtures']:
+            ident, context, image = self.fixture(f)
+            for key, value in [('screen', 'foreign'), ('identifier', ''), ('identifier', '-'), ('label', 'E7'), ('elementType', 999), ('frame', [0, 0, 1, 1])]:
+                changed = dict(ident); changed[key] = value
+                self.assertIsNone(self.check(changed, context, image))
+                self.assertIsNone(self.check(ident, context, image, after=changed))
+            for key in ['isEnabled', 'isSelected']:
+                changed = dict(ident); changed[key] = not changed[key]
+                self.assertIsNone(self.check(ident, context, image, after=changed))
+            for key, value in [('screen', 'foreign'), ('matches', 0), ('matches', 2), ('viewport', [0, 0, 401, 874]), ('clearBounds', [0, 0, 402, 50]), ('blockedRects', [ident['frame']])]:
+                changed = dict(context); changed[key] = value
+                self.assertIsNone(self.check(ident, changed, image))
+                self.assertIsNone(self.check(ident, context, image, after_context=changed))
+            for elapsed in [float('nan'), float('inf'), -.01, 5.01]:
+                self.assertIsNone(self.check(ident, context, image, elapsed=elapsed))
+            self.assertIsNone(self.check(ident, context, image[::2, ::2]))
+
+    def test_all_eighteen_old_occluded_plus_unreviewed_and_anonymous_reject(self):
+        f = self.catalog['fixtures'][0]
+        ident, context, image = self.fixture(f)
+        excluded = [row for row in self.catalog['excluded'] if 'elementType' in row]
+        self.assertEqual(len(excluded), 18)
+        self.assertTrue(any(row['label'] == '28' for row in excluded))
+        for row in excluded:
+            changed = dict(ident)
+            changed.update({key: row[key] for key in ['screen', 'identifier', 'label', 'elementType', 'frame']})
+            self.assertIsNone(self.check(changed, context, image))
+        self.assertFalse(any(row['label'] in ['Jingle', 'Bells', 'Ode to', 'E7'] for row in self.catalog['fixtures']))
+        for missing in ['', '-']:
+            for text in ['unknown one', 'unknown two', 'unknown three']:
+                changed = dict(ident, identifier=missing, label=text)
+                self.assertIsNone(self.check(changed, context, image))
+
+    def test_original_provenance_is_not_current_revision_gate(self):
+        source = (ROOT / 'ios/TimbreUITests/CurrentCallbackRasterCheck.swift').read_text()
+        self.assertIn('actualBefore == actualAfter, actualBefore == reference', source)
+        self.assertIn('elapsedSeconds <= CurrentCallbackCapture.maximumCaptureSeconds', source)
+        self.assertIn('referenceSourceSHA: fixture.referenceSourceSHA', source)
+        self.assertNotIn('captureRevision', source)
+        self.assertNotIn('renderInputsSignature', source)
+        self.assertNotIn('installed', source)
+        self.assertNotIn('maximumChannelDelta == 4', source)
+        self.assertIn('auditAuthorization: Bool = false', source)
+        self.assertIn('input.copyICCData() != nil', source)
+        self.assertIn('orientation == 1', source)
+        self.assertIn('CGColorSpace.sRGB', source)
+        self.assertNotIn('UIImage.scale', source.replace('// UIImage.scale, UIImage.size and an expected scale supplied by a caller are never used.', ''))
+
+    def test_original_png_profile_chunks_reject_missing_corrupt_and_ambiguous_declarations(self):
+        original = (RESOURCES / self.catalog['fixtures'][0]['resource']).read_bytes()
+        self.assertEqual(model.source_profile(original), ('srgb', None))
+        icc = ImageCms.ImageCmsProfile(ImageCms.createProfile('sRGB')).tobytes()
+        tagged = io.BytesIO()
+        Image.fromarray(self.catalog['fixtures'][0]['_pixels']).save(tagged, format='PNG', icc_profile=icc)
+        self.assertEqual(model.source_profile(tagged.getvalue()), ('icc', icc))
+        self.assertTrue(np.array_equal(model.rgba(tagged.getvalue()), self.catalog['fixtures'][0]['_pixels']))
+        chunks, offset = [], 8
+        while offset < len(original):
+            size = int.from_bytes(original[offset:offset + 4], 'big')
+            chunks.append(original[offset:offset + size + 12])
+            offset += size + 12
+        profile = next(chunk for chunk in chunks if chunk[4:8] == b'sRGB')
+        untagged = original[:8] + b''.join(chunk for chunk in chunks if chunk[4:8] != b'sRGB')
+        image = Image.open(io.BytesIO(untagged)); image.load()  # Decodable is not explicitly profiled.
+        corrupt = bytearray(original)
+        corrupt[original.index(b'sRGB') + 4] ^= 1  # Keep stale CRC.
+        duplicate = original[:8] + chunks[0] + profile + b''.join(chunks[1:])
+        def chunk(kind, payload):
+            return len(payload).to_bytes(4, 'big') + kind + payload + zlib.crc32(kind + payload).to_bytes(4, 'big')
+        invalid_icc = chunk(b'iCCP', b'ICC\0\0not-zlib')
+        bogus_profile = chunk(b'iCCP', b'ICC\0\0' + zlib.compress(b'x' * 128))
+        bomb = chunk(b'iCCP', b'ICC\0\0' + zlib.compress(b'x' * (1024 * 1024 + 1)))
+        for changed in [untagged, bytes(corrupt), duplicate,
+                        untagged[:33] + invalid_icc + untagged[33:],
+                        untagged[:33] + bogus_profile + untagged[33:],
+                        untagged[:33] + bomb + untagged[33:], original[:-1], original + b'trailing']:
+            with self.assertRaises(ValueError): model.rgba(changed)
+        source = (ROOT / 'ios/TimbreUITests/CurrentCallbackRasterCheck.swift').read_text()
+        for token in ['let declaredSpace = sourcePNGColorSpace(data)', 'CFEqual(decodedSpace, declaredSpace)',
+                      'crc32(', 'uncompress(', 'CGColorSpace(iccData:', 'space == nil, !sawImageData']:
+            self.assertIn(token, source)
+        native = (ROOT / 'ios/TimbreUITests/CurrentCallbackRasterCheckTests.swift').read_text()
+        self.assertIn('Check.decodePNG(untagged)', native)
+        self.assertIn('support.inspect(fixture, first: untagged, second: untagged)', native)
+        self.assertIn('CGImageSourceCreateImageAtIndex(container, 0, nil)', native)
+
+    def test_original_materializer_is_stdlib_only_and_uses_the_same_catalog_pin(self):
+        script = ROOT / 'tools/ci/materialize_current_contrast_originals.py'
