+import CryptoKit
+import ImageIO
+import UIKit
+import zlib
+
+/// Inactive diagnostic. No audit calls this helper, and a Measurement is not an exemption.
+/// The claim is confined to the supplied current, stable screenshot pair's reviewed support raster.
+/// App revision and runtime configuration are provenance, not substitutes for actual pixels.
+enum CurrentCallbackRasterCheck {
+    static let catalogSHA256 = "c56439643b1aedbd93a1570d722a434f1fd232c15e42bb306edcd97670f7f4c7"
+    static let minimumContrast: Double = 4.5
+
+    struct Identity: Equatable {
+        let screen: String
+        let identifier: String
+        let label: String
+        let elementType: Int
+        let frame: CGRect
+        let isEnabled: Bool
+        let isSelected: Bool
+    }
+
+    /// Capture these outside the audit handler from the actual application hierarchy.
+    /// Unknown/ambiguous screen, clipping or overlay bounds cannot be replaced by fixture bounds.
+    struct Context: Equatable {
+        let auditContextID: UUID
+        let screen: String
+        let viewport: CGRect
+        let clearBounds: CGRect
+        let blockedRects: [CGRect]
+        let exactIdentityMatches: Int
+    }
+
+    struct Role: Decodable {
+        let name: String
+        let coreMask: Data
+        let glyphMask: Data
+        let minimumRatio: Double
+    }
+
+    struct Fixture: Decodable {
+        let key: String
+        let screen: String
+        let identifier: String
+        let label: String
+        let elementType: Int
+        let frame: [Double]
+        let viewport: [Double]
+        let clearBounds: [Double]
+        let imageSize: [Int]
+        let supportRect: [Int]
+        let paddingPixels: Int
+        let referenceSourceSHA: String
+        let referencePNG: String
+        let referencePNGSHA256: String
+        let resource: String
+        let resourceSHA256: String
+        let rgbaSHA256: String
+        let roles: [Role]
+        let backgroundMask: Data
+        let minimumRatio: Double
+        let coverageReview: String
+        var width: Int { supportRect[2] - supportRect[0] }
+        var height: Int { supportRect[3] - supportRect[1] }
+    }
+
+    struct Catalog {
+        let fixtures: [Fixture]
+        fileprivate let references: [String: [UInt8]]
+    }
+
+    struct Measurement {
+        let fixtureKey: String
+        let minimumRatio: Double
+        let roleRatios: [String: Double]
+        let supportPixels: Int
+        let beforePNGSHA256: String
+        let afterPNGSHA256: String
+        let referencePNGSHA256: String
+        let referenceSourceSHA: String
+        /// This review candidate cannot authorize an audit exception.
+        let auditAuthorization: Bool = false
+    }
+
+    private struct Document: Decodable {
+        let version: Int
+        let status: String
+        let maximumChannelDelta: Int
+        let fixtures: [Fixture]
+    }
+
+    static func loadCatalog(data: Data, resource: (String) -> Data?) -> Catalog? {
+        guard sha256(data) == catalogSHA256,
+              let document = try? JSONDecoder().decode(Document.self, from: data),
+              document.version == 1, document.status == "inactive-review-candidate",
+              document.maximumChannelDelta == 0, document.fixtures.count == 10 else { return nil }
+        var references: [String: [UInt8]] = [:]
+        for fixture in document.fixtures {
+            guard references[fixture.key] == nil, !fixture.identifier.isEmpty,
+                  fixture.frame.count == 4, fixture.viewport == [0, 0, 402, 874],
+                  fixture.clearBounds == [0, 0, 402, 791], fixture.imageSize == [1206, 2622],
+                  fixture.supportRect.count == 4, fixture.paddingPixels == 8,
+                  fixture.width > 0, fixture.height > 0,
+                  fixture.width * fixture.height <= 100_000,
+                  fixture.coverageReview == "pending-independent-expanded-support-review",
+                  fixture.resource == fixture.resourceSHA256 + ".png",
+                  let bytes = resource(fixture.resource), sha256(bytes) == fixture.resourceSHA256,
+                  let source = decodePNG(bytes), source.width == fixture.width, source.height == fixture.height,
+                  let pixels = sRGBPixels(source), sha256(Data(pixels)) == fixture.rgbaSHA256,
+                  validateMasks(fixture) else { return nil }
+            references[fixture.key] = pixels
+        }
+        return Catalog(fixtures: document.fixtures, references: references)
+    }
+
+    /// Runtime diagnostic entry: accepts only the collector's private-initialized in-memory capture.
+    /// Pre/post contexts are observed outside the callback; neither a UUID nor a hash proves their completeness.
+    static func inspect(capture: CurrentCallbackCapture.Capture,
+                        contextBeforeAudit: Context, contextAfterAudit: Context,
+                        catalog: Catalog?) -> Measurement? {
+        let metadata = capture.metadata
+        guard metadata.schema == 1, metadata.status == "captured-diagnostic-only", metadata.problems.isEmpty,
+              metadata.auditContextID == contextBeforeAudit.auditContextID.uuidString.lowercased(),
+              metadata.auditContextID == contextAfterAudit.auditContextID.uuidString.lowercased(),
+              metadata.screenKey == contextBeforeAudit.screen,
+              let first = capture.firstPNG, let second = capture.secondPNG,
+              let before = metadata.before, let after = metadata.after,
+              let beforeType = Int(exactly: before.elementType), let afterType = Int(exactly: after.elementType),
+              metadata.pngs.count == 2,
+              metadata.pngs[0].sha256 == sha256(first), metadata.pngs[1].sha256 == sha256(second) else { return nil }
+        func identity(_ value: CurrentCallbackCapture.Element, type: Int) -> Identity {
+            Identity(screen: metadata.screenKey, identifier: value.identifier, label: value.label,
+                elementType: type,
+                frame: CGRect(x: CGFloat(value.frame.x), y: CGFloat(value.frame.y),
+                              width: CGFloat(value.frame.width), height: CGFloat(value.frame.height)),
+                isEnabled: value.elementState.isEnabled, isSelected: value.elementState.isSelected)
+        }
+        return inspect(before: identity(before, type: beforeType), after: identity(after, type: afterType),
+            beforePNG: first, afterPNG: second, contextBeforeAudit: contextBeforeAudit,
+            contextAfterAudit: contextAfterAudit, elapsedSeconds: metadata.uptimeEnd - metadata.uptimeStart,
+            catalog: catalog)
+    }
+
+    /// Unit-testable raster check. Runtime PNG inputs must come directly from the callback collector,
+    /// never a file, reference resource, caller digest, or a screenshot taken after a reveal/retry.
+    static func inspect(before: Identity, after: Identity, beforePNG: Data, afterPNG: Data,
+                        contextBeforeAudit: Context, contextAfterAudit: Context,
+                        elapsedSeconds: Double, catalog: Catalog?) -> Measurement? {
+        guard let catalog, before == after,
+              contextBeforeAudit == contextAfterAudit,
+              elapsedSeconds.isFinite, elapsedSeconds >= 0, elapsedSeconds <= CurrentCallbackCapture.maximumCaptureSeconds,
+              contextBeforeAudit.exactIdentityMatches == 1,
+              before.screen == contextBeforeAudit.screen,
+              finitePositive(before.frame), finitePositive(contextBeforeAudit.viewport),
+              finitePositive(contextBeforeAudit.clearBounds),
+              contextBeforeAudit.viewport.origin == .zero,
+              contextBeforeAudit.viewport.contains(contextBeforeAudit.clearBounds),
+              contextBeforeAudit.clearBounds.contains(before.frame) else { return nil }
+        let candidates = catalog.fixtures.filter { fixture in
+            fixture.screen == before.screen && fixture.identifier == before.identifier &&
+            fixture.label == before.label && fixture.elementType == before.elementType &&
+            rect(fixture.frame) == before.frame && rect(fixture.viewport) == contextBeforeAudit.viewport
+        }
+        guard candidates.count == 1, let fixture = candidates.first,
+              let reference = catalog.references[fixture.key],
+              let first = decodePNG(beforePNG), let second = decodePNG(afterPNG),
+              first.width == fixture.imageSize[0], first.height == fixture.imageSize[1],
+              second.width == first.width, second.height == first.height else { return nil }
+        // Derive physical mapping from the actual pixel dimensions and observed app viewport.
+        // UIImage.scale, UIImage.size and an expected scale supplied by a caller are never used.
+        let sx = CGFloat(first.width) / contextBeforeAudit.viewport.width
+        let sy = CGFloat(first.height) / contextBeforeAudit.viewport.height
+        guard sx == 3, sy == 3 else { return nil }
+        let support = CGRect(x: CGFloat(fixture.supportRect[0]) / sx,
+                             y: CGFloat(fixture.supportRect[1]) / sy,
+                             width: CGFloat(fixture.width) / sx, height: CGFloat(fixture.height) / sy)
+        guard contextBeforeAudit.clearBounds.contains(support),
+              rect(fixture.clearBounds).contains(support),
+              contextBeforeAudit.blockedRects.allSatisfy({ finitePositive($0) && !$0.intersects(support) }),
+              let actualBefore = supportPixels(first, fixture: fixture),
+              let actualAfter = supportPixels(second, fixture: fixture),
+              actualBefore == actualAfter, actualBefore == reference else { return nil }
+        let count = fixture.width * fixture.height
+        let backing = indices(fixture.backgroundMask, count: count)
+        var ratios: [String: Double] = [:]
+        for role in fixture.roles {
+            let core = indices(role.coreMask, count: count)
+            guard let ratio = measuredRatio(actualBefore, core: core, backing: backing) else { return nil }
+            ratios[role.name] = ratio
+        }
+        guard let ratio = ratios.values.min() else { return nil }
+        return Measurement(fixtureKey: fixture.key, minimumRatio: ratio, roleRatios: ratios,
+                           supportPixels: count, beforePNGSHA256: sha256(beforePNG),
+                           afterPNGSHA256: sha256(afterPNG), referencePNGSHA256: fixture.referencePNGSHA256,
+                           referenceSourceSHA: fixture.referenceSourceSHA)
+    }
+
+    private static func supportPixels(_ source: CGImage, fixture: Fixture) -> [UInt8]? {
+        let box = fixture.supportRect
+        guard box[0] >= 0, box[1] >= 0, box[2] <= source.width, box[3] <= source.height,
+              let crop = source.cropping(to: CGRect(x: CGFloat(box[0]), y: CGFloat(box[1]), width: CGFloat(fixture.width), height: CGFloat(fixture.height))),
+              crop.width == fixture.width, crop.height == fixture.height,
+              let pixels = sRGBPixels(crop) else { return nil }
+        for offset in stride(from: 3, to: pixels.count, by: 4) where pixels[offset] != 255 { return nil }
+        return pixels
+    }
+
+    /// Decode the exact PNG bytes that are attached. Do not apply orientation or reinterpret raw RGB bytes.
+    static func decodePNG(_ data: Data) -> CGImage? {
+        let signature: [UInt8] = [137, 80, 78, 71, 13, 10, 26, 10]
+        guard data.count <= 32 * 1024 * 1024, Array(data.prefix(8)) == signature,
+              let declaredSpace = sourcePNGColorSpace(data),
+              let container = CGImageSourceCreateWithData(data as CFData, nil),
+              CGImageSourceGetCount(container) == 1,
+              let properties = CGImageSourceCopyPropertiesAtIndex(container, 0, nil) as? [CFString: Any] else { return nil }
+        let orientation = (properties[kCGImagePropertyOrientation] as? NSNumber)?.intValue ?? 1
+        guard orientation == 1,
+              let width = (properties[kCGImagePropertyPixelWidth] as? NSNumber)?.intValue,
+              let height = (properties[kCGImagePropertyPixelHeight] as? NSNumber)?.intValue,
+              width > 0, height > 0, width <= 4096, height <= 4096,
+              let source = CGImageSourceCreateImageAtIndex(container, 0, nil),
+              source.width == width, source.height == height,
+              let decodedSpace = source.colorSpace, CFEqual(decodedSpace, declaredSpace) else { return nil }
+        return source
+    }
+
+    /// ImageIO can assign a default profile to untagged bytes. Require explicit source evidence
+    /// first, including chunk CRCs; never mistake that default for an embedded color declaration.
+    private static func sourcePNGColorSpace(_ data: Data) -> CGColorSpace? {
+        let bytes = [UInt8](data)
+        var offset = 8
+        var space: CGColorSpace?
+        var sawImageData = false
+        func word(_ index: Int) -> UInt32 {
+            (UInt32(bytes[index]) << 24) | (UInt32(bytes[index + 1]) << 16)
+                | (UInt32(bytes[index + 2]) << 8) | UInt32(bytes[index + 3])
+        }
+        while offset <= bytes.count - 12 {
+            let count = Int(word(offset))
+            guard count <= bytes.count - offset - 12 else { return nil }
+            let end = offset + 12 + count
+            let type = String(bytes: bytes[(offset + 4)..<(offset + 8)], encoding: .ascii)
+            let checksum: uLong = bytes.withUnsafeBufferPointer { buffer in
+                crc32(0, buffer.baseAddress!.advanced(by: offset + 4), uInt(count + 4))
+            }
+            guard UInt32(checksum) == word(offset + 8 + count),
+                  offset != 8 || (type == "IHDR" && count == 13) else { return nil }
+            let payload = Array(bytes[(offset + 8)..<(offset + 8 + count)])
+            switch type {
+            case "sRGB":
+                guard space == nil, !sawImageData, count == 1, payload[0] <= 3 else { return nil }
+                space = CGColorSpace(name: CGColorSpace.sRGB)
+            case "iCCP":
+                guard space == nil, !sawImageData, count <= 1024 * 1024,
+                      let zero = payload.firstIndex(of: 0), zero >= 1, zero <= 79,
+                      zero + 2 < count, payload[zero + 1] == 0 else { return nil }
+                let compressed = Array(payload[(zero + 2)...])
+                var profile = [UInt8](repeating: 0, count: 1024 * 1024)
+                var length = uLongf(profile.count)
+                let status: Int32 = profile.withUnsafeMutableBufferPointer { output in
+                    compressed.withUnsafeBufferPointer { input in
+                        uncompress(output.baseAddress, &length, input.baseAddress, uLong(compressed.count))
+                    }
+                }
+                guard status == Z_OK, length >= 128, length <= uLongf(profile.count) else { return nil }
+                profile.removeSubrange(Int(length)..<profile.count)
+                let embedded = Data(profile)
+                guard let colorSpace = CGColorSpace(iccData: embedded as CFData), colorSpace.model == .rgb else { return nil }
+                space = colorSpace
+            case "IDAT": sawImageData = true
+            case "IEND":
+                guard count == 0, end == bytes.count, sawImageData else { return nil }
+                return space
+            case "IHDR":
+                guard offset == 8 else { return nil }
+            case "cICP", "mDCV", "cLLI", "acTL":
+                return nil // Unsupported HDR/alternative declarations and animation remain outside this proof.
+            default: break
+            }
+            offset = end
+        }
+        return nil
+    }
+
+    /// Drawing performs profile conversion into sRGB; assigning a color space to unchanged bytes does not.
+    /// Unknown/device RGB, unsupported bit depth and nonopaque support pixels reject.
+    static func sRGBPixels(_ source: CGImage) -> [UInt8]? {
+        guard source.width > 0, source.height > 0, source.width <= 4096, source.height <= 4096,
+              source.bitsPerComponent == 8, let input = source.colorSpace, input.model == .rgb,
+              input.name != CGColorSpaceCreateDeviceRGB().name, input.copyICCData() != nil,
+              let output = CGColorSpace(name: CGColorSpace.sRGB) else { return nil }
+        var result = [UInt8](repeating: 0, count: source.width * source.height * 4)
+        let drawn: Bool = result.withUnsafeMutableBytes { bytes in
+            guard let context = CGContext(data: bytes.baseAddress, width: source.width, height: source.height,
+                bitsPerComponent: 8, bytesPerRow: source.width * 4, space: output,
+                bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue | CGBitmapInfo.byteOrder32Big.rawValue) else { return false }
+            context.setBlendMode(.copy)
+            context.setRenderingIntent(.relativeColorimetric)
+            context.interpolationQuality = .none
+            context.draw(source, in: CGRect(x: 0, y: 0, width: CGFloat(source.width), height: CGFloat(source.height)))
+            return true
+        }
+        return drawn ? result : nil
+    }
+
+    /// Shared calculation, exposed to native numerical boundary controls. Masks remain catalog-pinned at runtime.
+    static func measuredRatio(_ pixels: [UInt8], core: [Int], backing: [Int]) -> Double? {
+        guard pixels.count % 4 == 0, !core.isEmpty, !backing.isEmpty,
+              core.allSatisfy({ $0 >= 0 && $0 < pixels.count / 4 }),
+              backing.allSatisfy({ $0 >= 0 && $0 < pixels.count / 4 }) else { return nil }
+        let foreground = core.map { luminance(pixels, pixel: $0) }
+        let background = backing.map { luminance(pixels, pixel: $0) }
+        guard let fgMin = foreground.min(), let fgMax = foreground.max(),
+              let bgMin = background.min(), let bgMax = background.max() else { return nil }
+        let ratio: Double
+        if fgMin > bgMax { ratio = (fgMin + 0.05) / (bgMax + 0.05) }
+        else if bgMin > fgMax { ratio = (bgMin + 0.05) / (fgMax + 0.05) }
+        else { return nil }
+        return ratio.isFinite && ratio >= minimumContrast ? ratio : nil
+    }
+
+    private static func validateMasks(_ fixture: Fixture) -> Bool {
+        let count = fixture.width * fixture.height
+        let backing = Set(indices(fixture.backgroundMask, count: count))
+        guard fixture.backgroundMask.count == (count + 7) / 8, backing.count >= 400,
+              !fixture.roles.isEmpty, fixture.minimumRatio >= minimumContrast else { return false }
+        var used = Set<Int>()
+        var names = Set<String>()
+        for role in fixture.roles {
+            let core = Set(indices(role.coreMask, count: count))
+            let glyph = Set(indices(role.glyphMask, count: count))
+            guard role.coreMask.count == (count + 7) / 8, role.glyphMask.count == (count + 7) / 8,
+                  names.insert(role.name).inserted, !core.isEmpty, core.isSubset(of: glyph),
+                  core.isDisjoint(with: backing), core.isDisjoint(with: used),
+                  role.minimumRatio >= minimumContrast else { return false }
+            used.formUnion(core)
+        }
+        return used.count >= 20
+    }
+
+    static func indices(_ data: Data, count: Int) -> [Int] {
+        let bytes = [UInt8](data)
+        guard bytes.count == (count + 7) / 8 else { return [] }
+        return (0..<count).filter { index in bytes[index / 8] & (1 << (7 - index % 8)) != 0 }
+    }
+
+    static func rect(_ values: [Double]) -> CGRect {
+        CGRect(x: CGFloat(values[0]), y: CGFloat(values[1]), width: CGFloat(values[2]), height: CGFloat(values[3]))
+    }
+
+    static func sha256(_ data: Data) -> String {
+        SHA256.hash(data: data).map { String(format: "%02x", $0) }.joined()
+    }
+
+    private static func finitePositive(_ value: CGRect) -> Bool {
+        [value.minX, value.minY, value.width, value.height].allSatisfy(\.isFinite) && value.width > 0 && value.height > 0
+    }
+
+    private static func luminance(_ pixels: [UInt8], pixel: Int) -> Double {
+        let weights: [Double] = [0.2126, 0.7152, 0.0722]
+        var result: Double = 0
+        for channel in 0..<3 {
+            let value = Double(pixels[pixel * 4 + channel]) / 255
+            let linear = value <= 0.04045 ? value / 12.92 : pow((value + 0.055) / 1.055, 2.4)
+            result += linear * weights[channel]
+        }
+        return result
+    }
+}
diff --git a/ios/TimbreUITests/CurrentCallbackRasterCheckTests.swift b/ios/TimbreUITests/CurrentCallbackRasterCheckTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..95de473489dd363432ac463745c3bb4c20aafe82
--- /dev/null
+++ b/ios/TimbreUITests/CurrentCallbackRasterCheckTests.swift
@@ -0,0 +1,316 @@
+import ImageIO
+import UIKit
+import XCTest
+
+@MainActor
+final class CurrentCallbackRasterCheckTests: XCTestCase {
+    typealias Check = CurrentCallbackRasterCheck
+
+    func testTenExactCurrentRastersAreDiagnosticOnly() throws {
+        let support = try Support()
+        XCTAssertEqual(support.catalog.fixtures.count, 10)
+        for fixture in support.catalog.fixtures {
+            let png = try support.canvas(fixture)
+            let result = try XCTUnwrap(support.inspect(fixture, first: png, second: png))
+            XCTAssertGreaterThanOrEqual(result.minimumRatio, 4.5)
+            XCTAssertEqual(result.minimumRatio, fixture.minimumRatio, accuracy: 0.00001)
+            XCTAssertFalse(result.auditAuthorization)
+            XCTAssertEqual(result.beforePNGSHA256, Check.sha256(png))
+            XCTAssertEqual(result.afterPNGSHA256, Check.sha256(png))
+            XCTAssertEqual(result.referenceSourceSHA, fixture.referenceSourceSHA)
+            if fixture.label == "LV 1" {
+                XCTAssertEqual(Set(result.roleRatios.keys), Set(["mint", "ink"]))
+            }
+        }
+    }
+
+    func testActualContrastBoundaryAndWorstRoleCannotBeAveragedAway() throws {
+        let white: [UInt8] = [255, 255, 255, 255]
+        let passing: [UInt8] = [118, 118, 118, 255]
+        let failing: [UInt8] = [119, 119, 119, 255]
+        let good = try XCTUnwrap(Check.measuredRatio(passing + white, core: [0], backing: [1]))
+        XCTAssertGreaterThanOrEqual(good, 4.5)
+        XCTAssertNil(Check.measuredRatio(failing + white, core: [0], backing: [1]))
+        XCTAssertNil(Check.measuredRatio(passing + failing + white, core: [0, 1], backing: [2]))
+        XCTAssertNil(Check.measuredRatio(passing + white, core: [], backing: [1]))
+        XCTAssertNil(Check.measuredRatio(passing + white, core: [2], backing: [1]))
+        XCTAssertNil(Check.measuredRatio(passing + white, core: [0], backing: [-1]))
+    }
+
+    func testChangedIdentityElementStateContextAndTimingReject() throws {
+        let support = try Support()
+        let fixture = try XCTUnwrap(support.catalog.fixtures.first)
+        let png = try support.canvas(fixture)
+        let identity = support.identity(fixture)
+        let context = support.context(fixture)
+        let identities: [Check.Identity] = [
+            support.identity(fixture, screen: "foreign"), support.identity(fixture, identifier: ""),
+            support.identity(fixture, identifier: "foreign"), support.identity(fixture, label: "LV 2"),
+            support.identity(fixture, elementType: 9),
+            support.identity(fixture, frame: identity.frame.offsetBy(dx: 0.001, dy: 0)),
+            support.identity(fixture, frame: CGRect(x: -1, y: 0, width: 20, height: 20)),
+            support.identity(fixture, frame: CGRect(x: CGFloat.nan, y: 0, width: 20, height: 20)),
+            support.identity(fixture, enabled: false), support.identity(fixture, selected: true),
+        ]
+        for changed in identities {
+            XCTAssertNil(support.inspect(fixture, first: png, second: png, after: changed))
+        }
+        for changed in identities.prefix(8) {
+            XCTAssertNil(support.inspect(fixture, first: png, second: png, before: changed, after: changed))
+        }
+        let contexts: [Check.Context] = [
