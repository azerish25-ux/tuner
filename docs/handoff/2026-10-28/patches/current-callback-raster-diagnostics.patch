+    func testRotationScaleMappingAlphaAndColorProfileRejectOrConvertCorrectly() throws {
+        let support = try Support()
+        let fixture = try XCTUnwrap(support.catalog.fixtures.first)
+        let png = try support.canvas(fixture)
+        let source = try XCTUnwrap(Check.decodePNG(png))
+        for scale in [CGFloat(1), 2, 3, 4] {
+            let reencoded = try XCTUnwrap(UIImage(cgImage: source, scale: scale, orientation: .up).pngData())
+            XCTAssertNotNil(support.inspect(fixture, first: reencoded, second: reencoded), "Metadata does not change physical pixels")
+        }
+        for orientation in [2, 3, 4, 5, 6, 7, 8] {
+            let rotated = try Support.png(source, orientation: orientation)
+            XCTAssertNil(Check.decodePNG(rotated))
+        }
+        let crop = try support.crop(fixture)
+        let groups: [[UInt8]] = stride(from: 0, to: crop.count, by: 4).map { Array(crop[$0..<($0 + 4)]) }
+        let reversed = groups.reversed().flatMap { $0 }
+        let moved = try support.canvas(fixture, crop: reversed)
+        XCTAssertNil(support.inspect(fixture, first: moved, second: moved))
+        var transparent = crop
+        transparent[3] = 0
+        let alpha = try support.canvas(fixture, crop: transparent)
+        XCTAssertNil(support.inspect(fixture, first: alpha, second: alpha))
+        let linear = try XCTUnwrap(CGColorSpace(name: CGColorSpace.linearSRGB))
+        let one = try Support.image([128, 128, 128, 255], width: 1, height: 1, space: linear)
+        let normalized = try XCTUnwrap(Check.sRGBPixels(one))
+        for channel in normalized.prefix(3) { XCTAssertEqual(Double(channel), 188, accuracy: 1) }
+        let device = try Support.image([128, 128, 128, 255], width: 1, height: 1, space: CGColorSpaceCreateDeviceRGB())
+        XCTAssertNil(Check.sRGBPixels(device))
+        let mistagged = try support.canvas(fixture, space: linear)
+        XCTAssertNil(support.inspect(fixture, first: mistagged, second: mistagged))
+        let wrongSize = try Support.png(Support.image([0, 0, 0, 255], width: 1, height: 1))
+        XCTAssertNil(support.inspect(fixture, first: wrongSize, second: wrongSize))
+    }
