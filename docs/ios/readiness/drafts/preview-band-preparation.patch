@@ -178,6 +178,104 @@ final class AudioStartupTests: XCTestCase {
         audio.stop()
     }
 
+    func testPreparedLessonRechecksItsOutputLeaseBeforeStartingTheClock() async {
+        let gate = SessionGate()
+        let audio = service(gate)
+        let lesson = AudioStartGate()
+        var revisionMatches = true
+        var released = 0
+        var clocks = 0
+        let output = AudioPreviewLease(readiness: AudioReadiness(task: Task { true }, current: { revisionMatches }),
+                                       release: { released += 1 })
+        _ = await output.readiness.value
+        let rejected = expectation(description: "prepared output became stale during activation")
+        lesson.begin(audio.setMetronome(bpm: 60, beats: 4, subdivision: 1, accents: true),
+                     prepared: { output.isCurrent }, rejected: { output.release(); rejected.fulfill() }) {
+            clocks += 1
+            output.release()
+        }
+        await waitForActivation(gate)
+        revisionMatches = false
+        gate.finish()
+        let result = await XCTWaiter.fulfillment(of: [rejected], timeout: 1)
+        XCTAssertEqual(result, .completed)
+        XCTAssertEqual(clocks, 0)
+        XCTAssertEqual(released, 1)
+        lesson.cancel()
+        XCTAssertEqual(released, 1)
+        audio.stop()
+    }
+
+    func testCancellingPreparedStartupReleasesItsReservationExactlyOnce() async {
+        let gate = SessionGate()
+        let audio = service(gate)
+        let lesson = AudioStartGate()
+        var rejections = 0
+        var clocks = 0
+        lesson.begin(audio.setMetronome(bpm: 60, beats: 4, subdivision: 1, accents: true),
+                     prepared: { true }, rejected: { rejections += 1 }) { clocks += 1 }
+        await waitForActivation(gate)
+        lesson.cancel()
+        lesson.cancel()
+        XCTAssertEqual(rejections, 1)
+        gate.finish()
+        for _ in 0..<100 { await Task.yield() }
+        XCTAssertEqual(clocks, 0)
+        XCTAssertEqual(rejections, 1)
+        audio.stop()
+    }
+
+    func testCancellingReadyButUnconsumedStartupStopsItsOwnClickAndReleasesOutput() async {
+        let gate = SessionGate()
+        let audio = service(gate)
+        let request = audio.setMetronome(bpm: 60, beats: 4, subdivision: 1, accents: true)
+        await waitForActivation(gate)
+        gate.finish()
+        let started = await request.value
+        XCTAssertTrue(started)
+        let output = audio.reservePreviewOutput()
+        let prepared = await output.readiness.value
+        XCTAssertTrue(prepared)
+        let lesson = AudioStartGate()
+        var clocks = 0
+        lesson.begin(request, prepared: { output.isCurrent }, rejected: {
+            if request.isCurrent { audio.stopMetronome() }
+            output.release()
+        }) { clocks += 1 }
+        lesson.cancel()
+        XCTAssertFalse(audio.metronomeRunning)
+        XCTAssertFalse(output.isCurrent)
+        XCTAssertEqual(gate.releases, 1)
+        for _ in 0..<100 { await Task.yield() }
+        XCTAssertEqual(clocks, 0)
+        audio.stop()
+    }
+
+    func testReplacingPreparedStartupDoesNotStopTheNewerClick() async {
+        let gate = SessionGate()
+        let audio = service(gate)
+        let old = audio.setMetronome(bpm: 60, beats: 4, subdivision: 1, accents: true)
+        await waitForActivation(gate)
+        gate.finish()
+        _ = await old.value
+        let lesson = AudioStartGate()
+        var oldRejections = 0
+        var oldClocks = 0
+        lesson.begin(old, rejected: {
+            oldRejections += 1
+            if old.isCurrent { audio.stopMetronome() }
+        }) { oldClocks += 1 }
+        let newer = audio.setMetronome(bpm: 90, beats: 4, subdivision: 1, accents: true)
+        let ready = expectation(description: "newer prepared startup owns its click")
+        lesson.begin(newer) { ready.fulfill() }
+        let result = await XCTWaiter.fulfillment(of: [ready], timeout: 1)
+        XCTAssertEqual(result, .completed)
+        XCTAssertEqual(oldRejections, 1)
+        XCTAssertEqual(oldClocks, 0)
+        XCTAssertTrue(audio.metronomeRunning)
+        audio.stop()
+    }
+
