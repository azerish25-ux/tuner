  "L48cd1ce6e6": [
    {
      "pointer": "/courses/3/units/0/lessons/4/steps/2",
      "type": "quiz",
      "pairs": [
        {
          "key": "L98171b4591",
          "source": "A string is a little flat. What do you do?"
        },
        {
          "key": "L48cd1ce6e6",
          "source": "Turn its fine tuner clockwise"
        },
        {
          "key": "L4929fa407e",
          "source": "Turn its fine tuner counterclockwise"
        },
        {
          "key": "Ldbd51d60bd",
          "source": "Push on the bridge"
        },
        {
          "key": "Le74a7237be",
          "source": "Flat means too low. Clockwise tightens the string and raises the pitch."
        }
      ]
    },
    {
      "pointer": "/courses/4/units/0/lessons/4/steps/2",
      "type": "quiz",
      "pairs": [
        {
          "key": "L98171b4591",
          "source": "A string is a little flat. What do you do?"
        },
        {
          "key": "L48cd1ce6e6",
          "source": "Turn its fine tuner clockwise"
        },
        {
          "key": "L4929fa407e",
          "source": "Turn its fine tuner counterclockwise"
        },
        {
          "key": "Ldbd51d60bd",
          "source": "Push on the bridge"
        },
        {
          "key": "Le74a7237be",
          "source": "Flat means too low. Clockwise tightens the string and raises the pitch."
        }
      ]
    }
  ],
  "L3454c546b5": [
