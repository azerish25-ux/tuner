  "L89579d8d62": [
    {
      "pointer": "/courses/0/units/14/lessons/1/steps/3",
      "type": "quiz",
      "pairs": [
        {
          "key": "Ld0d4792f7e",
          "source": "What makes a scratch?"
        },
        {
          "key": "L89579d8d62",
          "source": "Fretting fingers resting lightly on the strings"
        },
        {
          "key": "L50bfb1a652",
          "source": "Strumming with your palm"
        },
        {
          "key": "Ld30524a12c",
          "source": "Plucking with your thumb"
        },
        {
          "key": "L00130a44b5",
          "source": "Touching without pressing stops the strings from ringing. The strum turns into a crisp, percussive click."
        }
      ]
    }
  ],
