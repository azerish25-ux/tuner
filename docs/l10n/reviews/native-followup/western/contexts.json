        {
          "key": "Lca348ac8c3",
          "source": "It keeps the chord in tune"
        },
        {
          "key": "L4a5bfbd8f4",
          "source": "With every pair held down, relaxing your fingers stops the sound at once. That is the secret of the chop."
        }
      ]
