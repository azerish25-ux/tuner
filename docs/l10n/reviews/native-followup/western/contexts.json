  "Ld429fddfef": [
    {
      "pointer": "/courses/2/units/5/lessons/0/steps/3",
      "type": "quiz",
      "pairs": [
        {
          "key": "L4270ae2ed2",
          "source": "Your eighth notes start to rush. What helps?"
        },
        {
          "key": "L67ef0e743a",
          "source": "Play louder"
        },
        {
          "key": "Ld429fddfef",
          "source": "Lock to the click and relax your hand"
        },
        {
          "key": "L43ba221783",
          "source": "Use one finger only"
        }
      ]
    }
  ],
  "Laab8fac3fc": [
    {
      "pointer": "/courses/6/units/1/lessons/3/steps/3",
      "type": "quiz",
      "pairs": [
        {
          "key": "L16f34028b9",
          "source": "You lose the beat in the middle of a roll. What now?"
        },
        {
          "key": "L85741bed97",
          "source": "Stop and start the bar over"
        },
        {
          "key": "L15bf5e9c0d",
          "source": "Slow down until it feels right"
        },
        {
          "key": "Laab8fac3fc",
          "source": "Keep the right hand moving and rejoin"
        },
        {
          "key": "L28ec0b6cff",
          "source": "In a band the beat never waits. Keep the pattern going and catch the next bar."
        }
      ]
    }
  ],
  "L72890bd1aa": [
    {
      "pointer": "/courses/12/units/5/lessons/0/steps/4",
      "type": "notes",
      "pairs": [
        {
          "key": "L72890bd1aa",
          "source": "G at fret 3 on string 1, down to D at fret 3 on string 2, then F sharp at fret 2 and D again."
        }
      ]
    }
  ],
  "L0a1a03075a": [
    {
      "pointer": "/courses/0/units/15/lessons/4/steps/2",
      "type": "quiz",
      "pairs": [
        {
          "key": "L6191fba215",
          "source": "What does an intro do?"
        },
        {
          "key": "L0a1a03075a",
          "source": "Sets the key and tempo before the melody"
        },
        {
          "key": "Lcf9f1e141a",
          "source": "Replaces the verse"
        },
        {
          "key": "Lb8e34d8f97",
          "source": "Repeats the chorus words"
        },
        {
          "key": "Le19e0e9d18",
          "source": "A few bars of chords tell everyone where home is and how fast to go."
        }
      ]
    }
  ],
  "Le06a043bf5": [
    {
      "pointer": "/courses/0/units/12/lessons/0/steps/3",
      "type": "quiz",
      "pairs": [
        {
          "key": "Lbeabdc326d",
          "source": "What makes a hammer-on ring clearly?"
        },
        {
          "key": "Ld4895dee1b",
          "source": "Picking both notes hard"
        },
        {
          "key": "Le06a043bf5",
          "source": "A fast, firm landing right behind the fret"
        },
        {
          "key": "L246b2e01d8",
          "source": "Pressing finger 1 harder"
        },
        {
          "key": "Lcfcdca45bf",
          "source": "Speed and aim matter more than force. Land on the fingertip, right behind the fret, and the string keeps singing."
        }
      ]
    }
  ],
