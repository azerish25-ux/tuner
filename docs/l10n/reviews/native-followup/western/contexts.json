  "Ld15aab05ef": [
    {
      "pointer": "/courses/11/units/4/lessons/0/steps/0",
      "type": "explain",
      "pairs": [
        {
          "key": "Ld15aab05ef",
          "source": "A spring song turned carol"
        },
        {
          "key": "L65626dc943",
          "source": "This tune was printed in 1582 in Piae Cantiones, a songbook from Finland, as a song about spring. John Mason Neale gave it Christmas words in 1853."
        }
      ]
    }
  ],
  "L8d7832013f": [
    {
      "pointer": "/courses/3/units/5/lessons/2/steps/2",
      "type": "quiz",
      "pairs": [
        {
          "key": "Lce08e1b823",
          "source": "Why use fourth finger instead of an open string?"
        },
        {
          "key": "L8d7832013f",
          "source": "It avoids a string crossing and sounds warmer"
        },
        {
          "key": "L05ccceedd1",
          "source": "It's always louder"
        },
        {
          "key": "L0aeea6d1c3",
          "source": "Open strings are out of tune"
        },
        {
          "key": "Le62599f375",
          "source": "A fingered note keeps the line on one string and blends with the notes around it. Open strings ring brighter."
        }
      ]
    }
  ],
  "Leebc43af63": [
    {
      "pointer": "/courses/7/units/0/lessons/3/steps/4",
      "type": "explain",
      "pairs": [
        {
          "key": "Leebc43af63",
          "source": "Trust your first impression"
        },
        {
          "key": "Lb5876d82e3",
          "source": "With tiny steps, your first impression is usually right. Answer, and don't talk yourself out of it."
        }
      ]
    }
  ],
