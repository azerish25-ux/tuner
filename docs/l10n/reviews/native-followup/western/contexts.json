  "Lc5f918e593": [
    {
      "pointer": "/courses/2/units/3/lessons/2/steps/0",
      "type": "explain",
      "pairs": [
        {
          "key": "Lc5f918e593",
          "source": "Two strings over, two frets up"
        },
        {
          "key": "L7d6ba1832b",
          "source": "The octave is the same note name, higher. From a root on string 4 or 3, go two strings thinner and two frets up. Open A becomes fret 2 of string 1."
        }
      ]
    }
  ],
  "Lf8d753d19b": [
    {
      "pointer": "/courses/12/units/5/lessons/2/steps/3",
      "type": "notes",
      "pairs": [
        {
          "key": "Lf8d753d19b",
          "source": "Open G, C at fret 1 on string 2, open E, then D and C. Next, A at fret 2 on string 3 and back up."
        }
      ]
    }
  ],
  "L5fbc8a707e": [
    {
      "pointer": "/courses/3/units/5/lessons/2/steps/1",
      "type": "notes",
      "pairs": [
        {
          "key": "L5fbc8a707e",
          "source": "Fourth-finger A on the D string, open A, then fourth finger again. Match them exactly."
        }
      ]
    }
  ],
  "L8a28d3c1df": [
    {
      "pointer": "/courses/2/units/0/lessons/2/steps/0",
      "type": "explain",
      "pairs": [
        {
          "key": "L8a28d3c1df",
          "source": "Index, middle, index, middle"
        },
        {
          "key": "L473cfd5bc5",
          "source": "Pluck with the pads of your index and middle fingers, taking turns. Rest your thumb on the pickup or on string 4."
        }
      ]
    }
  ],
  "L2826c276b1": [
    {
      "pointer": "/courses/11/units/4/lessons/4/steps/3",
