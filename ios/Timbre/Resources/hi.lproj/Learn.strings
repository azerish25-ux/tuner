"Lfebcaf764a" = "डायनैमिक्स यानी आप कितना तेज़ या हल्का गाते हैं। अधिक साँस-ऊर्जा से आवाज़ बढ़ाएँ, गला कसकर नहीं। सुर अपनी जगह रहना चाहिए।";
"Lfec07e8937" = "छलाँगें अलग दिखती हैं";
"Lfed0d341ed" = "इस इकाई के पाँच गाने: दो धीमे गीत और तीन कैरोल। कोई नया स्वर नहीं, बस एक के बाद एक, हर एक पहले से थोड़ा तेज़।";
"Lfeddc76ee1" = "चेलो में हर उँगली का अपना आधा स्वर है, तो F दूसरी और F शार्प तीसरी उँगली लेता है। हाथ के बाहर का स्वर, जैसे C तार पर F शार्प, फैलाव यानी चौड़ा हाथ माँगता है। इस पाठ्यक्रम के सुर इसे टालते हैं।";
"Lfee05773f7" = "ज़ोर वाले स्ट्रोकों के बीच स्क्रैच";
"Lfee96c0c90" = "आराम देना और थोड़ा पानी पीना";
