"Lfdbedf9988" = "60 सेकंड में 60 ताल, यानी हर सेकंड एक ताल।";
"Lfdd63130f1" = "Thistle and Thread, A में 116 ताल प्रति मिनट का चमकदार फ़ोक स्ट्रम है। Asus4 और Asus2, A कॉर्ड को सजाते हैं: एक उँगली बदलें और कॉर्ड चमक उठता है।";
"Lfde0413422" = "D से दो फ़्रेट ऊपर E है।";
"Lfde6285917" = "Largo, New World Symphony";
"Lfe04f7c950" = "आवाज़ सीखने को खुले कॉर्ड स्ट्रम करें, फिर बैंड को गति देने के लिए 2 और 4 पर दबे स्ट्रोक। हर बदलाव में ताल स्थिर रखें।";
"Lfe09e0f049" = "E माइनर, G, C";
