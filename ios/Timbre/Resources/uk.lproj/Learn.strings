"L0c208a0abc" = "Палець 3";
"L0c23f0a5cf" = "D: троє в ряд";
"L0c29073b8b" = "Рахуйте раз, два, три, наголошуючи раз. У багатьох тактах середня нота довга: раз, два й коротка нота перед наступним раз.";
"L0c2b4e0520" = "Точка контакту";
"L0c3070c6dd" = "Схід сонця";
"L0c33a64f82" = "Куплет 1";
"L0c467cb74c" = "Міксолідійський D двічі";
"L0c4b550708" = "Що підтримує звучання слайда?";
"L0c565f96a8" = "Фанкові шістнадцяті й глухі удари, приглушені удари регі, кантрі «бум-чик» та синкопований попбій.";
"L0c6490ff61" = "Від D до C пропускаємо одну клавішу — C♯.";
