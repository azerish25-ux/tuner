"Ldde0717e63" = "Які ноти утворюють G мажор?";
"Lde01691b6d" = "Сильні клацання — це долі. Скільки долей ви почули?";
"Lde21a6c060" = "«Місяць у джукбоксі» — повільний танець у стилі ду-воп 1950-х: C, A мінор, F і G7 по колу, 72 долі за хвилину. Бийте на кожну долю, зі швидким свінговим рухом угору перед новим тактом.";
"Lde2250b41b" = "Напружити горло";
"Lde26bf1131" = "Острівний бій";
"Lde27d27bb2" = "Скільки півтонів у малій терції?";
"Lde34a0e125" = "Велика терція охоплює чотири півтони й звучить світло. Мала терція охоплює три й звучить темніше, трохи сумовито. Прислухайтеся до світлого забарвлення.";
"Lde39622d81" = "Що означає ліга?";
"Lde3e9cebaf" = "Стрибайте на терції, квінти й октави та влучайте в точну висоту.";
"Lde659e078c" = "A розташована між останніми двома чорними клавішами групи з трьох.";
"Lde68a1bad0" = "Дві перевірки октав: G із відкритою G, потім D четвертим пальцем із відкритою D.";
"Lde807dcfef" = "Початок піднімається нотами акорду. Він мажорний чи мінорний?";
"Lde8802ea97" = "Що рухається під час зміни позиції?";
"Lde91b63020" = "Півтори долі плюс пів долі — дві долі.";
"Lde9490c2f7" = "Тема на октаву вище";
"Lde97f92a64" = "Ода до радості";
"Ldea01f41bc" = "Ноти на струні 4";
"Ldea06d68d7" = "На яких струнах грають великий, вказівний, середній і безіменний пальці?";
"Ldea5c0e0d2" = "Униз і разом";
"Ldeb187f76d" = "C на ладу 1 струни 2, D на ладу 3, відкрита E, F на ладу 1 струни 1, G на ладу 3, потім знову D.";
"Ldeb3e83098" = "G мажор на ладу 2";
"Ldec07dceb7" = "Притисніть струну 3 на ладі 2, зіграйте медіатором і ковзніть тим самим пальцем до ладу 4, зберігаючи тиск. Плавне ковзання від A до B — класичний звук банджо.";
"Lded54f4d23" = "Щоб пропустити удар, рука…";
"Lded96cd2e1" = "До, ре, мі, фа, соль: п'ять нот, отже квінта.";
"Ldedc352570" = "Пара 3, лад 4, другий палець. Це F дієз.";
"Ldefd45d833" = "F зі старовинним відтінком";
"Ldf13caa06f" = "Обидві ноти — G. Два місця, одна нота.";
"Ldf1e29237b" = "Пісні мандрують за числами";
"Ldf2c44251f" = "C мажор у дві октави";
"Ldf45ea6e38" = "Ліги й крапки";
"Ldf53263604" = "Лише струна 1";
"Ldf5602781a" = "Над нотним станом";
"Ldf5d466476" = "Соль";
"Ldf5d952b52" = "Підводьте до кожної зміни";
"Ldf701edabb" = "Антонін Дворжак написав цю тему для англійського ріжка в 1893 році в симфонії «З Нового світу», коли жив у Нью-Йорку.";
"Ldf7608fa4b" = "Мажорна пентатоніка містить C дієз — терцію A7. Нота C мінорного боксу створює з нею тертя, і це тертя — блюз.";
"Ldf81944547" = "Так, звучить завершено";
"Ldf8256f56d" = "Дієзи, бемолі й півтони";
"Ldf8bfe1015" = "Ця версія в G мінорі, у першій позиції: по пальцю на півтон, починаючи на тон вище відкритої струни; схема акордів — для тих, хто акомпанує вам.";
"Ldf8c99884a" = "Тиша — частина груву";
"Ldf95d6824f" = "Який палець щипає струну 1?";
"Ldfade6dea5" = "Оксамитова година";
"Ldfaf34e56e" = "C♯ і D";
"Ldfb0ff696c" = "Зіграйте ноту медіатором, потім ковзніть тим самим пальцем угору до вищого ладу, не послаблюючи притискання. Нова нота звучить без другого удару. Секрет — легкий рівномірний тиск.";
"Ldfb160841a" = "Малі, розслаблені рухи швидші, і їх легше тримати рівними.";
