"L0009cb1a16" = "Одна струна звучить глухо. Яка ймовірна причина?";
"L00130a44b5" = "Дотик без притискання не дає струнам звучати. Бій перетворюється на чітке перкусійне клацання.";
"L0015244e3f" = "G7 зберігає низьку G, але згори додає F: палець 3 на струні 6, лад 3; палець 2 на струні 5, лад 2; палець 1 на струні 1, лад 1.";
"L0017247d59" = "Який із них G7 — більш напружений?";
"L001a8a4e76" = "Палець 1 на струні 3, ладу 1 дає ту єдину ноту, яка утворює E мажор.";
"L0024a55a06" = "Шафл";
"L002ba346f7" = "Струна 3: лад 2, лад 3, лад 5.";
"L002e2c331d" = "Накресліть контур";
"L002fe27c72" = "«Мідний дріт» побудовано на рифі — короткій чіпкій фразі на низьких струнах, на якій тримається весь гурт. Темп 112 долей за хвилину, тональність E, у приспіві квінтакорди.";
"L00398ce342" = "Затисніть баре на струнах від 5 до 1 на ладу 10, а палець 3 покладіть на струни 4, 3 і 2 на ладу 12. Це ваше баре аплікатурою A, і знову це G.";
"L00573ce6a3" = "Каподастр";
"L006392a6a7" = "Терція";
"L0074f77ab6" = "Сьома нота G мажору — F♯.";
"L0077cab0a8" = "Суза писав марші для військового духового оркестру. «Весна» — для скрипки й струнних, а рондо — для фортепіано.";
"L007b8bf14c" = "Рахуйте 1 2 3, 1 2 3, наголошуючи 1. Це вальсовий ритм. «Клементина», уперше надрукована у 1884 році, погойдується на три долі.";
"L008b7d6e79" = "D дієз на лад нижче E. Цей півтон сильно тягне додому, тому у пісні «Зелені рукави» він є в кожній каденції.";
"L008b914131" = "Програма на відкритих акордах";
"L008ec0fe41" = "Співати трохи нижче";
"L00b1aaa1ac" = "Джон Філіп Суза написав цей марш наприкінці 1896 року, а опублікували його в 1897. Це офіційний національний марш США. Тут звучить його розлога мелодія тріо.";
"L00b6eb7b38" = "«Погода для повітряних зміїв» — світлий, легкий поп: цикл із чотирьох акордів G, D, E мінор і C у спокійному темпі 88 долей за хвилину. Почуйте, як мотив стрибає до F дієза у другому такті.";
"L00db96471b" = "Утримуйте ноту в уяві";
"L00f131a2fc" = "Шість рівних долей";
"L00f1e4a733" = "D на ладу 3 струни 2 й відкрита струна 4 — обидві D. Яка між ними відстань?";
"L00f5a8d2df" = "Регтайм, марші й сцена";
"L0100ebed8a" = "Дерев'яна тростина тягнеться від колодки, де ви тримаєте смичок, до кінчика. Між ними натягнутий кінський волос. Підтягніть гвинт, щоб між волосом і тростиною саме вміщався олівець.";
"L0101b7221e" = "Крокуємо в D та E";
"L010a5a3a68" = "Під frost-y wind made moan акорди йдуть від A мінору до D7, тягнучи рядок назад до G.";
"L011468ba58" = "Дві ноти на один смичок — кожній по половині. Плануйте наперед і починайте лігу, залишивши достатньо смичка для обох нот.";
"L011d756661" = "У C E G, F A C і G B D знизу велика терція.";
"L0124abba92" = "У куплеті кілька слів співають на одній ноті. Кожну F дієз грайте коротко й рівно; нехай слова несуть рядок.";
"L0129c1441b" = "На 1, 3 і 5";
"L013fea348d" = "G, A";
"L015e6a69e5" = "Двічі за секунду";
"L016652736c" = "Який ступінь гами є останньою нотою?";
"L018f21ccb1" = "Акорд, зіграний двома ударами";
"L0191c4f678" = "Знову на A";
"L019766279b" = "Де півтони в мажорній гамі?";
"L0199b663ee" = "Фраза 1";
"L01a4a05447" = "Рахуйте від C";
"L01aa1069e8" = "Остання тема";
"L01bda6585d" = "G мажор у дві октави на ладу 2, ступені гами й акорди, дорійський та міксолідійський лади.";
"L01c6956f6f" = "Хто що грає";
"L01cacb6e6a" = "Торкайтеся лише на «і»";
"L01d1af9aef" = "Півтон чи тон?";
"L01d8ca79df" = "Прем'єра опери «Кармен» Жоржа Бізе відбулася в Парижі в 1875 році. Прелюдія починається цим святковим маршем, а потім звучить мелодія відомої «Пісні тореадора».";
"L01e269d40a" = "Секунди, терції, сексти й септими бувають великими та малими. Малий інтервал завжди на півтон менший за великий.";
"L01e81b91bc" = "Точка опори";
"L01e9d574a3" = "Вібрато не врятує неточну ноту: воно лише забарвлює чисту. Більшість музикантів додають його, коли пальці вже влучають у ноти без пошуку.";
"L01ee5b3bac" = "Ті лише на півтон нижче до, тому сильно тяжіє до неї.";
"L020232021d" = "Прискорюватися до вирівнювання";
"L0213925244" = "Відкрита висока G належить до акорду C, тож звучить як є. У цих уроках ви її не притискаєте.";
"L0213e2ea6e" = "Пісні повертаються до тонічного акорду своєї тональності. У F це F.";
"L022a274f11" = "Який ряд іде вниз?";
"L023748ecd0" = "«О дивна благодать», перша половина";
"L023da003cb" = "У тактах 11 і 12 часто є поворот — коротка фраза, що веде до початку. Ця спускається від A до E по одному ладу.";
"L023e171007" = "Перші пальці: A та E";
"L023f7f5a8c" = "Від G до B й назад — перехід між струнами. Плавно погойдуйте ліктем.";
"L0241523d12" = "Почуйте ноту, повторіть голосом і рухайтеся малими кроками.";
"L025497d15a" = "Групами по два";
"L025c45471b" = "Рахуйте вгору від C: C, D, E, F. F — четверта нота, тож F — акорд IV ступеня.";
"L026036a0e5" = "На кожне «і»";
"L0268cd2c6e" = "Один палець, два лади";
"L028703cd0b" = "А цей варіант?";
"L028ca831a9" = "У цій фразі C звучить півтори долі, а D з'являється на «і» четвертої. Рахуйте раз, два, три, чотири-і.";
"L0297ac2321" = "Униз-угору вгору по гамі";
"L029fad523d" = "Четвертий палець дістає на тон вище за третій. На струні D це A, та сама нота, що й відкрита струна A. Тримайте палець зігнутим і трохи нахиліть кисть до нього.";
"L02bc9eff1a" = "У B мінорі";
"L02c33b1967" = "Послабте тиск, залишивши палець на струні. Нота зупиниться без брязкоту.";
"L02ed0975aa" = "Кожен акорд будується на одній ноті — основному тоні. Основний тон акорду A — A. Басисти грають основні тони, щоб гурт відчував, де домівка.";
"L03016009de" = "Випробування: ноти й літери";
"L0301e70c80" = "C мінор";
"L0306da2b91" = "Бам, ді, ті: ті — це завжди щипок великим пальцем на короткій п'ятій струні.";
"L030d0d05a0" = "G, D, E мінор, C";
"L032ccbe9b9" = "Доля — рівний пульс, під який ви притупуєте ногою. Він не поспішає й не відстає, наче кроки на спокійній прогулянці. На ньому тримається кожен ритм.";
"L0335a6785b" = "Основний тон на струні 5";
"L0345d17207" = "Щипніть відкриту струну 3. Це G.";
"L035e66b640" = "Яка нота на тон нижче D?";
"L0371438f82" = "C3";
"L037f025d31" = "«Примарне світло» — повільна, похмура балада в A мінорі, 70 долей за хвилину. Куплет спускається від A мінору через F і C до E мажору, який сильно тягне назад до A мінору.";
"L038dcfc2fa" = "O Come, All Ye Faithful";
"L03909ad236" = "У жодного";
"L03bb0a5896" = "Струна 3: лади 2, 3 і 5.";
"L03c23e6b0b" = "Солодка фраза";
"L03c936bf04" = "Від E до F — один півтон.";
"L03e4b8ba68" = "У кожному рядку пара довго-коротко: четвертна з крапкою, потім швидка восьма, як у -er, my та God, to. Нехай довга нота тяжіє до короткої.";
"L0406d13e7a" = "Пласко зверху на тростині";
"L040c7ac884" = "Улюблена мелодія оркестрів волинок";
"L04178c0873" = "Найтовща струна звучить найнижче. Під час гри вона найближча до обличчя. Її називають струною 4.";
"L042dc4512f" = "i";
"L04304099ff" = "Знайомство з укулеле";
"L043e57dc85" = "E на ладу 2 струни 4, G дієз на ладу 1 струни 3 тричі, F дієз на ладу 4 струни 4, E, потім відкрита B.";
"L04444fb012" = "Скільки разів у приспіві звучить O come, let us adore him?";
"L044767a8b1" = "До ті до";
"L044a177de9" = "Яка мелодія починається так?";
"L044d7dcdd8" = "Групами по три";
"L045c1b7cc0" = "Верхня нота пішла вгору чи вниз?";
"L045f70eda3" = "Сповільнитися й рахувати вголос";
"L04677e71b2" = "Від C до B♭ — десять півтонів.";
"L046a35ba3a" = "Яка з цих пісень має розмір 3/4?";
"L0472142819" = "Другий палець — на ладі 2 струни 4, перший — на ладі 1 струни 3. Струни 2 і 1 звучать відкритими.";
"L047687398f" = "Прискоритися";
"L04784737ff" = "Ця версія в F. Четверта струна налаштована високо, тож мелодія лишається на струнах від 1 до 3, а всі акорди на схемі мають аплікатури для укулеле.";
"L047f059e7a" = "C замість C♯";
"L0488810a08" = "Нота тривалістю в одну долю — четвертна. Чотири такі ноти заповнюють такт 4/4, тож відбивати кожну долю означає відбивати четвертні.";
"L048e4dae0c" = "Сядьте з віолончеллю";
"L04a44d6f06" = "12-тактовий блюз — акордна схема на дванадцять тактів, основа безлічі блюзових, рок- і джазових мелодій. Вона має I, IV і V, часто всі як домінантсептакорди для блюзового забарвлення.";
"L04b6e2feff" = "Від C до D і від F до G";
"L04ba3fc545" = "Спершу щипок";
"L04cd34e7dd" = "A мінор — це аплікатура E на одну струну тонше: пальці 2 і 3 на ладу 2, палець 1 на струні 2, ладу 1.";
"L04df911481" = "Домінантсептакорд";
"L04e51c7ae2" = "Випробування: перші ноти на ладах";
"L04e8a55b79" = "Третій палець: D";
"L04f8cd7955" = "Торкайтеся в такт клацанню";
"L051485fbea" = "Одна клавіша, дві назви";
"L051d8c7d10" = "Велика септима";
"L051e1dcbb4" = "Скільки тактів I на початку 12-тактового блюзу?";
"L0521b1782d" = "«Радіо відпливу» — розслаблене регі в темпі 80 долей за хвилину. Гітара грає лише на «і» кожної долі коротким ударом, званим сканк, а бас і барабани тримають пульс.";
"L0532d7cb1e" = "Мелодії на струнах 3 і 4";
"L0538d50d6e" = "Три пісні, які родини співали біля фортепіано, а потім «Юпітер» Голста.";
"L0548676f4d" = "Основний тон, квінта, октава";
"L05496b6432" = "Від E до F лише півтон";
"L0561798932" = "Як чітко зупинити притиснуту ноту?";
"L05652cf34f" = "F дієз пальцем 4";
"L0567c9ef33" = "Цій англійській мелодії понад 400 років. Усі акорди вам знайомі: A мінор, C, G, E мінор, F і E. Вона тридольна: спершу грайте один удар на такт, потім — на кожну долю.";
"L0572eb5f3f" = "Яку послідовність ви чуєте?";
"L059dd7492f" = "Програма пісень-історій";
"L05a0c1c0fd" = "Балада, зіграна пальцями";
"L05a2271256" = "A зменшений";
"L05b1593cdf" = "C, A, G, E та D — п’ять відкритих аплікатур, які кожен мажорний акорд може запозичити будь-де на грифі.";
"L05ba0eb344" = "Раз-і, два-і";
"L05cc7ef8cf" = "Народні пісні й пісні біля вогнища з простими схемами акордів для гри або співу під акомпанемент.";
"L05ccceedd1" = "Він завжди гучніший";
"L05ccf6d485" = "Другий такт зберігає ритм першого, але змінює одну ноту. Навіщо?";
"L05d69233ea" = "Народна колядка";
"L05e740748b" = "На наступну струну";
"L0602e15d9e" = "Стійко й рівно";
"L06057c47cb" = "Який інтервал ви чуєте?";
"L0617b17c54" = "C7: один палець";
"L061a989771" = "F — лише початок";
"L0620855030" = "Нова нота: F дієз";
"L062484b438" = "Тризвуки вздовж грифа";
"L062787aa32" = "Вище";
"L0656355e15" = "Який палець грає C дієз у D мажорі?";
"L065919aae8" = "C мажор від струни 5 до G на струні 1.";
"L065dc33b0f" = "Відкрита A, B, перехід першим пальцем до D, потім E третім.";
"L066423f08b" = "Піднімайтеся від відкритої струни 6: F дієз на ладу 2, G на ладу 3, відкрита A, B на ладу 2.";
"L0674eef56c" = "Терція з чотирьох півтонів — велика, як від C до E. Терція з трьох — мала, як від C до E♭ або від A до C.";
"L068982656c" = "Малий F";
"L06aa39bbd4" = "Нові пісні на відкритих акордах: поп біля вогнища, балада, фолк із притупами, регі й кантрі.";
"L06aa3b37b8" = "Лад 5, лад 8 на струні 6, потім лад 5, лад 7 на струні 5.";
"L06b2310e15" = "Ваші притиснуті ноти: D, F, B, C.";
"L06b832525f" = "Зміна тональності на тон угору піднімає кожну ноту…";
"L06cd2c603c" = "Струна 4 порушує порядок";
"L06d272f076" = "Перевірка D та G";
"L06e461da5a" = "Без каподастра: вступ";
"L06e5c2a776" = "«Неділя біля моря» — регі в A мінорі, 76 долей за хвилину. Гітара грає подвійний короткий удар на два й чотири, чк-а, чк-а, а барабани наголошують третю долю.";
"L06e8a4031a" = "«Зелені рукави», куплет";
"L06ed945364" = "Кожна пара має збігатися з тюнером і сама із собою. Якщо струни різняться, чутно повільну пульсацію. Налаштуйте одну, потім підведіть другу до тієї самої ноти.";
"L06f797893d" = "Яку з цих мелодій рахуємо на три?";
"L0709783dc0" = "Динаміка: голосно й тихо";
"L070e348de7" = "Палець 1 на струні 3";
"L070fa0c272" = "В A мажорі є G♯. Зниження до G дає міксолідійське звучання, характерне для старовинної американської музики й блюграсу.";
"L0712a01674" = "Від C до G";
"L0732398ea5" = "Жодної: однакова висота";
"L07387ec03e" = "Тримайте довгі ноти";
"L073ebc6d51" = "Та сама назва, на вісім нот угору";
"L0749856ea5" = "Пара 4, лад 2 першим пальцем, потім лад 4 другим.";
"L0784f2a75e" = "Який палець щипає струну 3 між нотами великого пальця?";
"L078f873444" = "Рівномірно розподіляти смичок";
"L079265d880" = "Перший палець — на ладі 2 струни 1, другий — на ладі 3 струни 2, третій — на ладі 4 струни 3. Струна 4 звучить відкритою.";
"L0798e85c74" = "Тривалості нот";
"L079b0c5c75" = "Для пісні «У Мері було ягнятко» потрібні три ноти: відкрита струна 2 — B, лад 2 струни 3 — A, відкрита струна 3 — G. Другий палець притискає A; великий щипає струну 3.";
"L07a46d953b" = "Від кінчика до колодки";
"L07aec77f36" = "Чвертні на D та A";
"L07b574a082" = "Свінговий акомпанемент";
"L07be9b9784" = "У A";
"L07c33b35a8" = "Із трясіння щелепою";
"L07c74c4f57" = "Кожна тональність визначає місце другого пальця. Перед грою запитайте: високий 2 чи низький 2 і на якій струні?";
"L07c90e906b" = "Нота між ними";
"L07c9e258fe" = "Перевірте кожну струну";
"L07cd0ccf75" = "Henry Francis Lyte (1847)";
"L07d8522005" = "2 і 3";
"L07e1dc41ae" = "B, висока G, низька D, висока D, G. Знайдіть кожну струну за нотою.";
"L07ed48285a" = "Секунди з мелодією";
"L07f4a8e116" = "Мелодії часто опускаються нижче до — до ті, ля чи соль унизу. Це ті самі ноти, лише нижче. Багато мелодій починаються з нижньої соль і стрибають угору до до.";
"L07f8b44be5" = "Велика секунда";
