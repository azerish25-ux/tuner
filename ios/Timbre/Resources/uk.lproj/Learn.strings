"L93e511e9a3" = "Валлійська колискова";
"L940775a017" = "Остання відповідь";
"L940dc20aaa" = "Мелодії";
"L941a010b08" = "У четвертій позиції на струні D перший палець грає G, третій — A, ту саму ноту, що й відкрита струна A. Зіграйте їх по черзі й доможіться збігу.";
"L94294abc71" = "E7: підніміть один палець";
