"L3c04db022b" = "Навчіться тримати пряму, рівну ноту, перш ніж прагнути вібрато. Коли голос вільний і має опору, вібрато часто з'являється саме.";
"L3c133acefb" = "Такти від 9 до 12";
"L3c13a82897" = "Ця версія в F, у першій позиції: по пальцю на півтон, починаючи на тон вище відкритої струни; схема акордів — для тих, хто акомпанує вам.";
"L3c1a93647d" = "Гімни й американа";
"L3c24a17a99" = "Підійміться від відкритого G — наступна аплікатура E: ваш G з баре на ладу 3. Його основний тон на струні 6 — та сама G, що й у відкритому акорді.";
"L3c28e31a23" = "Чому такт 12 закінчується на G дієз?";
"L3c3628688b" = "Будяк і нитка";
"L3c3e2dcb6b" = "Солодко, гостро й співуче";
"L3c4d2a648b" = "Пул-офи";
"L3c50e8b84e" = "Угору й назад на струні 2";
"L3c687b801a" = "E7, A7 і C7";
"L3c6a908125" = "При зміні спершу ставте палець для найнижчої струни. Це перша нота бою, тож ви маєте мить для решти пальців.";
"L3c6aabe514" = "Що робить рука на другу долю в цьому рисунку?";
"L3c6bc13182" = "A мажор";
"L3ca23d0a58" = "Скільки разів грають медіатором для хамер-она?";
"L3ca5daddf3" = "Який варіант — цикл із чотирьох акордів у C?";
"L3cb48ad52b" = "Послідовності акордів";
"L3cba220418" = "Поставте пальці 1, 2 і 3 поруч на ладі 2 струн 4, 3 і 2. Струна 1 звучить відкритою.";
"L3cda72ee29" = "«Кріпл-Крік», висока частина";
"L3ceeb038fb" = "Різдвяна пісня на основі гами";
"L3cef29ddcc" = "Акорди під мелодією";
"L3cf87b8db7" = "Пауза — тиша певної тривалості. Ви й далі рахуєте, просто не торкаєтеся. Четвертна пауза триває одну долю.";
"L3cfdd441bf" = "Визначайте, яка з двох нот вища: від широких стрибків до найменшого кроку.";
"L3cffc5119a" = "Притиснути сильніше";
"L3d062b60ba" = "Свінгові гітаристи акомпанують короткими акордами, що відповідають гурту. Ритм чарльстону звучить на першу долю та свінгове «і» після другої, а далі лишає простір.";
"L3d0b6575fc" = "Тримайте рівно";
"L3d2766c8fc" = "Дуга над нотами — ліга: грайте їх одним рухом смичка. Ліва рука змінює ноти, поки смичок продовжує рух.";
"L3d4f37cac6" = "Бурдон між нотами";
"L3d52765b87" = "Який палець грає струну 2?";
"L3d5bd44833" = "Третій рядок";
"L3d61a24486" = "Зіграйте чи заспівайте основні тони блюзу в A: A, D, E, назад до A.";
"L3d8b6cac24" = "Над акордом E звучить G дієз, а не G. Де G дієз на струні 3?";
"L3d8bca869b" = "З якої струни починають бій акорду D?";
"L3d95a85c5a" = "Три акорди, багато пісень";
"L3da474537a" = "Стрибок";
"L3da4c1a9f3" = "Довгі рівні рухи смичка, чисті переходи між струнами й перші ритми.";
"L3da91dbb34" = "Мелодія з Америки";
"L3db204f097" = "Дві долі";
"L3dcdc13a05" = "Заспівайте C-D-E-D-C, потім той самий рисунок на ступінь вище. Яка тепер верхня нота?";
"L3dd3401402" = "Тримайте ноту";
"L3dd94b43e2" = "Рівні долі, будь-який перебір";
"L3de72cca33" = "Раз-е-і-а";
"L3deba27fef" = "G на ладах 4, 3 і 3 має ту саму аплікатуру, що й…";
"L3dfd137528" = "Утримувати ноту — означає зберігати одну рівну висоту. Видихайте повільно й рівномірно, наче безперервно дихаєте на дзеркало, щоб воно запітніло.";
"L3e1599e1ba" = "D двічі";
"L3e1f4000da" = "На «ті», великий палець";
"L3e26549015" = "A, G, E, D. Знайдіть кожну пару за назвою.";
"L3e265b5971" = "Основний тон на долю 1 підказує всім, який акорд звучить.";
"L3e308928e8" = "Випробування: зміни акордів";
"L3e4bee01f5" = "Тризвук від B відрізняється: B D F. Обидві терції малі, тож це зменшений тризвук. Він звучить напружено й прагне руху.";
"L3e4f84ee53" = "Крапка після ноти додає половину її тривалості. Половинна нота триває дві долі, тож половинна з крапкою — три. Четвертна з крапкою триває півтори.";
"L3e6191ba8a" = "Один акорд, п’ять аплікатур";
"L3e686cd6f9" = "Стилі бою";
"L3e6875ae40" = "«Зірки, що світяться в темряві» — м'який домашній поп, 84 долі за хвилину: E мінор, C і G легким боєм. Більшість рядків починаються одразу після долі — нехай вони з'являються плавно.";
"L3ea9c2ab81" = "Почніть із G і дотримуйтеся формули: G, A, B, C, D, E, потім тон до F♯ і півтон додому, до G. У G мажорі один дієз: F♯.";
"L3eca6b3e69" = "П'ять угору, п'ять униз";
"L3ed18e44f0" = "Перекличка від тонкої до товстої";
"L3eda3584fa" = "Дві перевірки октав: G із відкритою G, потім A із відкритою A.";
"L3eeb51ee4a" = "Марш";
"L3ef3ecbe12" = "Який інтервал від до до наступного до?";
"L3efc69511f" = "Велика терція плюс велика терція, як C E G♯, утворюють збільшений акорд.";
"L3f11d15876" = "Цей перебір — вісім рівних нот: великий на 3, вказівний на 2, великий на 5, середній на 1, потім великий на 4, вказівний на 2, великий на 5, середній на 1.";
"L3f1369f326" = "Скільки долей у такті 3/4?";
"L3f1828fb27" = "Перервана (V–vi)";
"L3f1a972f01" = "Знайдіть до, а тоді ноту";
"L3f1bdf177c" = "Дієз пересуває ноту…";
"L3f1d4501ff" = "Велика секста";
"L3f33d819a0" = "Другий удар медіатора";
"L3f35020108" = "Вальс рахуємо раз, два, три. Канкан і марш волинок — на чотири.";
"L3f457fafb1" = "У свінговому бою кожна доля ділиться на…";
"L3f4dc82407" = "B і C";
"L3f54dc6ebe" = "Коли нота виходить за межі стану, його продовжують короткі додаткові лінійки. Середнє C стоїть на одній додатковій лінійці безпосередньо під станом у скрипковому ключі.";
"L3f60c9b5a6" = "Довгі рухи смичка";
"L3f63ae8b8d" = "Шафл Іржавого поясу";
"L3f7e88d302" = "Які ноти утворюють акорд C мінор?";
"L3f83f903ee" = "Випробування: джазові акорди";
"L3f861c08cd" = "До ре до ті";
"L3f9e2ba82f" = "Униз і вгору";
"L3fb2c2cb4a" = "Яка мелодія знаходить спокій на A замість G?";
"L3fb4bf0d81" = "FACE у проміжках";
"L3fb6369a3b" = "Колядки при свічках";
"L3fc5913c66" = "Автентична (V–I)";
"L3fdcc445c5" = "Відкрита струна 4 двічі, F на ладу 3, відкрита D, відкрита струна 3, знову F, потім відкрита D.";
"L3fe286ea49" = "C і D";
"L3fe3239a4a" = "Найтовстіша";
"L3fea718391" = "Кожна нота двічі: форте, потім піано. Зберігайте чисту інтонацію, змінюючи гучність.";
"L3ffa870aac" = "F, G, A, B♭, C, D: шоста нота — D, а vi — мінорний акорд.";
"L4004eefd5c" = "Усі сім після каденції";
"L40077848cd" = "Співати голосніше";
"L401ad01ac9" = "Куплет";
"L401d6a1dd7" = "Рахуйте: 1 і 2 і 3 і 4 і. На числа грайте вниз, на кожне «і» — угору. Рука рухається без зупинки.";
"L4035859fcf" = "Мелодії з чотирьох нот";
"L403662af9b" = "Перша скрипкова партія: униз від F дієза на струні 1, потім угору до C дієза.";
"L4038a4c443" = "1 і 2 і 3 і 4";
"L403fa7952a" = "На кожне «і» — удар угору, де б не була нота.";
"L4041906f12" = "Низько, торкаючись першого";
"L4042a0c3f6" = "Зіграйте чи заспівайте B♭, C, D. B♭ — та сама клавіша, що й A♯.";
"L4043e3598d" = "Пульс ніколи не зупиняється. Рахуйте й ті долі, на яких не торкаєтеся.";
"L405976e2db" = "На струні G перший палець грає A, високий другий — B, третій — C. Знову та сама аплікатура. Підніміть руку зі смичком на найвищий рівень.";
"L406b881188" = "Good King Wenceslas";
"L407ff5e2bb" = "Французька народна мелодія";
"L409ecb8e8b" = "На сусідній товстішій струні";
"L40a376c23b" = "A B D E G";
"L40a6eca42e" = "Основні тони в G";
"L40a779f5b2" = "Лише у вступі";
"L40c876931a" = "Випробування: CAGED";
"L40cb97dc7d" = "Worship Christ починається на G на ладу 3 струни 1 — вершині всієї колядки.";
"L40cf5e5cf3" = "«Пил на панелі приладів» — авторська пісня Timbre: кантрі в A. Кожен куплет завершується двома тактами E й двома A — щойно вивченою зміною. Уявіть аплікатуру, рухайтеся завчасно й влучайте в першу долю. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L40dc3c0724" = "Доля 1, сильна доля, починає кожен такт.";
"L40de34d2de" = "Регі на «і»";
"L40e5bb234c" = "Довгі ноти занижуються наприкінці. Що допоможе?";
"L40ecadf834" = "Який акорд у F мажорі є V?";
"L40f04c9675" = "Угору, потім назад униз";
"L40fd4edaf9" = "Приспів повертається з тими самими словами й мелодією. Саме його люди запам’ятовують і підспівують.";
"L4108f40a57" = "F♯ на чотири лади вище за відкриту D струни 1. П'яту струну тут ніколи не притискають.";
"L410c8ec093" = "Її грають повільніше";
"L411310e91d" = "Спів птахів";
"L4116e85488" = "Підняття пальця наприкінці";
"L412f801dcc" = "У розмірі 3/4 кожен такт має три долі: РАЗ, два, три. Це вальс. Рахуйте 1, 2, 3 і наголошуйте 1.";
"L4136ab0a9d" = "Що ближчі дві ноти, то важче їх розрізнити. Дослухайте кожну ноту, перш ніж відповідати. Кожна відповідь, правильна чи ні, тренує слух.";
"L4140dfc97d" = "Лише п'ять нот";
"L415096e47f" = "Від D до A — сім півтонів.";
"L4177c93c45" = "Від D на струні 5, ладу 5 вгору тією самою позицією до D на струні 2, ладу 3.";
"L417bd3bbc4" = "Який інтервал ширший?";
"L418029e65e" = "Яку з цих пісень рахуємо на шість?";
"L4181db331b" = "Що робить тремоло добрим?";
"L41828baed3" = "Друга половина сягає вище: A, C на ладу 1 струни 2, відкрита E, потім униз D, C, B і G.";
"L418aadaeed" = "Великі й малі інтервали";
"L418b725eda" = "Високий уривок";
"L418d9b4ff9" = "Низький 2";
"L4193c6a4e3" = "Камберлендський перевал — шлях, яким ранні поселенці йшли до Кентуккі. Мелодія піднімається до E та F♯ на струні 1, тож другому й четвертому пальцям є робота.";
"L419bdb8e93" = "Ця версія в G, у першій позиції: мелодія рухається чотирма струнами з пальцями від 1 до 4, а схема акордів — для тих, хто акомпанує вам.";
"L41a3e728d3" = "C: маленький крок";
"L41a402c5e5" = "Великі гучні удари";
"L41ad61ca24" = "Home! Sweet Home!";
"L41cdeebbb5" = "Основний тон на один лад вище";
"L41d1024e80" = "Перший рядок закінчується на D. На чому закінчується другий?";
"L41d9a6a844" = "A B C D E";
"L41dc92686a" = "Доля";
"L41f9143b0f" = "У G: I — G, V — D, vi — E мінор, IV — C.";
"L41fc396f68" = "Програма на біс";
"L4206f2e463" = "Майже не має тривати";
"L42146c0c68" = "На одну струну";
"L42222e1426" = "До мі ре до";
"L423f20489c" = "John Newton (1779)";
"L4245f73649" = "Верхня 4 означає чотири долі; нижня 4 робить кожну четвертною нотою.";
"L425cc7a8d1" = "Пропустити цей акорд";
"L425cd61f8a" = "Аплікатура E чи A?";
"L42626aabd8" = "D мажор";
"L42657f23ba" = "Пора бенгальських вогнів";
"L426cc417e2" = "F з баре й B мінор, мінорна пентатоніка A та ваше перше соло.";
"L426efefb3d" = "Формула мажорної гами";
"L4270ae2ed2" = "Ваші восьмі починають поспішати. Що допоможе?";
"L4279cdf578" = "У свінгу кожна пара восьмих стає довгою-короткою. «І» зміщується пізніше, на останню частину тріолі. Уявляйте ду-ба, ду-ба.";
"L42884787f4" = "Легше вгорі";
"L428b839966" = "Ті самі числа, інша тональність";
"L42a58326f5" = "Скільки долей у такті 3/4?";
"L42b0890e73" = "Рука, якою ви граєте бій, постійно рухається вниз і вгору, наче маятник. Щоб пропустити удар, продовжуйте рух, просто не торкаючись струн.";
"L42bcf89708" = "Кожна доля може ділитися на чотири шістнадцяті. У темі швидка пара F дієз, E припадає на другу половину другої долі.";
"L42d30a8a5b" = "Виставте шпиль";
"L430ce36ce3" = "Аплікатура E на ладу 8";
"L430cf25789" = "Скільки півтонів у чистій квінті?";
"L4313c2f8b2" = "Півтон — найменший крок у музиці. У першій позиції між пальцями по півтону, починаючи на тон (два півтони) вище відкритої струни. Великий палець позаду грифа, навпроти другого.";
"L431be71b0e" = "Великий пасаж: відкрита G, стрибок до G на ладу 3 струни 1, потім кроками вниз аж до A.";
"L4320dda37b" = "Лад 2 струни 3";
"L4324d0a12b" = "Одна позиція, три настрої";
"L432e7f2ad8" = "Струна 1: лад 2, лад 4, лад 2, потім відкрита.";
"L433632ea5c" = "Марш";
"L4349c7f665" = "Пересуньте бокс мінорної пентатоніки з ладу 5 на лад 2 й вважайте домівкою A: звук стане солодким і мажорним. Це мажорна пентатоніка A: A, B, C дієз, E і F дієз.";
"L434e95846c" = "Спершу дві швидкі ноти";
"L4351df04dd" = "Менует — танець на три. У каноні та марші тролів рахуємо на чотири.";
"L435288c01d" = "Остання фраза: F дієз, дотягнувшись пальцем 1 назад до ладу 2. Потім E бемоль, D, C на ладу 5 струни 3 та B бемоль.";
"L435eef57b3" = "Радість солдата";
"L4378fed8cb" = "Заповнюйте проміжки";
"L438e5aaa6d" = "Тон, тон, півтон: перший півтон — від 3 до 4. Тон, тон, тон, півтон: другий — від 7 до 8.";
"L439a7003e1" = "Восьмі під лігою";
"L439cc8cefc" = "C E G";
"L43a0400f7f" = "C D E F G A B, потім знову C октавою вище.";
"L43a99bfc67" = "Поставте другий палець на струну A. Не зрушуючи кінчика, розслабте суглоб і повільно погойдуйте кистю до завитка й назад. Мало й рівно. Тут корисний погляд викладача.";
"L43b9ebb5b9" = "Вимірюйте розмір у півтонах";
"L43ba221783" = "Грати лише одним пальцем";
"L43bf68e94d" = "Який акорд найсильніше тяжіє назад до F?";
"L43df6de9f2" = "Бетховен завершив Дев'яту симфонію в 1824 році, і нині ця мелодія — гімн Європейського Союзу. Тут ви зіграєте її повністю, із середнім розділом.";
"L43edee6687" = "Проведіть угору по струнах від 1 до 3, потім розслабте руку на грифі, щоб акорд одразу замовк. Чк на два, чк на чотири. Тихі долі створюють погойдування.";
"L43fd9617db" = "На квінту вгору";
"L441288a772" = "Кантрі з каподастром";
"L441c2d83ad" = "Down by the riverside: B, B, A дієз на ладу 3, B, потім A й G.";
"L4425c2fc2c" = "Лад 5 струни 1";
"L442ca321c9" = "У пісні «Погода для повітряних зміїв» — G, D, E мінор, C. У пісні «Каньйон відлуння» — E мінор, C, G, D. Що змінилося?";
"L442f11be15" = "Відкрита B тричі, A дієз на ладу 3 струни 3, знову B, потім угору до G на струні 1 й униз D, D, B.";
"L44368c8e63" = "Відкрита струна, лад 1, лад 3: E, F, G.";
