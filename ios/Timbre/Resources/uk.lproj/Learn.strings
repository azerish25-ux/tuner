"Ld96c7b9ad5" = "На парі 2 лад 2 — B, лад 3 — C, лад 4 — C♯.";
"Ld975a3a9d1" = "W. W. Fosdick (1861)";
"Ld97d7d70a8" = "Який це інтервал?";
"Ld9963a291e" = "Четвертна нота — одна доля, а в долі вміщуються чотири шістнадцяті.";
"Ld99df80a9b" = "Скрипка на ключиці, смичок тримаєте м'яко, він посередині між підставкою й накладкою грифа. Тепер зіграйте все з цього розділу.";
"Ld9ae6738ec" = "Малі аплікатури, увесь гриф";
