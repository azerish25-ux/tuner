"L0cee63f97a" = "При ключі один дієз, F♯. Яка це мажорна тональність?";
"L0cf065e1f1" = "Затакт — кілька нот, що ведуть до першої сильної долі. Тут вони підводять до складу com-.";
"L0cf4d1d8eb" = "Крістіна Россетті написала цей вірш у 1872 році, а Густав Голст поклав його на музику для збірки гімнів у 1906. Рядки короткі й спокійні, наче падає сніг.";
"L0d04e7ac6c" = "«Арканзаський мандрівник», висока частина";
"L0d05f4bd7b" = "Підказка з дієзами";
"L0d08b4ee08" = "Ді, середню";
"L0d09e295cd" = "Куплет 2";
"L0d17bb1df3" = "Грайте мелодії нота за нотою на струнах від 1 до 3.";
"L0d19973a19" = "Оголошуйте мелодії";
"L0d1cefb9f1" = "До, ре, мі, фа, соль: на перших п'яти ступенях побудовано багато простих мелодій. Заспівайте їх угору й назад униз на одному диханні, якщо це легко.";
"L0d1d2365f7" = "Від низької до високої пари — G, D, A та E. Мнемоніка за англійськими ініціалами: Good Dogs Always Eat. Скрипка має такий самий стрій, тому її народні мелодії природно лягають на мандоліну.";
"L0d2b6e73ca" = "Яка пара є терцією?";
"L0d2ce2c173" = "Додайте пальці";
"L0d2ebb6ad9" = "Третій палець грає D, на півтон вище за C дієз, тому стоїть впритул до другого. На струні A порядок такий: 1, потім 2 і 3 разом.";
"L0d3104ffd5" = "Пора гамаків";
"L0d6aa1d01c" = "На мандоліні кожен палець охоплює два лади, тож другий відповідає за лади 3 і 4.";
"L0d772098ad" = "Випробування: відкриті акорди";
"L0d815d5b43" = "Тепер торкайтеся лише на 1 і 3. Кожен дотик — половинна нота, тривалістю дві долі. Рахуйте всі чотири: пропущені долі все одно тривають.";
"L0d94f2e27e" = "Зіграйте чи заспівайте середнє C, потім E, G і C у третьому проміжку.";
"L0d96530743" = "Медіатором грають лише першу ноту. Під час ковзання зберігайте тиск на струну, інакше нота згасне в дорозі.";
"L0da3c0bfe0" = "C, рисунок Тревіса";
"L0daa2701cc" = "Велика секста охоплює дев'ять півтонів; із неї починається «My Bonnie Lies Over the Ocean». Мала секста охоплює вісім і звучить темніше. «The Entertainer» стрибає на неї вгору відразу після швидких початкових нот.";
"L0db3144f34" = "«Skip to My Lou» була грою на вечірках у 1840-х. У клоухаммері кожна нота мелодії — це бам, за яким ідуть удар по струнах і щипок великим пальцем на струні 5.";
"L0dd28dc711" = "Для G розставте пальці ширше: палець 2 на струні 6, лад 3; палець 1 на струні 5, лад 2; палець 3 на струні 1, лад 3. Звучать усі шість струн.";
"L0dd97ca1ba" = "Ця мелодія з Дев'ятої симфонії Бетховена рухається майже лише кроками. Співайте плавно й рівно, наче ходите сходами вгору та вниз.";
"L0debbfc022" = "Спершу струна 5, потім струна 1. Яка вища?";
"L0df973ffa2" = "Вібрато — м'яке, рівне коливання навколо ноти кілька разів за секунду.";
"L0e03afecc0" = "Лише високі";
"L0e09dfdc9c" = "G, A, B, C на струні G разом із D, E, F дієз, G на струні D утворюють гаму G мажор. Ті самі пальці на обох струнах.";
"L0e12a0aaf0" = "Едмунд Сірс написав ці слова в Массачусетсі в 1849 році, а Річард Сторрс Вілліс — мелодію роком пізніше. Вона гойдається двома великими долями в такті, кожна поділена на три.";
"L0e22317022" = "Почніть із затакту";
"L0e26c5f4fc" = "На долі 1 і 3";
"L0e28fb76fb" = "Ду-воп рухається м'яким свінгом. Панк і серф — прямими, рівними восьмими.";
"L0e290fc064" = "Long займає дві ноти, a- — дві, go — одну: п'ять нот на три склади.";
"L0e294ddaf1" = "Рухомі квінтакорди";
"L0e2b8a2286" = "Що відбувається на другу й четверту долі в «бум-чик»?";
"L0e3584c6c8" = "G на струні 4 ладі 3, C на струні 3 ладі 3, потім відкрита D.";
"L0e3d8c7eb1" = "Рух був угору чи вниз?";
"L0e3dbdf12e" = "Ця версія в G, у першій позиції: по пальцю на півтон, починаючи на тон вище відкритої струни; схема акордів — для тих, хто акомпанує вам.";
"L0e4a8a8ead" = "Квінта";
"L0e4e40eda7" = "Заспівайте чи зіграйте до, мі, соль у G мажорі: G, B, D.";
"L0e5e82e12e" = "G аплікатурою D розташований на…";
"L0e648419ea" = "Зупиняється";
"L0e691ce9fa" = "Кінцівка піднімається до G на ладу 3 струни 1, затримується на F дієзі, потім крокує вниз до відкритої D.";
"L0e78b3694c" = "Asus4 та Asus2";
"L0e7c35d2b5" = "Гама";
"L0e856e0a16" = "Від B до D й від D до F — малі терції.";
"L0e87d7c69a" = "Половинна (закінчується на V)";
"L0e8a5b56f7" = "Улюблений джазовий хід: акорд на другому ступені тональності, потім на п’ятому, потім до тоніки. У C це Dm7, G7 і Cmaj7.";
"L0e8e204738" = "Багато давніших пісень мають форму AABA: мелодія, знову вона, контрастний бридж, потім мелодія ще раз. Кожна частина часто має вісім тактів; тут — чотири.";
