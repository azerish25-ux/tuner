"L94cc4cc3bd" = "Чотири вниз, ще чотири вниз";
"L94cd1bcc15" = "Випробування: ступені гами";
"L94d71996f9" = "A на ладу 2 струни 3, відкрита B, D на ладу 3 струни 2, потім G на ладу 3 струни 1, F дієз, відкрита E.";
"L94e06d61d8" = "G, B і D — ноти акорду G мажор, тож мелодія піднімається самим акордом.";
"L94f2c05f3d" = "Випробування: дієзи й бемолі";
"L9503c95c17" = "Покажіть, що знаєте";
"L951f4e8f4d" = "Як мають рухатися пальці між акордами?";
"L95355fcd8e" = "Перша частина, завершення";
"L953a83999d" = "Від волинок до Парижа";
"L953de1dfc6" = "Лише вниз";
"L953ef812aa" = "Струна 4: лад 1, лад 3, лад 5.";
"L953f5d261e" = "Бетховен написав цю мелодію для Дев'ятої симфонії у 1824 році. Вона переважно рухається поступенево, тож пальці крокують.";
"L95499b43d8" = "E7, G7 і A7";
"L95795902e2" = "У рок-музиці напруження часто наростає приглушеними восьмими, а потім звучить відкритий акорд. Підніміть долоню для потужного удару й дайте йому прозвучати.";
"L957dc77c43" = "Перший варіант";
"L95847c5f13" = "Ця веслярська пісня має розмір шість восьмих: шість швидких відліків у такті відчуваються як два великі погойдування. Рахуйте 1 2 3, 4 5 6, наголошуючи 1 і 4.";
"L9585f7c5d0" = "Лоуфай для відпочинку";
"L958cd7f8b2" = "Де грає гітара в пісні «Радіо відпливу»?";
"L95ab7724b7" = "Вичавити останнє повітря";
"L95bc608d2b" = "Цей рисунок припадає на 1, «і» долі 2 та 4. Рахуйте 1 і 2 і 3 і 4 і, торкаючись лише в цих трьох місцях.";
"L95c1c21193" = "Випробування: акорди";
"L95cc58709f" = "У G два-п’ять-один — це Am7, D7 і Gmaj7. Am7 — баре аплікатурою мінорного септакорду E на ладу 5; Gmaj7 пропускає струну 5, а основний тон має на струні 6, ладу 3.";
"L95ce1c02d1" = "Почуйте, а тоді заспівайте";
"L95d140dc9a" = "Просто вгору від струни";
"L95e175061b" = "Одна пісня, три позиції";
"L95eb9cc861" = "Зміна переборів";
"L95f5713a23" = "Грайте щипком у ритм";
"L96088d2f8d" = "Паузи";
"L960980770a" = "D мінор — це F із додатковим пальцем на ладі 2 струни 3.";
"L96108a5b85" = "Півтон — це перехід до найближчої клавіші. Тон пропускає одну клавішу, тож дорівнює двом півтонам. Обидва звучать як кроки, але тон трохи ширший.";
"L9615ca288f" = "Одна мелодія, дві країни";
"L9622a4644d" = "Дієзи не змінюють кількість ступенів";
"L964cd16960" = "St Anne (O God, Our Help), 1708";
"L9658de26f1" = "Лінія в стилі Motown";
"L968a665a6d" = "F, G, A, B♭, C: п'ята нота — C.";
"L9690c0c94a" = "Народна пісня (друк 1876; James Yorkston, 1884)";
"L96a6a52d47" = "Від G до F — сім літер і десять півтонів: мала септима.";
"L96b66429e0" = "Кожна струна має кілок на головці грифа. Його обертання змінює висоту звуку. Timbre слухає й підказує напрямок.";
"L96bda2a527" = "Шафл із мелодією";
"L96c19a032f" = "Ті тяжіє вгору до до, тому мелодія, що зупинилася на ті, ніби чогось чекає.";
"L96cb30fc29" = "Приспів перебором на ладу 5";
"L96d2cba622" = "Зберігайте форму кисті";
"L96e3f35aa3" = "Мелодія починається з двох швидких нот, F дієз та E, перед першою долею. Потім довга D й низка восьмих піднімаються до A.";
"L96e5a980f0" = "F: два пальці";
"L96e60c39eb" = "Початок: C, E, F, потім відкрита G.";
"L96e7ede57d" = "Танцювальна пісня шейкерів";
"L96ee5864c0" = "Нічого нового: мажорні й мінорні тризвуки, їхні обернення, G, E мінор, C і D у двох позиціях та арпеджіо. Нехай кожен рух буде малим.";
"L96fdc9d259" = "З відкритою струною A";
"L96fe6af3c4" = "Три акорди: G, C і D7";
"L96fe6f4903" = "Це випробування чергує розміри й акценти. Перед кожною вправою з дотиками тихо порахуйте один такт, щоб знайти долю 1.";
"L9701123b70" = "Якщо не влучили, не зупиняйтеся. Повільно піднімайте чи опускайте голос, доки висота не стане точною. Так слух і голос учаться узгоджуватися.";
"L9702ee0f0e" = "Пісня з опери";
"L970a7784d9" = "Четвертна з крапкою";
