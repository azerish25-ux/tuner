"L945a9f057a" = "Тепер пара 2, пара A.";
"L9464d06605" = "Цього разу G. Опустіть щелепу й тримайте «а» відкритим.";
"L946d9e8e59" = "«Останній дзвоник» — панк-поп, 152 долі за хвилину: C5, G5, A5 і F5 — цикл із чотирьох акордів як квінтакорди. Лише удари вниз рівними восьмими, долоня на струнах біля підставки.";
"L9471dc4971" = "Від до до мі й назад: C, E, C.";
"L94739b8015" = "Відкрита G, F дієз на ладу 4 струни 4, G, A на ладу 2 струни 3, G, потім C на ладу 1 струни 2 двічі й відкрита B.";
"L947c6bdef2" = "A мінор на ладу 5";
"L9482daee9c" = "Від E до F";
"L948ad5178d" = "Середня лінійка — B, від Boy у фразі Every Good Boy Does Fine.";
"L948c4988ab" = "Основні тони й квінти, як у першому акомпанементі басиста гурту: основний тон на початку акорду, квінта між ними, низько в першій позиції. Пісня лишається в A мінорі, де її грає гурт.";
"L948eb34feb" = "Ролердром";
"L949ec2d490" = "Там, де мелодія тримає ноту";
"L94a826abe3" = "Утримані ноти";
"L94af6c4088" = "Гітара";
"L94b0431a32" = "6/8 гойдається двома великими долями, кожна поділена на три: раз-два-три, чотири-п'ять-шість.";
