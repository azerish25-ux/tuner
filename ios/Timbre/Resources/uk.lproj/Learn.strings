"Lcffbe42188" = "Четвертна з крапкою та восьма заповнюють дві долі: довго, коротко. Рахуйте 1 і 2 і; торкніться на 1 і на «і» долі 2.";
"Ld0007695e3" = "B і C дієз мінор";
"Ld004ac6df6" = "C, G, D і D мінор, дві класичні послідовності та хвилинна зміна акордів.";
"Ld005c13abf" = "Каподастр на ладу 2. Яка аплікатура звучить як E?";
"Ld005cb31b2" = "Пропустіть палець";
"Ld010097106" = "B на відкритій струні 2";
"Ld01f5c0bf4" = "Каденція — коротка послідовність акордів, що завершує фразу. Вона чітко задає тональність. Тихо наспівайте собі до, а потім відміряйте від неї відстань до нової ноти.";
"Ld021278fb3" = "«Погода для повітряних зміїв» — авторська пісня Timbre: світла попмелодія для вогнища на G, D, E мінорі й C, знову й знову. Змінюйте завчасно, спершу ставте палець для найнижчої струни. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"Ld025bb9f28" = "Рисунок на райді";
"Ld026471b5e" = "Грайте рівні восьмі вниз-угору, але три з них сильніше: 1, «і» після 2 та 4. Між акцентами — 3, 3 і 2 восьмі.";
"Ld02d212366" = "Поєднайте все: чисту інтонацію, прямий смичок, ліги й динаміку. Почніть піано, нарощуйте гучність у середині й завершіть форте.";
"Ld035dda7cc" = "«Пізній виїзд» — авторська пісня Timbre: лоу-фай у C на Dm7, G7, Cmaj7 і Am7. Це ii–V–I плюс акорд шостого ступеня для повернення до початку. Акомпануйте септакордами з баре в ритмі чарльстону. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"Ld03983b022" = "У мажорного тризвуку знизу велика терція, чотири півтони, а над нею — мала. C E G — мажорний. Так само F A C і G B D.";
"Ld04239bad0" = "Низький 2 і високий 2";
"Ld04dc84ef6" = "3–4 і 7–8";
"Ld04dff28a0" = "В E мінорі D дієз на лад нижче E й тяжіє до неї. Знайдіть D дієз на струні 4, ладу 1 та C дієз на струні 5, ладу 4.";
"Ld052b9a30c" = "Маленька нічна серенада";
"Ld055b1188a" = "Зупинити звук і чекати";
"Ld06dd032b4" = "Завершення";
"Ld074583ef5" = "Мелодії з трьох нот";
"Ld07694d3e3" = "До ре ті до";
