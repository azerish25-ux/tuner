"L48d87087f9" = "Як влаштована музика: від назв нот до акордів у піснях";
"L48e812a5c1" = "Крокуючий блюз в A";
"L48fa43c2ec" = "Банджо має чотири повнорозмірні струни й п'яту, що починається посеред грифа, біля власного маленького кілка. Ця коротка струна — впізнаваний звук банджо.";
"L48fe3178d7" = "Dm7 — це ваше баре A мінору з піднятим мізинцем. D7 — баре аплікатурою A з пальцями 3 і 4 на струнах 4 і 2. Назви обох визначає струна 5.";
"L49001bc117" = "Восьмі вниз-угору: де удари вгору?";
"L490de4dad7" = "C, лише великий палець";
"L490f551702" = "Як називається нота на відкритій струні 4 і на струні 2, ладу 3?";
"L490f6b717c" = "Рівномірний тиск під час руху";
"L49154676bb" = "Випробування: три мелодії";
"L4919fc8832" = "У 6/8 кожен такт має шість восьмих у двох групах по три: РАЗ два три ЧОТИРИ п'ять шість. Відчуваються дві великі долі з погойдуванням.";
"L4929fa407e" = "Повернути машинку проти годинникової стрілки";
"L492f20e9cd" = "Який удар пропускають в острівному бою?";
