"L2cb5a2aa90" = "Медіатором грають лише першу ноту. Під час ковзання продовжуйте притискати, інакше нота згасне в дорозі.";
"L2cba02bd23" = "D, E, F, G: відкрита, 1, 2, 4. Другий палець стоїть поруч із першим.";
"L2cbde2fc49" = "Октава вгору подвоює частоту коливань: 440 стає 880.";
"L2cbec77a01" = "Тон, тон, півтон, тон, тон, тон, півтон — це…";
"L2cc03c9660" = "Ця мелодія в E мінорі. Яка нота звучить як домівка?";
"L2cc8bcaef4" = "Ритмічне випробування";
"L2ce950fe74" = "Пропустіть середню ноту тріолі";
"L2cea9987eb" = "Єдиний дієз G мажору — F♯.";
"L2cec2b9250" = "C і G";
"L2ceccefc66" = "Струна 1, лад 3, третій палець.";
"L2cefd57e14" = "Пряма, рівна A. Без хвилі, лише чітка лінія.";
"L2cf580048c" = "Ця версія в G. Четверта струна налаштована високо, тож мелодія лишається на струнах від 1 до 3, а всі акорди на схемі мають аплікатури для укулеле.";
"L2d10987376" = "Почуйте кожен стрибок в уяві, перш ніж співати. Легко влучіть у верхню ноту, а тоді крокуйте додому.";
"L2d12445cb7" = "F замість F♯";
"L2d1407093e" = "Яка лічба відповідає цьому рисунку?";
"L2d2583ef7c" = "Низько на A, високо на E";
"L2d354c8d87" = "Яка квінта від E?";
"L2d3edcae5d" = "Від C до D пропускаємо одну клавішу — C♯.";
"L2d55381343" = "Основний тон C — на струні 5, ладу 3. Лишайтеся на ладу 3 й переходьте до аплікатури A.";
"L2d596e69f3" = "F дієз, а потім високий 2 чи низький 2?";
"L2d75847a6b" = "By yon bonnie banks: відкрита D, потім G, G, A, B і назад униз до G.";
"L2d7e44e828" = "Зробіть губну трель на G, E, потім C. Якщо губи зупиняються, злегка притисніть щоки.";
"L2d8a9921f8" = "П’яти ладів";
"L2daa85f845" = "До мі ре";
"L2db2598ae2" = "D, E, F: пальці 1, 3, 4. Тут угорі ноти розташовані трохи ближче одна до одної.";
"L2db4973514" = "Квінти";
"L2dd456e860" = "Зіграти відкриту струну 2";
"L2dd4c36e57" = "A C E";
"L2dded32bee" = "Знайомі секунди";
"L2de5e2da49" = "З'єднайте A і B одним рухом униз, потім B і A одним рухом угору.";
"L2df0282bf4" = "Перше клацання — доля 1. Сильні клацання на числах чи на «і»?";
"L2e035bd48b" = "Який акорд у G мажорі побудовано на 6?";
"L2e09dac6dc" = "«Зелені рукави»: мелодія";
"L2e225d587c" = "C, A мінор, D мінор, G7";
"L2e28166032" = "F із повним баре";
"L2e2ccc4532" = "Скільки разів у AABA звучить мелодія A?";
"L2e3197089c" = "Такти 1 і 2";
"L2e3427e159" = "Чому п'ята струна звучить так високо?";
"L2e5b0c8e6f" = "Та сама клавіша безпосередньо під G. Яка її назва з бемолем?";
"L2e5cbf0101" = "Чиста квінта";
"L2e5d1a8b85" = "Чотири такти I. Два IV, два I. Один V, один IV, два I. Потім повтор. У A: A7 чотири рази, D7 двічі, A7 двічі, E7, D7, A7 двічі.";
"L2e6501b0d7" = "Давні улюблені пісні з американського пісенника для бою й співу.";
"L2e7d43d0bf" = "Зменшений";
"L2e9170d9ae" = "Кисть у формі кігтя";
"L2e9f3dcf47" = "На струні G перший палець грає A, третій — B, четвертий — C. Відстані ті самі, що й на D. Зручно розташуйте руку на рівні струни G.";
"L2ea3c739b2" = "Струна 4, під пальцем 1";
"L2ea7c6f471" = "B мінор, повний чи спрощений";
"L2ea98f1bf5" = "Яку струну налаштовують першою?";
"L2eae1cdcfb" = "Чотири пісні за один раз";
"L2ec3d6e24c" = "Які ключові знаки має G мажор?";
"L2ede7957fd" = "Півтон";
"L2edff0be1b" = "Хвиля на C";
"L2ee61dcfa7" = "Від A на струні 6, ладу 5, потім лади 2 і 4 на струнах 5 і 4 та A на ладу 2 струни 3.";
"L2ee7ba5734" = "До якого акорду найближчий D мінор?";
"L2efc99f79a" = "Хамер-они, пул-офи й слайди";
"L2f086284e9" = "«У Мері було ягнятко» грають на струні D: відкрита D, перший палець на тон вище — E, третій на два тони вище від відкритої — F дієз. Спершу щипком, потім смичком.";
"L2f1d6857a4" = "A і B";
"L2f34e7c4c2" = "Мі ре до";
"L2f6b4e2d99" = "Нових прийомів немає: дві теми Моцарта, дві старовинні мелодії й третя позиція, кожна трохи швидше, ніж раніше. Переводьте подих між творами.";
"L2f6d509f56" = "Який лад починається на другій ноті G мажору?";
"L2f6e32e2ab" = "Покладіть руку на живіт і повільно вдихніть. Живіт і нижні ребра розширюються, а плечі не рухаються. Таке низьке дихання живить голос.";
"L2f8101b73b" = "Поверніть, щоб налаштувати";
"L2f866e54b7" = "Звузьте вибір";
"L2f955deef1" = "Пара 3, лад 2, перший палець. Це E.";
"L2f97468b30" = "Випробування: кроки й стрибки";
"L2f99eedb1f" = "Продовжуйте рух великим пальцем. Між його нотами m щипає струну 2, а i — струну 3: великий, m, великий, i. Грайте повільно, доки рух не стане автоматичним.";
"L2fa54cefb9" = "Обидві струни разом, як одну ноту";
"L2fdcf7418d" = "Пройдіться відкритими струнами";
"L2fe30e7339" = "Кохана моряка";
"L2fea9a5a2c" = "Баладний бій: сильний удар на першу долю — дайте йому звучати, ще один на третю, потім вниз-угору на четверту. Простір після кожного удару — частина пісні.";
"L2ffd9e234c" = "Палець 1 тримає баре на струнах від 1 до 5 на ладу 2. Пальці 2, 3 і 4 будують аплікатуру A мінору на два лади вище. Пропускайте струну 6.";
"L2ffed6bb0c" = "У якій із цих тональностей немає дієзів?";
"L3001018105" = "Другий такт мотиву повторює перший на кілька нот вище. Як це називається?";
"L300573ec25" = "In Dublin's fair city: відкрита D, чотири відкриті G, угору до відкритої B й назад до G.";
"L300a77b2e9" = "Угору й униз сходами";
"L302c29cd4d" = "Додаткова нота згори";
"L3035942462" = "Струни 3 і 2";
"L3039b0b516" = "Синті-поп на гітарі";
"L303b331516" = "Від 1861 року до рок-н-ролу";
"L303e509ef4" = "Каподастр затискає всі струни на одному ладу. На ладу 2 кожна відкрита струна звучить на два лади вище, і відкриті аплікатури акордів підіймаються разом із нею.";
"L304d3240c4" = "«У Мері було ягнятко», швидше";
"L304fc0767f" = "Перехід із G на A оминає струну D, тому рух ліктя більший. Рухайтеся плавно, не озвучуючи проміжну струну.";
"L3066ac6489" = "Літери, октави, клавіші";
"L306ba6fcb7" = "G на ладу 3 струни 6 двічі, B на струні 5, відкрита D, потім стрибок до D на ладу 3 струни 2 й униз до відкритої B.";
"L3070d2ed6c" = "Зіграйте чи заспівайте проміжки в басовому ключі: A, C, E, G.";
"L3085f7c0cf" = "Четвертні й восьмі";
"L30864f5bf3" = "«Нічний метелик і жарина» — пісня, під яку тупає весь зал: важкі удари вниз, мотив-скандування, 96 долей за хвилину. Починається похмуро в A мінорі й світлішає на D.";
"L308bd352e4" = "Рух назад абеткою означає нижчі ноти: E, D, C, B.";
"L3097623905" = "По пальцю на лад";
"L309abb0817" = "Що робить B бемоль наприкінці такту 1?";
"L309f7c8ab7" = "Зіграйте чи заспівайте вгору по білих клавішах від середнього C до наступного C.";
"L30a0f679a5" = "G — домівка, C відводить убік, D7 повертає назад. Змінюйте на першій долі кожного такту й не зупиняйте праву руку.";
"L30a6c8a770" = "W W H W W W H";
"L30a785efa7" = "Від B до C дієза — тон, тому між 1 і 2 є проміжок. Від C дієза до D — півтон, тому 2 і 3 торкаються.";
"L30af854113" = "Як утримати довгу A наприкінці?";
"L30b87fb5c8" = "Середній";
"L30be5259ed" = "Кроспікінг";
"L30e03d8db8" = "Останній дзвоник";
"L30eee1ef36" = "C дієз на один лад нижче за D. Півтоновий крок веде просто до нового основного тону.";
"L30fe3e97dd" = "Посеред довгої ноти";
"L3119876531" = "Знайомство: «Стробоскоп у сповільненні»";
"L312acfe780" = "Дієзи завжди стоять в одному порядку: F♯, C♯, G♯ тощо. Останній дієз на півтон нижче ноти, що дає назву тональності. Один дієз, F♯: G мажор.";
"L313f4f4f0a" = "Низький 2, G бекар";
"L3152f77370" = "Струна 3, лад 2";
"L31658ea8ce" = "Останній марш";
"L3168d34908" = "Бас і гітара грають на долях 1 і 3. Мандоліна відповідає на 2 і 4, як малий барабан.";
"L316bae1469" = "Який акорд у такті 2 за ранньої зміни в A?";
"L3176b3b09d" = "Такти від 1 до 6";
"L3177f554bc" = "Коли D звучить чисто, відкрита струна D вібрує разом із нею. Вони мають ту саму назву й віддалені на вісім нот — октаву. Слухайте, як звук скрипки стає повнішим.";
"L31788a622a" = "B, а потім високий 2 чи низький 2?";
"L31855cbc4f" = "Приспів";
"L318dbb790f" = "Бо там закінчується мелодія";
"L319a467396" = "Розмір вальсу: 3/4";
"L31aec9b003" = "Він задає тональність і темп";
"L31b6f60c6a" = "Рахуйте вгору в C мажорі: C 1, D 2, E 3, F 4, G 5. Септакорд на G — це G7.";
"L31cd431c31" = "Який акорд прагне рухатися далі?";
"L31e7cf74cc" = "Пісні з акордами";
"L31effebed3" = "Фанк: глухі й звучні удари";
"L31fa9a51ba" = "E, F дієз, G дієз, A. Та сама аплікатура, що й на струні A.";
"L32073f3b44" = "Плавно проведіть медіатор униз по всіх чотирьох парах, від низької до високої. Досить короткого легкого руху: акорди мандоліни яскраві.";
"L320813384c" = "Рівна рука, співучі ноти";
"L32096c2e0e" = "C";
"L3214a42eb4" = "Лише середня нота, терція, опускається на півтон: C E G стає C E♭ G.";
"L3216e73fdd" = "Аплікатура A на ладу 8";
"L3219ecca2c" = "Знову аплікатура струни A: тон, тон, півтон. Півтон — між 2 і 3.";
"L321f653c2e" = "Підняте плече";
"L3223de15b5" = "Мажорні акорди зазвичай звучать світло й стійко. Мінорні — темніше. E та E мінор відрізняються лише однією нотою.";
"L3234d1f9ae" = "Сильно влучайте на раз";
"L32362ba752" = "D мажор униз";
"L32423b32be" = "Потім угору: відкрита B двічі, A на ладу 2 струни 3 і додому до відкритої G.";
"L3245837e48" = "Гама з чотирьох нот";
"L3257dbf5cd" = "Малі римські цифри позначають мінорні акорди. Шоста нота C мажору — A.";
"L326fae9bdd" = "Інтервали рухаються в обидва боки";
"L3275c76740" = "Унісон";
"L327afc3dad" = "Середня фраза: вона йде вгору чи вниз?";
"L328873ffaf" = "Приглушений удар миттєво обривається. Ударте вниз і водночас торкніться струн ребром долоні: коротке сухе клацання, наче малий барабан.";
"L329a2be211" = "D на ладу 3 струни 2, відкрита E, G на ладу 3 струни 1 тричі, F дієз на ладу 2, відкрита E.";
"L32a2abd6aa" = "Em7";
"L32b5e50c4c" = "Більшість долей діляться довго-коротко: восьма з крапкою й шістнадцята. Витримуйте довгу ноту повністю, а коротка нехай веде до наступної долі.";
"L32d33fbc0b" = "Фанк на одному акорді";
"L32d45d5138" = "Між дотиками тримайте палець над самим склом. Короткий, легкий рух простіше зберігати рівним у швидшому темпі.";
"L32dc25fc3a" = "Ні, різні ноти";
"L32dd96191d" = "Рисунки тренують слух";
"L32e13b4e3c" = "Проспівайте відстань";
"L32f5531fae" = "Безперервний рух руки підтримує рівний ритм. Пропущений удар — це рух без дотику до струн.";
"L330c09bf46" = "Басові «бум» у G, C і D";
"L331847e1a3" = "Це випробування поєднує паузи, окреме «і», синкопи й міждольові акценти. Рахуйте кожну восьму вголос, навіть коли не торкаєтеся.";
"L333af88d0a" = "Як називається нота струни 3?";
"L333f9924c0" = "Ритм для гурту";
"L3350730484" = "Дві групи по три";
"L3351283c9f" = "Хор на даху";
"L335ef982fd" = "Нота мандоліни швидко згасає. Тремоло підтримує її спів: швидко й рівно грайте медіатором униз-угору по одній парі, щоб звук був безперервним.";
"L337c35f159" = "Який із цих творів має лише п'ять нот у темі?";
"L33892aafc9" = "Який бокс звучить солодше на A7?";
"L338d8235f0" = "Ритмічна програма";
"L339d5e6044" = "Обидві ноти — A. Кожна струна налаштована за ладом 5 сусідньої нижчої за звучанням струни.";
"L33a8a4eb1c" = "A на ладі 5 струни 4 звучить як відкрита струна 3. Відкриті струни звучать довше; притиснуті ноти легше глушити й змінювати їхній звук.";
"L33acd0cef4" = "Розігрівайтеся м'яко";
"L33bd63b9b4" = "Інші завершення";
"L33c4b9b170" = "Рівні удари вниз, униз-угору й острівний бій.";
"L33d68f2500" = "На F";
"L33def03689" = "На другій і четвертій долях";
"L33f26ce58f" = "1 і 2, 3, 4 і";
"L33fef3b1de" = "Гама A мажор";
"L33ff97aed5" = "Повільна мелодія гімну";
"L3408622053" = "C D E F G A B C. Почніть із відкритої струни 3 і піднімайтеся через струни 2 і 1. Усі ноти — у межах перших трьох ладів.";
"L340c93526e" = "Такт дев’ять, на B7: F дієз на ладу 2 струни 1, відкрита E, D дієз на ладу 4 струни 2 мізинцем, потім B.";
"L341bcc90eb" = "Додайте струну 5";
"L34214aaa54" = "Бридж";
"L3425659a66" = "Швидкі ноти по три";
"L342dd05205" = "Дві долі в такті";
"L342ffe164f" = "Спрямуйте завиток уперед і ліворуч, приблизно паралельно підлозі. Ліва рука підтримує гриф, великий палець навпроти першого. Зап'ясток прямий і вільний.";
"L3442d12e9f" = "Септакорди й sus-акорди";
"L3450910c58" = "Вона піднімається до довгої високої E — ноти, що веде назад додому, до A мажору маршу.";
"L34547c6e01" = "Блюз, вальс, фолк у 6/8, лоуфай і фанк із септакордами, sus-акордами та свінговими ритмами.";
"L3454c546b5" = "Зупинитися, відпочити, співати тихіше";
"L345e211f3a" = "Тон, тон, півтон: перший півтон — між нотами 3 і 4.";
"L346430acc8" = "A: два пальці";
"L34653dcce3" = "Від A вгору до C — це…";
"L3473290b74" = "Куди припадають ноти мелодії в «бам-ді-ті»?";
"L34753a425b" = "Від до до мі пропускаємо ре, а від мі до соль — фа.";
"L347f68654e" = "В очікуванні";
"L34bab6103a" = "Рахуйте вгору від G: G, A, B, C, D. П'ята нота — D, а V — мажорний акорд.";
"L34c2737622" = "Частина B";
"L34c7bb15d5" = "Цільова нота";
