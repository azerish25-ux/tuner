"Lef55f19970" = "Ця версія в C. Четверта струна налаштована високо, тож мелодія лишається на струнах від 1 до 3, а всі акорди на схемі мають аплікатури для укулеле.";
"Lef58de4ff0" = "Boat";
"Lef62a2d0be" = "Назва CAGED походить від…";
"Lef6d359bbf" = "Парний щипок";
"Lef7f677c71" = "Собор на автостоянці";
"Lef8608fd32" = "Скрипковий ключ, або ключ G, огинає другу лінійку знизу. Ця лінійка — G над середнім C. Ним користуються високі інструменти й голоси.";
"Lefa3dd7c25" = "Великий палець";
"Lefb3a32162" = "Терція";
"Lefc1ea7915" = "Місяць у джукбоксі";
"Lefda538736" = "Лише на «і»";
"Lefe5a8489c" = "Перша доля починає такт. Трохи гучніший перший удар допомагає і вам, і слухачам тримати ритм.";
"Lefe94a9cd8" = "У якому акорді є септима?";
"Lefefe2ad70" = "Пасаж на відкритих струнах";
"Leffdf2cc93" = "C♯ і D♭";
"Lf001d019d2" = "Фанк любить нонакорд. Палець 2 на струні 5, лад 7, палець 1 на струні 4, лад 6, а палець 3 пласко на струнах 3, 2 і 1 на ладу 7.";
"Lf004439642" = "Усі чотири, угору й назад";
"Lf00ba01668" = "Відкрита голосна, вільне горло";
"Lf02209b661" = "Нічого нового: приглушені удари, острівний бій із приглушенням, свінг, акценти 3-3-2 і вальс. Не зупиняйте руку й дайте акцентам промовляти.";
"Lf026eac482" = "Ця народна мелодія стрибає від C угору до G, а потім спускається по одній ноті. Кожен рядок закінчується довшою нотою.";
"Lf02792e9e5" = "Проведіть по струнах один раз, а решту такту використайте для зміни. Новий акорд має прозвучати точно на першу долю. Швидкість прийде сама, згодом.";
"Lf0292a943f" = "Від A до C — мала терція, три півтони.";
"Lf02cabc5b6" = "Генрі Френсіс Лайт написав ці слова в 1847 році, а Вільям Генрі Монк — мелодію «Eventide» до них у 1861. В Англії вболівальники співають її перед фіналом кубка від 1927 року.";
"Lf02f101c07" = "Лад 7";
"Lf036171c29" = "Рівні основні тони";
"Lf03a831605" = "Лад 5";
"Lf0407dd043" = "Ви продовжуєте рахувати";
"Lf048e06f81" = "«The Holly and the Ivy» — на три. Інші дві рахуємо на чотири.";
"Lf04e8a09c2" = "На A";
"Lf0647309b4" = "Стрибки в мелодії";
"Lf068a34024" = "Sus-акорд замінює ноту, що визначає мажор або мінор, сусідньою. Він звучить відкрито й незавершено, доки не розв’яжеться.";
"Lf0714231ef" = "Сядьте ближче до переднього краю стільця, поставте стопи на підлогу й розведіть коліна, ніби можете легко встати. Віолончель стоїть між колінами.";
"Lf0914244f3" = "З боку в бік";
"Lf09abc15d8" = "Основні тони й квінти, як у першому акомпанементі басиста гурту: основний тон на початку акорду, квінта між ними, низько в першій позиції. Пісня лишається в D мінорі, де її грає гурт.";
"Lf0baa74e41" = "Мир на землі";
"Lf0bbc1d6e7" = "Для переходу на іншу струну змінюйте рівень ліктем, а не зап'ястком. Займіть новий рівень перед самою зміною напрямку смичка.";
"Lf0db57fe3e" = "Шістнадцяті ноти";
"Lf0e20b63de" = "Униз на 1, униз-угору на 2, униз на 3, униз-угору на 4. Після 1 і 3 рука теж іде вгору, просто не торкається струн.";
"Lf0f611c748" = "Де A дієз на струні 5?";
"Lf0f7458ee6" = "Ще не готові до баре? Грайте лише чотири верхні струни: лад 4 на струнах 4 і 3, лад 3 на струні 2, лад 2 на струні 1.";
"Lf0fd6576f2" = "«При місячному сяйві», друга частина";
"Lf109defb30" = "У цій тональності два дієзи: F дієз і C дієз. C дієз розташована на ладу 2 струни 2.";
"Lf115cd0d4d" = "Хамер-он дає другу ноту лише рукою на грифі. Щипніть ноту, потім різко поставте інший палець перед вищим ладовим поріжком. Струна звучить далі.";
"Lf11be4708d" = "«Зелені рукави» співали в Англії вже в 1580-х, і Шекспір згадує її у «Віндзорських жартівницях». Тут вона в E мінорі, низька й похмура.";
"Lf149dab787" = "Сядьте, виставте шпиль, візьміть смичок, зіграйте відкриті струни й першу пісню.";
"Lf14bcf9b91" = "Дванадцять";
"Lf155ce04bf" = "Акорди під куплет";
"Lf160cb4eda" = "Тональність";
"Lf16f6a6b45" = "Нехай довгі ноти співають";
"Lf179bbea59" = "Основний тон називає акорд";
"Lf182217aca" = "Розминка переходів";
"Lf185b408d3" = "Велика секста";
"Lf192d656d8" = "Додайте септиму";
"Lf19797ad4a" = "Випробування: відкритий G";
"Lf1ab4a3306" = "Мелодія йде вгору чи вниз?";
"Lf1abce53b1" = "Нарощуйте, а не стрибайте";
"Lf1bdbc66eb" = "12-тактовий блюз працює в будь-якій тональності. У E це акорди E, A і B. Крокуйте основними тонами, терціями, квінтами й секстами та підводьте до кожної зміни.";
"Lf1c6f16910" = "На два лади";
"Lf1cc990354" = "Ця дитяча мелодія крокує нотами C, D та E, а потім стрибає до G. Стрибок — від відкритої струни 1 до ладу 3.";
"Lf1d459f7d7" = "G третім пальцем, відкрита G, G третім пальцем. Слухайте резонанс.";
"Lf1da2082b9" = "Від E до G♯ — велика терція; від G♯ до B — мала.";
"Lf1e96e9a2e" = "Нічого нового: 12-тактовий блюз у A та E, рання зміна, лінія бугі, поворот до початку й ваші фрази. Зберігайте свінговий рух шафлу.";
"Lf1ed699d9f" = "За формулою від ноти 6 до 7 потрібен тон, а від 7 вгору до G — півтон.";
"Lf1ee7fc29d" = "Основний тон D — відкрита струна 4, з якої починається бій акорду D.";
"Lf1f2c89442" = "Скільки тут долей у кожному такті?";
"Lf1f7abf176" = "Ця версія в A. Четверта струна налаштована високо, тож мелодія лишається на струнах від 1 до 3, а всі акорди на схемі мають аплікатури для укулеле.";
"Lf1f91d70ac" = "A E C G";
"Lf205ad6518" = "Униз до низької C";
"Lf210cbbe01" = "«Радість солдата» вже була надрукована в Шотландії не пізніше 1780 року й відтоді лунає на американських джемах. Її перша частина стрибає між D, F♯ та A.";
"Lf21d5f21a2" = "Лише на числа";
"Lf237c6e813" = "Перший мороз";
"Lf23c32ed91" = "Крапка подовжує ноту наполовину. У другому такті F дієз звучить півтори долі, G вступає на «і» другої, а A — на третю.";
"Lf23cc17a3e" = "Послабити притискання, зберігши дотик";
"Lf246d5ffdd" = "Тепер E. Те саме низьке дихання, те саме легке «а».";
"Lf2475e34a0" = "Першим пальцем на струні A";
"Lf253337468" = "Відкрита D, потім E першим пальцем. Тримайте E до чистої інтонації.";
"Lf2535255bd" = "Народні пісні, колядки й класичні теми в тональностях для мандоліни";
"Lf253e82edc" = "Яку струну грає великий палець в D?";
"Lf25c3da65a" = "John Howard Payne (1823)";
"Lf26babdf48" = "A мінор починається з A першим пальцем на струні G. Другий палець високий на струні G для B, потім низький на струні D для F бекара.";
"Lf26ecaaa90" = "Відмовитися від цієї ноти";
"Lf26f659729" = "Чому другий палець залишається над своїм місцем?";
"Lf27727d913" = "Короткий кінчик дає контроль і чистий звук. Якщо виступає забагато, медіатор чіпляється за парні струни.";
"Lf27b4287d6" = "Хроматичні підхідні ноти";
"Lf284772600" = "Перша спроба вийшла нижче. Що далі?";
"Lf28ef6a501" = "Яка інша назва E♭?";
"Lf2a23bbd56" = "Випробування: читання нот";
"Lf2b380c306" = "Чоп глушить рука на грифі. Послабте тиск, але залиште кінчики пальців на струнах.";
"Lf2c31c38b7" = "Великий палець тримає ритм";
"Lf2ceb7212c" = "Щипайте ноти окремо";
"Lf2d0250794" = "Лад 3 на струні 2, потім відкрита струна 1. Піднімайте палець під час щипка.";
"Lf2e3dcb7b0" = "G, A, B, C, D, E, F, G: вісім літер, октава.";
"Lf2e8c49236" = "Для A поставте пальці 1, 2 і 3 поруч на ладу 2, на струнах 4, 3 і 2. Починайте бій зі струни 5.";
"Lf2ecba4f27" = "Карусель перед закриттям";
"Lf2f8952faa" = "Аплікатура A працює будь-де на грифі. Посуньте її на три лади вгору для C і на п'ять для D. Під час руху зберігайте положення всіх чотирьох пальців.";
"Lf30e266da0" = "Четвертна нота триває одну долю. Грайте вниз на кожну долю й рахуйте вголос: раз, два, три, чотири.";
"Lf3162ad5ad" = "C дієз, B, A, B, потім C дієз тричі.";
"Lf319af35dc" = "Тиха ніч";
"Lf33aa81082" = "Більшість мелодії йде восьмими. Рухайте медіатором коротко, чергуючи вниз і вгору, щоб не відставати.";
"Lf33c98e78a" = "Перевірка відкритих струн";
"Lf34302e375" = "Ваші восьмі нерівні. Що допоможе найбільше?";
"Lf355697145" = "Заспівайте чи зіграйте низхідну квінту: від G униз до C.";
"Lf3627bff2c" = "Смичок, пальці й чиста інтонація: від відкритих струн до народних мелодій";
"Lf36c5f296a" = "Зіграйте перші десять тактів боєм із ранньою зміною, а в тактах 11 і 12 перейдіть на фразу. Так блюзовий гурт завершує кожне коло.";
"Lf37033bc4a" = "Угору й униз абеткою";
"Lf3756a3ab7" = "Вісім нот, дві пари";
"Lf377cdbeac" = "Струна E";
"Lf37a20ea1c" = "G і A на струні 3, потім B, C і D на струні 2.";
"Lf38484922d" = "F дієз, G дієз, A на струні E, потім відкрита A на октаву нижче.";
"Lf386a7ddfa" = "Відкрита G, стрибок угору до D на ладу 3 струни 2, відкрита E й назад до D.";
"Lf38952de44" = "Deck the Halls";
"Lf38de4092a" = "«Бам» припадає на долю, тож там і звучить мелодія. «Ді» й «ті» підтримують плин ритму.";
"Lf3949e8a3d" = "Фраза, що повертає до початку";
"Lf3ad8067b3" = "Притисніть обидві струни пари одним кінчиком пальця впритул перед металевим ладовим поріжком. Струни мандоліни тугі, тож ставте самий кінчик і тисніть лише настільки, щоб нота була чистою.";
"Lf3cd4632fc" = "Три";
"Lf3d1999a5d" = "Струни рахують від підлоги вгору: 1, 2, 3, 4.";
"Lf3d4a454a3" = "Та сама ідея працює нижче: G аплікатурою E на ладу 3, C аплікатурою A на ладу 3 та D аплікатурою C на ладу 2.";
"Lf3da164b85" = "C дієз мінор із баре аплікатурою A мінору — це…";
"Lf3ec90a313" = "До, ре, мі, фа, соль, ля, ті, до: вісім нот, із до на обох кінцях.";
"Lf3f836de8c" = "Чотири відкриті G, потім стрибок до відкритої E на струні 1, униз до D на ладу 3 струни 2 й відкритої B.";
"Lf42b604b43" = "Палець 2 на струні 6";
"Lf42e6f48eb" = "Випробування: бій";
"Lf46578d518" = "Вона починається на «і» й звучить через наступну долю. Це зміщення — синкопа, як у вашому попбої.";
"Lf47d48c3f0" = "Проміжки у скрипковому ключі";
"Lf47fc5ba22" = "Зі швидкістю рухи меншають";
"Lf486c38d33" = "Дотики зміщуються";
"Lf49c331357" = "O Little Town of Bethlehem";
"Lf4a0ae9f34" = "Основний тон на 1, квінта на 3";
"Lf4a1612b32" = "По пальцю на півтон";
"Lf4ae93d3b6" = "Погода для повітряних зміїв";
"Lf4bc046e54" = "Рахуйте більше, ніж відбиваєте";
"Lf4ed20a89d" = "Тепер на деякі долі припадає один дотик, на інші — два. Промовляйте кожне «і», навіть коли не торкаєтеся на ньому.";
"Lf4ed51a241" = "П’ять нот угору й назад";
"Lf4f417cd76" = "Ліга з'єднує дві ноти";
"Lf4f6aa9fd6" = "Знайомство: «Радіо відпливу»";
"Lf50861df80" = "Послідовність ii–V–I";
"Lf530c5da71" = "Кожна тональність має ноту-домівку — тоніку. Співаки називають її до. Тут ви почуєте акорд, що задає тональність, а потім окрему ноту, місце якої треба визначити.";
"Lf535d088fe" = "Спершу акорди, потім мелодія. Знайдіть до, простежте контур, назвіть кожну ноту, а тоді заспівайте чи зіграйте почуте.";
"Lf5379f3358" = "Лад 12";
"Lf5424db4cf" = "Коротко, потім довго";
"Lf5673f8feb" = "Ця шотландська народна мелодія починається із затакту — ноти перед першим повним тактом. Заспівайте її легко, а наступну трохи підкресліть.";
"Lf576c0e08e" = "Долі 2 і 4";
"Lf57eae0697" = "Frère Jacques";
"Lf5854d682c" = "Флейта";
"Lf592a06d42" = "Хамер-он";
"Lf5a5c874a5" = "Угору акордом D: відкрита D двічі, E, F дієз на ладу 4, D, F дієз, A, потім D на струні 2.";
"Lf5b24d3f1d" = "Другий: F бекар";
"Lf5b69acd24" = "Заспівайте чи зіграйте до, ре, мі в C мажорі: C, D, E.";
"Lf5cc23e145" = "Доля — рівний пульс";
"Lf5d185261c" = "З відкритою струною G";
"Lf5d6251948" = "G четвертим пальцем, відкрита G, потім знову G четвертим пальцем. Слухайте резонанс.";
"Lf5de276f3e" = "Лоуелл Мейсон аранжував цю мелодію в 1839 році, запозичивши фрази з «Месії» Генделя. Вона починається гамою G мажор, прямо вниз від G до G.";
"Lf5e69b5b0c" = "Квінта";
"Lf5ec0ca28b" = "Тепер струна A. Переведіть усю руку на її рівень і повільно ведіть смичок.";
"Lf5f237d3de" = "Такт 3";
"Lf5fe463b78" = "Готуємося до вібрато";
"Lf608c3d2a6" = "Відкриті струни";
"Lf61c307c93" = "На чому завершується друга фраза?";
"Lf631d5c0dd" = "Основи зміни позицій";
"Lf641ff8ce1" = "Перехід у A мажор";
"Lf65092abf5" = "Що робить крапка";
"Lf6586312d9" = "1, 2, 3 і 4";
"Lf658f40eba" = "«Оксамитова година» — неосоул, 74 долі за хвилину: чотири насичені септакорди спускаються кроками — Fmaj7, Em7, Dm7 і Cmaj7. Один бій на раз, потім м'які удари вгору на «і».";
"Lf665d58f2a" = "Гама підіймається нота за нотою від однієї літери до тієї самої літери октавою вище. У C мажорі лише літерні назви без знаків: C D E F G A B C.";
"Lf66662ae8c" = "Акорд — це три чи більше нот, що звучать разом. Мажорний акорд звучить світло й стійко. Мінорний — темніше. Між ними відрізняється лише середня нота.";
"Lf6677b9032" = "Різні ноти";
"Lf66bbc5b7c" = "У E";
"Lf698ed242e" = "У якому акорді потрібні всі чотири пальці?";
"Lf6b136534d" = "Трохи підняти висоту й утримати";
"Lf6b456d043" = "Тріо";
"Lf6bcc1d6e8" = "Пісенник для віолончелі";
