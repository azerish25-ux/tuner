"Ld38313cba0" = "Мажор, світлий";
"Ld3953a8b28" = "Joseph Mohr (1818), англійський текст John Freeman Young (1859)";
"Ld39907caf6" = "Він повторюється";
"Ld39b7ad826" = "Четвертна, залігована з восьмою";
"Ld39f4e3b9c" = "Де лежить долоня під час глушіння?";
"Ld3a1cbb5a3" = "Сильне клацання — доля 1. Скільки долей у кожному такті?";
"Ld3b3d0511c" = "Бугі в D";
"Ld3be936b27" = "Стівен Фостер опублікував цю пісню в 1854 році. Вона просить слухача зупинитися й подумати про тих, хто має менше; співаки й досі повертаються до неї.";
