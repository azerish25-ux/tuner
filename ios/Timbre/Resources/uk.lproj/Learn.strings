"Lae26a82c1d" = "Третій палець на E грає A. З чим можна звірити цю ноту?";
"Lae326b5f18" = "Сім літер, повторення октав і місце кожної ноти на клавіатурі.";
"Lae32dc692f" = "Увесь смичок на A";
"Lae3b25eec0" = "На першій додатковій лінійці під станом у скрипковому ключі — середнє C.";
