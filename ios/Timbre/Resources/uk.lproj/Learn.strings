"L45eb5ad9a3" = "C на ладу 1 струни 2, відкрита E двічі, D на ладу 3, знову C, потім A на ладу 2 струни 3.";
"L45ffe10705" = "Симфонія № 40";
"L460980de29" = "Високий 2";
"L4609b66e0f" = "Приглушено, потім відкрито";
"L4612c36c66" = "Початок: E E F G G F E D, по одному кроку.";
"L4618448b18" = "Мажорна пентатоніка, кантрі-хамер-они й слайди, трелі, фразування, солодке й гостре звучання в блюзі.";
"L462597718b" = "Чарльз Веслі написав слова в 1739 році. У 1856 англійський органіст поклав їх на мелодію хорового твору Фелікса Мендельсона; відтоді колядку співають саме так.";
"L4628ff6cee" = "Основні тони й квінти, як у першому акомпанементі басиста гурту: основний тон на початку акорду, квінта між ними, низько в першій позиції. Пісня лишається в A, де її грає гурт.";
"L462c1cdbea" = "Який палець грає F дієз на струні E?";
"L463616e2ed" = "Зіграйте чи заспівайте три нижні лінійки: E, G, B.";
"L4648e71e66" = "Короткий розігрів м'яко готує голос: низьке дихання, мугікання, губна трель, потім гама. Починайте із середини діапазону й не виходьте за межі комфорту.";
"L4668dbcb15" = "Вальс рахуємо по три: 1, 2, 3.";
"L46719941d8" = "Чергування великого пальця, повільно";
"L467533d05f" = "F, G, A, B♭, C: ii — G мінор, V — C.";
"L4675e96719" = "D7: баре й один палець";
"L4678a30ba2" = "Мінорна пентатоніка A";
"L4689a3fd75" = "Плавний перебір Тревіса";
"L468f49fb52" = "E♯";
"L46a172011f" = "1, 3, 4 і 5";
"L46a6cedfce" = "Серф-рок";
"L46b56dfff2" = "Побудуйте й назвіть";
"L46b851c25a" = "Повне баре F";
"L46bc29826c" = "Піднімайтеся A мінором: A на ладу 2 струни 3, C на ладу 1 струни 2, відкрита E. Потім кроками назад униз.";
"L46c4bede0a" = "«Пора бенгальських вогнів» — авторська пісня Timbre: літній гімн у C на C, G, A мінорі й F. Грайте синкопованим попбоєм, змінюючи акорд ледь раніше — на «і» після «чотири». Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L46ca2af6b2" = "Терції";
"L46caccda3a" = "Струна 2: B, C і D";
"L46d8a95826" = "На якій клавіші грають E♯?";
"L46dda40204" = "Акорди, що тяжіють далі";
"L46ee7bf077" = "Перша частина";
"L46f673a218" = "Каденція — перехід між акордами, що завершує фразу, наче розділовий знак. Від V до I — найсильніший, немов крапка. Це автентична каденція.";
"L4716f06a93" = "Септима";
"L471b82b423" = "«Лебідь» — із «Карнавалу тварин», який Camille Saint-Saëns написав у 1886 році. Це початкова фраза, спрощена й на октаву нижча.";
"L47207f2354" = "Jane Taylor (1806)";
"L4730912cd3" = "Інтерлюдія";
"L4735de3a09" = "Над накладкою грифа";
"L473cfd5bc5" = "Щипайте подушечками вказівного й середнього пальців по черзі. Великий палець спирається на звукознімач або струну 4.";
"L4748699753" = "«Базарний день» запозичує хайлайф — світлий гітарний поп Гани й Нігерії: G, B мінор, C і D, 104 долі за хвилину. Мотив підстрибує між долями, тож рухайтеся в ритм.";
"L475c7e45a4" = "Ці слова вперше з'явилися в американській дитячій книжці в 1885 році, а Джеймс Р. Мюррей дав їм цю ніжну мелодію в 1887. Вона гойдається на три, наче колиска.";
"L476514910a" = "Половинна нота звучить дві долі. Щипніть один раз, рахуйте «раз, два» й дайте їй звучати до наступної ноти.";
"L476dec716c" = "Мелодія в ритмі бам-ді-ті";
"L479d0e21fb" = "Який це рядок?";
"L479edb151f" = "Тричі, щоразу трохи вище, перш ніж Christ the Lord поверне мелодію додому.";
"L47afa0eef5" = "Завершення на A замість D залишає мелодію в очікуванні, тож вона відразу переходить до наступного кола.";
"L47bd381a43" = "На які долі припадає чоп?";
"L47cc289fbf" = "Можна заглушити, послабивши тиск";
"L47ccb8f6fc" = "Щоб відтворити висоту, послухайте ноту, знову уявіть її, а тоді заспівайте чи зіграйте. Timbre покаже, чи вище ви, чи нижче. Плавно змінюйте висоту, доки не влучите.";
"L47ceec419a" = "Улюблені концертні твори";
"L47cef636b2" = "На G";
"L47d5277660" = "Світлий бік кварталу";
"L47dd6589a9" = "Від притиснутого основного тону";
"L47f06bcc13" = "З D на A, p-i-m-a";
"L47f68cf5d8" = "Зіграйте чи заспівайте G, A, B, C. Абетка повертається від G до A.";
