"Ld2531a9536" = "Щоб новий акорд звучав на першу долю";
"Ld25d5e886c" = "Третя";
"Ld267b1d797" = "П’ять відкритих аплікатур стають п’ятьма позиціями для G, а акорди лишаються поруч із рукою.";
"Ld26b5595e3" = "Парний щипок";
"Ld27c50fbca" = "Каніфоль дарує звук";
"Ld27fb015ab" = "П'ятинотні рисунки";
"Ld2813c6484" = "При переході з G на ладах 4, 3, 3 до E мінору на 4, 5, 3 які ноти лишаються?";
"Ld282f8d728" = "Від A до B пропускаємо одну клавішу — A♯.";
"Ld2858a02d4" = "Два тони";
"Ld288499adb" = "Лишається притиснутим";
"Ld29d052e78" = "Пара 1: відкрита, лад 2, лад 3, лад 5.";
"Ld2cb16553f" = "Високий 2 і низький 2 разом";
"Ld2d4de9287" = "В останніх двох тактах. Він веде слух назад до такту 1 на наступне коло.";
"Ld2deb82291" = "Один палець, шість струн";
"Ld2e697126e" = "Гімн подяки";
"Ld2f5301214" = "Зіграйте чи заспівайте зменшений тризвук від B: B, D, F.";
