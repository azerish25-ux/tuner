"Ldc63f40eb1" = "Пара 1, E";
"Ldc663b9265" = "Яка інша назва G♯?";
"Ldc86a7b5a8" = "Вказівний і середній на E";
"Ldc89e2afc4" = "A мінор, F, G7 і G: разом із C ці акорди лежать в основі безлічі пісень.";
"Ldc9cbe6ff2" = "Народний спіричуел (надруковано 1918)";
"Ldc9dc1e8d9" = "Третій палець, на тон вище за перший. Це F дієз.";
"Ldca75cfcda" = "Випробування: мелодії";
"Ldcc8159602" = "Унісон, октава, квінта й кварта: угору, униз і разом. Якщо вагаєтеся, наспівайте відповідну мелодію.";
