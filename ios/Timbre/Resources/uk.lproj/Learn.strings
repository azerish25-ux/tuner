"L88e5ba0589" = "B на струні 3 та G на струні 1 лишаються на місці. Рухається лише струна 2: з D вгору до E.";
"L88f22a4d50" = "Пара 2, від ладу 2 до 4";
"L88f6d3c736" = "Випробування: виразне соло";
"L89070c4cff" = "F дієз мінор із баре аплікатурою E — це…";
"L89114f6aca" = "p — великий, i — вказівний, m — середній, a — безіменний. Мізинець зазвичай відпочиває.";
"L8915b6cd7b" = "Чи звучить ця фраза завершено?";
"L89163da1ab" = "Тема кружляє навколо A: B, A, G дієз, A. Кожне коло — чотири шістнадцяті. Потім вона піднімається на ступінь і знову кружляє.";
"L891f76c681" = "Стандарти й класика";
"L893275da51" = "Мерехти, маленька зірко";
"L893afa2d3b" = "Струни 6 і 5";
"L894a2efb3d" = "«Frère Jacques» починається з великої секунди — тону вгору. «До Елізи» починається коливанням униз і вгору на малу секунду — півтон. Малі розміри, велика різниця.";
"L894f2e4a3d" = "Як відчувається пульс?";
"L8955dbcbc9" = "Синкопований попбій";
"L89579d8d62" = "Пальці на грифі легко торкаються струн";
"L895d5a3f5c" = "Які струни грає парний щипок?";
"L89610cf27c" = "G третім пальцем на струні D на октаву вище за відкриту струну G. Коли вона звучить чисто, струна G резонує разом із нею.";
"L89677615c2" = "Весна";
"L896fb3bcac" = "Відкрита пара A, пара 3 лад 4, відкрита D, потім знову лад 4.";
"L89738fc6cf" = "Ритмічні малюнки й септакорди";
"L898398980e" = "На одному диханні звук наростає від тихого до гучнішого й повертається назад. Почніть тихо, м'яко посильте, потім стиште — усе на тій самій висоті.";
"L898916792b" = "Рахуйте від C: C — перший, D — другий ступінь. Септакорд на D — малий мінорний септакорд D.";
"L898eafaa29" = "Перша частина";
"L899658e27a" = "Темп";
"L89a58f7e0a" = "Рахуємо струни";
"L89c21ba2e6" = "O Tannenbaum, o Tannenbaum: відкрита D, три відкриті G, потім A на ладу 2 й три відкриті B.";
"L89c69af538" = "Відома мелодія Бетховена";
"L89ccbe333e" = "Половинна нота з крапкою";
"L89cf0e67dc" = "D на ладу 3 струни 2, F на ладу 1 струни 1 двічі, G на ладу 3, F двічі, відкрита E, потім F.";
"L89d0f84fcb" = "E, потім G. Почуйте кожну в уяві, перш ніж співати.";
"L89d192dbc9" = "Гама C мажор угору.";
"L89d397a6a6" = "Високо й низько";
"L89d6e067f8" = "Оберіть найближче до руки обернення — і послідовність майже не потребуватиме руху. G, E мінор, C і D розташовані між ладами 2 і 5.";
"L89dfe418c4" = "Коли друга нота вища, мелодія рухається вгору. Коли нижча — униз. Слухаючи, показуйте рукою напрямок у повітрі.";
"L89e03eb68c" = "Струна 4";
"L89e4852745" = "Три ноти й стрибок";
"L89f08530c1" = "Додайте септиму";
"L89fe6b3227" = "Цей менует є в зошиті 1725 року, який Бах подарував дружині Анні Магдалені. Нині дослідники вважають автором його колегу-композитора Крістіана Петцольда.";
"L8a117afb1e" = "Інтервали для співу";
"L8a14547552" = "Тепер струна D. Трохи підніміть лікоть і повільно ведіть смичок.";
"L8a14698dc1" = "Коли ви граєте бій, мелодія звучить у вас у голові або в голосі друга. Змінюйте акорди там, де мелодія цього потребує, і зберігайте рівний бій.";
"L8a15878ca1" = "Скільки восьмих уміщується в одну долю?";
"L8a28d3c1df" = "Вказівний, середній, і знову";
"L8a349e018e" = "Ви відбивали цей рисунок із паузою в розділі 3. Що змінює крапка?";
"L8a34b9883c" = "1 і 5";
"L8a40d2b8dc" = "Додайте рухи лівої руки й перебори правої, що надають мелодії блюграсового звучання.";
"L8a52ed17c5" = "Мажорний";
"L8a5e6d018b" = "Cmaj7";
"L8a5e8d0566" = "3/4 рахуємо раз, два, три, з наголосом на раз: це вальс.";
"L8a6060c461" = "Відкрита E, D на ладу 3 струни 2, C дієз на ладу 2, відкрита B, потім A на ладу 2 струни 3.";
"L8a71a33747" = "Починайте з основного тону";
"L8a8683d90c" = "Обидві ноти — D. Кожна струна налаштована за ладом 5 сусідньої нижчої за звучанням струни.";
"L8a8b9cc525" = "Соль до ре";
"L8a8c729180" = "До, мі та соль";
"L8a90df9c3e" = "Та сама нота, новий початок";
"L8a9d0a0308" = "Яка нота триває цілий такт 4/4?";
"L8aa2514408" = "Пісня тореадора";
"L8ab2f23db2" = "Табулатура має шість ліній — по одній на струну, зі струною 1 вгорі. Число на лінії — це лад, який треба затиснути. 0 означає відкриту струну.";
"L8aceef3430" = "Так, з різницею в октаву";
"L8ae6e236df" = "Октава стрибає від до до наступного до, на вісім нот гами вгору. Обидві ноти мають одну назву й так добре зливаються, що майже звучать як одна.";
"L8afae1aebf" = "Реджинальд Гебер написав ці слова, надруковані в 1826 році, а Джон Бакхус Дайкс — мелодію в 1861. Перший рядок піднімається нотами акорду G мажор.";
"L8b242ab2a9" = "Дві поспіль";
"L8b259aba31" = "Фанковий вамп";
"L8b33eb04a4" = "Мелодії в G повертаються додому, до G — тут це відкрита третя струна.";
"L8b33fe392c" = "Фолліотт Пірпойнт написав ці слова в 1864 році весняного дня в англійській сільській місцевості. Їх співають на німецьку мелодію «Dix» 1838 року.";
"L8b370ad96d" = "Понизьте терцію";
"L8b3ccea2a5" = "До, мі, соль";
"L8b3fd24a46" = "G B♭ D F";
"L8b50cfb9a8" = "Та сама літерна назва?";
"L8b52fe3ce3" = "Струна 1";
"L8b540851de" = "«Стробоскоп у сповільненні» — синті-поп, 118 долей за хвилину: F дієз мінор, D, A та E. Бій випереджає долю: два удари припадають на «і» безпосередньо перед нею.";
"L8b5cbd551a" = "Прямий перебір іде в одному напрямку: великий, вказівний, середній, знову й знову. Вісім нот — це двічі великий, вказівний, середній, потім великий, вказівний.";
"L8b6b5db4e6" = "Перевірка другого пальця";
"L8b6c78e799" = "A дієз на ладу 3 струни 3 на півтон нижче відкритої B й одразу тяжіє назад до неї.";
"L8b6ce4e1f8" = "Рахувати подумки";
"L8b83737b47" = "Усі чотири пальці";
"L8b95df9b3c" = "Перенесіть ті самі два пальці на струни 4 і 3. З відкритою струною 5 це A5. Грайте боєм лише по струнах 5, 4 і 3.";
"L8ba11c58da" = "Головне — короткий звук";
"L8ba2a07385" = "6/8";
"L8bbca3e54a" = "Нота з крапкою й швидка нота додають маршу пружності: довга, потім коротка. У першому такті друга D довга, а E вступає перед другою долею.";
"L8be1dd6d7f" = "Обидві водночас";
"L8be2f0040b" = "Переходячи на іншу пару, не переривайте руху вниз-угору. Передпліччя переносить руку між парами, а зап'ясток тримає пульс.";
"L8bf51bccc9" = "Рахуйте 1 і 2 і";
"L8bffd0e29a" = "Який тризвук будується від D лише з нот C мажору?";
"L8c00bae676" = "B7 — на п’ятій літері від E. П’ята літера від A — це E, тож його місце займає E7.";
"L8c1a14f104" = "Інтервал — відстань між двома нотами. Пропустіть один ступінь гами — отримаєте терцію, як від до до мі. Почуйте мі в уяві, перш ніж залишити до.";
"L8c1ce802ec" = "Аранжування визначає, що й коли ви граєте. Ваше: вступ перебором Тревіса, мелодія куплету, приспів боєм «бум-чик», на завершення — мелодія приспіву.";
"L8c21826a55" = "Зберігає стрій струн";
"L8c2a569978" = "По одному такту: A мінор, F, C, G, потім A мінор, F, E, A мінор. Великий палець знаходить кожен новий основний тон: струни 5, 4, 5 і 6.";
"L8c44f7422f" = "У 3/4 кожен такт містить три четвертні долі. Рахуйте 1, 2, 3, наголошуючи 1. Це погойдування вальсу.";
"L8c49b6c18f" = "Акцент — це нота, зіграна трохи голосніше. На першу долю вдаряйте сильніше, ніж на інші. Так усі чують початок такту.";
"L8c57590db7" = "Менует — танець на три. Більшість тактів починаються з довгої долі, потім швидкі пари: раз, два-і, три-і.";
"L8c78b4d5a4" = "Тихо заспівайте E й підлаштуйте висоту до точної.";
"L8c79b32d43" = "Нова тональність";
"L8c811628a6" = "Великий палець рухається першим";
"L8c93362841" = "Зіграйте чи заспівайте C, D, E, піднімаючись абеткою.";
"L8c9559afca" = "Лад 2 на струні 3 — D. Лад 1 на струні 2 — F. Лад 3 на струні 2 — G, та сама нота, що й відкрита струна 4.";
"L8c9613039b" = "На повне баре потрібні тижні, тож рухайтеся поступово. Малий F ви вже знаєте. Далі — F на п’яти струнах, потім повне баре.";
"L8c9f842731" = "Що зазвичай містить приспів?";
"L8cabfc1895" = "F дієз, E, D, E, потім F дієз тричі.";
"L8cb072ae2f" = "Пронумеруйте ноти";
"L8cb30bcd93" = "A в четвертій позиції на струні D, потім відкрита A. Доможіться збігу.";
"L8cd463cd5c" = "1, 4 і 7";
"L8cdc88457d" = "Долю 2 заліговано з долею 3. Що робити на 3?";
"L8ce955eb20" = "Томас Мур поклав ці слова на старовинну ірландську мелодію й надрукував їх у 1813 році. Згодом Мендельсон написав на неї фантазію, а Флотов увів її до опери «Марта».";
"L8cef689ea3" = "Повне аранжування акордової мелодії";
"L8d02931319" = "Недотягнутий бенд звучить фальшиво. Підтягуйте, доки звук не збігатиметься з почутою ціллю.";
"L8d167a9434" = "Другий такт двічі";
"L8d374f6e5e" = "Заспівати кінець голосніше";
"L8d3e7efd0a" = "Другий палець";
"L8d4acd4307" = "Підніміть палець 2 зі струни 1, щоб отримати Dsus2. Для Asus4 зіграйте A й додайте мізинець на струну 2, лад 3.";
"L8d6cc94f22" = "Holy, Holy, Holy";
"L8d6ce15313" = "У якій мажорній тональності два дієзи?";
"L8d71201dce" = "Три малюнки, п'ять акордів";
"L8d7832013f" = "Без переходу на іншу струну, тепліший звук";
"L8d8d13f6af" = "Тепер найтоншу — струну 1.";
"L8da12619dc" = "Чотири пісні суспільного надбання з мелодією й акордами.";
"L8db1314ed2" = "Хамер-он і перебір";
"L8dbf6541b6" = "Більшість пісні тримається на G. D7 приходить наприкінці другого рядка, C забарвлює четвертий. Змінюйте акорд на слові, що починає такт.";
"L8dd449787d" = "Струна G";
"L8dd8c19ce6" = "Відкрита E";
"L8dd93106de" = "До каподастра: щипніть відкриті струни 1 і 2. Це E та B.";
"L8ddf603daf" = "Бас підказує слуху, який акорд звучить. Основний тон на першу долю робить зміну виразною.";
"L8de501a36e" = "Утримуйте першу ноту в уяві, поки звучить друга. Тоді порівняйте їх, наче дві висоти поруч.";
"L8de764a4cd" = "i, m, a: вказівний на струні 3, середній на 2, безіменний на 1.";
"L8deaa20015" = "Timbre";
"L8df5dae6c0" = "Дуже гучна нота";
"L8df938dc5d" = "Який рисунок ви почули?";
"L8e0159dfcd" = "«Пора гамаків» — легке регі в C, 76 долей за хвилину. Гітара грає лише на другу й четверту долі: один короткий, яскравий удар угору по верхніх струнах, потім тиша.";
"L8e036dd4bf" = "Інші розміри";
"L8e081d8487" = "Пізній виїзд";
"L8e0d30c372" = "Третя фраза, soft the drowsy hours, піднімається до C, D та E. Решта три фрази мають одну мелодію.";
"L8e0fa6714e" = "Розминка: звірте четвертий палець із відкритими струнами, A, потім E.";
"L8e12c51b85" = "Почніть із D";
"L8e1f78c027" = "Септакорд додає ноту, що тягне до тоніки. D7 прагне перейти в G. Пальці: 2 на струні 3, лад 2; 1 на струні 2, лад 1; 3 на струні 1, лад 2.";
"L8e215e734a" = "Перенесіть у D та E";
"L8e244d0df6" = "Половинна нота триває дві долі. Ведіть смичок довше й повільніше, щоб звук не згасав на другій долі.";
"L8e26078967" = "Крок, крок, тримайте";
"L8e3537ea13" = "Пунктирні звороти";
"L8e372c61b9" = "Бам, першу";
"L8e449bf03d" = "Мажорний чи мінорний?";
"L8e472761e0" = "E, на півтон угору до F і назад.";
"L8e48bd58a1" = "C, F, G7, C";
"L8e531fc324" = "Четвертні й пари";
"L8e58c29cec" = "Випробування: сольна гра";
"L8e5dc125b0" = "Чотири ритми, одна рука";
"L8e63782e93" = "Кожному пальцю належить півтон. Тримаючи всі чотири на своїх місцях, ви щоразу влучатимете в ту саму ноту.";
"L8e6a7ff4c1" = "Тримайте G більшість рядка, C на crib for a bed, D7 для повернення додому. На три бийте вниз на раз і легко на два й три.";
"L8e6d99d6d5" = "Починає ту саму мелодію пізніше";
"L8e6f9b89fa" = "Дві ноти на одну долю";
"L8e725a02c0" = "Тричі";
"L8e79e5f76b" = "Панк і рок на квінтакордах";
"L8e89a50f83" = "Вступ: перебір Тревіса на G і D7";
"L8e8a426d30" = "Над кінцем накладки грифа";
"L8eb002c098" = "Чвертні на A";
"L8ebf8adb53" = "Знову марш";
"L8ec6b597c8" = "Зіграйте струну 1 на ладі 2, потім зробіть пул-оф до відкритої.";
"L8ee74d56ef" = "Почніть той самий цикл із vi — отримаєте vi–IV–I–V: A мінор, F, C, G. Акорди ті самі, але початок із мінору робить звучання серйознішим.";
"L8ef1b53787" = "Основний тон, квінта, октава й назад до квінти. На A: відкрита струна 3, лад 2 струни 2, лад 2 струни 1. Підходить до будь-якого мажорного чи мінорного акорду.";
"L8f0d715970" = "Пропустіть ступінь: терція";
"L8f17a64c02" = "Струна 3: затисніть лад 5 пальцем 1 і щипніть, потім зробіть хамер-он пальцем 3 на лад 7.";
"L8f23fdd1d8" = "Випробування: програма для сцени";
"L8f320d87c0" = "Шість відомих мелодій по одній ноті на верхніх струнах. Повільні темпи, великі успіхи.";
"L8f339f02c0" = "Вихід тореадорів";
"L8f577a55a2" = "Народна (надруковано 1917)";
"L8f62ed5e67" = "Різні розміри впереміш";
"L8f89b8e0dc" = "Слова Веслі, мелодія Мендельсона";
"L8f8a2a2d84" = "Акорди спускаються F, E, D. Де завершується цикл?";
"L8f8abdbe72" = "Довгі ноти вгору";
"L8f921f64e0" = "D F A: мала терція, потім велика.";
"L8fb29d802d" = "Заповнюйте простір нотами акорду під довгою нотою. На G: G, B і D. На D7: D, F дієз, A і C. Вони не суперечитимуть звучанню гурту.";
"L8fc0138f5f" = "Джазовий рисунок на райді";
"L8fc16896c6" = "F і G";
"L8fd60484f5" = "У D мажорі два дієзи: F дієз і C дієз. Обидві ноти грають високим 2.";
