"L913345befa" = "G мажор у дві октави";
"L9138eef56a" = "E, G і B";
"L913cf6027b" = "Нехай вага руки притискає баре, наче ви м’яко тягнете гриф до себе. Великий палець лише стабілізує. Поверніть палець 1 на бік.";
"L91421d0780" = "Старовинна англійська балада";
"L914bfe3e36" = "Октава";
"L914f41e96b" = "«О, Сюзанно» у повному темпі";
"L9150ad10a0" = "Двічі зіграйте фразу однаково, потім змініть лише її завершення. Слухачі впізнають повтор і прислухаються до нового повороту.";
"L915a836cf9" = "Довго, коротко-коротко";
"L91625829f3" = "Великий, вказівний, великий, середній: великий грає кожну другу ноту, звідси й назва перебору.";
"L916747f4b1" = "Простіший B мінор";
"L916a78d701" = "Перший палець";
"L917c4a8a76" = "Четвертні ноти й довші";
"L9196742b09" = "Повний D7, якщо бажаєте";
"L91967d6e76" = "Вібрато змушує ноти співати";
"L919980cb85" = "Який палець грає B на струні A?";
"L919c5a30be" = "Малі зміни найшвидше знаходять ноту. М'яко підніміть висоту й дайте їй усталитися.";
"L919dcdc979" = "При переході з G на C на ладу 3 палець 1 лишається на баре. Змінюються лише пальці далі по грифу. Це найплавніша зміна акордів з баре.";
"L91a9491bcd" = "Випробування: десять акордів";
"L91d307deab" = "D, E, F дієз, G: відкрита, 1, 3, 4.";
"L91d585db22" = "E D C B";
"L91f10a30af" = "Сядьте рівно, ближче до краю";
"L91f6624ab0" = "Em: сходинки";
"L91f8ed6b40" = "Глушіння — половина гри на бас-гітарі. Легко торкніться струни пальцем, щоб вона замовкла.";
"L92012f8afc" = "«Радість світу» в аранжуванні Лоуелла Мейсона 1839 року починається гамою G мажор прямо з верхньої ноти вниз. Усі ноти вам уже знайомі.";
"L9204183bf9" = "C, E і G";
"L920df29d22" = "Три пальці в ряд";
"L920f253fe7" = "Відкритий C, піднятий на сім ладів, — це G. Палець 1 лежить на струнах 3, 2 і 1 на ладу 7, палець 2 — на струні 2, ладу 8, а пальці 3 і 4 тягнуться до струн 4 і 5.";
"L9216734f89" = "Одна нота, два місця";
"L921bfa2279" = "Верхні ноти тут — G, G, G, F дієз: майже нерухомі, поки під ними змінюються акорди. Ноту, що є у двох акордах, називають спільним тоном. Саме тому тризвуки звучать так плавно.";
"L9222e335ff" = "Тепер затисніть каподастр перед ладовим поріжком 2 й щипніть знову: F дієз та C дієз.";
"L9225771ef7" = "Ця мелодія — з Дев’ятої симфонії Бетховена. У ній є C, D, E, F і G, і вона рухається переважно на один ступінь за раз.";
"L9250446614" = "«Мерехти, маленька зірко», трохи швидше";
"L92535cab95" = "Від G C E A до нових тональностей, пальцевої гри й концертної програми";
"L9260bce5a2" = "Едвард Гріг написав «Ранок» у 1875 році для п'єси «Пер Ґюнт». Флейта грає тему, гобой відповідає, а музика піднімається, наче сонце.";
"L9279caa296" = "Saint-Saëns, 1886";
"L927fb0237c" = "Тремоло на повільній мелодії";
"L9280fd4c84" = "Бам — окрема нота, ді — удар по струнах, ті — великий палець на п'ятій струні.";
"L928ff94fbb" = "Баре й великі фінали";
"L929175316b" = "Гама в D мажорі";
"L9295de93d1" = "Лад 5 або відкрита струна";
"L929634bca2" = "Лади мандоліни близькі, тому кожен палець охоплює два. Перший грає лади 1 і 2, другий — 3 і 4, третій — 5 і 6, мізинець — 7.";
"L92c11c2622" = "Якою нотою завершується мелодія?";
"L92c629aecd" = "На парі E лад 2 — F♯, лад 3 — G, лад 5 — A. Перший, другий і третій пальці, як і раніше.";
"L92d2225f42" = "Пауза наприкінці";
"L92d40794f5" = "D7";
"L92dad30792" = "Ті";
"L92f0fedac4" = "G, B і D — звуки акорду G. Тому цей стрій називають відкритим G.";
"L92f74658a6" = "Дві восьмі ноти";
"L93063dfd83" = "Яка формула мажорної гами? (W = тон, H = півтон)";
"L9323296883" = "C на ладах 9, 8 і 8";
"L93296e7508" = "Ця мелодія почалася як спіричуел. У 1890-х залізничники Середнього Заходу дали їй нові слова, а Карл Сендберг надрукував її в 1927 році. Вона піднімається від низької B до D на струні 2.";
"L932eaaf5a3" = "IV";
"L9339e8e2bf" = "Послідовність ii–V–I по колу";
"L93426e061a" = "Слухайте верхній голос";
"L93454789e3" = "Мінорна балада";
"L934bc345a0" = "Рівно чи зі свінгом";
"L93538583d4" = "«Каньйон відлуння» грає E мінор, C, G і D у темпі 80 долей за хвилину. Сильний бій на раз, дайте звучати, потім нарощуйте на три й чотири. Удвічі повільніше відчуття пульсу додає розмаху.";
"L935817d90a" = "Ця народна мелодія була надрукована не пізніше 1896 року. Кожен рядок закінчується довгою нотою: відлічіть її тривалість перед наступним.";
"L937007d20f" = "Кроки й стрибки";
"L937448906f" = "Чотири долі";
"L937f7ac180" = "Три акорди, безліч пісень";
"L938495b6b3" = "Проведіть палець крізь струну";
"L939941777a" = "Сильніше торкатися на кожній долі";
"L93a54e0bca" = "Машинки для малих змін";
"L93ad46cbed" = "Балада в A мінорі";
"L93afab8c9e" = "На скільки рахуємо мелодію «Юпітер»?";
"L93b54ad89d" = "Основний тон — це нота, за якою названо акорд. В A мінорі це відкрита струна 5, тож починайте бій з неї, пропускаючи струну 6.";
"L93cfd1277b" = "Які струни зазвичай грає великий палець?";
