"Ld084d0d618" = "Якою нотою закінчується пісня?";
"Ld088f7c609" = "Основний тон, терція, квінта: від C пропустіть літеру до E, потім ще одну до G.";
"Ld0891d01e4" = "Інді-фолковий вальс";
"Ld0955e7e58" = "A на струні 3, F дієз на ладу 4 струни 4, D на ладу 3 струни 2, A, потім F дієз на ладу 2 струни 1, E й D.";
"Ld0a60a1202" = "Gm: три пальці";
"Ld0a7102e60" = "Крокуємо вгору по акорду";
