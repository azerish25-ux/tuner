"Lfeddc76ee1" = "У віолончелістів кожен палець має свій півтон, тож F грають другим, F дієз — третім. Нота за межами кисті, як F дієз на струні C, потребує розширення позиції — ширшого розташування пальців. У цьому курсі обрано тональності без нього.";
"Lfee05773f7" = "Приглушені удари між акцентами";
"Lfee96c0c90" = "Відпочити й пити воду ковтками";
"Lfee9d6b463" = "Для C поставте третій палець на лад 3 струни 1. Інші три струни звучать відкритими.";
"Lff2a2c32e4" = "Фолк із гітарним боєм";
"Lff3d0e2a51" = "Яка струна коротка?";
"Lff43cc465c" = "Нота, зіграна сильніше";
"Lff445f2a2f" = "Ця версія в D, у першій позиції: по пальцю на півтон, починаючи на тон вище відкритої струни; схема акордів — для тих, хто акомпанує вам.";
"Lff52112f8f" = "Скільки шістнадцятих дорівнюють одній четвертній ноті?";
"Lff6d87bddf" = "Скільки дієзів у G мажорі?";
"Lff702e55c4" = "Високий 2 на струні A";
"Lff7f54768d" = "Основний тон на струні 5 — яка це аплікатура?";
"Lff90290e24" = "Від D до A на одній струні";
"Lff90719bf6" = "Відпочинок допомагає втомленому голосу відновитися. Якщо захриплість триває кілька тижнів, зверніться до лікаря.";
"Lffb94aa78b" = "Кожен палець щипає вгору й трохи до долоні, а потім розслабляється. Тримайте кисть нерухомо над струнами — рухаються лише пальці.";
"Lffdd26c5bf" = "Лишайте простір";
"Lffdfb29a52" = "Два півтони";
"Lfffa9baa62" = "На які долі припадають приглушені удари?";
"Lfffcb19506" = "«Клементина» починається з двох швидких нот перед першою долею. Як вони називаються?";
