"Ld9d98cb22c" = "C мажор угору й униз";
"Ld9ef5c4391" = "Палець на кожну струну, перебори, чергування великого пальця й мелодія всередині акордів.";
"Lda0b0858b4" = "Поєднуємо все";
"Lda2cf5473d" = "Від до до соль — п'ять нот гами, квінта. Вона звучить просторо й міцно. Уявіть проміжні ступені, а потім стрибніть просто до соль.";
"Lda2fddd676" = "The water is wide, I cannot get o'er: угору від відкритої D до B, потім м'яко назад униз до D.";
"Lda4b3775a3" = "Від D вгору до A — квінта: D, E, F, G, A.";
"Lda4f2c3958" = "E мінор, струна за струною";
"Lda5241c1fb" = "Дієз (♯) підвищує ноту на півтон. Бемоль (♭) знижує її на півтон. Чорна клавіша безпосередньо над C — це C♯; безпосередньо під D — D♭.";
"Lda53d2cd50" = "Коли припадають удари вгору?";
"Lda5724cf7a" = "Рахуйте кожен такт уголос: 1, 2, 3, 4. Доля 1, сильна доля, зазвичай відчувається найсильніше. Трохи підкреслюйте її.";
"Lda591e9132" = "Широкі стрибки, малі кроки й півтони, високо й низько — усе впереміш. Перед кожним прикладом зробіть вдих.";
"Lda6100e227" = "bpm — долі за хвилину, тож 90 bpm — півтори долі щосекунди.";
"Lda64346e33" = "G7 — це G зі струною 1 на ладу 1 замість ладу 3: пальці 3 і 2 на струнах 6 і 5, палець 1 на струні 1. Він сильно тяжіє до C.";
"Lda76f722d3" = "Від відкритої до ладу 2";
"Lda7fb19df0" = "Від C вгору до A — це…";
"Ldaa773898e" = "Від C до E пропускаємо D, тож охоплюємо три ноти гами — терцію.";
"Ldaa89c854f" = "Великий фінал";
"Ldac20b899b" = "«Легко веслуй», тихо, потім гучно";
"Ldadf85cff2" = "D7 веде до G, а G7 — додому, до C. Кожен акорд готує наступний.";
"Ldae5d94e06" = "Основний тон і квінта під акорди";
"Ldaec340ac2" = "Скільки півтонів від C вгору до E?";
"Ldaeebaf4ab" = "Чотири акорди, безліч пісень";
"Ldb1265c2e8" = "Зміна фактури";
"Ldb1b147f2b" = "Перша восьма подовжується, а «і» настає пізніше.";
"Ldb1bb06d86" = "Який лад на струні 3 збігається з відкритою струною 2?";
"Ldb226d64ae" = "Де доречні вставки?";
"Ldb332603d2" = "Поєднавши їх, піднімаємося станом: E, F, G, A, B, C, D, E, F — лінійка, проміжок, лінійка, проміжок, аж до верху.";
"Ldb38d7b8f2" = "Рухається вгору, не торкаючись струн";
"Ldb4211a03a" = "У Мері було ягнятко";
"Ldb4a6bf41c" = "Nicaea (Holy, Holy, Holy), 1861";
"Ldb4feecf84" = "Поєднайте половини: A, B, C дієз, D на струні A, потім E, F дієз, G дієз, A на струні E. Вісім нот, від A до A, одна аплікатура двічі.";
