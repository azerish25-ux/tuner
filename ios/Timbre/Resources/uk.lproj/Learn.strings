"L9023afb03a" = "Валлійська колискова, човнярська пісня Гайленду й три колядки німецькою, латиною та англійською.";
"L9027ae66b4" = "Міждольові акценти — це «і» між долями. Кивайте на числах і торкайтеся лише на «і», наче короткі гітарні удари в регі.";
"L902977f90f" = "D і G";
"L9039459dc1" = "Поставте суворе запитання на ладу 5, а потім солодко відповідайте на ладу 2. Перенесіть руку на довгій ноті й завершіть обидві фрази на A.";
"L903c46b456" = "D, G, A, D";
"L905b5e6f9a" = "F на ладу 1 струни 1, відкрита E, C на ладу 1 струни 2, потім G на ладу 3 струни 1, E та C.";
"L905ea4c423" = "Початок";
"L9076d517d1" = "Відтворіть висоту";
"L9089c0361d" = "Познайомтеся з п'ятьма струнами, налаштуйте відкритий G, знайдіть бурдонну струну й зіграйте пісню.";
"L90a0efbc72" = "Посилення й затихання";
"L90c41c755e" = "Німецька народна пісня";
"L90f0a50cbb" = "Бурдонна струна";
"L90f2df58e4" = "Від 3 до 4";
"L910ddb372b" = "Розміри в півтонах";
"L91116aad75" = "На три долі грайте вниз на 1, потім униз-угору на 2 і на 3: D, DU, DU. Наголосіть 1, щоб відчувалося погойдування.";
"L91127b7945" = "Ваш інструмент не має ладів, тож кожну ноту визначає слух. Під час навчання багато хто наклеює на накладку грифа тонкі смужки-орієнтири.";
"L9114298cd0" = "Притискайте перед ладовим поріжком";
