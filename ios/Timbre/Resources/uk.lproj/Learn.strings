"Ldbc9fba181" = "Яка нота на другій лінійці у скрипковому ключі?";
"Ldbd51d60bd" = "Натиснути на підставку";
"Ldbd9022eff" = "Лад 3 струни 3 — C. Та сама аплікатура, новий основний тон.";
"Ldbdc65cb5e" = "Довга відкрита G, потім A, C, B, A й дві D на ладу 3 струни 2.";
