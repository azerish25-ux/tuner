"L9f3ade1645" = "Струна 5, лад 5, потім струна 4: лади 2, 4 і 5. Додому, на G.";
"L9f46d5de0c" = "Підніміть палець 2, щоб струну 3 тримало баре. Це аплікатура E мінору, і вона так само рухається: F дієз мінор на ладу 2, A мінор на ладу 5.";
"L9f5490044a" = "Довгі ноти потребують повільного смичка. Тримайте його близько до підставки й розподіляйте рівномірно, щоб кожна нота звучала до кінця, не згасаючи.";
"L9f65b86455" = "Анітрохи: грати далі";
"L9f68ee78ce" = "Сольмізація називає ступені";
"L9f85e2c546" = "Перший палець на ладі 2 пари 4, другий — на ладі 2 пари 1. Пари 3 і 2 звучать відкритими.";
"L9f8827d936" = "На F♯";
"L9f890fd5b6" = "Великий, вказівний, середній двічі, потім великий, вказівний. Акцент зміщується в русі, створюючи плинне звучання.";
"L9f9413d895" = "Зелені рукави";
"L9f97de9512" = "B — біла клавіша безпосередньо праворуч від групи з трьох чорних.";
"L9f9e47ab42" = "З каподастром на 2 аплікатури G, C, D і E мінору звучать як A, D, E та F дієз мінор. Ті самі пальці, нова тональність — A мажор.";
"L9fa4aab34c" = "Лише великим пальцем: штовхайте вниз струни 6, 5 і 4 по черзі.";
"L9fae0ee839" = "Прямий, під волосом";
"L9fbea6e676" = "Обидві фрази";
"L9fc93acaa4" = "Соло";
"L9fd1b5eb5f" = "Восьмі на E та A";
"L9fe53dfc73" = "Такти 11 і 12";
"La002bb134a" = "Затакт — кілька нот, що ведуть до першої сильної долі. Тут вони припадають на «і» третьої долі.";
"La006e84500" = "Тринотні акорди на верхніх струнах: мажорні й мінорні, усі обернення та послідовності з мінімальним рухом.";
"La00cba78ab" = "«Арканзаський мандрівник» починається низько, на парі G, потім стрибає до пари E, де друга частина спускається по гамі. Мелодія вже була надрукована не пізніше 1840-х років.";
"La00f1e2864" = "Хамер-они, пул-офи, слайди, бенди й вібрато та другий бокс пентатоніки.";
"La0177ef800" = "Балада автора-виконавця";
"La01f60fc50" = "Пауза — тиха доля. Торкніться струни пальцями руки на грифі, щоб тиша була чіткою, а тоді вступіть точно вчасно.";
"La0292c8e9d" = "Які ноти утворюють тризвук C мажор?";
"La042a700a4" = "«Донька доглядача» — пісня-історія в 6/8, 120 відліків за хвилину: E мінор, D, C і B7. Три куплети розповідають історію, а приспів відповідає кожному.";
"La04360e850" = "Варіація 1";
"La04af666be" = "F, G";
"La05a917a5f" = "Повільна балада в D";
"La06e04321c" = "Danny Boy";
"La0b0aee62a" = "Ця французька мелодія з XVIII століття (1700-ті роки) використовує лише вивчені ноти: D, E, F дієз, G на струні D та A і B на струні A.";
"La0b40a1232" = "Без ладів, лише слух";
"La0beba17f6" = "Великий палець — це рівна пульсація: басова нота на кожну долю з переходом між двома струнами.";
"La0c09b188e" = "Один повільний рух униз, потім угору на A. Зберігайте рівний звук до кінця.";
"La0c7b36fb9" = "F, G, A — терція, а чотири півтони роблять її великою.";
"La0c829bf20" = "Поставте C, потім підніміть перший палець зі струни 2. Два пальці лишаються на ладі 2, струнах 4 і 1, а акорд стає похмурішим: E мінор.";
"La0e88a1c69" = "B A G A B B B: відкрита струна 2, потім струна 3.";
"La1042ecdf6" = "Друга пара";
"La104946954" = "Ре мі до";
"La11c2fc10f" = "Мелодія та вставки";
"La12de8dcf6" = "На D, тоніці";
"La12debeda3" = "Домашній поп на септакордах";
"La12eefd0b6" = "Яке місце притискають і в G, і в G7?";
"La13338039b" = "4/4";
"La13d7ed90c" = "E і B";
"La15c2bceff" = "«Радість солдата» надрукували в Шотландії у XVIII столітті (1700-ті роки), і її досі грають на танцях по всій Америці. Перша частина гойдається на A, F дієзі й D — звуках акорду D мажор.";
"La16512a680" = "Знайомство: «Пил на панелі приладів»";
"La18434bfcf" = "Charles Wesley (1739), у друкованій версії 1861 року";
"La19c28f48a" = "Третій проміжок знизу — C: F, A, C.";
"La1a6cd89dd" = "Доля";
"La1a7eae4eb" = "Аплікатура E рухається";
"La1ac52704c" = "У приспівах";
"La1beb6f2c6" = "Кожна частина може дещо додати: куплет перебором, приспів боєм, потім тризвуки далі по грифу в останньому приспіві. Найпотужніший звук лишіть на кінець.";
"La1cabe7426" = "Мінор, похмуріший";
"La1cbad7ea8" = "Зберігати пульс";
"La1dba6ff02" = "Аплікатура D на ладу 5";
"La1e019b524" = "Що грає великий палець після кожного удару по струнах?";
"La1e05a8089" = "Гостро, на ладу 5";
"La1e36be585" = "В обох акордах палець стоїть на ладі 2 струни 3. Використайте його як опору.";
"La1ee77097e" = "Утримуйте G з точною висотою.";
"La1f91698f6" = "Впритул перед ладовим поріжком";
"La2104ff762" = "Верхня октава";
"La21a251129" = "Один палець, чотири струни";
"La227d18f6d" = "Шоста нота — E, а акорди на 2, 3 і 6 мінорні. Складіть E, G і B — отримаєте E мінор.";
"La22b83738d" = "Впізнаваний мотив у другій позиції";
"La241eba100" = "Пальці 1 і 2 залишаються на місці. Рухається лише палець 3: зі струни 3 на струну 5, лад 3.";
"La25d557787" = "Автор невідомий (1885); куплет 3 — John T. McFarland (1892)";
"La26afab0b8" = "D F A";
"La26dc12fc6" = "Розслаблений хват";
"La27c40b980" = "Початковий акорд";
"La2876d30d9" = "Від 2 до 3";
"La29acbee78" = "Перші чотири такти";
"La29e2b8c73" = "Такти 5 і 6";
"La2b90adbdc" = "C — найтовща й найнижча струна. Струни рахують від A (1) до C (4).";
"La2ed87c794" = "Ця версія в E мінорі. Четверта струна налаштована високо, тож мелодія лишається на струнах від 1 до 3, а всі акорди на схемі мають аплікатури для укулеле.";
"La30989d36d" = "На ладу 12 коло починається знову";
"La32484a6d1" = "Соль мі до ре";
"La32de66618" = "Основа джазу";
"La32fddb34b" = "Рифовий рок";
"La33decf93a" = "Знайомство зі скрипкою";
"La34ad451bf" = "Світлий і темний звук";
"La34b9a7a05" = "Мажорна гама вгору й униз";
"La34ef3df9b" = "Притиснута чи відкрита";
"La35051bafe" = "Мерехти, маленька зірко";
"La35c94dde9" = "Ті самі чотири акорди є й вище: G на ладах 7, 8 і 7, E мінор на 9, 8 і 7, C на 9, 8 і 8 та D на 7, 7 і 5.";
"La35e6254c0" = "Яким пальцем грають ноти F дієз?";
"La36a6718f5" = "G";
"La3863173e9" = "Крокуйте нотами акорду";
"La3880c6876" = "Довго-коротко, довго-коротко";
"La389d618e8" = "«Старий Джо Кларк» у A, але в другій частині має G. Ця знижена нота — її характерна риса.";
"La38c28b546" = "П'ять струн, відкритий G: перебори, давні мелодії та клоухаммер";
"La38c9fb8e2" = "Та сама літера, але вище";
"La396146923" = "«Ода до радості» на октаву вище";
"La39f9d505a" = "Униз, угору й тремоло";
"La3a8eaa762" = "У цій мелодії на кожну долю дві ноти. Як їх рахувати?";
"La3ab92391c" = "Шістнадцяті";
"La3b8418154" = "Великий палець обхоплює гриф згори";
"La3bc24f6cb" = "Стрій відкритий G";
"La3c433fca2" = "Куплети мають одну мелодію: A, A. Бридж приносить нові акорди й мелодію, B, а потім куплет повертається.";
"La3c51a6d36" = "Де стоїть другий палець на струнах A та E в A мажорі?";
"La3e60ce6a4" = "На наступній лінійці вгорі";
"La3f0345a76" = "Joseph Brackett (1848)";
"La3f4c297e3" = "Готуйте зміну до першої долі";
"La3f7eb7ea9" = "Що робить рука на «і» після 1?";
"La40c51e83e" = "Блюзові акорди стоять на першому, четвертому й п’ятому ступенях тональності. У E це E7, A7 і B7. У тональності A вони стають A7, D7 і E7.";
"La40f15dda0" = "«Старий Джо Кларк» у A, тож ви граєте C♯ та G♯. У другій частині G♯ опускається до звичайної G на ладі 3 пари E. Ця одна нота надає мелодії старовинного звучання.";
"La4132ff98f" = "E бемоль на ладу 4 і D на ладу 3 струни 2, потім пальцем 4 угору до B бемоля на ладу 6 струни 1.";
"La4154244ab" = "Соль до мі соль";
"La41b644912" = "Заспівайте чи зіграйте коливання на півтон: E, D♯, E.";
"La41f1f6a6e" = "Спершу одну струну, потім іншу";
"La42bbdd946" = "A D G B E A";
"La432715d92" = "Цей народний спіричуел став джазовим стандартом. У ньому звучать C, D, E, F і G на струнах 5, 4 і 3.";
"La44a4911f1" = "O Christmas Tree";
"La44f10aed1" = "На мить послаблюйте баре під час руху, а ставши на місце, притискайте. Постійний сильний тиск втомлює руку й уповільнює зміну.";
"La46d19dee2" = "E F G";
"La47109ee9d" = "Am";
"La477fa0848" = "Тут головна — мелодія: кожну ноту щипає палець, якому належить її струна. Уся мелодія звучить на струнах 3, 2 і 1.";
"La4780ed732" = "Спочатку мотив піднімається чи спадає?";
"La496bafe40" = "«Шафл Іржавого поясу» — блюз, 80 долей за хвилину: дванадцять тактів E7, A7 і B7 боєм довго-коротко. Мелодія свінгує так само, тож підкреслюйте кожну довгу ноту.";
"La49e0f29f7" = "З A мінору на C";
"La49f08c03f" = "Нічого нового: хамер-они, пул-офи, слайди, цілі для бендів, вібрато й обидва бокси. Грайте кожну фразу чисто, потім дайте їй заспівати.";
"La4bbf4c979" = "Коли рухаємося літерами вперед — від A до B до C, ноти піднімаються. Назад — опускаються. Літери йдуть по колу, як години на годиннику.";
"La4d3530fda" = "Плагальна (IV–I)";
"La4da2f3fd4" = "Відомі теми Пахельбеля, Дворжака, Брамса, Петцольда, Гріга й Бетховена в першій позиції.";
"La4f090a431" = "Підставка — тонка дерев'яна арка, що підтримує струни. Її тримає лише тиск струн. Якщо вона нахиляється, попросіть викладача або майстра вирівняти її.";
"La4fff09395" = "Одним коротким рухом проведіть медіатор униз крізь обидві струни пари й зупиніть відразу за ними. Основа долоні легко спирається біля підставки.";
"La50440f7b6" = "C і D на струні 2, потім E, F і G на струні 1.";
"La506845314" = "Лише кінчик";
"La509c95d62" = "Що має робити рука під час зміни акордів?";
"La51fdf3080" = "«Пекарка Анджеліна», низька частина";
"La536f7740f" = "На струні 2 все так само, як на струні 1. Відкрита — це B. Лад 1 першим пальцем — C. Лад 3 третім пальцем — D.";
"La5370db024" = "Цій колядці кілька століть. Збирач пісень Сесіл Шарп почув її в містечку Котсволдсу й надрукував цю мелодію в 1911 році. Вона танцює на три.";
"La53bd3e50b" = "Аплікатури E на ладу 3 та D на ладу 5 мають спільну ноту: G на струні 4, ладу 5. Стежте за нею очима під час переходу.";
"La53df880f6" = "C, A мінор, F, G, G7, D мінор, E мінор, D, A та E7. Спершу чисті аплікатури, потім рівний бій.";
"La540c73c53" = "Ліва рука, знайомтеся з правою";
"La541bc6a00" = "Яка каденція звучить найбільш завершено?";
"La565fec46a" = "Яка нота в блюзі A найбільше нагадує домівку?";
"La581777778" = "Зіграйте чи заспівайте C, C♯, D: два півтони вгору.";
"La584c5cd66" = "Який акорд звучить стійко?";
"La585d1d107" = "Чотири пісні суспільного надбання в аранжуванні для укулеле та як вести за собою співаків.";
"La58dfbf1c7" = "Ті самі пальці, нижча струна";
"La590c15b67" = "Відкрита G тричі, униз до відкритої D, E на ладу 2 струни 4, назад до D.";
"La59da87257" = "Нічого нового: чотири пісні з відліком, без зупинок і з чітким завершенням. Зіграйте їх підряд, наче короткий концерт.";
"La5a22a1ba8" = "Дві половинні ноти заповнюють такт із чотирьох долей.";
"La5a2f6cae6" = "Чиста квінта";
"La5aca5e81d" = "Гімни розділу поспіль, від найдавнішої мелодії до найновішої. Дайте довгим нотам звучати, а акорди змінюйте на відповідному слові.";
"La5aeda8eb5" = "Нічого нового: четвертні, восьмі та фолковий бій на знайомих акордах. Рухайте рукою без зупинки й виділяйте першу долю.";
"La5b0809117" = "Який акорд у C мажорі є ii?";
"La5d1f0607d" = "Цю колядку рахуємо на два. У першому такті G займає першу долю, F дієз — більшість другої, а E з'являється наприкінці.";
"La5e2dd71de" = "Цей гімн рухається довгими нотами: половинними на дві долі й цілою на чотири наприкінці. Рахуйте кожну долю, навіть коли нота звучить.";
"La5ee2d48fb" = "Кожному ладу — свій палець: лад 1 — палець 1, лад 2 — палець 2, лад 3 — палець 3.";
"La5f49e18ed" = "Бенд до цільової ноти";
"La6191327f7" = "«Тінистий гай» у гірському мінорі з центром на A. Решта повертаються додому, до G.";
"La629b56f7b" = "A і E";
"La629e1f318" = "Пил на панелі приладів";
"La634de9a19" = "Ви постійно запізнюєтеся зі зміною. Що найкраще допоможе?";
"La6510a8eaf" = "E7 і A7";
"La65af49fcb" = "Терція чи квінта?";
"La660db2dbd" = "G, A і B";
"La668e99eaf" = "Верхня цифра тактового розміру показує кількість долей у кожному такті.";
"La673530863" = "Від Венеції до Вашингтона";
"La67c6660d1" = "Відкрита струна 2, потім струна 1 лад 2.";
"La6899881d0" = "Зупиняється й чекає";
"La69e411f56" = "Мажорна гама йде від до вгору до наступного до: вісім нот. Від мі до фа й від ті до до — півтони; решта кроків — тони.";
"La6a5e4515b" = "C розташована безпосередньо ліворуч від групи з двох чорних клавіш.";
"La6b67883e4" = "Терції, сексти й секунди — великі та малі.";
"La6b7e89948" = "A5: на сусідніх струнах";
"La6be98d6c0" = "Неосоул";
"La6c74c079a" = "Ця американська народна пісня XIX століття (1800-ті роки) рухається повільно, із широкими стрибками. Вдихайте на кожній паузі й уявляйте кожен стрибок, перш ніж співати.";
"La6cc58fc37" = "«Радість світу» в позиції";
"La6f5916eae" = "Від низької до високої: C, G, D, A. Кожна струна на п'ять назв нот вище за попередню; цей інтервал — квінта. Запам'ятайте за першими літерами англійської фрази: Cats Go Dancing Around.";
"La6f9aacf24" = "Мі ре до ті";
"La72036c5b6" = "1, 2, 4 і 5";
"La7412044b7" = "Тепер D, G та C. Налаштуйте кожну, потім зіграйте смичком і тримайте звук.";
"La7477a66af" = "Яка нота в E мінорі тяжіє вгору до E?";
"La74a040c5c" = "Лише F";
"La753f6d27f" = "Мінорна пентатоніка має п’ять нот. В A мінорі це A, C, D, E і G. Так звучать безліч блюзових і рокових соло.";
"La7556c4fe2" = "Грайте мелодію або акомпануйте акордами й співайте";
"La7590147b6" = "Мелодія для танцювальної гри";
"La75bd4a533" = "«Deck the Halls» походить від «Nos Galan», валлійської пісні на переддень Нового року з XVIII століття (1700-ті роки). Англійські слова з'явилися в 1862 році.";
"La7619a2080" = "Ті, останню";
"La78bcf5f50" = "Ліги в народній скрипковій грі";
"La79365f454" = "Легка ліва рука";
"La797e30923" = "Тема";
"La79bc75189" = "Усі шість нот від низької до високої.";
"La7a6368866" = "Чотири акорди й два перебори. Тримайте праву руку рівною, навіть коли ліва зайнята змінами.";
"La7ac4ed745" = "Четвертий палець";
"La7ad3ff674" = "Для «У Мері було ягнятко» потрібні три ноти: E, D і C, на крок одна від одної. Співайте там, де зручно: Timbre розпізнає правильну ноту в будь-якій октаві.";
"La7bfd88357" = "Скотт Джоплін опублікував «The Entertainer» у 1902 році, а фільм 1973 року знову зробив його відомим. У регтаймі мелодія тяжіє між долями, а бас тримає рівний пульс.";
"La7d4bccc07" = "«У Мері було ягнятко» грають на парі D: відкрита D, E на ладі 2 першим пальцем і F дієз на ладі 4 другим.";
"La7d8dcaf1c" = "Вітаємо, банджо";
"La7dd2f8d1e" = "Улюблена мелодія Нового Орлеана";
"La7dfc51bf0" = "Дві ноти, потужний звук";
"La8092ffd6e" = "Читання тактового розміру";
"La80d149405" = "Ця версія в A мінорі, у першій позиції: по пальцю на півтон, починаючи на тон вище відкритої струни; схема акордів — для тих, хто акомпанує вам.";
"La812dcd05d" = "Відкритий D, піднятий на п’ять ладів, — це G. Палець 1 тримає струну 4 на ладу 5, замінюючи верхній поріжок. Пальці 2, 4 і 3 будують вище трикутник D.";
"La833694ea5" = "Пул-оф переходить до нижчої ноти. Поставивши обидва пальці, щипніть вищу ноту, потім зніміть верхній палець убік, щипнувши ним струну на виході.";
"La83613e1c6" = "F, A, B, D на струнах 4 і 3.";
"La838ce8844" = "У якому розмірі зазвичай вальс?";
"La838e58546" = "C7";
"La84286cfd7" = "Основні тони й квінти, як у першому акомпанементі басиста гурту: основний тон на початку акорду, квінта між ними, низько в першій позиції. Пісня лишається в F, де її грає гурт.";
"La84916ddaf" = "Пересуньте G5 на два лади вгору. Що вийде?";
"La84b3cb0ac" = "Попгімни на чотирьох акордах";
"La84b8ec4f8" = "Перший палець на ладі 1 струни 2, другий — на ладі 2 струни 4, третій — на ладі 2 струни 1. Струни 3 і 5 звучать відкритими.";
"La85842de7b" = "ii–V–I — найпоширеніша послідовність у джазі. У C мажорі: D мінор, G, C. Кожен основний тон опускається на квінту до наступного, тож рух нагадує повернення додому.";
"La8645a16b1" = "Stephen Foster (1850)";
"La873066bef" = "Кількість ступенів інтервалу визначають за літерними назвами, рахуючи обидва кінці. Від C вгору до E рахуємо C, D, E: три літери, отже терція.";
"La87a011753" = "Ля";
"La87e2c8711" = "Обидві ноти одним рухом смичка";
"La8809e146f" = "Дві назви однієї висоти називають енгармонічними. C♯ і D♭ — одна клавіша з двома назвами. Вибір назви залежить від тональності.";
"La886c1c031" = "Почніть на лад нижче потрібної ноти й під час щипка ковзніть до неї вгору. Важлива цільова нота: прийдіть до неї точно на долю.";
"La88ea4fac6" = "Рівні восьмі ділять долю навпіл; свінгові йдуть довго-коротко. Відбийте одні, потім інші й відчуйте різницю.";
"La8a779b8fc" = "Дві цифри одна над одною на початку твору — тактовий розмір. Верхня вказує кількість долей у такті. Нижня — яка нота є однією долею: 4 означає четвертну.";
"La8b4e6bec0" = "Мала терція";
"La8b9ce1278" = "В акордовій мелодії рука на грифі тримає акорд, а ви вибираєте з нього ноти мелодії. Затисніть F — і C, F та A вже під пальцями.";
"La8bc7b3ffc" = "Пронумеруйте ноти гами C, і зможете називати акорди числами: C — I, G — V, A мінор — vi, F — IV. Ця послідовність є в безлічі пісень.";
"La8ca21349f" = "Лад 9";
"La8cf6b72f7" = "90 дотиків у кожному такті";
"La8ff6396ce" = "Рух униз веде смичок праворуч, від колодки до кінчика. Рух угору повертає його ліворуч. У нотах знак руху вниз схожий на столик, а вгору — на V.";
"La913fdc3a7" = "A4 коливається 440 разів за секунду. Як швидко коливається A5?";
"La926e162a2" = "Крокуйте вгору: C, D, E.";
"La928974510" = "Перший палець — на ладі 2 струни 3, другий — на ладі 2 струни 1, третій — на ладі 3 струни 2. Зігніть пальці дугою, щоб струна 4 звучала вільно.";
"La93782f693" = "Перехід: слайдом угору";
"La93be25bf6" = "Шекспір знав цю мелодію";
"La94782f4d7" = "Розмір маршу: 2/4";
"La94dd92fdf" = "Ля ті до ре";
"La969eae660" = "Скільки долей триває ціла нота в 4/4?";
"La9751bfa9f" = "Мала секунда 1, велика секунда 2. Мала терція 3, велика терція 4. Мала секста 8, велика секста 9. Мала септима 10, велика септима 11.";
"La97ca40468" = "1, 4, 5 і 6";
"La98b0c0ae0" = "A веде додому до D. Перехід на нього повертає всю пісню до нової тональності.";
"La9a5089400" = "Від D вгору до F — це…";
"La9b40f842e" = "Кантрі-хамер-они й слайди";
"La9c57d56a0" = "Далі вгору — аплікатура E";
"La9c988979c" = "Куди ставити кінчик пальця?";
"La9d2f15994" = "Зіграйте чи заспівайте основні тони ii–V–I у C: D, униз до G, угору до C.";
"Laa1d27fa8b" = "У четвертій позиції на струні A перший палець грає D, третій — E, четвертий — F. Форма кисті як у першій позиції: по пальцю на півтон.";
"Laa30a31d22" = "Перший палець на ладі 2 пари 2, другий — на ладі 3 пари 1. Пари 4 і 3 звучать відкритими.";
"Laa415abe38" = "Каподастр на ладу 2. Ви граєте аплікатуру G. Який акорд звучить?";
"Laa4a7419a4" = "Притуліть корпус до грудей, спрямувавши гриф ліворуч. Найближча до підлоги струна — струна 1. Вона дає найвищу відкриту ноту.";
"Laa55d86158" = "Ключиця й вага голови";
"Laa5be51896" = "Заспівайте чи зіграйте почуті ноти в тому самому порядку.";
"Laa605a61fc" = "Великі й малі терції";
"Laa69c9a2c3" = "A на ладу 2 струни 3, C на ладу 1 струни 2, A, униз до F дієза й назад угору.";
"Laa7951537f" = "Струна 4: щипніть на ладу 2, потім зробіть хамер-он пальцем 3 на лад 4.";
"Laa85dcccaf" = "Удар у відповідь";
"Laa87302d09" = "C мажор";
"Laa8a9b351d" = "Просто на підставці";
"Laa8f6a1c10" = "D на ладу 3 струни 2, A на струні 3, потім C дієз на ладу 2, відкрита E й G на ладу 3 струни 1.";
"Laa90901b9e" = "Чотири твори розділу поспіль: регтайм, марш, оперна прелюдія та схід сонця. Кожен трохи швидше, ніж раніше.";
"Laaa025b382" = "C4";
