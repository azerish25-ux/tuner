"L08bc967946" = "Валлійська новорічна мелодія";
"L08be0247dc" = "Такти від 5 до 8";
"L08c1f1d011" = "For the починається з двох восьмих на the: F дієз і G, один склад на обидві ноти. Зіграйте їх рівно в межах однієї долі.";
"L08e947b299" = "На C, тоніці";
"L08f08e985c" = "«Неонова пральня» — авторська пісня Timbre: фанк на одному акорді, A7. Впізнаваний мотив ковзає з C до C дієза — те саме тертя, що у ваших блюзових фразах, а приспів опускається до E7. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L08f46eb59c" = "Прямий перебір, повільно";
"L090369bc10" = "Шафл ділить долю нерівно: довгий удар униз, короткий угору. Це серцебиття блюзу. Уявіть ритм «там-та, там-та».";
"L09054f67ac" = "Jingle Bells";
"L0907c52560" = "Від E вгору до F — це…";
"L09126510ac" = "Затисніть баре на ладу 5, струнах 3, 2 і 1 — отримаєте A мінор з C унизу. Один палець, три ноти.";
"L09197799bd" = "Відкрита B, D на ладу 3, відкрита E, потім назад униз до відкритої G та A на ладу 2.";
"L0922b8af84" = "Акорди перебором";
"L09305f28c5" = "Спершу ступені, потім розмір";
"L0936b94844" = "Свінг ділить долю нерівно: довгий удар униз, короткий угору. Промовляйте «дам-ба, дам-ба» під бій. Це пружний ритм старих мелодій укулеле.";
"L0938f25e07" = "Відкрита D, D дієз на ладу 1, E на ладу 2 струни 4, потім стрибок до C на ладу 1 струни 2 й назад, тричі.";
"L096cd1a591" = "Одна октава";
"L0975f3a9aa" = "Дієз і бемоль";
"L097fa0a14b" = "У четвертому такті Dsus4: акорд D із мізинцем на струні 1, ладу 3. Він зависає в повітрі. Восьмий такт опускається до звичайного D — і пісня приземляється.";
"L0987ab3025" = "Блюз у A";
"L0995a331f6" = "Шум на дев'ятому каналі";
"L09a5833cec" = "Для E мінору поставте два пальці на лад 2, струни 5 і 4. Звучать усі струни.";
"L09ccba787a" = "Нічого нового: відкриті й рухомі квінтакорди, глушіння долонею та ваш риф. Точно тримайтеся клацань, грайте приглушені ноти чітко.";
"L09ccd34cd2" = "Тепер ковзніть пальцем 3 на струні 3 з ладу 4 до ладу 6, від B угору до C дієза, а потім назад у бокс.";
"L09d6838d36" = "Якщо ходу машинки не вистачає, скористайтеся кілком. Трохи повертайте його, водночас втискаючи всередину для фіксації. Якщо струна сильно розладнана, зверніться до викладача: кілки можуть проковзувати.";
"L09da34c321" = "На струну далі, на два лади вище";
"L09f494cac5" = "Половину її тривалості";
"L09ff4bdac3" = "Вітаємо, віолончеле";
"L0a0bca8e18" = "Фраза 2";
"L0a18a64ab3" = "Перебір Тревіса зі змінами";
"L0a1a03075a" = "Задає тональність і темп перед мелодією";
"L0a25055a42" = "Ті самі п’ять нот повторюються далі по грифу. Бокс 2 починається там, де завершується бокс 1: палець 1 на ладу 7 струн 5, 4 і 3, палець 2 на ладу 8 струн 6, 2 і 1.";
"L0a43370b6e" = "Восьма нота триває пів долі, тож у долі вміщуються дві. Рахуйте 1 і 2 і 3 і 4 і, промовляючи «і» між долями.";
"L0a4556ffa9" = "У якому такті 12-тактовий блюз уперше переходить до IV?";
"L0a4c5bebb2" = "Ударте й заглушіть";
