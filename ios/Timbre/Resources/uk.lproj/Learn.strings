"L4a29a0b6a6" = "Яку каденцію ви чуєте?";
"L4a34f892f7" = "Четверта позиція на A";
"L4a40d5eb64" = "A дієз на лад вище A, а A — відкрита струна 5. Отже, A дієз на ладу 1.";
"L4a58c5eca4" = "Попурі концертної зали";
"L4a5bfbd8f4" = "Коли всі пари притиснуті, розслаблення пальців миттєво зупиняє звук. У цьому секрет чопу.";
"L4a715d157b" = "Коротко, коротко, довго";
"L4a72dceccd" = "До мі ре фа";
"L4a732fabe7" = "Містечко в сніговій кулі";
"L4a7cf38bd7" = "До, мі, соль: дві терції складаються у квінту.";
"L4a87ec5ec8" = "У тональності E чотири дієзи. У першій позиції G дієз на ладу 1 струни 3, D дієз на ладу 1 струни 4, C дієз на ладу 2 струни 2.";
"L4a8833e5c8" = "«The water is wide»: відкрита струна 3, F на ладі 1 двічі, G на ладі 3, потім відкрита A.";
"L4ab0eba17c" = "Якомога більше";
"L4ab8cd9c25" = "Занижена нота звучить нижче потрібної висоти, завищена — вище. Якщо нота занижена, трохи підніміть голос. Якщо завищена — м'яко опустіть. Найкраще діють малі зміни.";
"L4ac8819649" = "Пісенник для бас-гітари";
