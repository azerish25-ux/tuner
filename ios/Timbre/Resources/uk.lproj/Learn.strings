"L4579927219" = "Раз-е-і-а: чотири рівні частини кожної долі.";
"L45812f1a6b" = "Запитання й відповідь, плавно";
"L4587537fd0" = "Восьма нота триває пів долі.";
"L458fba05c8" = "G — на ладі 3 струни 4. Де G на октаву вище?";
"L459418a6a6" = "Крокуємо в A";
"L45971e1ddb" = "Усі три";
"L459787af9a" = "Почніть із чотирьох ударів на долю. Коли стане легше, перестаньте рахувати й рухайтеся швидко та рівно. Пульс живе у стопі, а не в медіаторі.";
"L459a2eef4d" = "Лад 5 на струні 4, потім відкрита струна 3.";
"L45a7a6dd86" = "B мінор був аплікатурою A мінору з баре. Мажорна аплікатура A теж рухається: баре на струнах від 1 до 5, а палець 3 лежить пласко на струнах 4, 3 і 2 на два лади вище.";
"L45b054bf46" = "Усі п'ять утворюють G";
