"L4957f52b01" = "Риф";
"L495be9b820" = "Мала септима";
"L495db98044" = "Ця версія в A мінорі, у першій позиції: по два лади на палець на чотирьох парах струн; усі акорди на схемі мають аплікатури для мандоліни.";
"L49670fb4dc" = "Низька тема";
"L497ebafb13" = "Від A поставте палець 4 на струну 2, лад 3 для Asus4. Зніміть палець зі струни 2 й дайте їй звучати відкрито для Asus2. Обидва повертаються до A.";
"L498a9644f2" = "Дві нові аплікатури";
"L4994e82bf3" = "Переходи між парами";
"L49a23f903d" = "E7 — це E, G дієз, B і D. G — блюзова нота: вона створює тертя з акордом, а потім слайдом входить у нього.";
"L49b5f5c9cb" = "Балада на двох струнах";
"L49dfd36a45" = "Мала секунда";
"L49ec64c4f0" = "Прямуйте до наступного акорду";
"L49ed331df7" = "Септакорди й джазові розташування";
"L49ed48a9ff" = "Перенесіть найнижчу ноту нагору — отримаєте обернення. З E внизу C лежить на ладах 9, 8 і 8. З G внизу — це верхня частина вашого відкритого C.";
"L49ef7eac01" = "Пісні-історії й повільний розпал";
