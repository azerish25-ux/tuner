"Laab6a0ec9b" = "Каподастр на ладу 2. Аплікатура D звучить як…";
"Laab8fac3fc" = "Не зупиняти праву руку й повернутися в ритм";
"Laabbfc6893" = "Зовсім нічого";
"Laac40a5bc0" = "Униз до струни 4";
"Laae818fc1b" = "Будуйте B7 зі струни 5: палець 2 на ладу 2, палець 1 на струні 4, лад 1, палець 3 на струні 3, лад 2, мізинець на струні 1, лад 2. Струна 2 звучить відкритою.";
"Laae8b17f6d" = "Півтони, тони й терції, угору та вниз. Спершу визначте, крок це чи стрибок, а тоді — точний розмір.";
"Laaecd8b231" = "B бемоль: мале баре";
"Laaf57f2a76" = "C підіймається сходами: палець 3 на струні 5, лад 3; палець 2 на струні 4, лад 2; палець 1 на струні 2, лад 1.";
"Lab017316af" = "Гама й рисунок";
"Lab249fa603" = "Яка струна найнижча?";
"Lab281c21d4" = "Auld lang syne шотландською означає давні часи, що минули. Роберт Бернс надіслав слова до пісенника в 1788 році, а цю мелодію надрукували з ними в 1799.";
"Lab3bdf024d" = "Проведіть подушечкою великого пальця вниз по всіх чотирьох струнах, від струни 4 до струни 1. Не напружуйте зап'ясток.";
"Lab3fc46a0c" = "П'ять нових пісень на знайомих відкритих акордах: поп біля вогнища, балада, фолк із притупами, регі й кантрі.";
"Lab41f6b897" = "Струни нумерують від найтоншої (1) до найтовстішої (6).";
"Lab5a1d35e6" = "«Hard Times» і «Остання троянда літа»";
"Lab749475f7" = "Що підтримує скрипку?";
"Lab775f6243" = "Ваша перша народна скрипкова мелодія";
"Lab7966c45e" = "На які відліки припадають великі долі в розмірі шість восьмих?";
"Lab81a5b1f0" = "Високе до, соль, мі, до: назад униз.";
"Lab83b91522" = "Струмки";
"Lab8ffb6b34" = "Мі фа мі ре";
"Lab9322ed00" = "Дріб'язок у кишені";
"Lab95521d24" = "Випробування: добірка грувів";
"Lab9f1e970f" = "Блюзові фрази розмовляють між собою. Зіграйте фразу 1 як запитання, потім дайте відповідь фразою 2, яка приходить до низької A.";
"Labab628a15" = "Тримайте палець над екраном і торкайтеся щоразу, коли чуєте клацання. Нехай він відскакує від скла, наче барабанна паличка. Намагайтеся влучати разом із клацанням, не після нього.";
"Labab711220" = "Основні тони й точність ритму";
"Labccd3300d" = "Випробування: перші ноти";
"Labd92f9cd8" = "Легший дотик";
"Labf32d46cd" = "Знайомі терції";
"Labf5c6ec3c" = "Від A вгору до D — це…";
"Labf6980bc4" = "Hard Times Come Again No More";
"Labf6a33d0c" = "Під час пул-офу верхній палець…";
"Labfd9ee184" = "Від до до соль і назад: C, G, C.";
"Lac09488666" = "То голосно, то тихо";
"Lac0a2f09a5" = "Регтаймова послідовність";
"Lac289dd846" = "Чвертна нота триває одну долю. Швидким нотам потрібно менше смичка: грайте середньою половиною й робіть усі рухи однакової довжини.";
"Lac2f0f32ff" = "Святковий концерт";
"Lac3f356824" = "У тактах від 9 до 12 йдуть E, D, A, E. E в такті 12 повертає коло до початку.";
"Lac46c5c9a5" = "Гама терціями";
"Lac492f11b3" = "Вершина";
"Lac4975a458" = "Від мі до фа (від E до F) — півтон. Решта кроків від до до соль — тони.";
"Lac4a920dc4" = "Восьмі й шістнадцяті ноти";
"Lac4e52e004" = "Як тут перетворити E на E7?";
"Lac4f5bbb68" = "На останньому ударі вгору в такті можна послабити притискання або відкрити струни. У цей момент перейдіть до наступного акорду, щоб доля 1 прозвучала чисто.";
"Lac71d37471" = "З E мінору на A мінор";
"Lac9b73be67" = "Який основний тон акорду E?";
"Laca97f5add" = "Коли дві ноти звучать разом, слухайте їхнє злиття. Октава зливається в один звук. Квінта звучить порожньо й міцно. Кварта — просторо, але неспокійно.";
"Lacaf77ea57" = "Використовуйте лише чотири верхні струни. Цей A мінор — верхня частина вашого баре A мінору на ладу 5: палець 3 на струні 4, лад 7, палець 1 тримає баре на решті.";
"Lacb1865b98" = "Аплікатура A на ладу 10";
"Lacb4d1a25b" = "По дві й по три";
"Lacbbd790e2" = "Зміни позиції першим пальцем";
"Lacbf27617c" = "Перші ноти на ладах";
"Lacd2f46b7e" = "Ви пересунули аплікатуру, почавши з ладу 5 струни 4. Яка тепер це гама?";
"Lacd96bd87b" = "Крок веде до наступної літери. Стрибок пропускає одну, як від C до E повз D. Ця відстань зветься терцією. Стрибки звучать просторіше за кроки.";
"Lacded341a5" = "Щоб закінчити пісню";
"Laceb4c7f48" = "G на ладу 3 струни 1";
"Lad01b0086e" = "Які ноти утворюють D мінор?";
"Lad17f6d151" = "Мелодія пішла вгору чи вниз?";
"Lad1ad83724" = "Такт 5";
"Lad1b64e858" = "Ноти й абетка";
"Lad2212fd92" = "Timbre приймає ноту в межах 30 центів, приблизно третини півтону. Якщо зависоко, трохи посуньте палець до завитка. Якщо занизько — до підставки.";
"Lad39794b45" = "F розташована безпосередньо ліворуч від групи з трьох чорних клавіш.";
"Lad3a50dd09" = "Якомога більше вібрато";
"Lad3b27735d" = "Чергуйте по два й по три";
"Lad4437456b" = "F♯ і G на парі 3, потім відкрита пара A.";
"Lad5fe25684" = "Комета над променадом";
"Lad6dd44de0" = "D, E і A";
"Lad6fadc1b2" = "Ірландська мелодія";
"Lad7c14e697" = "Від відкритої G до відкритої E — секста. Тримайте медіатор близько до струн і переходьте зі струни 3 на струну 1 одним рухом.";
"Lad8b46c5e0" = "Клоухаммер грають без медіаторів. Вільно зігніть кисть наче кіготь і бийте вниз по струні зовнішнім боком нігтя вказівного або середнього пальця, рухаючи зап'ястком і передпліччям.";
"Lad9631533c" = "Ставте новий акорд, коли великий палець починає наступний такт. Пальці продовжують перебір; змінюється лише аплікатура під ними.";
"Lada3439dab" = "Чергуйте медіатор восьмими й надавайте довгим нотам співучості за допомогою тремоло.";
"Ladbb834a79" = "Гама в A мажорі";
"Ladc7896c15" = "Скільки нот у мажорній гамі від до до до?";
"Ladd0a2feac" = "Знизьте B на півтон — отримаєте B♭.";
"Ladd6d2f77c" = "Другим, на струні D";
"Ladda01eb27" = "Колядки й новорічна пісня на два, три, чотири й шість.";
"Laddb26ec0a" = "Для пісні «У Мері було ягнятко» потрібні три ноти: B на ладі 2 струни 3, відкрита A і G на ладі 3 струни 4. Другий палець для B, третій для G.";
