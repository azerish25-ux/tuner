"L4adbed04f2" = "Дотягніться до ладу 5";
"L4adf75129a" = "У G мінорі";
"L4ae2f0cb0a" = "Униз, униз-угору, угору-вниз-угору";
"L4b0066fc0e" = "Зіграйте чи заспівайте F, G, A, починаючи зі щойно знайденої F.";
"L4b105ef4ba" = "Які ноти мають дієз у D мажорі?";
"L4b115ba3bc" = "Випробування: п'ять акордів";
"L4b18749b08" = "Літери чергуються: лінійка, проміжок, лінійка, проміжок.";
"L4b1e5c2bd9" = "У G більшу частину роботи роблять акорди G, C і D7, а E мінор додає похмурішої барви. D7 тягнеться назад до G, як G7 до C.";
"L4b252da345" = "Притискайте для кожного удару й одразу розслабляйте, щоб звук був коротким. Пересуньте всю аплікатуру E9 на два лади вниз — отримаєте D9.";
"L4b44ae6a0d" = "E, а потім другий палець чи третій?";
"L4b49795891" = "A дієз лежить між A та B на ладу 3 струни 3. Вона переходить угору до відкритої B — блюзовий підйом, що надає госпелу його звучання.";
"L4b608fa398" = "Трелі й підходи до нот слайдом";
"L4b65fb9aa1" = "B♭ мажор";
"L4b67e3b6b9" = "Сильніше стискання";
"L4b793d1b90" = "Поворот віолончелі";
"L4b85ad14e6" = "Розрізняйте інтервали й акорди та повторюйте почуте голосом";
"L4b8aa1bb43" = "Окремий палець для кожної струни";
"L4b8ddb7777" = "E B G D A E";
"L4b97a9dae2" = "Скільки восьмих заповнюють такт із чотирьох долей?";
"L4b993b91c8" = "«Аура Лі» вийшла друком у 1861 році, музику написав George R. Poulton. Грайте повільно й давайте кожній ноті звучати до наступної.";
"L4b9b2dc09d" = "Основний ритм клоухаммера звучить як його назва. Бам: одна нота на долю. Ді: проведіть униз по струнах. Ті: великий палець грає струну 5.";
"L4b9bf2fa3c" = "Фраза 1: два хамер-они";
"L4b9d8a76f6" = "Стежте за схемою";
"L4bae911c72" = "Униз, потім назад угору";
"L4bb025dc17" = "G першим пальцем, потім A третім, обидві на струні D.";
"L4bb38184b0" = "Бас рівно, пальці між долями";
"L4bbb7432b3" = "Який акорд у такті 2 за ранньої зміни в E?";
"L4bc18141f8" = "Коли нота готова до вібрато?";
"L4bc4f5018a" = "D F♯ A";
"L4bcc812c1c" = "Для G мажору потрібні C бекар на струні A й G бекар на струні E, тож там другий палець низький. На струнах G та D він лишається високим.";
"L4bcca0fb8f" = "Колискова з 1868 року";
"L4bd11fba9c" = "Основні тони A, D і E: усі на відкритих струнах.";
"L4bd20fb5fa" = "Дві рівні ноти на долю — восьмі. На першій промовляйте число, на другій — «і».";
"L4be63de2a8" = "«Down by the riverside»: B, B, A дієз, B, потім A і G.";
"L4bed9c3edf" = "Де знаходиться A на струні 3?";
"L4bf6b5663d" = "Від A до A через дві пари";
"L4c001840db" = "Підніміться й поверніться";
"L4c0b79f89f" = "Дзвін свободи";
"L4c17aadf51" = "Розробка";
"L4c2b96d64a" = "Хамер-он, потім пул-оф";
"L4c2f73faa7" = "Долі й такти";
"L4c40cf3873" = "Bethlehem";
"L4c559f2ca9" = "Вона може стати завищеною";
"L4c6c8ede5d" = "Яку ноту виділено?";
"L4c6fbc3c8d" = "G, пропускаємо A, B, пропускаємо C, D.";
"L4c7b579190" = "Яка нота на півтон вище B?";
"L4c9c92c06d" = "Відповідайте на риф квінтакордами на раз, «і» другої долі й чотири: A5, G5, C5, D5. Між ударами послаблюйте пальці на грифі, щоб акорди швидко замовкали.";
"L4c9cab15b4" = "Скільки півтонів у великій сексті?";
"L4c9cc2437a" = "Підвищте F на півтон — отримаєте F♯.";
"L4cad552525" = "Неділя біля моря";
"L4cb2c083f2" = "Вона звучить на струнах D, A та E.";
"L4cc78df1b7" = "Ліхтарний пагорб";
"L4ccadbfff8" = "На яку долю в цьому рисунку немає удару на число?";
"L4ccdff8050" = "«In Dublin's fair city»: відкрита струна 3, F на ладі 1 чотири рази, відкрита A, назад до F.";
"L4cd7920fdd" = "Bm";
"L4ce7a9627e" = "Риф у повному темпі";
"L4cf432a342" = "Відчинені вікна";
"L4cf503f371" = "Тризвуки від верхньої струни вниз";
"L4cf5332030" = "Тепер струна 2, D.";
"L4cfe4ee7d4" = "«Пора бенгальських вогнів» має найвідоміший попцикл: C, G, A мінор і F — акорди першого, п'ятого, шостого й четвертого ступенів C. Ці акорди є в сотнях хітів; нова мелодія й слова роблять кожен особливим.";
"L4d02f3e84b" = "До — нота-домівка";
"L4d08076fb1" = "Четверта нота C мажору — F.";
"L4d08abbd78" = "Дві ноти на долю";
"L4d0c4b41aa" = "Коли рука на грифі має притискати струни?";
"L4d11838152" = "На ладовому поріжку";
"L4d146edd55" = "Третя позиція";
"L4d16667656" = "Акорд, що прагне додому";
"L4d19d4e955" = "Угору до пари E";
"L4d3237854b" = "Регі: короткі міждольові удари";
"L4d39331c9c" = "У пісні «Неонова пральня» немає шафлу. Зіграйте хід бугі рівними восьмими — і він стане басовою лінією під A7: A, C дієз, E, F дієз, G і назад униз.";
"L4d5370570e" = "Це підхідна нота, на один лад вище за A — основний тон наступного акорду. Вона плавно веде вас у наступний такт.";
"L4d53f02370" = "Поставте другий палець на лад 2 струни 4 і проведіть по всіх чотирьох струнах. A мінор звучить похмуріше за C.";
"L4d60a0fa07" = "G, рисунок Тревіса";
"L4d6ade7a7d" = "Чому дві ноти октави так добре зливаються?";
"L4d6c5b7a10" = "«Легко веслуй» — стара німецька дитяча пісня. Вона крокує вгору й униз по D мажору на струнах D та A.";
"L4d7da33a0c" = "Двічі в першому рядку швидка B веде до A, що звучить три долі. Щипніть A один раз і дайте їй звучати.";
"L4d8264bf18" = "Рухайте розслабленим зап’ястком і передпліччям, наче струшуєте воду з руки. Напружена рука дає різкий звук.";
"L4d8fc5434e" = "Зіграйте E, потім підніміть палець 3 зі струни 4. Відкрита D, що зазвучить, — це септима, нота, яка додає блюзового напруження.";
"L4db2765622" = "Рядок зі вставками";
"L4db6e3134c" = "Щипніть струну 1, A, і дайте їй звучати.";
"L4dbb22d824" = "Його грають вище";
"L4dc737db08" = "Що робить риф рифом?";
"L4dcaf0bbc5" = "До ре мі фа";
"L4ddbbc6269" = "E G B";
"L4de0cc441b" = "Як завжди, грає струну 5";
"L4df1e87c76" = "Той самий палець на струні A: відкрита A, потім B.";
"L4e01389342" = "Поставте палець 3 на струну 5, лад 3. Це C — нота, з якої починається гама C мажор.";
"L4e255b9991" = "Другий палець ковзає назад";
"L4e54b12025" = "«Ліхтарний пагорб» — пісня біля вогнища на трьох акордах G, C і D у темпі 92 долі за хвилину. Приспів створено для гурту, тож удруге співайте на повний голос.";
"L4e72381f4d" = "На кожне число й кожне «і»";
"L4e95f3a260" = "Великий палець позаду грифа";
"L4e983027f0" = "Цикл із чотирьох акордів у п'яти версіях: два літні гімни, ролер-поп, поп у 6/8 і стадіонний приспів.";
"L4eadaa0b39" = "D, A, D, A. Нехай рука погойдується між двома рівнями.";
"L4ec363ab89" = "Чотири струни, маленький корпус";
"L4ed0586f6e" = "До якого акорду тут тяжіє D7?";
"L4ed27a0f3e" = "Відкрита A, C на ладу 3 струни 5, відкрита D, потім G на ладу 3 струни 6 та відкрита низька E.";
"L4ed6671eed" = "Колядка-колискова";
"L4ee0a24d6f" = "Шість восьмих утворюють дві групи по три, тож відчуваються дві великі долі.";
"L4ef7deb211" = "Дублінська пісня на три";
"L4f025d84ef" = "Кожна октава вгору додає одиницю до номера.";
"L4f0fd93f33" = "D стоїть у проміжку безпосередньо під нижньою лінійкою.";
"L4f162aedb4" = "Середній розділ";
"L4f19f04b93" = "Зіграйте чи заспівайте A мінор по одній ноті: A, C, E.";
"L4f23ad510c" = "Який інтервал від C вгору до A?";
"L4f240cf65f" = "C♭";
"L4f36c5bb9e" = "Третій палець дістає до ладу 3 без розтягування.";
"L4f38c92209" = "Попурі колядок";
"L4f3fa917d7" = "Покладіть зовнішнє ребро долоні руки, якою граєте, на струни біля самої підставки. Проведіть по струнах — звук стане коротким і щільним.";
"L4f43432762" = "На першу долю називайте номер такту: раз, два, три, чотири; два, два, три, чотири. Так ви завжди знаєте, де перебуваєте.";
"L4f511017a0" = "Де припадають міждольові акценти?";
"L4f52c2c8db" = "Щоб залишити місце для затакту";
"L4f53f58670" = "Чиста квінта охоплює сім півтонів, як від C вгору до G. Звучить просторо й міцно. «Мерехти, маленька зірко» після перших двох нот стрибає на квінту вгору.";
"L4f55fd25f1" = "Бас крокує з танцюристами на першу й третю долі, бій заповнює другу й четверту.";
"L4f5f5a2eb8" = "Вище потрібної висоти";
"L4f6854efd1" = "Доля 1";
"L4f75706770" = "Історія в 6/8";
"L4f76b31420" = "Малими й легкими";
"L4f93b2c841" = "I–IV–V–I";
"L4f96be6780" = "C і A";
"L4f98230c29" = "На чотири";
"L4fa8c64be4" = "Щипок двома пальцями";
"L4fbeb6bda9" = "Чотири струни, одна аплікатура";
"L4fd1570a97" = "Струни 4, 5 і 6";
"L4fd48d6edf" = "D мажор восьмими";
"L4ff1f57db9" = "Відкрита струна 4, F на ладу 3, відкрита струна 3, потім C на ладу 3 струни 5.";
"L4ffe2d706c" = "Тут бурдон водночас є нотою мелодії. Великий палець грає її точно на долю.";
"L5008b8a25f" = "Вальсуйте на три, маршируйте на два, гойдайтеся в 6/8 і розставляйте акценти.";
"L500ab3c359" = "Thomas Oliphant (1862)";
"L5023f95426" = "Швидкий уривок: D E D C на струнах 2 і 1, потім B і G.";
"L502a620be6" = "Тональність D мінор";
"L502e8524eb" = "Нічого нового — лише ви";
"L50354aa417" = "Обидві — D, на відстані октави: однакова назва ноти, але одна звучить вище за іншу.";
"L5037df4744" = "Співати трохи вище";
"L50397b603a" = "Давні добрі часи";
"L505151a3ef" = "Яку частину «бам-ді-ті» грає великий палець?";
"L50619c33dd" = "Ноти мають номер, що вказує на октаву. Середнє C, біля центру фортепіано, — це C4. На кожному C номер збільшується на один.";
"L5065186975" = "Скільки восьмих нот у такті 6/8?";
"L506628fe06" = "D на ладу 3 струни 2, відкрита B й назад, потім відкрита E на струні 1 та знову вниз.";
"L5066fc7d78" = "Короткі рівні удари";
"L5067110091" = "Галоген";
"L5072e1fd6d" = "B мінор із повним баре";
"L50882f22ec" = "Ваша рука — годинник";
"L50aaea1fb0" = "Палець 4";
"L50bfb1a652" = "Удар долонею по струнах";
"L50c9e8d5fc" = "D";
"L50f1d21a1f" = "Половинні ноти";
"L50f7cd33c4" = "12-тактовий шафл";
"L50fae3bee8" = "На яку долю припадає акцент?";
"L51006e77e0" = "Половина однієї долі — пів долі. Додайте її — отримаєте півтори.";
"L510fbf7d5b" = "Великий палець грає басові струни. Решта пальців — тонші.";
"L51221b9b02" = "Струна 3, лад 9: це ціль вашого бенду. Дайте ноті прозвучати й запам’ятайте її.";
"L512ad9c471" = "D, G та A7";
"L51428dc12b" = "Другий такт піднімає E до F дієза, ноти B мінору. Той самий ритм, новий акорд, нова нота.";
"L514ebad382" = "A на ладу 2 струни 3, потім C і C дієз на ладах 1 і 2 струни 2. Двічі.";
"L5155fc0931" = "Вогні табло";
"L515a00d6bf" = "Гама — це драбина";
"L515a6d791f" = "Блакитний Дунай";
"L51689e74cf" = "Доля — рівний пульс, під який ви притупуєте ногою. Долі об'єднуються в такти, англійською bar або measure. У більшості музики кожен такт має чотири долі.";
"L516b7f77a6" = "F і група з трьох";
"L516b9783fc" = "p";
"L5172fb1e96" = "Яка літера в p-i-m-a позначає великий палець?";
"L517a9d49ae" = "Униз сходами";
"L517b4007db" = "Гітара регі відповідає пульсу: короткий удар угору на два й чотири, між ними — тиша.";
"L517e8a1134" = "90 долей щохвилини";
"L51955b693b" = "Торкаєтеся на першій ноті й утримуєте її протягом другої.";
"L51a6b331b9" = "Завершіть мелодією приспіву й дайте останній G прозвучати. Знайома всім щойно почута мелодія створює відчуття завершення.";
"L51be815771" = "Щипнути сильніше";
"L51bfaf7a67" = "Чвертні й половинні";
"L51c9519408" = "Фанковий акорд: E9";
"L51def84886" = "Сім літер";
"L51e14416b6" = "G7 з баре";
"L51e4d1a6c5" = "A B C D";
"L51ee443e1a" = "Удари вгору — між долями";
"L51f6cadc38" = "На що свінг перетворює кожну пару восьмих?";
"L51fd07643b" = "Robert Burns (1788)";
"L51fdd94638" = "Пів долі";
"L52024c2ffb" = "Знизьте G на півтон — отримаєте G♭.";
"L520dc4bae4" = "Знайомство: «Базарний день»";
"L521a1675b9" = "G7 — це G мажор (G B D) плюс F, мала септима над G.";
"L521a5d65a5" = "Вставки акордовими тонами";
"L521cae7af6" = "Попурі біля вогнища";
"L522a49de0f" = "По дві на долю, чотири долі: вісім восьмих нот.";
"L5246177269" = "Назва ноти та сама чи інша?";
"L5249b2406f" = "У D мажорі є F♯ і C♯.";
"L526c6c5099" = "Ернст Аншютц написав ці слова в Лейпцигу в 1824 році на значно давнішу народну мелодію. Ви співатимете німецькою — мовою оригіналу.";
"L527dd18ef5" = "Гімн зі зміною тональності";
"L527f08b479" = "Ду-воп п'ятдесятих";
"L5288dd6252" = "Рахуйте літери";
"L5299a47c6b" = "Початок той самий, завершення інше. Другий рядок повертається додому, до G.";
"L529c00bd92" = "Від C до A — дев'ять півтонів: велика секста.";
"L52a76ba869" = "Тривалості, крапки, паузи й тактові розміри разом. Відбиваючи ритм, рахуйте вголос: голос допоможе рукам не збиватися.";
"L52abc3a14b" = "G дієз на ладу 4 струни 1, F дієз, відкрита E, відкрита B, потім D дієз на ладу 4 струни 2, C дієз, D дієз.";
"L52b515dd1c" = "D F A♭";
"L52b62b2b14" = "Знайомство: «Листи в коробці від взуття»";
"L52c31f2b7d" = "Для G потрібне нове розтягування: перший палець — лад 2 пари 2, другий — лад 3 пари 1, третій — лад 5 пари 3, мізинець — лад 7 пари 4.";
"L52cb5c1449" = "E мінор — E, G і B; C — C, E і G; G — G, B і D. G є в усіх трьох, тому переходи плавні.";
"L52d774ad9f" = "C G D A";
"L52f0892747" = "Яка інша назва C?";
"L53029da8ad" = "У якого акорду спільний палець із F?";
"L5303e39fcd" = "Нікуди: чекає одну долю";
"L530d434756" = "Зіграйте чи заспівайте тризвук C по одній ноті: C, E, G.";
"L531203f152" = "Додайте вільний палець";
"L53193ec70c" = "Повторний щипок у кінці";
"L531a76efcc" = "Відкрита B, відкрита E, G на ладу 3 струни 1, відкрита E, потім C на ладу 1 струни 2, E та C.";
"L532c25828a" = "«Тінистий гай» має похмуре давнє звучання, яке музиканти називають гірським мінором. Мелодія знаходить спокій на A замість G, а висока G п'ятої струни звучить на її тлі.";
"L5335521663" = "Тримайте інструмент, знайомтеся з G C E A, грайте перші ноти, перший акорд і пісню.";
"L53360a91ed" = "Середній рядок";
"L535bb8d429" = "Дев'ять";
"L53621703cb" = "Салонне попурі";
"L5379d48a08" = "Ця версія в D, у першій позиції: мелодія рухається чотирма струнами з пальцями від 1 до 4, а схема акордів — для тих, хто акомпанує вам.";
"L53844e53b0" = "E, F дієз, G, F дієз. Другий палець низько, торкається першого.";
"L5385ffddaa" = "ii–V–I";
"L5393fb38e0" = "Ноти на струні E";
"L5397e0583f" = "Так";
"L53a05073fd" = "G, F дієз, E: пальці 4, 3, 1. Це найвища точка колискової.";
"L53b763e406" = "Краще запізнитися з акордом, ніж збити пульс. Продовжуйте бій, навіть якщо струна брязкає.";
"L53c771e316" = "Пісня «Зелені рукави» побудована на цьому акорді. Він мажорний чи мінорний?";
"L53cc9a5bfd" = "Діліть кожну долю навпіл. Грайте вниз на число й угору на «і»: раз і два і. Це вісім ударів на такт.";
"L53d54b3da0" = "Percy Montrose (1884)";
"L53daebd69c" = "D7 тяжіє до G";
"L53ea870d0b" = "Друга октава";
"L53f63b6be7" = "Куди рухається палець під час пул-офа?";
"L540e256981" = "Як називається пара 2?";
"L541d5448c4" = "Домінантсептакорд — це мажорний акорд із додатковою нотою вгорі: малою септимою над основним тоном, від якого походить назва акорду. Він звучить по-блюзовому й неспокійно.";
"L5423a6924a" = "Пул-офи в боксі 1";
"L54536ce670" = "Який удар припадає на долю?";
"L5456c995d6" = "Ранок";
"L545a1353d5" = "Акорди пісні «Базарний день» — G, B мінор, C і D. На яких вони ступенях гами?";
"L546aee20de" = "Палець 3 на струні 3, лад 4. Щипніть, потім ковзніть до ладу 6, не піднімаючи пальця.";
"L5474f7c098" = "C, F і A";
"L5478c3c226" = "A мінор, C, G, D";
"L5480b46e6f" = "Прямий перебір на 72";
"L54853f9ed5" = "«Away in a Manger» — вальс: раз, два, три. Інші дві рахуємо на чотири.";
"L5490c1ee9f" = "«Неонова пральня» весь час лишається на одному акорді A7. Такий вамп живе ритмом: щільний, уривчастий бій, 96 долей за хвилину, й мотив, що оминає долю.";
"L549650b09a" = "Відкрита струна A на октаву нижче, тож резонує, коли ваша A звучить чисто.";
"L54b37dcfaa" = "Дві октави від G до G";
"L54c232e169" = "Гарольд Болтон поклав ці слова в 1884 році на човнярську мелодію Гайленду, записану Енн Маклауд. Вони розповідають про втечу Красунчика принца Чарлі на острів Скай у 1746 році.";
"L54c4ef86e9" = "Швидший темп";
"L54d8043465" = "Струна 3 лад 4, потім відкрита струна 2: на один лад угору до D.";
"L54deb32f09" = "Струна 4, лад 3, третій палець.";
"L54e680593a" = "Рух усієї кисті зберігає відстані між пальцями, тому наступні ноти теж звучать чисто.";
"L54e98fe345" = "Вище по грифу";
"L54ed8b71a7" = "«Кріпл-Крік» має високу частину, де п'ята струна грає ноту мелодії, і низьку на струнах 3 і 4. Спершу пройдіть кожну повільно.";
"L54ee8eebd8" = "Тризвук — найменший повний акорд: основний тон, терція й квінта. На струнах 3, 2 і 1 тризвуки звучать чисто та яскраво й працюють будь-де на грифі.";
"L54fbad53e3" = "Угору чи вниз?";
"L5500f384a8" = "Основний тон і квінта";
"L550413371a" = "Авторські пісні на відкритих акордах";
"L5517163095" = "E, струна за струною";
"L552a48081a" = "Який тризвук зменшений?";
"L552e9d35ee" = "Народна пісня (Cecil Sharp, 1906)";
"L5533d4675e" = "У печері гірського короля";
"L553931570f" = "Паузи позначають кінці фраз. Вдихайте там, щоб кожен рядок мав повну дихальну опору.";
"L554ea59541" = "Рівний видих дає рівну ноту. Зайва гучність і напруга ускладнюють контроль.";
"L555a45f8ee" = "Від багаття до сцени";
"L555d690162" = "Риф на струні E";
"L556ebf9e6c" = "Відтворити висоту — означає заспівати почуту ноту. Послухайте, на мить уявіть її, потім тихо заспівайте й підлаштуйте висоту, доки вона не стане точною.";
"L55751877e1" = "Великий палець";
"L5586ce9ee7" = "Яку C використовує менует?";
"L559b2f0425" = "Крокуючий блюз в E";
"L55b84af5bf" = "«Листи в коробці від взуття» — авторська пісня Timbre, повільна балада в C. Приспів звучить на струнах 1 і 2, а впізнаваний мотив починається з довгої та короткої нот, як у мелодії «Ода до радості». Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L55b9b551f7" = "Поппослідовність";
"L55bc11a8bb" = "Після G на парі 3 іде A. Грайте її на відкритій парі A, а не тягніться до ладу 7.";
"L55c00c847d" = "E G♯ B";
"L55c922b164" = "Розмір 3/4";
"L55ea61dde9" = "Once in Royal David's City";
"L55ec63b759" = "Прямо й рівно";
"L55f002b223" = "Соль фа мі";
"L55f3d1f477" = "Випробування: рифи";
"L55fefea833" = "Вісім рівних нот";
"L56151fcf69" = "Чергування великого пальця зі змінами";
"L5621e931a1" = "Щипайте основний тон акорду на першу й третю долі, а на другу й четверту грайте бій, після кожного — швидкий удар угору. Бум, чик-а, бум, чик-а: кроки танцівників.";
"L562d4d7bad" = "Від соль назад униз до до: від G униз до C.";
"L562fb6ab78" = "Симфонія № 40 Моцарта";
"L5630a6293e" = "Тепер струна 2, наступна вгорі.";
"L564de342cd" = "Мотив якої пісні починається так?";
"L565a9be014" = "E мажор у A мінорі додає одну нову ноту. Яку?";
"L565f5c8676" = "Аура Лі";
"L5662c4e330" = "Коли вже звучить чисто";
"L567df0b3b4" = "Нових нот немає: шість тем цього розділу, від Пахельбеля до Бетховена, кожна трохи швидше, ніж раніше.";
"L568921f01d" = "Частини смичка";
"L568ad3429d" = "Від D униз до G, потім від G униз до C: щоразу на квінту.";
"L568eaf3aa8" = "G, A і D";
"L5690d5ad4c" = "Яку ноту додають до C, щоб отримати Cmaj7?";
"L5693f84d8a" = "Довгі звуки з чистою інтонацією";
"L56b51bad86" = "Восьма нота — пів долі, тож дві заповнюють долю.";
"L56b5c25b85" = "По два на кожну пару";
"L56b5dbf88d" = "F надто низька для співу";
"L56bde85b97" = "На які долі припадає бас у тустепі?";
"L56c0b8ad39" = "Яка нота на тон вище E?";
"L56c7ce3b5f" = "Від B до F — шість півтонів; для чистої квінти потрібно сім.";
"L56cc9c481c" = "Це 12-тактовий блюз?";
"L56db6392a5" = "Удар униз на 3";
"L56e13d8580" = "Розмір 3/4: три долі в такті, з наголосом на 1.";
"L56e1af7c65" = "Яка інша пісня має ту саму мелодію?";
"L571006fc8a" = "Вказівний на основному тоні, безіменний на ладі 5 для квінти й октави.";
"L5732c8052f" = "Яка аплікатура йде після A вгору по грифу?";
"L5743da51bc" = "Який акорд найсильніше тяжіє назад до I?";
"L574772dd90" = "На які долі грають чоп?";
"L5750aaf23b" = "Потрібна C♯ на парі 2. Який лад?";
"L5761a580f3" = "Де середнє C в басовому ключі?";
"L576324effd" = "Запитання й відповідь";
"L576e04843f" = "Струна 3, потім струна 5. Яка вища?";
"L577bf8ee69" = "Нота без щипка";
"L57863d228f" = "A на ладу 2 струни 3, відкрита B, C дієз на ладу 2 струни 2, потім відкрита E й F дієз на ладу 2.";
"L578de8709a" = "Пальці, великий палець і мелодія";
"L578dfe3449" = "Половина довгої гами";
"L5796a8f6bb" = "Що робить великий палець у цьому малюнку?";
"L579f548b6d" = "2–3 і 6–7";
"L57a6df6e88" = "Зіграйте малий F, але пальцем 1 притискайте лише струну 2. Відкрита струна 1, E, — велика септима від F.";
"L57ab1a031e" = "Перенесіть другий «бум» на іншу струну: у G — струна 6, потім струна 4. У C — струна 5, потім 4. У D — струна 4, потім відкрита струна 5.";
"L57bc96d79f" = "Ви рахуєте 1-трі-оль, 2-трі-оль. Що ви відбиваєте?";
"L57c32e7438" = "Ваш перший акорд: G";
"L57dd24c894" = "Яка нота є соль у C мажорі?";
"L57e2f80c73" = "Зіграйте E першим пальцем у першій позиції, потім ковзніть ним угору до G. Це три півтони — стільки ж, як від B до D на струні A.";
"L57f12775b1" = "Який палець грає C дієз на струні A?";
"L57f172a006" = "A мінор, чергування басів";
"L580399c15c" = "Поки що великий палець грає струни 3, 4 і 5, вказівний — струну 2, середній — струну 1. Безіменний і мізинець легко спираються на мембрану.";
"L5806880abe" = "Поєднуйте тривалості";
"L580fd54b57" = "Так, на ладі 2";
"L581cb35ea8" = "Аплікатура A — і знову по колу";
"L5827b85ed8" = "У ньому лише акорди";
"L5838c9ec25" = "Входьте в кожну фразу слайдом";
"L5887ff3d74" = "Чвертна нота";
"L588f8784f5" = "Перший палець — на ладі 1 струни 2, другий — на ладі 2 струни 3, третій — на ладі 2 струни 1. Проведіть по всіх чотирьох струнах.";
"L58a534af12" = "Він підтримує віолончель";
"L58b29e6cc0" = "A♯";
"L58bb52be10" = "Гріг написав цей твір для п'єси «Пер Ґюнт» у 1875 році. Він зображує тролів у залі їхнього короля, починається тихо й поступово прискорюється.";
"L58cb3fff31" = "Яка пара білих клавіш має відстань у півтон?";
"L58d40ef087" = "Angels from the Realms of Glory";
"L58d52b16c1" = "Додаткова нота в D7 тяжіє до G. Коли звучить G, напруження зникає.";
"L58d68468c9" = "Рахуйте вгору від D: D, E, F дієз, G, A. A — п'ята нота, тож A7 — акорд V ступеня.";
"L58e4cebcce" = "Кожна доля";
"L58eedeebf8" = "Повільні, завчасні зміни формують звичку. Швидкість прийде сама.";
"L58f102ddae" = "Що відбувається наприкінці мелодії тореадора?";
"L58fe8858cf" = "Поворот до B мінору";
"L59072f6149" = "Перебори";
"L590c267292" = "Гра смичком";
"L59188c6d63" = "Знайдіть пульс";
"L5921a5b2b8" = "Висуньте шпиль так, щоб верхній край віолончелі торкався грудей біля грудини, а кілок C був біля лівого вуха. Затягніть гвинт. Упор або ремінь не дасть шпилю ковзати.";
"L592f4b6689" = "Знайомство: «Тустеп на гравійній дорозі»";
"L5938c71ae6" = "C: три пальці";
"L594cfc45fd" = "Генрі Бішоп написав цю мелодію для лондонської опери в 1823 році на слова американського актора Джона Говарда Пейна. За кілька років вона стала однією з найулюбленіших пісень світу.";
"L5952f9b6a9" = "Філліпс Брукс написав ці слова в 1868 році для дітей своєї церкви у Філадельфії, а її органіст Льюїс Реднер — мелодію для їхньої різдвяної служби.";
"L597b60da13" = "Угору до C, униз до відкритої B й назад, потім D, спуск до A і знову D.";
"L59814fa3ba" = "Лишайтеся на одному місці";
"L5983fa3abd" = "Струна 3, лад 2, другий палець. Це B.";
"L598a489b59" = "Який розмір нагадує марш?";
"L598c2fd0e7" = "Заспівайте чи зіграйте ноти акорду від нижньої до верхньої.";
"L599637a52a" = "Зіграйте чи заспівайте проміжки знизу вгору: F, A, C, E.";
"L599a010fb7" = "Великий стрибок: від G угору до високого C, потім кроками вниз.";
"L59a890261d" = "Скільки медіатора має виступати?";
"L59abc0da88" = "Шукайте місця без чорної клавіші: від E до F і від B до C. Ці білі клавіші стоять поруч, тож між ними лише півтон.";
"L59bc865a46" = "Випробування: баре";
"L59c12ec1c9" = "Відкриті струни, щипок двома пальцями й перші притиснуті ноти. Чергуйте пальці й давайте кожній ноті прозвучати.";
"L59c1350d23" = "Французька народна пісня";
"L59d0bca33c" = "Від C білі клавіші йдуть C, D, E, F, G, A, B, а потім знову C. Сім білих клавіш містять по одній із кожних семи літер.";
"L59d89422db" = "Яка G звучить вище?";
"L59efa0f9f5" = "Дієзи й бемолі";
"L59f912292e" = "Високий рядок: угору до D на ладу 3 струни 2, потім B G, B A, G E D.";
"L5a0e299b6e" = "Скільки долей триває половинна з крапкою?";
"L5a14702747" = "Приспів іде C, A мінор, D7 і G. Змінюйте акорд на слові, що починає кожну половину такту, й грайте легким боєм під високу E.";
"L5a4c7da42b" = "Випробування: перші кроки";
"L5a59483173" = "Панк-поп, рифовий рок, похмурий рок у 6/8, інді-гімн і дезерт-рок на квінтакордах та низьких рифах.";
"L5a5d733600" = "До, мі та соль — ноти тонічного акорду, тож звучать стійко й спокійно. Мі — солодко, соль — міцно й просторо, до — завершено.";
"L5a5d8340b2" = "Тінистий гай";
"L5a636e248d" = "Ноти з однаковою літерою звучать схоже, навіть якщо одна вища. Відстань від одного C до наступного C — октава. Вища нота коливається рівно вдвічі швидше.";
"L5a80ba0bea" = "Слайдом угору до боксу 2";
"L5a9ac09da7" = "Струна C";
"L5a9e82f489" = "Низький 2 на високих струнах";
"L5ab4b059e7" = "Народна пісня (Франція, 18-те століття)";
"L5ab72ee022" = "Чудові соло дихають. Зіграйте коротку фразу, зробіть приблизно таку саму паузу, потім дайте відповідь. Тиша надає ваги наступним нотам.";
"L5acc606203" = "Куплет 4";
"L5acf76b488" = "Із вільного горла й рівного дихання";
"L5ad2994115" = "D, A, B мінор, G";
"L5af071dd5b" = "П’яти струн";
"L5af311b98c" = "Залишити долю 1 порожньою найважче. Кивніть на 1, щоб відчути її без дотику, а тоді вступіть на 2.";
"L5b0918cfec" = "Рахуйте вгору від G: нота 1 — G, нота 4 — C, нота 5 — D.";
"L5b0e679c41" = "Нота на лінійці піднімається на одну літеру. Де вона опиниться?";
"L5b10c8407c" = "A мінор і ваша перша зміна";
"L5b11880954" = "Scotland the Brave";
"L5b1ad97ddf" = "Диктант — це слухання й запис мелодії. Тут ви вибираєте її зі списку. Знайдіть до за акордом, а потім стежте за кожним рухом: угору чи вниз, крок чи стрибок.";
"L5b206df439" = "Який акорд є vi у C?";
"L5b2757c644" = "Від B до наступної ноти: який крок?";
"L5b3ab40010" = "Одна доля";
"L5b4d19a642" = "Цю мелодію вперше надрукували у збірці ірландської музики Джорджа Пітрі в 1855 році. Слова «Danny Boy» поклали на неї значно пізніше, у 1913.";
"L5b56b84455" = "Вібрато з'являється, коли голос вільний і має опору. Примусове хитання щелепою чи животом дає нестійке коливання.";
"L5b57dfbaff" = "Пропущена нота";
"L5b5d9c7ca6" = "Швидший темп потребує менше зусиль, а не більше. Тримайте кисть вільно й торкайтеся рухом від суглоба пальця, не від зап'ястка чи плеча.";
"L5b6055b519" = "Акорди з баре й синкопи";
"L5b72ac2ae5" = "Зигзаг, а не драбина";
"L5b72f1cd00" = "Відкрита E, назад до C і D на струні 2, потім E, F дієз і G на струні 1.";
"L5b73319e44" = "«Пісня човна до острова Скай» гойдається в шість восьмих. «O Christmas Tree» — на три, а «All Through the Night» — на чотири.";
"L5b739425ea" = "У блюзі A працюють обидва бокси. Мажорна пентатоніка на ладу 2 звучить солодко, мінорна на ладу 5 — суворо. Вправні музиканти переходять між ними.";
"L5b7d0278c6" = "Чотири інтервали в усіх варіантах";
"L5b809972b5" = "D, E та F дієз";
"L5b90e239db" = "Дезерт-рок";
"L5b9874ad31" = "Ключові знаки";
"L5b9f430ff6" = "Третім, на струні D";
"L5ba0846c7d" = "Баре спочатку дається важко. Що найкраще допоможе?";
"L5ba3d0bd26" = "Куплет починається на долю раніше, із затакту. Довга остання нота залишає цю долю вільною.";
"L5bacba7e1d" = "Рух на одну літеру вгору веде з лінійки до наступного проміжку або з проміжку до наступної лінійки. Ноти на сусідніх лінійках віддалені на дві літерні сходинки.";
"L5bb2c4c6f5" = "Перевірка восьмих";
"L5bb58088d4" = "Тризвуки в послідовності";
"L5bb64c45c4" = "Шістнадцяті, дві ноти";
"L5bd0ac44e7" = "Де другий дотик?";
"L5bd73fc956" = "W H W W H W W";
"L5bd822ea89" = "Яка септима лежить на лад нижче октави основного тону?";
"L5bdb895373" = "Родина D мінору — D мінор, G мінор і A7. A7 тяжіє додому, до D мінору, як E7 до A мінору.";
"L5bece8cfd8" = "Зіграйте D, E, F дієз, G на струні D, потім A, B, C дієз, D на струні A. Ті самі пальці двічі: відкрита, 1, 3, 4.";
"L5bef0ed765" = "Задайте тональність каденцією";
"L5bf5b6d904" = "Основні тони зі схеми акордів";
"L5bff6b57d3" = "П'ять грувів";
"L5c023fea92" = "Ноти на струні A";
"L5c0543142b" = "Ціла нота триває всі чотири долі. Торкніться один раз на 1 і тихо порахуйте 2, 3, 4, щоб наступна 1 настала вчасно.";
"L5c067fec77" = "Арпеджіо восьмими";
"L5c08c48eb7" = "Друга лінійка знизу — G, яку огинає скрипковий ключ.";
"L5c1817f5a4" = "Стрибки на октаву";
"L5c1e7ffe61" = "Спершу рівний звук";
"L5c228ef72c" = "G бекар на півтон вище за F дієз, тому другий палець стає впритул до першого.";
"L5c295e30fb" = "Знайомство з віолончеллю";
"L5c2cb44d0b" = "Крапки й паузи";
"L5c2fe433c0" = "Лише хамер-они";
"L5c3ec26bbd" = "Ліги тривалості";
"L5c47ff6ad3" = "Щоб заспівати ту саму ноту двічі, на мить зупиніть видих, а тоді почніть знову на м'яке «да». Не ковзайте між нотами.";
"L5c49265a7a" = "A мінор, p-i-m-a-m-i";
"L5c4bea20f2" = "Пересуньте руку вгору, щоб палець 1 став на лад 3. Тепер кожен палець охоплює один лад: 3, 4, 5 і 6. Великий палець теж пересуньте вгору, позаду пальця 2.";
"L5c65302b62" = "D, E і F на струні 4, потім G і A на струні 3.";
"L5c70a63a7d" = "Короткі рисунки, як до-ре-мі-ре-до, швидко розвивають точність. Заспівайте один, а тоді почніть на ступінь вище, орієнтуючись на гаму.";
"L5c7d93a81b" = "Знайомство: «Пізній виїзд»";
"L5c8558d5d5" = "Ця фраза йде вгору чи вниз?";
"L5c93ebdb3e" = "Низько, високо, низько, високо";
"L5ca845ae96" = "G, C, D, G";
"L5cb0a0bffe" = "Перебір через три пари";
"L5cc2c5012f" = "Відкрита G струни 5 не входить до D7. Поки що великий палець тримається струн 3 і 4.";
"L5cc3f9c6da" = "Завершіть упізнаваним мотивом";
"L5ce294ca6f" = "Великий і середній разом";
"L5cf2129767" = "П'ять ступенів: від до до соль";
"L5cf7c86c4c" = "Перевірка контролю";
"L5cffb13f9a" = "Половинні, повільніший смичок";
"L5d04369de5" = "Заспівайте до, ре, мі на C, D, E.";
"L5d0ad0fc65" = "Ретропрограма";
"L5d0e8c4208" = "Від E до наступної ноти: який крок?";
"L5d0f30ba50" = "Тон, тон, потім півтон від 3 до 4; тон, тон, тон, потім півтон від 7 до 8.";
"L5d2826f313" = "Струна 3: G і A";
"L5d288a10b1" = "Що триває стільки ж, скільки четвертна з крапкою?";
"L5d28917df7" = "Балада пальцевим перебором";
"L5d2b5b9774" = "Та сама аплікатура працює від струни 5. Палець 1 на струні 5, ладу 3 дає C5. Кінчиком пальця 1 торкніться струни 6, щоб вона мовчала.";
"L5d2d5a00d5" = "B, C, D — терція з трьох півтонів: мала.";
"L5d3468e2a0" = "Якщо пальцям тісно, нахиліть їх: кожен має бути трохи навскіс перед ладовим поріжком. Не торкайтеся струни 1, щоб вона звучала.";
"L5d3c4cb4c4" = "Як довго має звучати приглушений удар у регі?";
"L5d43afb2a2" = "Базарний день";
"L5d4b37b67c" = "Ця мелодія йде від струни 5 до струни 1. Що допоможе діставати всі струни?";
"L5d538c9b62" = "«Неділя біля моря» — авторська пісня Timbre: неквапливе регі в A мінорі, де Am7 і D7 чергуються тактами. Обидва бокси пентатоніки підходять. Грайте хамер-они, пул-офи й слайди, починайте такти акордовою нотою. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L5d5cd8b1c4" = "2 і 4";
"L5d68b7e4ac" = "Вона піднімається до довгої E";
"L5d7b2934d4" = "Відлуння Генделя";
"L5d7cef323e" = "Sarah Josepha Hale (1830)";
"L5d89aa22bd" = "Сильний удар на першу долю";
"L5d8eb567e2" = "Бетховен у низькому регістрі";
"L5d9c113b57" = "Town";
"L5dab3832af" = "Каподастр, аплікатури G і D з каподастром на 2 та «О, Сюзанно» з куплетом і приспівом.";
"L5db362c3bc" = "Струна 3, лад 3, третій палець.";
"L5dc0bfe304" = "Яка нота на півтон вище E?";
"L5dc6589c07" = "A, потім C на струні 5, E та A. Далі B, E, G дієз на ладу 1 струни 3 та B.";
"L5dd85395a1" = "Яка з них — відкрита струна G?";
"L5de6270d77" = "Перш ніж співати, на секунду почуйте ноту в уяві. Ця пауза допоможе голосу відразу націлитися на висоту, а не шукати її.";
"L5ded105f41" = "Shenandoah";
"L5df3a182bb" = "Народне попурі";
"L5df42cd32b" = "Під час удару великий палець спирається на п'яту струну. На наступну долю він проходить крізь неї, коли рука піднімається.";
"L5e0badd310" = "Перший рядок: відкрита D, E, чотири відкриті G, спуск до B на струні 5, потім додому до G.";
"L5e31a53ca0" = "Аплікатура D, струна за струною";
"L5e46546af1" = "Куди посунути смичок, щоб грати форте?";
"L5e61ddbe60" = "Колядка з Філадельфії";
"L5ea1e1b5db" = "Прикраси: «Старий Джо Кларк»";
"L5eb3cba827" = "Поділіть долю навпіл";
"L5ebd5cc8aa" = "Тон — два півтони, а кожен лад — півтон. C стає D, а G стає A.";
"L5edd62cd1e" = "Між нотами 3 і 4 та 7 і 8";
"L5ee75a46ea" = "Чоп — короткий акорд на долях 2 і 4. Ударте вниз, потім послабте притискання, не відриваючи пальців від струн, щоб звук відразу припинився.";
"L5eeb230a51" = "Тримайте медіатор між подушечкою великого пальця й боком зігнутого вказівного. Нехай виступає лише кінчик. Зап'ясток вільний, ніби струшуєте воду з руки.";
"L5ef37ace42" = "На якій ноті мелодія знаходить спокій?";
"L5ef3f68e90" = "Тональність — це музична домівка пісні. У тональності G головну роль відіграють акорди G, C і D. Безліч фолкових і рок-пісень обходяться лише ними.";
"L5f0aa6a4b7" = "Тримайте кожну довгу ноту й погойдуйте її малим, рівним підтягуванням і відпусканням. Амплітуда вузька: висота має коливатися, а не блукати.";
"L5f17243700" = "Акцент стосується сили, а не тривалості. Ноту просто грають сильніше.";
"L5f379602c3" = "Чергує струни 3 і 4";
"L5f380cb28f" = "Трель";
"L5f3c33cec0" = "Від колодки до кінчика";
"L5f46a3d91b" = "Довгі витримані основні тони";
"L5f5706be4a" = "Блюграсовий акомпанемент";
"L5f6d14e352" = "Які ноти утворюють E мажор?";
"L5f709f471f" = "Струни 1 і 2";
"L5f790c22cb" = "Басові лінії епохи Motown багато рухалися: звуки акордів, ноти-підходи до наступного акорду й акценти між долями. Ця лінія нова, написана в тому дусі.";
"L5f8b0a6d18" = "D і D мінор";
"L5f940a5b65" = "Dm7 на ладу 5. Де його основний тон?";
"L5fa00666ea" = "Тепер D, потім A.";
"L5fb1db5278" = "Секунди";
"L5fb4562659" = "П'ять нот, одна ніжна мелодія";
"L5fbc8a707e" = "A четвертим пальцем на струні D, відкрита A, потім знову четвертий палець. Доможіться точного збігу.";
"L5fbdb73163" = "Ваш четвертий палець";
"L5fbe60e018" = "Вершина: три A, угору до F дієза на ладу 2 струни 1, потім E E D B D, A F дієз D.";
"L5fc3444ce4" = "Великий, вказівний, середній";
"L5fd07fade8" = "Секунди на акорд";
"L5fef0931cc" = "Основний тон чи ні? Слухайте найнижчу ноту.";
"L5ff6946aec" = "«Базарний день» — авторська пісня Timbre: сонячний поп у G з пружним ритмом хайлайфу, яскравої гітарної музики Західної Африки. У мотиві лише ноти G мажору, тож він лягає в гаму другої позиції. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L600e2dce19" = "Струна 1, лад 3";
"L601d7efe00" = "Рефрен";
"L60229f5c78" = "Для слайду щипніть ноту й, не послаблюючи тиску, пересуньте той самий палець на інший лад. Тиск зберігає звук; щипають лише першу ноту.";
"L6027a15546" = "Кроки й півтони";
"L6030ff6791" = "D на ладу 3 струни 2, відкрита B й назад, потім відкрита E та F дієз на ладу 2 струни 1.";
"L603a7315ae" = "Дати їй відзвучати";
"L603b077f43" = "Основний тон відкритого D — відкрита струна 4. Після перенесення його тримає палець 1: G на ладу 5. Струна 2, лад 8 — теж G.";
"L60416d96dc" = "З каподастром ви й далі мислите знайомими аплікатурами G, C і D. Тут схеми називають акорд, який справді звучить, тож аплікатура G з каподастром на 2 позначена A.";
"L6046c05006" = "Home! — ціла нота: тримайте D на ладу 3 струни 2 протягом усього такту.";
"L60486c0a4b" = "Септакорди простим способом";
"L6049def04f" = "Паузи теж рахують";
"L604ac866f0" = "Стійте рівно й вільно";
"L6053efe7e3" = "Пальцева гра запозичила іспанські назви: p — великий, i — вказівний, m — середній, a — безіменний. Поставте i на струну 3, m на струну 2, a на струну 1, готуючись до щипка.";
"L60567af0fd" = "C, A7, D7, G7, а потім додому, до C. Кожен септакорд тяжіє до наступного — ланцюжок напруги. Століття тому на ньому будували безліч пісень.";
"L6063ec8dfa" = "Приспів перебором";
"L6065bcf219" = "Терціями вгору по гамі";
"L60715612f0" = "G мажор угору й униз";
"L608e8768cd" = "Третім пальцем на струні D";
"L60948f8372" = "Чорні клавіші, найменший крок і ноти з двома назвами.";
"L609651b67b" = "Він охоплює вісім літерних назв";
"L60db049169" = "G D A E";
"L60dea2df67" = "Робить короткою й уривчастою";
"L60f61fb4e2" = "Нічого нового: E, F і G на струні 1, B, C і D на струні 2. Почніть повільно, потім тримайте рівний темп.";
"L60f6f7bc7e" = "Не зупиняйте маятник";
"L6128108d6c" = "Та сама аплікатура на двох нижчих струнах, D мажор і три мелодії.";
"L6129f8fd2f" = "Усі чотири струни";
"L61378dcfa1" = "При зміні акорду великий палець грає новий основний тон точно на першу долю. Решта пальців і далі щипають струни 2 і 3.";
"L613a306f82" = "Яким пальцем грають лад 5 у цій позиції?";
"L613b9483be" = "У вступі й соло";
"L6142dc5601" = "Знову друга тема";
"L614f875fca" = "Цей бокс на ладу 2 — також мінорна пентатоніка F дієз, якщо почати з F дієза. Нота, яку ви вважаєте домівкою, визначає, яку з них ви граєте.";
"L6152642fb8" = "Пара 2: відкрита, лад 2, лад 4, лад 5.";
"L6153371910" = "Лад 3 належить до зони другого пальця — ладів 3 і 4.";
"L616a1bd784" = "Джазові музиканти зазвичай додають септими: Dm7, G7, Cmaj7. Додаткові ноти роблять кожен перехід ще плавнішим. Основні тони й шлях додому лишаються тими самими.";
"L616b46e903" = "«Ода до радості», другий рядок";
"L6181145819" = "Тримайте медіатор близько до струн, а удари — рівними. Швидкість прийде пізніше, коли рух стане вільним.";
"L6191fba215" = "Що робить вступ?";
"L61992ffcfb" = "Струна 2, лад 4";
"L61a7fd6fc3" = "Кожна мажорна гама має одну формулу кроків: тон, тон, півтон, тон, тон, тон, півтон. Почніть із будь-якої ноти й дотримуйтеся її — побудуєте мажорну гаму.";
"L61ac361d21" = "Що таке зміна позиції";
"L61b524f257" = "Коли повітря мало, висота знижується. Завершіть трохи раніше, щоб уся нота лишилася чистою.";
"L61d442d352" = "Приспів починається високо: D на ладу 3 струни 2, C дієз на ладу 2, відкрита B, потім униз до відкритої D.";
"L61da910eb5" = "Пекарка Анджеліна";
"L61e018ea94" = "Короткі удари та D9";
"L61e1dfe135" = "П'ять спрощених традиційних джемових мелодій, від мелодії «Вари капусту» до мелодії «Старий Джо Кларк».";
"L61ec307304" = "Поставте палець 1 на лад 2 й дайте кожному пальцю свій лад, аж до ладу 5. Від G на струні 6, ладу 3 гама підіймається струнами 6, 5 і 4.";
"L61ee1ab807" = "Де зупиняється палець після щипка з опорою?";
"L61f1c8da71" = "Пронумеруйте гаму від G: G — 1, A — 2 і так до F дієза — 7. Цими числами музиканти описують мелодії й акорди в будь-якій тональності.";
"L61fc25fa4f" = "Перша доля";
"L62137e8c2f" = "Шість пісень за один раз";
"L62175f3821" = "Нічого нового: G мажор у дві октави, гама терціями, дорійський A та міксолідійський D. Зберігайте по одному пальцю на лад.";
"L621c5e6bc0" = "Довго-коротко на три";
"L621f8b64c0" = "Дванадцять тактів";
"L622c702c21" = "Пісенник для укулеле";
"L623729eeb4" = "Інтервал — відстань між двома нотами. Унісон не має відстані: та сама нота двічі. Октава йде від однієї літери до тієї самої вище, як від C до C. Звучить ніби одна нота, тільки яскравіше.";
"L62490fbda1" = "Низька частина, друга половина";
"L625278775b" = "Початок той самий, завершення інше. Другий рядок повертається додому, до C.";
"L625d141f7d" = "Палець 4 на струні 1";
"L6271a044a6" = "Бетховен написав цю фортепіанну п'єсу в 1810 році, але її опублікували лише в 1867, через сорок років після його смерті. Ця спрощена версія зберігає відомий початок.";
"L62773cc1b4" = "Зіграйте струни 6, 5 і 4 по черзі.";
"L62781903b0" = "Щипніть струну 1 великим пальцем і дайте їй звучати.";
"L6281828c75" = "Перша мелодія для джему";
"L628db1ad7e" = "Такт — одна група долей. Тут кожен такт має чотири долі, що записують як 4/4. Доля 1 починає кожен такт, тож трохи наголошуйте її під час лічби.";
"L62ab25cde7" = "Чиста квінта";
"L62ba9ae8e4" = "Обернення G і D";
"L62bb50e1c3" = "Який акорд — Cmaj7?";
"L62c4d6152c" = "Пара 3, лад 2, перший палець.";
"L62d40dd812" = "Перший палець на ладі 1 струни 2, другий — на ладі 2 струни 3. Струни 4 і 1 звучать відкритими. П'яту пропустіть: її G конфліктує з D7.";
"L62f0a6aab6" = "В одній парі чутно повільну пульсацію. Що не так?";
"L62fa3abe46" = "Два напрямки";
"L62fb1d70f8" = "Палець 1 тримає струну 5 на ладу 3 й лежить упоперек до струни 1. Палець 3 — на струні 4, палець 2 — на струні 3, палець 4 — на струні 2.";
"L630868a13b" = "Це випробування поєднує ліги й крапки. Рахуйте кожну восьму вголос: утримана нота все одно займає всю свою тривалість.";
"L6311ef1e1f" = "Три долі: половинна нота (2) плюс її крапка (1).";
"L63190e07e0" = "До появи записів родини співали ці пісні вдома біля фортепіано. Тут вони звучать поспіль, а завершує їх розлога мелодія Голста.";
"L632198cb87" = "Класичні теми II";
"L63233a5412" = "Унісон, октава, квінта й кварта — кожен із мелодією, яку можна наспівати.";
"L6335412816" = "Які пальці грають D мажор на кожній струні?";
"L634209dd7c" = "Кожна нота тут — четвертна, половинна чи ціла. Рахуйте чотири рівні долі в такті й дайте довгим нотам звучати.";
"L6355e11493" = "D, E, F: три літери.";
"L63881ab90d" = "I, IV і V";
"L638f400164" = "Синкопа ставить акцент між долями. На початку кожна C припадає на «і». Рахуйте раз-і-два-і й відчуйте, як C тягне вперед.";
"L639b70b19b" = "Гірський мінор";
"L63a15ae368" = "Лад 1 струни 2";
"L63a5f6c540" = "В обох акордах притискають лад 2 на струнах 3 і 2. Змінюються лише крайні струни.";
"L63abb5650f" = "Сім";
"L63b4995f45" = "Унісон і повтори";
"L63b5f26523" = "У шість восьмих четвертна й восьма складають одну велику долю: довго, коротко. Рахуйте раз-два-три, чотири-п'ять-шість; грайте на раз, три, чотири й шість.";
"L63bb4a431f" = "Зайвий тиск часто підвищує ноту, а дуже тихі ноти можуть занижуватися. Стежте за висотою в обох випадках.";
"L63d01fe4fe" = "Між підставкою й накладкою грифа посередині";
"L63dcadbd78" = "П'ять мелодій поспіль, по одній фразі з кожної. Вдихайте на кожній паузі й наново починайте повторювані ноти.";
"L63e8cf2011" = "Яка нота на тон вище B?";
"L63f358c905" = "Це найскладніша частина";
"L640134fefa" = "Пара A працює так само: відкрита — A, лад 2 — B, лад 4 — C♯, лад 5 — D. Рука залишається на місці.";
"L640b18da1f" = "Класичне попурі";
"L6416c8c03f" = "Спадає";
"L641a2740f3" = "Мелодія";
"L6425315084" = "На першу й третю";
"L6439513619" = "Яке слово тягнеться на дві ноти в першому куплеті?";
"L644b2e3eb5" = "На ладах";
"L6455adb054" = "Ваше соло";
"L6478bdaaa1" = "Попурі гімнів";
"L647e4d73c5" = "Угору й додому";
"L648307a100" = "Коли припадає удар угору?";
"L64846fd98f" = "Гітарне соло";
"L648ac30e5c" = "Малий F, D7 та дві народні пісні з акордами й мелодією.";
"L648bfd8404" = "Острівний бій зі змінами";
"L649b215476" = "Пара 3: відкрита, лад 2, лад 4, лад 5.";
"L64afb60dbd" = "Що робити під час паузи?";
"L64e238b935" = "На 1 і 4";
"L64e6a5eeed" = "Ця версія в E мінорі, у першій позиції: мелодія рухається чотирма струнами з пальцями від 1 до 4, а схема акордів — для тих, хто акомпанує вам.";
"L64e9fb8ad9" = "Зіграйте чи заспівайте два півтони на білих клавішах: від E до F, потім від B до C.";
"L64f341465b" = "Відкрита 3, струна 2 лад 1, відкрита 1, струна 2 лад 3, струна 1 лади 1 і 3.";
"L6501930589" = "Нота та сама чи інша?";
"L650634caa9" = "Якій відкритій струні відповідає лад 3 на струні 2?";
"L6509372805" = "Знайомство: «Галоген»";
"L6512fd6029" = "Основний тон, терція, квінта";
"L651aaf0899" = "Кожен дотик має назву";
"L653eb46bda" = "Віолончель нахилена до грудей, а коліна легко підтримують її з боків.";
"L654648b7f9" = "Грає лише на долю 1";
"L655060742f" = "Підніміть непотрібний палець і поставте інший, поки ще звучить останній удар. Думайте наперед про наступний акорд.";
"L65572eaf06" = "Стівен Фостер написав цю пісню про перегони в 1850 році, через два роки після «О, Сюзанно». У ній ті самі ноти й ті самі два акорди.";
"L656206b093" = "Скільки тактів A на початку 12-тактового блюзу?";
"L65626dc943" = "Цю мелодію надрукували в 1582 році у фінському пісеннику Piae Cantiones як пісню про весну. Джон Мейсон Ніл написав до неї різдвяні слова в 1853 році.";
"L65790ce0d0" = "12-тактовий блюз";
"L658534e988" = "Восьмі вгору до A";
"L6586ce1f1f" = "У пісні «О дивна благодать» три долі в такті. Тримайте тремоло на кожній довгій ноті й змінюйте ноти точно на долю. Дві нові ноти — A і B на парі G.";
"L65a24ccc47" = "Друга половина починається високо: четвертий палець дістає B на струні E. Потім третій, потім низький 2.";
"L65b5eedd25" = "Попурі з перших нот";
"L65da260ff1" = "Тепер найтовща струна, C. Дайте їй загудіти.";
"L65dc0bc434" = "G, H";
"L65fc8eeea6" = "Приблизно стільки ж";
"L66059b65aa" = "У звичайному A мінорі є F. Дорійський лад зберігає F дієз із G мажору — світлу барву в мінорній гамі.";
"L661b9e9f2e" = "Один бокс на все коло";
"L661f67974f" = "Він замінює приспів";
"L66239be110" = "Унісон: та сама нота";
"L6636558793" = "Сядьте рівно, виставте шпиль, м'яко тримайте смичок посередині між підставкою й накладкою грифа. Тепер зіграйте все з цього розділу.";
"L664305ffb2" = "Від D до F перестрибуємо через E, тож це стрибок — терція.";
"L6643ee2897" = "F і C";
"L664688a0e9" = "Лад за ладом";
"L6646d01d84" = "Поп у 6/8";
"L6651a17acc" = "Відкрита D, E та F дієз на струні 4, потім стрибок до D на ладу 3 струни 2 й униз C дієз, B та A.";
"L66573d54aa" = "Два стрибки вгору";
"L6693552855" = "Крокуючий блюз в A";
"L66a2e1bb47" = "Увесь пісенник у тональностях укулеле, від початку до кінця";
"L66ae417c89" = "Униз на число, угору на «і». За кожну долю рука один раз рухається вниз і вгору.";
"L66ba679c70" = "Знайдіть пульс, рахуйте до чотирьох і відбивайте вчасно.";
"L66d9448f4d" = "«Шум на дев'ятому каналі» — панк: чотири квінтакорди, восьмі з глушінням долонею, 104 долі за хвилину. Куплет бурмоче низько, а приспів — гуртовий вигук, тож грайте завзято.";
"L66fa22185a" = "Восьма нота триває пів долі, тож на долю припадає дві. Грайте короткими швидкими рухами біля середини смичка.";
"L66fbb37faf" = "Ви переходите на іншу пару на «і». Який удар?";
"L670d6914c0" = "Акорди задають тональність, потім звучить одна нота. Спершу знайдіть до, а тоді назвіть ноту. У всіх тональностях діє той самий принцип.";
"L670e7fd853" = "Ви нижче потрібної ноти, тож трохи підніміть висоту.";
"L671c1ff474" = "Перша фраза завершується нотою з крапкою. Як це відчувається?";
"L67278e4178" = "Куплет і приспів";
"L672fd54460" = "C мажор, друга октава: другий палець для F і верхньої C.";
"L6739b9a584" = "Затакт і перший такт: відкрита G, A на ладу 2, потім відкрита B, двічі D на ладу 3 та відкрита E.";
"L67684dd3f9" = "Для «У Мері було ягнятко» потрібні три ноти: відкрита струна 2 — B, лад 2 на струні 3 — A, а відкрита струна 3 — G. Ноту A грайте другим пальцем.";
"L67695d722e" = "Відповідь на риф";
"L676e1e1bc9" = "Доля 3";
"L677297f490" = "Початок: D, G, B G, B, A. Відкриті струни 4, 3 і 2, а також A.";
"L6776fd531f" = "Штовхають три пальці";
"L6777925e65" = "Покладіть палець 1 поперек струн 3, 2 і 1 на ладі 2, а пальцем 3 дістаньте до струни 4, ладу 4.";
"L67920ab8cb" = "На один лад нижче";
"L67a8f1045a" = "За формулою від D нотою 3 стає F♯, а нотою 7 — C♯.";
"L67baf4caa8" = "Від D до F — мала терція; від F до A — велика.";
"L67c3806843" = "D, DU, UDU";
"L67c948a825" = "Скільки півтонів від D вгору до F?";
"L67d0dcf34e" = "Нота тривалістю дві долі";
"L67db55e61d" = "Нота, від якої будують тризвук, — його основний тон. Середня нота — терція, верхня — квінта: їх названо за відстанню над основним тоном.";
"L67ef0e743a" = "Грати голосніше";
"L67f0897e60" = "Поставте кінчик першого пальця на струну A на першу смужку. Це B, на тон вище за A; тон дорівнює двом півтонам. Притисніть струну до накладки грифа.";
"L67f2b8db53" = "C, p-i-m-a";
"L680e20c077" = "Усім відомі мелодії від початку до кінця";
"L6824a5dc37" = "Різні";
"L68262bf228" = "A в четвертій позиції, відкрита A, A в четвертій позиції. Доможіться одного звучання.";
"L68275325bd" = "Якої струни ця мелодія не використовує?";
"L6829fbcb04" = "Від до до до: від C вгору до наступного C.";
"L6854c89618" = "Яка нота на ладі 3 струни 4?";
"L6859188a0b" = "Тримайте акорд, щипайте мелодію";
"L686fe0d2fa" = "Покладіть палець 1 поперек струн 4, 3 і 2 на ладі 2, а палець 2 поставте на струну 1, лад 3.";
"L688a376adc" = "Скільки шістнадцятих уміщується в одній долі?";
"L689041fa42" = "Низький 2 і високий 2 на струні A, потім низький 2 і високий 2 на струні E.";
"L68a5d9377b" = "«Хор на даху» — гімн стадіонного масштабу, 92 долі за хвилину. Ви граєте приспів у C, потім один такт A піднімає все на тон, і приспів повертається в D.";
"L68a9c445ed" = "Пальці з медіаторами щипають угору";
"L68b0c5bf55" = "Звідки береться висока G у першому такті?";
"L68b2b09c89" = "A♭";
"L68d4c57c61" = "Якщо можете, грайте повне баре B мінор на ладу 2. Якщо ні, беріть чотири верхні струни: лад 4 на струнах 4 і 3, лад 3 на струні 2, лад 2 на струні 1.";
"L68d4cfda41" = "B7 тяжіє до E. Його напруження розчиняється в E мінорі або E.";
"L68d6126c37" = "Який акорд утворюють D, F♯ та A разом?";
"L68d9990b7c" = "A7: той самий прийом";
"L68dba3a68d" = "Останній рядок піднімається від відкритої D на струні 4: E, F дієз на ладу 4, відкрита G, потім A.";
"L68fd09b287" = "Міцне стискання лівою рукою";
"L68fd5ef7e1" = "Темп зростає. Якими мають бути дотики?";
"L690a93e955" = "Бридж";
"L690aa0b88d" = "У четвертій позиції перший палець грає D на струні A — ноту, яку четвертий грав у першій позиції. Великий палець стає там, де шийка грифа переходить у корпус.";
"L690ab2befe" = "Сусідні ноти";
"L6918767a98" = "Синкопа: між долями";
"L6918c2a4bb" = "Яка нота є квінтою тризвуку D F A?";
"L691f903820" = "Його не використовують";
"L691f9c22d1" = "Самі акорди";
"L693752b4ae" = "Грати бій і підхопити наступний акорд";
"L6941e683a3" = "Оскільки струна 4 — висока G, малюнок іде зигзагом: високо, низько, а далі вгору. Це іскристе звучання й вирізняє пальцеву гру на укулеле.";
"L694f5f09fe" = "Де слід вдихати в цій пісні?";
"L6952d23be8" = "B5";
"L695d14c16d" = "На два лади вище від G — A. Назва акорду рухається разом з основним тоном.";
"L696010416e" = "Велика септима";
"L696cd74a3d" = "Сидячи рівно, щипніть D, потім G. Не напружуйте плечі.";
"L6971957b55" = "На початку кожного такту лічба знову йде від 1.";
"L6973e1fed9" = "Приспів";
"L697ea8051a" = "З CAGED рідко потрібно стрибати. Біля ладу 5 G має аплікатуру D, C — аплікатуру G, а D — аплікатуру A. Три акорди, одне місце.";
"L6980bcdcd2" = "Турецьке рондо";
"L698eca6ecd" = "Пауза, потім дотик на «і»";
"L69a3fc0ffb" = "Рухайте ліктем";
"L69acddb13a" = "Нічого нового: по пальцю на струну, перебір туди й назад, чергування великого пальця та мелодія всередині акорду.";
"L69ba79c271" = "Перевірка зміни позицій";
"L69c68aba96" = "Speed, bonnie boat, like a bird on the wing: відкрита D, E, D, три відкриті G, потім A, B, A й угору до D.";
"L69d4feab52" = "Стрибнути набагато вище";
"L69d6c14191" = "«Стробоскоп у сповільненні» — авторська пісня Timbre: синті-поп у A на F дієз мінорі, D, A і E. Бокс на ладу 2 підходить до всього кола: це мажорна пентатоніка A, вона ж мінорна пентатоніка F дієз. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L69db2318a3" = "Пісня мандрівних торговців";
"L69dca66da6" = "Діліть кожну долю навпіл і рахуйте «і».";
"L69dd77610a" = "Струна 3: лади 2 і 4. Щипніть один раз, потім робіть хамер-он і пул-оф пальцем 3.";
"L69e8d3e991" = "Яка відкрита струна дає найнижчу ноту?";
"L69f444cda2" = "Три ноти утворюють акорд";
"L6a0141eeb5" = "Ви збилися на зміні посеред пісні. Що далі?";
"L6a04869038" = "Чергуйте баси";
"L6a06751695" = "Перші акорди";
"L6a09029e91" = "Від V до I — музична крапка.";
"L6a1333dc6b" = "Колискова Брамса";
"L6a266df3b3" = "Цей цикл із чотирьох акордів лежить в основі безлічі поппісень. У C мажорі це C, G, A мінор, F. Мінорний vi додає трохи тіні, перш ніж IV підніме звучання назад до дому.";
"L6a3f43a116" = "Відкриті й рухомі квінтакорди, глушіння долонею та власний риф.";
"L6a44f899d9" = "Який акорд у такті 9 12-тактового блюзу?";
"L6a4544fbab" = "Пальці, стискаючись";
"L6a490b5529" = "F — нижня нота, від якої побудовано тризвук.";
"L6a6239acaf" = "Яка струна відкрита і в E мінорі, і в G?";
"L6a6a771c43" = "Це верхня клавіша групи з трьох, безпосередньо під B: A♯, також звана B♭.";
"L6a6f0851c4" = "П'ять великих гімнів із довгими співучими нотами, від 1708 до 1861 року.";
"L6a92c479e4" = "Канон у D";
"L6a9a1b22eb" = "A мінор і G7";
"L6a9f85fba7" = "Ще одна пісня Фостера, з 1850 року. Мелодія стрибає між G та E, а короткий двонотний вигук відповідає кожному рядку.";
"L6aa7d512c9" = "Приспівна фраза";
"L6aa9536f2f" = "Перший на струні A";
"L6ab1a75a8e" = "Повільний танець на кухні";
"L6ab4d49036" = "Тема низько";
"L6abdd41c99" = "Соль фа мі до";
"L6ac7078ce0" = "Випробування: перша програма";
"L6acfb01639" = "Тепер найвища пара, пара 1.";
"L6ad11e23fa" = "На паузах між фразами";
"L6adc0545bd" = "Перший куплет";
"L6afe128204" = "Навпаки: притисніть лад 2, зіграйте медіатором, потім трохи потягніть палець убік, піднімаючи його. Цей рух щипає нижчу відкриту ноту.";
"L6b0d31c0d5" = "m";
"L6b21c99836" = "Лише тремоло";
"L6b2622171f" = "На струні 5 відлік іде від A: B на 2, C на 3.";
"L6b3901090e" = "Знімається вбік, щипаючи струну";
"L6b41c35f36" = "Ця чорна клавіша безпосередньо над F. Яка її назва з дієзом?";
"L6b484d8196" = "Інша техніка правої руки: бийте нігтем униз і підхоплюйте бурдон великим пальцем.";
"L6b4ea01575" = "Ви граєте G на ладу 3. Де найближчий C?";
"L6b5e864f14" = "На «бум» щипніть лише найнижчу ноту акорду, його основний тон: відкрита струна 5 для A, 4 для D, 6 для E. На «чік» проведіть по тонших струнах.";
"L6b73bd8277" = "Заспівайте E тричі на «да», щоразу з крихітним проміжком.";
"L6b7439b401" = "Мі";
"L6b83007605" = "Відкрита, 2, 3, 4";
"L6b851d6bd1" = "Яку форму має кисть у клоухаммері?";
"L6b8a8c1719" = "Ви постійно граєте трохи після клацання. Що допоможе?";
"L6b96408a7c" = "Повторюйте й варіюйте";
"L6b985b7dd5" = "D♯ і E";
"L6ba8291e3f" = "Яка нота є в F мажорі?";
"L6bb5e2c3fa" = "Кінець куплету";
"L6bb87f0675" = "Крапка додає половину";
"L6bc22c63a1" = "F — це F, A і C. У боксі 1 є A і C, тому на акорді F вони звучать стійко.";
"L6bcd9f5b3a" = "Торкнутися знову";
"L6bd4241ace" = "Тиснути сильніше, долаючи це";
"L6be64bc72f" = "Інді-поп, рок-балада, хайлайф, неосоул і гімн зі зміною тональності, з баре F і B мінор.";
"L6be91b6851" = "Повторює основний тон";
"L6c09947fc9" = "Яка нота належить G мажору?";
"L6c0db1e116" = "В обох терція внизу: на струні 3 — на один лад вище, дві інші ноти на одному рівні. Та сама аплікатура за п’ять ладів.";
"L6c0e1d8958" = "Високим 2 на струні D";
"L6c116fd3ab" = "Тріо";
"L6c33fc06dc" = "Бенди й вібрато";
"L6c3a5b85c6" = "E мажор: додайте один палець";
"L6c3e7e3c76" = "Права рука визначає, якої струни торкається смичок. Кожна струна має свій рівень руки, як сходинка. Рухайте всією рукою, не лише кистю.";
"L6c491db365" = "Малі гвинти на струнотримачі — машинки тонкого налаштування. За годинниковою стрілкою вони підвищують звук, проти — знижують. Чверті оберту цілком досить.";
"L6c5383ef15" = "Живіт і нижні ребра";
"L6c5d28d3ad" = "«Карусель перед закриттям» кружляє на три, наче атракціон, що сповільнюється: ум-па-па, 96 долей за хвилину. Рахуйте раз, два, три, з наголосом на раз.";
"L6c65dbe5e7" = "Cecil Frances Alexander (1848)";
"L6c65f3cae3" = "Скільки тріольних нот уміщується в одній долі?";
"L6c6c38ee17" = "Друга половина";
"L6c79a5739e" = "Знайомство: «Шафл Іржавого поясу»";
"L6caa2001f9" = "Підняття просто вгору лише зупиняє ноту. Легкий рух убік щипає відкриту струну.";
"L6cc385b2c8" = "Струни E та A";
"L6cca5c6c7d" = "Бам-ді-ті на C";
"L6ccca6a2ed" = "У такті з чотирьох долей є половинна й четвертна ноти. Чим заповнити решту?";
"L6ce6fb0543" = "Униз, до підлоги";
"L6ce9734f6e" = "Який палець грає C на струні G?";
"L6ce9ba793e" = "Від F вгору до A — це…";
"L6cf2d329e4" = "Що робить великий палець у переборі Тревіса?";
"L6d0a56720c" = "Dm7: палець 2 на струні 3, лад 2, палець 1 пласко на струнах 2 і 1 на ладу 1. Em7: лише палець 2 на струні 5, лад 2.";
"L6d0ce5b09d" = "Авторські пісні в сучасних стилях";
"L6d0e5b7e51" = "Марш переходить із A мінору в A мажор: C стає C дієзом на ладу 2 струни 2. Мелодія раптом світлішає.";
"L6d17d6f3d1" = "Униз на долю й угору між долями допомагає руці тримати ритм, як паличкам барабанщика.";
"L6d1bcd1968" = "Фраза зі слайдом";
"L6d2857de41" = "Випробування: мелодії";
"L6d329f74b9" = "Половинна нота заповнює дві з трьох долей. Торкніться на 1, порахуйте 2, торкніться на 3. Це наче великий і малий кроки вальсу.";
"L6d4859c613" = "A, B, C дієз. Не піднімайте перший палець, коли грає другий.";
"L6d551518d4" = "Струна A в G мажорі: другий палець низько, торкається першого.";
"L6d5e9572eb" = "Увесь час";
"L6d611c78b6" = "Затискач поперек грифа";
"L6d728b915c" = "На якому слові мелодія спускається до низької D в першому куплеті?";
"L6d7ea55826" = "Півтон і тон";
"L6d9391f723" = "Бенд зсуває струну поперек ладу, підвищуючи звук. Бенд на цілий тон, тобто на два лади, від ладу 7 має звучати точно як лад 9.";
"L6da4df5e98" = "Домінантсептакорд";
"L6daff2d5e5" = "Мандоліна має вісім струн, об'єднаних у чотири пари — хори. Дві струни пари налаштовані на одну ноту й грають разом, тож кожну пару сприймають як одну струну.";
"L6dbbe71427" = "Зіграйте струни 4 і 3 по черзі.";
"L6dcd4ce23d" = "A";
"L6dcffdfe3b" = "Яка нота на півтон нижче B?";
"L6dd77c71ef" = "Приспів: E E D C, потім C E G G G F.";
"L6dddb64ee4" = "Хартленд-рок";
"L6de1c1020b" = "A C E G B";
"L6df8685365" = "Який основний тон акорду D?";
"L6dfa63b1e7" = "Поєднуйте довгі й короткі";
"L6e09e914bc" = "Подовжуйте ноти через долю за допомогою ліг і пунктирних ритмів.";
"L6e0de553ed" = "Влучайте точно в долю";
"L6e0fc83c2b" = "Гама: довго, коротко-коротко";
"L6e1bf8743d" = "Басовий ключ — це ключ F: його крапки обрамляють лінійку F.";
"L6e293cb133" = "Півтони";
"L6e2d3f0b55" = "На струні 5 відлік іде від A: B на 2, C на 3, C дієз на 4.";
"L6e4a00070b" = "Знайомство: «Погода для повітряних зміїв»";
"L6e5c726d4d" = "Тринотний малюнок, повторюючись у такті з восьми нот, щоразу зміщує акцент. Це й створює хвилеподібне відчуття.";
"L6e6a60a89b" = "До ре до";
"L6e7163b180" = "Вальсовий бій";
"L6e7ab92ea9" = "Восьма нота триває пів долі, тож у кожній долі їх дві. Вісім таких нот заповнюють такт 4/4.";
"L6e7ad389a8" = "Відкрита G, E на ладу 2 струни 4, A на ладу 2 струни 3, G, потім C на ладу 1 струни 2, C, відкрита B й C.";
"L6e7c200b38" = "Зберігайте аплікатуру E мінору й додайте перший палець на струну 3, лад 1. Ця одна нота перетворює мінор на мажор.";
"L6e7f09ca20" = "Які пальці торкаються на струні A?";
"L6ea2cfee4e" = "Усе разом";
"L6ea8d54e79" = "Удари вгору природно тихіші. На шляху вгору торкайтеся лише трьох-чотирьох тонших струн. Це надає ритму легкості.";
"L6eac4b11f3" = "Синті-поп, госпел-поп, похмурий поп, інді-поп і фінал у 6/8, сповнені синкоп.";
"L6eba02a654" = "Вальс музичної скриньки";
"L6ed49a2fcf" = "Безліч народних, рок- і кантрі-пісень мають лише три акорди: I, IV і V. У C мажорі це C, F і G. Разом вони містять усі ноти гами.";
"L6ede73e021" = "Стробоскоп у сповільненні";
"L6ee0bf352f" = "Приспів починається з однієї довгої ноти. Якої тривалості?";
"L6ee8576cce" = "Коли смичок рухається швидко";
"L6eec260feb" = "Соло над повторюваними акордами";
"L6eef664840" = "Жодного";
"L6f04dd6683" = "Почніть з A на струні 6, ладу 5, пальцем 4 і підніміться тими самими ладами до A на струні 3.";
"L6f090fe056" = "На які долі припадають приглушені удари регі?";
"L6f0af4603c" = "Пропускайте удари на долі";
"L6f152bdf52" = "Знайомство: «Місяць у джукбоксі»";
"L6f1906dfa5" = "Яка це нота?";
"L6f1de5b0a4" = "Четвертий палець грає G, на півтон вище за F дієз. D, E, F дієз, G — перша половина гами D мажор: відкрита, 1, 3, 4.";
"L6f23e219b8" = "Від відкритих струн до крокуючого басу й грувів";
"L6f25a92f40" = "Перша й третя";
"L6f2ac8800d" = "Удари вниз, восьмі вниз-угору, акценти й рука, яка ніколи не зупиняється.";
"L6f2b7fab42" = "Яка пара звучить нижче?";
"L6f2c6204f8" = "Тріолі ділять кожну долю на три рівні частини.";
"L6f2ef252d3" = "Тривалості від цілої до шістнадцятої, крапки й паузи та розміри 4/4, 3/4 і 6/8.";
"L6f311d3822" = "У малюнку «основний тон — квінта» яка нота припадає на долю 1?";
"L6f49985ada" = "A C D E G";
"L6f4f52cd93" = "Ваш перший риф";
"L6f50fe9d19" = "Кроки, стрибки та їхні розміри";
"L6f7552e3f9" = "Аплікатура G для C займає лади 5 і 8, просто поруч із G аплікатурою D та D аплікатурою A.";
"L6f84cce07d" = "У багатьох тактах акорд змінюється посередині. Рахуйте куплет половинами по дві долі, по акорду на кожну, і змінюйте через клацання.";
"L6f9084b461" = "Harold Boulton (1884)";
"L6f97ae38f9" = "Який акорд повертає вас до G?";
"L6facc1d867" = "Першим пальцем перейдіть угору, назад і знову вгору. Влучайте в кожну ноту.";
"L6fb2e24cec" = "Другий палець грає C дієз, на тон вище за B, тому залиште проміжок після першого. Це місце називають «високий 2», бо воно близько до майбутнього місця третього пальця.";
"L6fbb27dbe1" = "Блюз";
"L6fc1b88b81" = "Чотири різдвяні колядки при свічках: Веслі й Мендельсон, колискова та дві мелодії з Америки.";
"L6fd4d1a273" = "Угору, як пальцевий медіатор";
"L6fd822f16e" = "Високо на обох";
"L6fe7b842e1" = "Мелодію «Ar Hyd y Nos» надрукували у Вельсі в 1784 році, а Гарольд Болтон написав ці англійські слова в 1884. Одна фраза звучить тричі, а в середині є вища.";
"L6ffb9b4308" = "Поверх кожної ноти мелодії";
"L700550f7a8" = "Перший рядок зі вставками";
"L7009b5c7ec" = "Стежте за доріжкою нот і не губіть місце, навіть пропустивши ноту. Пульс триває — продовжуйте й ви.";
"L700caf50a2" = "Основні тони й квінти, як у першому акомпанементі басиста гурту: основний тон на початку акорду, квінта між ними, низько в першій позиції. Пісня лишається в E, де її грає гурт.";
"L7011b1a621" = "Відповідь";
"L7017315505" = "Тримайте скрипку на місці й щипніть струну D, струну 3.";
"L702168cf86" = "Відчути долю й щипнути трохи раніше";
"L703760e9d4" = "1, 2 і, 3, 4";
"L7052923693" = "Один бемоль";
"L705b6fce44" = "Чи закінчується це тонічним акордом?";
"L705c9442a0" = "Віолончель";
"L705d82cb8e" = "Вище чи нижче";
"L707adcf2aa" = "Щипнути наступну струну";
"L707e698331" = "Почавши з G, на тон вище потрапимо на…";
"L7083894272" = "Завжди цілий такт";
"L708f879c93" = "Квінта акорду лежить на сусідній тоншій струні, на два лади вище від основного тону. Для відкритої A це лад 2 струни 2: E.";
"L708fc99213" = "Кожна нота на один лад нижче на струні 3: лад 2, лад 1, відкрита.";
"L7090f484fc" = "Знижує на півтон";
"L70a425cada" = "Зіграйте чи заспівайте F мажор угору від F до C. Четверта нота — B♭.";
"L70a67c5399" = "Мі соль ля соль";
"L70acdc94e1" = "Тихо заспівайте D й підлаштуйте висоту до точної.";
"L70ad456aec" = "4 і 3";
"L70aebab32e" = "Frederic Weatherly (1913)";
"L70cf9ad2c0" = "У якому акорді палець 1 на струні 2 стоїть там само, що й у B бемолі?";
"L70dbb7607e" = "G B D: велика терція, потім мала.";
"L70e3112f7b" = "Зіграйте чи заспівайте основні тони I, IV, V, I у C: C, F, G, C.";
"L70f8bb9a8a" = "Удома";
"L70fea9b4e8" = "Заспівайте чи зіграйте нижчу ноту.";
"L70ffe4f1fc" = "Що таке вібрато?";
"L71009efbad" = "Тризвуки на танцмайданчику";
"L7101505b22" = "Блюзові фрази у повному темпі";
"L710b5cf962" = "Початок: E E F G, G F E D.";
"L710ffe8ce8" = "Фрази з почуттям";
"L7113e58d7b" = "Малий F охоплює струни від 4 до 1: палець 1 пласко на струнах 2 і 1, лад 1; палець 2 на струні 3, ладу 2; палець 3 на струні 4, ладу 3.";
"L7122f02be1" = "Низьке дихання розширює ребра й живіт. Піднімання плечей напружує шию та горло.";
"L712f15d2f4" = "Крок, потім стрибок";
"L71327ca01d" = "Нічого нового: малий F, D7 та обидві пісні з цього розділу. Змінюйте акорди завчасно й дайте мелодіям співати.";
"L7140cafdab" = "The Entertainer";
"L7145911558" = "Потім униз: G, E, D, D.";
"L71569ed4cc" = "Струна 5, лад 5";
"L71570ee63d" = "B, на півтон угору до C і назад.";
"L7159acaaa1" = "На один півтон менше за октаву.";
"L716191664d" = "Великий мажорний септакорд додає ноту на лад нижче октави основного тону. Простий мажорний акорд стає м’яким і мрійливим. Відкритий Cmaj7 — це C з піднятим пальцем 1.";
"L71636302f6" = "Вільям Крофт написав мелодію «St Anne» у 1708 році, а слова Айзека Воттса вперше надрукували в 1719. Кожен куплет — чотири короткі рядки, найпростіша форма гімну.";
"L716ad20305" = "Нічого нового: фанкові шістнадцяті, приглушені удари регі, «бум-чик» і синкопований попбій. Рука рухається без зупинки — змінюється лише те, по чому вона вдаряє.";
"L716d58f177" = "B♯ на півтон вище B, тобто це C.";
"L717b08457c" = "Вільно стуліть губи й видихайте, щоб вони тремтіли, наче моторний човен, а потім додайте голос. Так горло лишається розслабленим, поки голос прокидається.";
"L7182a2d375" = "Бокс 1 угору й униз";
"L7187db723a" = "Септакорди зі свінгом";
"L71892e72a8" = "Тональність D";
"L718c34796e" = "«Світло на ґанку» перебором";
"L7192859777" = "Струна 5: висока G.";
"L719804b507" = "G на ладу 3 струни 1, F дієз на ладу 2, D на ладу 3 струни 2, потім F дієз, відкрита E й D.";
"L71adeb9248" = "Перебір Тревіса, названий на честь Merle Travis, чергує великим пальцем баси на кожну долю, а решта пальців щипають між ними, на «і».";
"L71af01d18d" = "Мелодія зупиняється на ті. Як вона звучить?";
"L71b92bbea9" = "Пальці перший, другий і третій на ладах 2, 4 і 5, між ними — відкриті пари. Грайте плавно, даючи кожній ноті звучати до наступної.";
"L71d8b81afd" = "F простим способом";
"L71e5b1f872" = "Піано";
"L71e7b3982b" = "П'ята струна лежить поряд зі струною 4, але починається на п'ятому ладі; її кілок збоку грифа.";
"L71e96e5d41" = "Лише на першу долю";
"L71ea378148" = "Вона падає на октаву";
"L720eef1b61" = "Що тут підсилює приспів?";
"L7212825ac8" = "Мажорну пентатоніку A";
"L721ac72fb9" = "На останньому ударі вгору перед зміною підніміть баре й продовжуйте бій. На мить зазвучать відкриті струни, ритм не зупиниться, а ви встигнете на акорд.";
"L72226fbc48" = "Тепер вважайте домівкою D. Ноти G мажору від D до D дають міксолідійський D: мажорну гаму із сьомим ступенем на лад нижче. Він поширений у фолку, рок-музиці й народних скрипкових мелодіях.";
"L72243f52e2" = "Усі вісім ступенів";
"L723c86e297" = "D на ладу 3 струни 2, відкрита B, A на ладу 2 струни 3, відкрита G, потім назад угору A й B.";
"L72429b5e7d" = "Ця версія в G, у першій позиції: по два лади на палець на чотирьох парах струн; усі акорди на схемі мають аплікатури для мандоліни.";
"L724b59aa0f" = "Хамер-он, пул-оф, слайд";
"L7258ad6ffb" = "Приспів: мелодія";
"L7277fd97d8" = "Верхня лінія — це струна 1, найтонша. Число означає лад.";
"L72856486dd" = "Два бокси, один блюз";
"L72890bd1aa" = "G на ладу 3 струни 1, униз до D на ладу 3 струни 2, потім F дієз на ладу 2 і знову D.";
"L72893aee6a" = "Сонячний хайлайф";
"L728cd633f1" = "A мінор";
"L728e1822bf" = "Від E вгору до G♯ — це…";
"L729b7425d6" = "Перехід зі струни 2 на струну 1 — це крихітний рух. Тримайте руку, якою щипаєте, близько до струн, готуючись до наступної ноти.";
"L72a3d2b16e" = "Ця французька мелодія з XVIII століття (1700-ті роки) використовує лише вивчені ноти: A, B, C дієз, D на струні A та E і F дієз на струні E.";
"L72b3117837" = "D зменшений";
"L72b38c6701" = "Рівномірний тиск під час ковзання";
"L72bab7e9c6" = "Ваше перше соло";
"L72bd85eb5d" = "Сольмізація дає кожному ступеню гами склад: до, ре, мі, фа, соль, ля, ті, до. До — домівка, хоч із якої ноти починається гама.";
"L72be45acb1" = "A, струна за струною";
"L72c3752afb" = "Народна пісня (1852)";
"L72c4335ad6" = "Що з цього — вальс на три?";
"L72c4615523" = "Жак Оффенбах написав цей галоп для оперети «Орфей у пеклі» 1858 року. Згодом паризькі танцювальні зали зробили його музикою канкану.";
"L72cb6a906d" = "Приспів";
"L72d49b8308" = "Свінг: довго, коротко";
"L72e1d250aa" = "Йоганн Штраус II вперше виконав цей вальс у Відні в 1867 році, і там його досі грають щороку на Новий рік. Мелодія піднімається акордом і відповідає двома високими нотами.";
"L72e2680c98" = "Вона починається на нижчій струні";
"L72e4578411" = "До мі соль мі";
"L72e72669af" = "Середній рядок";
"L72f31e7c85" = "Багато долей починаються з короткої тиші. Зупиніть струну рукою на грифі, а тоді вступіть на наступній восьмій.";
"L72f8829e7e" = "Що таке акцент?";
"L730ecf2b62" = "Почуйте, знайдіть, заспівайте";
"L730fe38866" = "Ця версія в D. Четверта струна налаштована високо, тож мелодія лишається на струнах від 1 до 3, а всі акорди на схемі мають аплікатури для укулеле.";
"L732983c362" = "На ноті відчуваєте напругу чи дряпання. Що робити?";
"L7329d82bd9" = "Перший палець";
"L7338864b70" = "Відкрита струна 3, потім струна 2 лад 2.";
"L734b1f0943" = "Тустеп";
"L734d8b3e2c" = "Складаємо терції";
"L7355696e60" = "E мінор: підніміть один палець";
"L7359906dce" = "Над резонаторним отвором";
"L73601df885" = "«Погода в підвалі» — авторська пісня Timbre: гаражний рок у A. Починається рифом на низьких струнах, якому відповідають квінтакорди на «раз», «і» після «два» та «чотири». Тримайте долоню біля підставки. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L7364993206" = "Почуйте місце кожної ноти в тональності: від до, ноти-домівки, до ті.";
"L7364a9324b" = "Тріоль уміщує три рівні ноти в одну долю. Рахуйте 1-трі-оль, 2-трі-оль, надаючи кожному складу однакову тривалість.";
"L737e9af907" = "Від струни 6 до струни 2";
"L7383cb2d2c" = "Уся кисть разом із великим пальцем";
"L738524e244" = "A C E: мала терція, потім велика.";
"L73aa18f071" = "Тон, тон, півтон, тон, тон, тон, півтон.";
"L73b1f13160" = "Починайте з баса";
"L73b7c2973b" = "На скільки знак дієза підвищує ноту?";
"L73bdfff736" = "Який акорд утворюють відкриті струни?";
"L73d4ee99cc" = "Долі 1 і 3";
"L73f6ca5963" = "Де грає гітара в регі?";
"L73fd26acc8" = "Відкрита, 1, 3, 4 на струнах D та A. Зберігайте форму кисті, влучайте в кожну ноту й дайте октавам резонувати.";
"L73ff0ae4b6" = "Щипніть найтовстішу струну й дайте їй прозвучати.";
"L740428ff15" = "Спершу гостро, потім солодко";
"L74140f4fbe" = "Униз, униз-угору";
"L741d9469c2" = "Її торкається палець";
"L742c5e9458" = "Asus4 — A із доданим мізинцем на струні 2, ладу 3. Як і Dsus4, він тяжіє вперед і прагне повернення додому.";
"L743c7fa8cf" = "Волинки, вальси й танці";
"L7455504689" = "Перші пісні";
"L7458302143" = "Зіграйте A, потім підніміть палець 2 зі струни 3. Звучить відкрита G, і A стає A7.";
"L746d58eb28" = "У реентрантному строї C на струні 3 — найнижча нота укулеле.";
"L746d806e74" = "Парний щипок чи ноти по черзі?";
"L749627803c" = "Замініть один удар униз приглушеним";
"L749ac2f07c" = "«Радіо відпливу» — авторська пісня Timbre: неквапливе регі на E мінорі й A. Гітара грає лише на «і». Рухайте рукою вниз і вгору, минайте струни на кожне число й грайте на кожне «і». Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L749bdaec42" = "E — біла клавіша безпосередньо праворуч від групи з двох чорних.";
"L749c9d8d0e" = "Нічого нового: форма, вступи, завершення, фактура, вставки та ваша пісня «На березі річки». Зіграйте все без зупинки, як концертну програму.";
"L74a62f2786" = "Розрізняйте мажорні й мінорні акорди, потім зменшені, збільшені й домінантсептакорди.";
"L74b4fa7ea9" = "Один акорд, одна пісня";
"L74c9c1f9c1" = "Від низької до високої: G, D, A, E. Кожна струна на п'ять назв нот вище за попередню; цей інтервал — квінта. Запам'ятайте за першими літерами англійської фрази: Good Dogs Always Eat.";
"L74d62bc627" = "Грайте, грайте, пауза, грайте";
"L74e030bebc" = "Від C до D пропускаємо чорну клавішу між ними: це тон, отже велика секунда.";
"L74e110372c" = "Налаштуйте віолончель";
"L74e60d76a3" = "Балада золотої лихоманки";
"L74f0435d4b" = "«Шафл Іржавого поясу» — авторська пісня Timbre: 12-тактовий блюз у E за щойно зіграним планом, зі свінговою мелодією згори. Зберігайте ритм довго-коротко в обох руках. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L74f4a6f380" = "G C E A — відкриті струни";
"L74f91db36a" = "Пружний маршовий ритм";
"L74fa60e9dc" = "Палець 3 на струні 3, лад 7. Щипніть, потім ковзніть угору до ладу 9, не піднімаючи пальця.";
"L7503f2131d" = "Він має вісім дієзів";
"L7515b995d9" = "Половинна нота";
"L75227e00b7" = "«Світло на ґанку» — авторська пісня Timbre: повільна балада в D. Грайте пальцями: великим — основний тон акорду, потім i, m та a вгору струнами 3, 2 і 1. Хай кожна нота звучить до наступної. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L75313a75b6" = "Яка струна не грає на D7?";
"L7564d208fb" = "Лоуфай по колу";
"L75651a09d2" = "Кожна мажорна тональність має схему: I, ii, iii, IV, V, vi, vii°. У C мажорі це C, D мінор, E мінор, F, G, A мінор і B зменшений.";
"L756a84dff3" = "Пул-оф";
"L756b13efd3" = "Приглушіть, потім ударте";
"L757ab23746" = "«Тустеп на гравійній дорозі» — авторська пісня Timbre: танцювальне кантрі в A на A, D і E. Поставте каподастр на лад 2 й грайте найзнайомішими аплікатурами G, C і D. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L75855335d0" = "C♯ і D♯";
"L759ca6682b" = "Пізніше, на останній ноті тріолі";
"L75a2941efc" = "A7: два пальці";
"L75ae4744f4" = "Кожному пальцю — свій лад: вказівний на ладі 2, середній на 3, безіменний на 4, мізинець на 5. Великий палець позаду грифа, навпроти середнього.";
"L75b46647b7" = "Тримайте F: відкрита струна 3, струна 2 на ладі 1, відкрита струна 1. Так починається «О дивна благодать».";
"L75b727a923" = "На тон вище за третій";
"L75ba5c8a40" = "У 3/4 три долі; 1 + 1 = 2, тож лишається одна доля.";
"L75c8e227cb" = "Усі п'ять струн";
"L75cc572d55" = "G5";
"L75cdb21b5a" = "Струна 1, під пальцем 3";
"L75dd0c550b" = "Рахуйте 1-трі-оль і торкайтеся лише на «1» та «оль». Проміжок посередині — це свінг.";
"L75dead00c2" = "Ліги";
"L7602fa4687" = "2 і 1";
"L760d963f68" = "То швидко, то повільно";
"L761695b22b" = "Секвенція";
"L761dcbbefc" = "Акорди й чоп";
"L762ee32125" = "Від D до E і від A до B";
"L763cf003eb" = "Розслабляйтеся між акордами";
"L764f650ee8" = "Великий, вказівний, середній — знову";
"L7653b6c98c" = "«Галоген» — авторська пісня Timbre: дезерт-рок у D мінорі. У рифі — щойно вивчені ноти: відкрита D, F на ладу 3, відкрита G та C на струні 5, ладу 3. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L7659355836" = "Слухайте резонанс";
"L76775d6156" = "Тустеп на гравійній дорозі";
"L768ad272b1" = "Народна (Англія, 1580-ті)";
"L769a21a4b6" = "Почуйте F в уяві, потім заспівайте.";
"L76a60ba092" = "Більшість пісень складається з кількох частин: куплети розповідають історію, приспів повторює впізнаваний мотив, а іноді для контрасту є бридж. Знання плану допомагає не загубитися.";
"L76ac577e04" = "На лівому плечі";
"L76b5c122da" = "Цей рисунок лежить в основі безлічі пісень. На третю долю рука рухається вниз, не торкаючись струн, а потім грає вгору.";
"L76b8e0aefa" = "Скільки четвертних долей у такті 4/4?";
"L76bdd8e96f" = "E мінор, p-i-m-a";
"L76ec2a9418" = "G звучить як домівка, а D7 тягне назад до неї. Куплет: три такти G, один D7, два G, потім D7 і G.";
"L76f05876f1" = "For the Beauty of the Earth";
"L770925fb1d" = "Відчуття свінгу";
"L7713766279" = "Трохи вбік, щипаючи струну";
"L772060f80c" = "Середнє C — це C4. Яке C розташоване на октаву вище?";
"L773199c55a" = "Що робить басову лінію крокуючою?";
"L7734925a70" = "Незавершено, наче запитання";
"L774303f5af" = "Мелодія тримається на «бам»";
"L7749e45f77" = "Бокс 2 і перехід";
"L7750c6982d" = "Це випробування поєднує тріолі, рівні восьмі та свінг. Тримайте пульс рівним, поки змінюється спосіб поділу долі.";
"L77510a1916" = "Остання A";
"L7755242089" = "У квінтакорді лише основний тон і квінта — п’ята нота за літерним відліком. Він не мажорний і не мінорний та зберігає чіткий, потужний звук навіть за великої гучності. E5 — нижня частина E мінору.";
"L775c034932" = "Мажор і мінор усюди";
"L777cf155db" = "Щипайте струни по одній, від товстої до тонкої. Глухий звук означає, що цієї струни торкається палець. Виправте положення й щипніть ще раз.";
"L77834a9822" = "Відкрита A, потім B першим пальцем. Тримайте B до чистої інтонації.";
"L7790a9bcca" = "Колядники біля дверей";
"L77afc8a8ff" = "Швидкий зворот: F, угору до A, назад до F.";
"L77c8e74c56" = "Зміна на великому пальці";
"L77cf24ec08" = "Як у відкритого C, основний тон аплікатури C — на…";
"L77dd8f60bb" = "Балада";
"L77e4a6e837" = "Скільки нот гами від до до соль, рахуючи обидва кінці?";
"L77e7ffc749" = "D на ладу 3 струни 2, B на ладу 4 струни 3, знову D, E на ладу 5 пальцем 4, потім D і B.";
"L77ebaa5664" = "Рифи, квінтакорди й ретро";
"L77f22a7a1f" = "Уже знайома мелодія";
"L77f34acf11" = "Навіщо змінювати акорд на «і» після «чотири»?";
"L77f82dbfe9" = "П'ять акордів, одна рука";
"L77fce1a6ed" = "Нона";
"L78040a6350" = "Рахуйте вгору по струні 6: відкрита E, F на 1, G на 3, A на 5.";
"L7831336036" = "Грайте медіатором униз на кожну долю й угору на «і» між ними. Рука гойдається як маятник: униз, угору, униз, угору, навіть коли нота чекає.";
"L783598aa9b" = "«Остання троянда літа» й «Юпітер»";
"L783f1dbb24" = "Грув із перших нот";
"L784171a46b" = "A мінор, F, C, G7";
"L784f56f7aa" = "Ця послідовність підіймається крок за кроком від A мінору й приходить до вашого нового F. Грайте по два удари на акорд і змінюйте завчасно.";
"L7850157ffa" = "Плагальна";
"L785ae9fde1" = "Це права клавіша пари, безпосередньо над D: D♯.";
"L78633b9ee3" = "Акорд, зіграний нота за нотою";
"L78748d3e3e" = "Третій палець: F дієз";
"L78771a5863" = "Відкрита, 1, 3, 4";
"L787ad3e57d" = "Притисніть, перебирайте, змініть";
"L78843288d8" = "Відтворюйте й рухайтеся";
"L78854cbe8a" = "Повільна трель";
"L788cce8f6d" = "Мала секста";
"L7893d45a81" = "Мінорну пентатоніку D";
"L78a15b5503" = "Перший такт: C, E, G, потім B бемоль, що тяжіє до A.";
"L78a252be29" = "Басові «бум» у G";
"L78a58336aa" = "Табулатура — це карта";
"L78ad15f28c" = "Найнижча струна";
"L78ad8f08fc" = "Пізній автобус додому";
"L78d00ac979" = "«На березі річки», уперше надрукована у 1918 році, створена для спільного співу. На укулеле вона звучить у G, з акордами G, C і D7 та госпельною нотою A дієз на струні 1, ладі 1.";
"L78e0fbb58e" = "Лад 4";
"L78e3c7b022" = "Коли великий палець низько позаду грифа, решта пальців вигинаються й без напруги дістають від струни 5 до струни 1.";
"L78f007754a" = "«Скляні супутники» — авторська пісня Timbre: рок-балада на A мінорі, F, C і G. Повне баре F грає другий акорд, а бокс 1 підходить до всього кола, тож отримує соло. Повна пісня — у розділі «Авторські пісні» вкладки «Пісні».";
"L79000b6379" = "У Da-vid's кожен склад припадає на дві восьмі. Зіграйте обидві, але співайте їх як один плавний звук.";
"L790e7c10be" = "У 6/8 кожен такт містить шість восьмих у двох групах по три. Відчуваються дві великі долі, кожна поділена на три: 1 2 3, 4 5 6.";
"L7922e364ef" = "Найгучніша нота пісні";
"L794a2fe83f" = "«Світанок із балончика» — інді-поп, 124 долі за хвилину: E, B, C дієз мінор і A — цикл із чотирьох акордів із двома баре. Рухайте його рівними восьмими.";
"L794e67d981" = "На два лади вище від G — A. Аплікатура лишається G, а звук підіймається з каподастром.";
"L795606787b" = "Хвиля на G";
"L797d46da49" = "E першим пальцем, потім ковзніть до G тим самим пальцем. Рухайте й великий палець.";
"L798fb9b546" = "Приспів сягає вгору: B, D, відкрита E, потім G на ладу 3 струни 1. Назад униз: D, B B G.";
"L7999cb145d" = "Над верхньою лінійкою порядок триває. G стоїть безпосередньо над нею, а A — на першій додатковій лінійці вгорі.";
"L799c178cf7" = "Відкрита A, лад 4 на струні 5, лади 2 і 4 на струні 4, потім відкрита G.";
"L799d8f14e5" = "Звідки це походить";
"L79c2909968" = "Зіграйте чи заспівайте середнє C, а потім C на октаву вище.";
"L79e96a01f4" = "Хамер-они, пул-офи, слайди";
"L79ea537c97" = "Який акорд тяжіє до G?";
"L79edc518ec" = "Дощ по мансардному вікну";
"L79f440e719" = "Струни 4 і 1";
"L7a0178640d" = "Випробування: відкриті струни";
"L7a0d002f86" = "Перенесіть палець 3 на струну 5, лад 3, а мізинець поставте на струну 4, лад 3. Звучать п’ять струн, і F стає повнішим.";
"L7a11f282e7" = "Залишається на струнах 3 і 4";
"L7a37110f72" = "На наступній долі";
"L7a3a4a4221" = "Кварта";
"L7a488412f4" = "Відкрита 3, лад 4; потім струна 2, лади 2 і 4.";
"L7a6cca45fb" = "Відкрита B двічі, A на ладу 2 струни 3, відкрита G, потім D на ладу 3 та E на струні 1, назад через D і C до B.";
"L7a85496646" = "П'ять гімнів";
"L7a94cc7e8b" = "Перед першим ударом уголос відлічіть у темпі пісні: раз, два, три, чотири. Усі почнуть разом у заданому вами темпі.";
"L7a9a2a3172" = "G на ладу 3 струни 1 та відкрита E, двічі. Потім знову G і D на ладу 3 струни 2, двічі.";
"L7aa1bfc90c" = "Бас і бас-барабан звучать разом. Цільтеся точно в мить клацання, а не просто поруч. Timbre показує, чи ви поспішили, чи запізнилися.";
"L7aa9032141" = "Ще один акорд із тяжінням";
"L7ac2aa3ed2" = "Широка вода";
"L7ac6eb4e66" = "Ні, хочеться продовження";
"L7ac946053a" = "Привіт, укулеле";
"L7ad16b9d12" = "Мелодія з «Планет»";
"L7aeab8183d" = "E, F і G";
"L7af2d04324" = "Мандоліна";
"L7b16481fcd" = "Відкрита струна 6 двічі, G на ладу 3, відкрита E, відкрита струна 5, знову G, потім відкрита E.";
"L7b3b95c47e" = "Окресліть акорди";
"L7b4579eb6a" = "2 + 2 + 2 + 2";
"L7b54d7c50d" = "У D мажорі";
"L7b56ed522a" = "«При місячному сяйві» — французька народна пісня з XVIII століття (1700-ті роки). Вона звучить на струнах G та D, із C під четвертим пальцем.";
"L7b5d00b025" = "Рання зміна";
"L7b646518c9" = "Плавно знайдіть точну висоту";
"L7b6e740eb2" = "Стрибок (терція)";
"L7b7b5e982c" = "Чопи на G, C і D";
"L7b84294da2" = "Шість відліків, два погойдування";
"L7b9006e026" = "Відкрита B двічі, C на ладу 1 та D на ладу 3 струни 2, потім назад униз B, A й G.";
"L7b96529d60" = "Угору по струні E";
"L7b972cb63e" = "Ця стара американська скрипкова мелодія тримається ритму, який ви грали на відкритих струнах: довго, коротко-коротко, довго, довго. Скрипалі всюди грають її на джемах.";
"L7bc07f1c51" = "Що таке затакт?";
"L7bcb899472" = "Випробування: перебори";
"L7bd8097a38" = "G і A на струні 3, D, E і F на струні 4, гама C мажор та дві народні мелодії.";
"L7be45b6fa8" = "Відкрита струна 4 — це D. Лад 2 — E, а лад 3 — F. Тримайте великий палець низько позаду грифа, щоб інші пальці дотягувалися.";
"L7be8ead7d9" = "Який акорд є V у тональності G?";
"L7be9004c2e" = "D, F♯ та A — три звуки D мажору. Народні скрипкові мелодії часто так окреслюють свої акорди.";
"L7bfa664ab2" = "Висока частина: відкрита B угору до D на ладу 3, потім униз через B, G і A.";
"L7c10b1802d" = "Кода";
"L7c17747dec" = "Фразуйте, як співак";
"L7c1d430e25" = "G: три пальці";
"L7c2ec91d74" = "Великий палець на басах";
"L7c61bafa47" = "Гучно й тихо";
"L7c678174ce" = "Тони й півтони";
"L7c69162628" = "Медіатор надто товстий";
"L7c796e01f6" = "0 на другій лінії означає…";
"L7c7dccf8a8" = "Між якими двома ступенями півтон?";
"L7c8910de43" = "Тримати далі, без нового дотику";
"L7c9b3dfe11" = "G7 звучить незавершено. Зіграйте після нього C — і напруга зникне. Через це тяжіння в багатьох піснях G7 стоїть перед C.";
"L7ca0aa3c1a" = "Основи басового ключа";
"L7caafe5ece" = "B бемоль, D7, B мінор і G мінор, тональності G, F і D та перенесення пісні в будь-яку тональність.";
"L7cbe9df99e" = "4 + 4";
"L7cd7cf4d00" = "«Остання троянда літа» та «Юпітер» — обидві на три. «Home! Sweet Home!» і «Hard Times» рахуємо на чотири.";
"L7cda0092d2" = "Найвідоміший марш Сузи";
"L7cf184f4c6" = "H";
"L7cfee748e2" = "Тон дорівнює двом півтонам: він пропускає рівно одну клавішу. Від C до D — тон, із C♯ між ними. Від E до F♯ — теж.";
"L7d052af42d" = "Вступи й завершення";
"L7d0f3c3f18" = "Тризвуки на верхніх струнах";
"L7d106663f4" = "Каподастр на ладу 2. Аплікатура C звучить як…";
"L7d14b6371f" = "Стійте рівно, дихайте низько, утримайте першу рівну ноту й заспівайте пісню.";
"L7d188e15c9" = "Схема";
"L7d19e2dbc8" = "Знайомство: «Ліхтарний пагорб»";
"L7d2121e467" = "Рівно одну долю";
"L7d35795799" = "Септакорди, sus і свінг";
"L7d52788ad8" = "Малі високі аплікатури";
"L7d596ac488" = "E на відкритій струні 1";
"L7d5a055e37" = "Каньйон відлуння";
"L7d69f3e22c" = "Коли мелодія тримає довгу ноту, сольний гітарист заповнює простір: одна-дві басові ноти акорду, потім вчасне повернення до мелодії.";
"L7d6b0a3fdf" = "На «і»";
"L7d6ba1832b" = "Октава — та сама назва ноти, але вище. Від основного тону на струні 4 або 3 перейдіть на дві струни в бік тонших і на два лади вгору. Відкрита A стає ладом 2 струни 1.";
"L7d6c1cd2a4" = "Friedrich Schiller (1785)";
"L7d73221cd1" = "Три долі в такті";
"L7d8c480c83" = "У G мажорі є F♯. Зниження до F дає міксолідійське звучання, характерне для старовинної американської музики й блюграсу.";
"L7da8a71881" = "Лінійки, проміжки, додаткові лінійки й обидва ключі. Користуйтеся мнемонічними фразами, а потім спробуйте впізнавати кожну ноту з першого погляду.";
"L7dab99667b" = "Одна басова нота";
"L7db3d33bc4" = "Що означає завищена нота?";
"L7db42c8944" = "Народна (надруковано 1927)";
"L7db4bd1048" = "Хамер-они й пул-офи";
"L7db6bb8ffa" = "Яка нота на тон нижче F?";
"L7dce4b7666" = "She'll Be Coming 'Round the Mountain";
"L7debe232fa" = "Номери октав змінюються на C, тож наступна нота вгору після B3 — C4.";
"L7df7b523ad" = "Легке мугікання";
"L7dfc34025a" = "Зіграйте кожну мелодію повністю в рівному темпі. Якщо нота не вдалася, не зупиняйте руку з медіатором і підхопіть наступну долю. Так і відбуваються справжні джеми.";
"L7e0448d5ad" = "На долі 1 один дотик, на долях 2 і 3 — по два, на долі 4 — один.";
"L7e1e38b1e4" = "Це основний тон E";
"L7e2e5973e7" = "Авторські пісні";
"L7e327ea06c" = "Димінуендо";
"L7e41044b8c" = "Четвертна з крапкою, потім восьма";
"L7e6a077cdf" = "I, V, vi, IV";
"L7e7e7f9183" = "Барви акордів";
"L7e8736c9eb" = "«Містечко в сніговій кулі» — швидкий вальс у G, 120 долей за хвилину, наче музична скринька: одна сильна доля, дві легкі. G, D, E мінор і C, із B7 у бриджі.";
"L7e8bcfbfd8" = "Fly починається на C й спускається до довгої A. Співаки називають один склад на кількох нотах розспівом.";
"L7e8c92c878" = "Від низької до високої: G, D, A, E.";
"L7e8d3d1635" = "Вальс у D мінорі";
"L7e90bc9187" = "При ключі один бемоль, B♭. Яка це мажорна тональність?";
"L7e98b4a84e" = "Техніка сольної гри";
"L7ea0083c67" = "Народна пісня";
"L7ea1a3dd0e" = "Дванадцять тактів по-вашому";
"L7ec06a6447" = "Частина A";
"L7ec3fd5bd8" = "Без застосунку оберіть два акорди й чергуйте їх хвилину, граючи кожен одним ударом. Рахуйте чисті зміни й завтра переверште результат. Почніть із D та D мінору.";
"L7eeafd430e" = "Абетка, октави й мапа клавіатури — усе разом. Орієнтуйтеся за групами чорних клавіш.";
"L7eed15e9d5" = "Від E вгору до C — це…";
"L7eed8c9e72" = "Від E до A на одній струні";
"L7ef3fb65e1" = "Яка нота є основним тоном тризвуку F A C?";
"L7ef88abbc5" = "Тиша й поштовх";
"L7f0dc7ec97" = "«Повільний танець на кухні» — соул-балада в 6/8, 108 відліків за хвилину, два повільні змахи в такті. Куплет несуть Cmaj7, Am7, Dm7 і G7; Fmaj7 та Em7 розкривають приспів.";
"L7f1de538f5" = "Основний тон на струні 5, ладу 3. Який це квінтакорд?";
"L7f3375dfa4" = "Ця пісня з півночі Англії — про Боббі Шафто, який пішов у море. Її слова надруковано не пізніше 1805 року, а скрипалі грали мелодію до танців уже в 1770 році.";
"L7f6bc35fde" = "Угору й відпустіть";
"L7f7d19a9c9" = "На E";
"L7f854b8d7a" = "Оркестри налаштовуються за A, тож почніть із неї, а потім налаштуйте решту.";
"L7f8877f534" = "Струна 5 відкрита, потім струна 1 на ладі 4 і ладі 2.";
"L7f8ad82b9c" = "Не зупиняйте руку";
"L7f9258b5df" = "Бугі в A";
"L7f95f4b200" = "C♯";
"L7f98eb4ee9" = "A мінор, p-i-m-a";
"L7f9b7bad94" = "G, C, F";
"L7f9c7aa1e0" = "Від A до C звучить похмуро; від A до C дієза — світло. Один півтон змінює весь настрій.";
"L7fa8c16dcd" = "Це мажорна гама?";
"L7fb3d77868" = "Квінта охоплює сім півтонів, кварта — п'ять.";
"L7fbbab3fe0" = "Програма біля вогнища";
"L7fdd1f14cb" = "Соль до ті до";
"L7fe2492022" = "Найменший крок";
"L7fed78e042" = "Та сама форма, інша тональність";
"L7ff5a6dafd" = "Частини";
"L7ff888e22b" = "12-тактовий блюз у E";
"L8002a822e7" = "Відразу після долі";
"L800d674d3a" = "Аплікатура C, струна за струною";
"L8017d0e097" = "Похмуріша гама";
"L802b0b27c9" = "По пальцю на струну";
"L8032d92208" = "Куплет перебором";
"L8053e7a2bb" = "«Кімнатні рослини» — м'який домашній поп, 88 долей за хвилину: Gmaj7, Em7, Cmaj7 і D. Септакорди додають мрійливості. Один бій на раз, потім м'які удари вгору на «і».";
"L806d33523e" = "Лад 3";
"L807035ab1f" = "Вказівний";
"L80744757e1" = "G C E A";
"L807478d21f" = "G7 і B7";
"L8081ba2e66" = "Яка аплікатура дає C біля ладу 5?";
"L8082440e36" = "Четвертна з крапкою триває півтори долі, тож наступна нота припадає на «і». Рахуйте 1 і 2 і: торкніться на 1, потім на «і» долі 2.";
"L808cd029f8" = "Соло над ритмом регі";
"L808e8b8b66" = "Ця американська мелодія гімну початку XIX століття (1800-ті роки) має розмір 3/4: рахуйте 1, 2, 3. Довгі ноти часто переходять у швидку пару — співайте її легко.";
"L808f3fcdc9" = "Відомі класичні теми: від барокового канону до романтичної колискової.";
"L809bd1e9c0" = "Довго-коротко на A, D та E";
"L80a64c52c1" = "Друга й четверта долі — бекбіт, де грає малий барабан. Приглушені удари тут додають бою барабанної пружності.";
"L80ac1b08fc" = "Акордова послідовність повторюється по колу. A мінор, C, G, D починається темно й світлішає, рухаючись угору.";
"L80af08d897" = "Антоніо Вівальді опублікував чотири скрипкові концерти «Пори року» в 1725 році. «Весна» починається цією світлою мелодією, а потім скрипка соло зображує спів птахів і струмки.";
"L80af5bfd06" = "Півтон веде від однієї клавіші до найближчої, чорної чи білої, без жодної між ними. Це найменша відстань на клавіатурі й у більшості музики.";
"L80b31f28ad" = "Ви надто сильно притискаєте";
"L80be651842" = "Основні тони й квінти, як у першому акомпанементі басиста гурту: основний тон на початку акорду, квінта між ними, низько в першій позиції. Пісня лишається в E мінорі, де її грає гурт.";
"L80c3052d33" = "Ніколи";
"L80c4d41909" = "Відкрита G, A на ладу 2 струни 3, відкрита B, C на ладу 1 та D на ладу 3 струни 2, потім назад до B.";
"L80cade81d7" = "Аплікатури E та A по грифу, мажор і мінор, ближча аплікатура й послідовність у A.";
