<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- gu plural forms (CLDR categories used: one, other). Keys match en.lproj/Localizable.stringsdict; wording follows this locale's Localizable.strings. -->
<plist version="1.0">
<dict>
	<key>%lld cents flat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld સેન્ટ્સ ઓછું</string>
			<key>other</key>
			<string>%lld સેન્ટ્સ ઓછું</string>
		</dict>
	</dict>
	<key>%lld cents sharp</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld સેન્ટ્સ ઊંચું</string>
			<key>other</key>
			<string>%lld સેન્ટ્સ ઊંચું</string>
		</dict>
	</dict>
	<key>%lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld મિનિટ</string>
			<key>other</key>
			<string>%lld મિનિટ</string>
		</dict>
	</dict>
	<key>%lld sessions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld સત્રો</string>
			<key>other</key>
			<string>%lld સત્રો</string>
		</dict>
	</dict>
	<key>Every %lld bars</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>દર %lld બારે</string>
			<key>other</key>
			<string>દર %lld બારે</string>
		</dict>
	</dict>
	<key>Practised on %lld days in the last twelve weeks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>છેલ્લાં બાર અઠવાડિયાંમાં %lld દિવસ પ્રેક્ટિસ કરી</string>
			<key>other</key>
			<string>છેલ્લાં બાર અઠવાડિયાંમાં %lld દિવસ પ્રેક્ટિસ કરી</string>
		</dict>
	</dict>
	<key>Practised today. Best run %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>આજે પ્રેક્ટિસ થઈ ગઈ. સૌથી લાંબો સિલસિલો %lld દિવસ.</string>
			<key>other</key>
			<string>આજે પ્રેક્ટિસ થઈ ગઈ. સૌથી લાંબો સિલસિલો %lld દિવસ.</string>
		</dict>
	</dict>
</dict>
</plist>
