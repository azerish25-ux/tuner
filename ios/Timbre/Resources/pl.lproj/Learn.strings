"L0268cd2c6e" = "Jeden palec, dwa progi";
"L028703cd0b" = "A ten przykład?";
"L028ca831a9" = "W tej frazie C brzmi przez półtora uderzenia, a D wchodzi na i po cztery. Licz raz, dwa, trzy, cztery-i.";
"L0297ac2321" = "Dół–góra, gama w górę";
"L029fad523d" = "Czwarty palec sięga cały ton ponad trzeci. Na strunie D daje A, ten sam dźwięk co pusta struna A. Zaokrąglij palec i pozwól dłoni lekko przechylić się ku niemu.";
"L02bc9eff1a" = "W B-moll";
