"L58b29e6cc0" = "A♯";
"L58bb52be10" = "Grieg napisał ten utwór do sztuki Peer Gynt w 1875 roku. Przedstawia trolle w sali ich króla. Zaczyna się cicho i stale przyspiesza.";
"L58cb3fff31" = "Którą parę białych klawiszy dzieli półton?";
"L58d40ef087" = "Angels from the Realms of Glory";
"L58d52b16c1" = "Dodatkowy dźwięk D7 ciąży ku G. Gdy pojawia się G, napięcie ustępuje.";
"L58d68468c9" = "Licz od D: D, E, F z krzyżykiem, G, A. A jest piątym dźwiękiem, więc A7 to akord V.";
"L58e4cebcce" = "Każde uderzenie";
"L58eedeebf8" = "Wolne zmiany wykonywane wcześniej budują nawyk. Szybkość przyjdzie sama.";
"L58f102ddae" = "Co dzieje się na końcu melodii toreadora?";
"L58fe8858cf" = "Zwrot ku B-moll";
"L59072f6149" = "Rolle";
"L590c267292" = "Gra smyczkiem";
"L59188c6d63" = "Znajdź puls";
"L5921a5b2b8" = "Wysuń nóżkę tak, by górna krawędź wiolonczeli dotykała klatki piersiowej na wysokości mostka, a kołek C znalazł się blisko lewego ucha. Dokręć śrubę. Podkładka lub pasek zapobiega przesuwaniu się nóżki.";
"L592f4b6689" = "Piosenka: Two-step na szutrowej drodze";
"L5938c71ae6" = "C: trzy palce";
"L594cfc45fd" = "Henry Bishop napisał tę melodię do londyńskiej opery w 1823 roku, do słów amerykańskiego aktora Johna Howarda Payne'a. W ciągu kilku lat stała się jedną z najbardziej lubianych pieśni na świecie.";
"L5952f9b6a9" = "Phillips Brooks napisał te słowa w 1868 roku dla dzieci ze swojego kościoła w Filadelfii, a organista Lewis Redner napisał melodię na ich nabożeństwo bożonarodzeniowe.";
"L597b60da13" = "W górę do C, w dół do pustego B i z powrotem, potem D, zejście do A i znów D.";
"L59814fa3ba" = "Zostań w jednym miejscu";
"L5983fa3abd" = "Struna 3, próg 2, drugi palec. To B.";
"L598a489b59" = "Które metrum przypomina marsz?";
"L598c2fd0e7" = "Zaśpiewaj lub zagraj dźwięki akordu, od niskiego do wysokiego.";
"L599637a52a" = "Zagraj lub zaśpiewaj pola od dołu do góry: F, A, C, E.";
"L599a010fb7" = "Duży skok: od G w górę do wysokiego C, potem krokami w dół.";
"L59a890261d" = "Ile kostki powinno wystawać?";
"L59abc0da88" = "Znajdź miejsca bez czarnego klawisza: od E do F i od B do C. Te białe klawisze są tuż obok siebie, więc dzieli je tylko półton.";
"L59bc865a46" = "Wyzwanie barré";
"L59c12ec1c9" = "Puste struny, szarpanie dwoma palcami i pierwsze dźwięki na progach. Używaj palców na zmianę i pozwól dźwiękom wybrzmieć.";
"L59c1350d23" = "Francuska pieśń ludowa";
"L59d0bca33c" = "Od C białe klawisze biegną C, D, E, F, G, A, B, potem znów C. Siedem białych klawiszy ma po jednej z każdej litery.";
"L59d89422db" = "Które G jest wyższe?";
"L59efa0f9f5" = "Krzyżyki i bemole";
"L59f912292e" = "Wysoki wers: w górę do D na progu 3 struny 2, potem B G, B A, G E D.";
"L5a0e299b6e" = "Ile uderzeń trwa półnuta z kropką?";
"L5a14702747" = "Refren przechodzi przez C, A-moll, D7 i G. Zmieniaj akord na słowie rozpoczynającym każdą połowę taktu i graj lekkie bicie pod wysokim E.";
"L5a4c7da42b" = "Wyzwanie pierwszych kroków";
"L5a59483173" = "Punk-pop, riff rock, mroczny rock w 6/8, hymn indie i desert rock na power chordach i riffach niskich strun.";
"L5a5d733600" = "Do, mi i sol to dźwięki akordu tonicznego, więc brzmią stabilnie i spokojnie. Mi brzmi słodko, sol mocno i przestrzennie, a do daje poczucie zakończenia.";
"L5a5d8340b2" = "Shady Grove";
"L5a636e248d" = "Dźwięki o tej samej literze brzmią podobnie, nawet gdy jeden jest wyższy. Odległość od jednego C do następnego C to oktawa. Wyższy dźwięk drga dokładnie dwa razy szybciej.";
"L5a80ba0bea" = "Slidem w górę do pozycji 2";
"L5a9ac09da7" = "Struna C";
"L5a9e82f489" = "Niski 2 na wysokich strunach";
"L5ab4b059e7" = "Utwór tradycyjny (Francja, 18. wiek)";
"L5ab72ee022" = "Świetne solówki oddychają. Zagraj krótką frazę, zrób przerwę mniej więcej tej samej długości, potem odpowiedz. Cisza nadaje wagę kolejnym dźwiękom.";
"L5acc606203" = "Zwrotka 4";
"L5acf76b488" = "Z luźnego gardła i równego oddechu";
