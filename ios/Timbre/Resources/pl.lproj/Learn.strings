"L0009cb1a16" = "Jedna struna brzmi głucho. Co jest prawdopodobną przyczyną?";
"L00130a44b5" = "Dotyk bez docisku nie pozwala strunom wybrzmieć. Uderzenie zmienia się w wyraźny, perkusyjny szelest.";
"L0015244e3f" = "G7 zachowuje niskie G, ale na górze ma F: palec 3 na strunie 6, progu 3; palec 2 na strunie 5, progu 2; palec 1 na strunie 1, progu 1.";
"L0017247d59" = "Który akord to G7, ten z większym napięciem?";
"L001a8a4e76" = "Palec 1 na strunie 3, progu 1 daje tę jedną nutę, która tworzy E-dur.";
"L0024a55a06" = "Rytm shuffle";
"L002ba346f7" = "Struna 3: próg 2, próg 3, próg 5.";
"L002e2c331d" = "Naszkicuj kształt";
"L002fe27c72" = "Miedziany drut opiera się na riffie: krótkiej, chwytliwej frazie na niskich strunach, z którą zgrywa się cały zespół. Płynie w E w tempie 112 uderzeń na minutę, z power chordami w refrenie.";
"L00398ce342" = "Zrób barré na strunach 5 do 1 na progu 10 i połóż palec 3 na strunach 4, 3 i 2 na progu 12. To twój chwyt A z barré, a znów brzmi G.";
"L00573ce6a3" = "Kapodaster";
"L006392a6a7" = "Tercja";
"L0074f77ab6" = "Siódmy dźwięk G-dur to F♯.";
"L0077cab0a8" = "Sousa pisał marsze na orkiestrę wojskową. Wiosna jest na skrzypce i smyczki, a rondo na fortepian.";
"L007b8bf14c" = "Licz 1 2 3, 1 2 3, z akcentem na 1. To rytm walca. „Clementine”, po raz pierwszy wydrukowana w 1884, kołysze się na trzy.";
"L008b7d6e79" = "D z krzyżykiem leży jeden próg pod E. Ten półton mocno ciągnie do domu, dlatego Greensleeves używa go w każdej kadencji.";
"L008b914131" = "Zestaw z akordami otwartymi";
"L008ec0fe41" = "Śpiewasz trochę niżej";
"L00b1aaa1ac" = "John Philip Sousa napisał ten marsz pod koniec 1896 roku, a wydano go w 1897 roku. Jest oficjalnym marszem narodowym Stanów Zjednoczonych. Oto jego wielka melodia tria.";
"L00b6eb7b38" = "Pogoda na latawce to pogodny, łatwy pop: cztery akordy w pętli, G, D, E-moll i C, w spokojnym tempie 88 uderzeń na minutę. Posłuchaj, jak chwytliwy motyw skacze do F z krzyżykiem w drugim takcie.";
"L00db96471b" = "Zachowaj go w głowie";
"L00f131a2fc" = "Sześć równych uderzeń";
"L00f1e4a733" = "D na progu 3 struny 2 i pusta struna 4 to dźwięki D. Jaka odległość je dzieli?";
"L00f5a8d2df" = "Ragtime, marsze i scena";
"L0100ebed8a" = "Drewniane drzewce biegnie od żabki, przy której trzymasz smyczek, do szpica. Między nimi rozciąga się końskie włosie. Dokręć śrubę tak, by między włosie a drzewce mieścił się ołówek.";
"L0101b7221e" = "Bas kroczący w D i E";
"L010a5a3a68" = "Pod frost-y wind made moan akordy przechodzą z A-moll do D7, ciągnąc frazę z powrotem do G.";
"L011468ba58" = "Dwa dźwięki na jednym smyczku oznaczają, że każdy dostaje połowę. Planuj naprzód i zaczynaj łuk z zapasem smyczka na oba dźwięki.";
"L011d756661" = "C E G, F A C i G B D mają na dole tercję wielką.";
"L0124abba92" = "Zwrotka śpiewa kilka słów na jednej nucie. Graj każde F z krzyżykiem krótko i równo, a słowa niech niosą wers.";
"L0129c1441b" = "Na 1, 3 i 5";
"L013fea348d" = "G, A";
"L015e6a69e5" = "Dwa razy na sekundę";
"L016652736c" = "Którym stopniem gamy jest ostatni dźwięk?";
