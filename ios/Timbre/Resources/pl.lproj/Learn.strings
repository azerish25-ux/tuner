"L01d8ca79df" = "Opera Carmen Georges'a Bizeta miała premierę w Paryżu w 1875 roku. Preludium zaczyna się tym uroczystym marszem, a potem pojawia się melodia słynnej Pieśni toreadora.";
"L01e269d40a" = "Sekundy, tercje, seksty i septymy występują w odmianach wielkich i małych. Mały interwał jest zawsze o półton mniejszy od wielkiego.";
"L01e81b91bc" = "Domowy punkt odniesienia";
"L01e9d574a3" = "Vibrato nie uratuje fałszywego dźwięku; tylko barwi ten trafiony. Większość muzyków dodaje je, gdy palce trafiają czysto bez szukania.";
"L01ee5b3bac" = "Ti leży zaledwie półton poniżej do, więc silnie do niego ciąży.";
"L020232021d" = "Przyspiesz, aż rytm się wyrówna";
"L0213925244" = "Puste wysokie G należy do akordu C, więc brzmi bez dociskania. W tych lekcjach nigdy nie dociskasz tej struny.";
"L0213e2ea6e" = "Piosenki wracają do akordu swojej tonacji. W F jest nim F.";
"L022a274f11" = "Który ciąg biegnie w dół?";
"L023748ecd0" = "Cudowna łaska, pierwsza połowa";
"L023da003cb" = "W taktach 11 i 12 często gra się zwrot: krótką zagrywkę prowadzącą na początek. Ta schodzi z A do E, po jednym progu.";
"L023e171007" = "Pierwsze palce: A i E";
"L023f7f5a8c" = "Przejście z G do B i z powrotem zmienia struny. Kołysz płynnie łokciem.";
"L0241523d12" = "Usłysz dźwięk, zaśpiewaj go i poruszaj się małymi krokami.";
"L025497d15a" = "Grupy po dwa";
