"L4716f06a93" = "Septyma";
"L471b82b423" = "Łabędź pochodzi z Karnawału zwierząt, napisanego przez Camille'a Saint-Saënsa w 1886 roku. To jego początkowa fraza, uproszczona i przeniesiona oktawę niżej.";
"L47207f2354" = "Jane Taylor (1806)";
"L4730912cd3" = "Interludium";
"L4735de3a09" = "Nad podstrunnicę";
"L473cfd5bc5" = "Szarp naprzemiennie opuszkami palców wskazującego i środkowego. Oprzyj kciuk na przetworniku lub na strunie 4.";
"L4748699753" = "Dzień targowy czerpie z highlife, pogodnego gitarowego popu z Ghany i Nigerii: G, B-moll, C i D w tempie 104 uderzeń na minutę. Motyw odbija się od pulsu, więc nie przestawaj się ruszać.";
"L475c7e45a4" = "Te słowa po raz pierwszy pojawiły się w amerykańskiej książce dla dzieci w 1885 roku, a James R. Murray nadał im tę łagodną melodię w 1887 roku. Kołysze się na trzy jak kołyska.";
"L476514910a" = "Półnuta brzmi przez dwa uderzenia. Szarpnij raz, policz raz, dwa i podtrzymaj dźwięk do następnej nuty.";
