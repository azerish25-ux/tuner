"L3cfdd441bf" = "Rozpoznaj, który z dwóch dźwięków jest wyższy: od szerokich skoków po najmniejszy krok.";
"L3cffc5119a" = "Dociśnij ją mocniej";
"L3d062b60ba" = "Gitarzyści swingowi akompaniują krótkimi akordami odpowiadającymi zespołowi. Rytm charlestona uderza na raz i swingowe „i” po dwa, potem zostawia przestrzeń.";
"L3d0b6575fc" = "Utrzymaj równo";
