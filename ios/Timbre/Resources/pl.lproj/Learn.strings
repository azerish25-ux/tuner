"L4612c36c66" = "Początek: E E F G G F E D, krok po kroku.";
"L4618448b18" = "Pentatonika durowa, hammer-ony i slide'y country, tryle, frazowanie oraz słodycz i ostrość w bluesie.";
"L462597718b" = "Charles Wesley napisał słowa w 1739 roku. W 1856 angielski organista dopasował je do melodii z utworu chóralnego Feliksa Mendelssohna i odtąd kolędę śpiewa się w tej wersji.";
"L4628ff6cee" = "Prymy i kwinty, jak przy pierwszym akompaniowaniu zespołowi na basie: pryma na początku akordu, kwinta pomiędzy, nisko w pierwszej pozycji. Piosenka pozostaje w A, w którym gra ją zespół.";
"L462c1cdbea" = "Który palec gra F z krzyżykiem na strunie E?";
"L463616e2ed" = "Zagraj lub zaśpiewaj trzy dolne linie: E, G, B.";
"L4648e71e66" = "Krótka rozgrzewka łagodnie przygotowuje głos: oddychaj nisko, mrucz, wykonaj wibracje warg, a potem zaśpiewaj skalę. Zacznij w środku skali głosu i nie wychodź poza wygodny zakres.";
"L4668dbcb15" = "Walca liczymy na trzy: 1, 2, 3.";
"L46719941d8" = "Naprzemienny kciuk, powoli";
