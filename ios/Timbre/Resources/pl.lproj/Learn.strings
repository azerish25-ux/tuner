"L5d4b37b67c" = "Melodia biegnie od struny 5 do struny 1. Co pomaga dosięgnąć każdej struny?";
"L5d538c9b62" = "„Słona niedziela” to autorski utwór Timbre: spokojne reggae w A-moll, z Am7 i D7 na zmianę co takt. Pasują obie pozycje pentatoniki. Graj hammer-ony, pull-offy i slide'y, zaczynając takt dźwiękiem akordu. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
"L5d5cd8b1c4" = "2 i 4";
