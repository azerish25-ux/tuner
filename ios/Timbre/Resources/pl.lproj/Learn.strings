"L60416d96dc" = "Z kapodastrem nadal myślisz G, C i D: znane ci chwyty. Diagramy tutaj podają akord, który naprawdę słyszysz, więc chwyt G z kapodastrem na 2 jest oznaczony A.";
"L6046c05006" = "Home! to cała nuta: trzymaj D na progu 3 struny 2 przez cały takt.";
"L60486c0a4b" = "Łatwe akordy septymowe";
"L6049def04f" = "Pauzy też się liczy";
"L604ac866f0" = "Stań prosto, zachowaj swobodę";
"L6053efe7e3" = "W grze palcami używa się hiszpańskich nazw: p to kciuk, i — wskazujący, m — środkowy, a — serdeczny. Oprzyj palec i na strunie 3, m na strunie 2, a na strunie 1, w gotowości do szarpnięcia.";
"L60567af0fd" = "C, A7, D7, G7, potem powrót do C. Każdy akord septymowy ciąży ku następnemu, tworząc łańcuch napięcia. Sto lat temu napędzał niezliczone piosenki.";
"L6063ec8dfa" = "Refren grany palcami";
"L6065bcf219" = "Tercje w górę gamy";
"L60715612f0" = "G-dur, w górę i w dół";
"L608e8768cd" = "Trzeci palec na strunie D";
"L60948f8372" = "Czarne klawisze, najmniejszy krok i dźwięki o dwóch nazwach.";
"L609651b67b" = "Obejmuje osiem nazw literowych";
"L60db049169" = "G D A E";
"L60dea2df67" = "Sprawia, że jest krótka i oddzielona";
"L60f61fb4e2" = "Bez nowości: E, F i G na strunie 1 oraz B, C i D na strunie 2. Zacznij powoli, a potem utrzymaj równe tempo.";
"L60f6f7bc7e" = "Nie zatrzymuj wahadła";
"L6128108d6c" = "Ten sam układ palców na dwóch niższych strunach, D-dur i trzy melodie.";
"L6129f8fd2f" = "Wszystkie cztery struny";
"L61378dcfa1" = "Gdy zmienia się akord, kciuk trafia w nową prymę dokładnie na raz. Palce nadal szarpią struny 2 i 3, tak jak wcześniej.";
"L613a306f82" = "Który palec gra próg 5 w tej pozycji?";
"L613b9483be" = "Wstęp i solo";
"L6142dc5601" = "Drugi temat ponownie";
"L614f875fca" = "Ta pozycja przy progu 2 daje też pentatonikę molową od F z krzyżykiem, gdy to F z krzyżykiem jest punktem wyjścia. O tym, którą grasz, decyduje dźwięk traktowany jak dom.";
"L6152642fb8" = "Para 2: pusta, próg 2, próg 4, próg 5.";
"L6153371910" = "Próg 3 leży w strefie drugiego palca, obejmującej progi 3 i 4.";
"L616a1bd784" = "Jazzmani zwykle dodają septymy: Dm7, G7, Cmaj7. Dodatkowe dźwięki wygładzają każdą zmianę. Prymy i droga do domu pozostają te same.";
"L616b46e903" = "Oda do radości, druga linijka";
"L6181145819" = "Trzymaj kostkę blisko strun i wykonuj równe ruchy. Szybkość przyjdzie później, gdy ruch będzie swobodny.";
"L6191fba215" = "Co robi wstęp?";
"L61992ffcfb" = "Struna 2, próg 4";
"L61a7fd6fc3" = "Każda gama durowa ma ten sam wzór kroków: cały ton, cały ton, półton, cały ton, cały ton, cały ton, półton. Zacznij od dowolnego dźwięku i zastosuj wzór, a zbudujesz gamę durową.";
"L61ac361d21" = "Czym jest zmiana pozycji";
"L61b524f257" = "Wysokość opada, gdy brakuje powietrza. Nieco wcześniejsze zakończenie utrzymuje czystą intonację całego dźwięku.";
"L61d442d352" = "Refren zaczyna wysoko: D na progu 3 struny 2, C z krzyżykiem na progu 2, puste B, potem w dół do pustego D.";
"L61da910eb5" = "Angeline the Baker";
"L61e018ea94" = "Krótkie akcenty i D9";
"L61e1dfe135" = "Pięć uproszczonych tradycyjnych melodii do wspólnego grania, od Boil Them Cabbage Down po Old Joe Clark.";
"L61ec307304" = "Ustaw palec 1 na progu 2 i przydziel każdemu palcowi własny próg, aż do 5. Od G na strunie 6, progu 3 skala wspina się przez struny 6, 5 i 4.";
"L61ee1ab807" = "Gdzie zatrzymuje się palec po szarpnięciu z oparciem?";
"L61f1c8da71" = "Ponumeruj skalę od G: G to 1, A to 2 i tak dalej do F z krzyżykiem, 7. Muzycy używają tych liczb, by mówić o melodiach i akordach w każdej tonacji.";
"L61fc25fa4f" = "Pierwsze uderzenie";
"L62137e8c2f" = "Sześć piosenek za jednym razem";
"L62175f3821" = "Bez nowości: G-dur przez dwie oktawy, skala w tercjach, A dorycka i D miksolidyjska. Trzymaj jeden palec na każdy próg.";
"L621c5e6bc0" = "Długo, krótko na trzy";
"L621f8b64c0" = "Dwanaście taktów";
"L622c702c21" = "Śpiewnik na ukulele";
"L623729eeb4" = "Interwał to odległość między dwoma dźwiękami. Pryma czysta to brak odległości: dwa razy ten sam dźwięk. Oktawa prowadzi od jednej litery do tej samej wyżej, jak od C do C. Brzmi jak jeden dźwięk, tylko jaśniej.";
"L62490fbda1" = "Niska część, druga połowa";
"L625278775b" = "Ten sam początek, inny koniec. Druga linijka wraca do C, do domu.";
"L625d141f7d" = "Palec 4 na strunie 1";
"L6271a044a6" = "Beethoven napisał ten utwór fortepianowy w 1810 roku, ale wydano go dopiero w 1867 roku, czterdzieści lat po jego śmierci. Ta uproszczona wersja zachowuje słynny początek.";
"L62773cc1b4" = "Zagraj struny 6, 5 i 4, po jednej.";
"L62781903b0" = "Szarp strunę 1 kciukiem i pozwól jej wybrzmieć.";
"L6281828c75" = "Pierwsza melodia do wspólnego grania";
"L628db1ad7e" = "Takt to jedna grupa uderzeń. Tutaj każdy takt ma cztery uderzenia, co zapisujemy jako 4/4. Uderzenie 1 rozpoczyna każdy takt, więc lekko podkreśl je podczas liczenia.";
"L62ab25cde7" = "Kwinta czysta";
"L62ba9ae8e4" = "Przewroty G i D";
"L62bb50e1c3" = "Który akord to Cmaj7?";
"L62c4d6152c" = "Para 3, próg 2, pierwszy palec.";
"L62d40dd812" = "Pierwszy palec na progu 1 struny 2, drugi na progu 2 struny 3. Struny 4 i 1 brzmią pusto. Pomiń piątą strunę; jej G kłóci się z D7.";
"L62f0a6aab6" = "Jedna para powoli faluje. Co jest nie tak?";
"L62fa3abe46" = "Dwa kierunki";
"L62fb1d70f8" = "Palec 1 trzyma strunę 5 na progu 3 i leży aż do struny 1. Palec 3 gra strunę 4, palec 2 strunę 3, a palec 4 strunę 2.";
"L630868a13b" = "To wyzwanie miesza łuki przedłużające i kropki. Licz na głos każdą ósemkę; trzymany dźwięk nadal zajmuje cały swój czas.";
"L6311ef1e1f" = "Trzy uderzenia: półnuta (2) plus jej kropka (1).";
"L63190e07e0" = "Przed erą płyt rodziny śpiewały te pieśni w domu przy fortepianie. Tutaj idą jedna po drugiej, z wielką melodią Holsta na zakończenie.";
"L632198cb87" = "Tematy klasyczne II";
"L63233a5412" = "Pryma, oktawa, kwinta i kwarta, każda powiązana z melodią, którą możesz zanucić.";
"L6335412816" = "Jakie palce grają D-dur na każdej strunie?";
"L634209dd7c" = "Każda nuta tutaj to ćwierćnuta, półnuta lub cała nuta. Licz cztery równe uderzenia w takcie i pozwól długim nutom brzmieć.";
"L6355e11493" = "D, E, F: trzy litery.";
"L63881ab90d" = "I, IV i V";
"L638f400164" = "Synkopa kładzie akcent między uderzeniami. Na początku każde C przypada na i. Licz raz-i-dwa-i i poczuj, jak C ciągnie naprzód.";
"L639b70b19b" = "Górskie brzmienie molowe";
"L63a15ae368" = "Próg 1 struny 2";
"L63a5f6c540" = "Oba akordy trzymają próg 2 na strunach 3 i 2. Zmieniają się tylko struny skrajne.";
"L63abb5650f" = "Siedem";
"L63b4995f45" = "Unisono i powtórzenia";
"L63b5f26523" = "W metrum sześć ósmych ćwierćnuta i ósemka tworzą jedno duże uderzenie: długo, krótko. Licz raz-dwa-trzy, cztery-pięć-sześć i graj na raz, trzy, cztery i sześć.";
"L63bb4a431f" = "Większy nacisk zwykle podnosi wysokość, a bardzo ciche dźwięki mogą opaść za nisko. W obu przypadkach pilnuj wysokości.";
"L63d01fe4fe" = "W połowie między podstawkiem a podstrunnicą";
"L63dcadbd78" = "Pięć melodii jedna po drugiej, po jednej frazie. Oddychaj przy każdej pauzie i zaczynaj powtarzane dźwięki na nowo.";
"L63e8cf2011" = "Co leży cały ton nad B?";
"L63f358c905" = "To najtrudniejsza część";
"L640134fefa" = "Para A działa tak samo: pusta to A, próg 2 to B, próg 4 to C♯, a próg 5 to D. Dłoń pozostaje na miejscu.";
"L640b18da1f" = "Wiązanka klasyczna";
"L6416c8c03f" = "W dół";
"L641a2740f3" = "Melodia";
"L6425315084" = "Na raz i trzy";
"L6439513619" = "Które słowo trwa przez dwie nuty w pierwszej zwrotce?";
"L644b2e3eb5" = "Na progach";
"L6455adb054" = "Twoje solo";
"L6478bdaaa1" = "Wiązanka hymnów";
"L647e4d73c5" = "W górę i do domu";
"L648307a100" = "Kiedy wypada uderzenie w górę?";
"L64846fd98f" = "Gitarowe solo";
"L648ac30e5c" = "Małe F, D7 i dwie tradycyjne piosenki z akordami i melodią.";
"L648bfd8404" = "Bicie wyspiarskie ze zmianami";
"L649b215476" = "Para 3: pusta, próg 2, próg 4, próg 5.";
"L64afb60dbd" = "Co robisz podczas pauzy?";
"L64e238b935" = "Na 1 i 4";
"L64e6a5eeed" = "Ta wersja jest w E-moll, w pierwszej pozycji: melodia przechodzi przez cztery struny palcami od 1 do 4, a schemat akordów jest dla osoby, która ci akompaniuje.";
"L64e9fb8ad9" = "Zagraj lub zaśpiewaj dwa półtony na białych klawiszach: od E do F, potem od B do C.";
"L64f341465b" = "Pusta 3, struna 2 próg 1, pusta 1, struna 2 próg 3, struna 1 progi 1 i 3.";
"L6501930589" = "Ten sam dźwięk czy inny?";
"L650634caa9" = "Której pustej strunie odpowiada próg 3 na strunie 2?";
"L6509372805" = "Piosenka: Halogen";
"L6512fd6029" = "Pryma, tercja, kwinta";
"L651aaf0899" = "Każde stuknięcie ma nazwę";
"L653eb46bda" = "Wiolonczela opiera się o klatkę piersiową, a kolana lekko stabilizują ją po bokach.";
"L654648b7f9" = "Gra tylko na uderzeniu 1";
"L655060742f" = "Unieś niepotrzebny palec i ustaw nowy, gdy ostatnie uderzenie jeszcze brzmi. Patrz naprzód, na następny akord.";
"L65572eaf06" = "Stephen Foster napisał tę piosenkę o wyścigach w 1850 roku, dwa lata po Oh! Susanna. Ma te same nuty i te same dwa akordy.";
"L656206b093" = "Ile taktów A otwiera 12-taktowego bluesa?";
"L65626dc943" = "Tę melodię wydrukowano w 1582 roku w fińskim śpiewniku Piae Cantiones jako piosenkę o wiośnie. John Mason Neale nadał jej bożonarodzeniowe słowa w 1853 roku.";
"L65790ce0d0" = "12-taktowy blues";
"L658534e988" = "Ósemkami w górę do A";
"L6586ce1f1f" = "Cudowna łaska ma trzy uderzenia w takcie. Graj tremolo przez każdy długi dźwięk i zmieniaj dźwięki dokładnie na puls. Dwa dźwięki są nowe: A i B na parze G.";
"L65a24ccc47" = "Druga połowa zaczyna się wysoko: czwarty palec sięga do B na strunie E. Potem trzeci, potem niski 2.";
"L65b5eedd25" = "Wiązanka pierwszych dźwięków";
"L65da260ff1" = "Teraz najgrubsza struna, czyli C. Niech zabrzmi głęboko.";
"L65dc0bc434" = "G, H";
"L65fc8eeea6" = "Mniej więcej tyle samo";
"L66059b65aa" = "Zwykłe A-moll ma F. Skala dorycka zachowuje F z krzyżykiem z G-dur: jasny punkt w molowej skali.";
"L661b9e9f2e" = "Jedna pozycja, cała pętla";
"L661f67974f" = "Zastępuje refren";
"L66239be110" = "Unisono: ten sam dźwięk";
"L6636558793" = "Usiądź prosto, ustaw nóżkę, chwyć smyczek miękko i połóż go w połowie drogi między podstawkiem a podstrunnicą. Teraz zagraj wszystko z tego działu.";
"L664305ffb2" = "Od D do F przeskakujemy E, więc to skok: tercja.";
"L6643ee2897" = "F i C";
"L664688a0e9" = "Tryb po trybie";
"L6646d01d84" = "Pop w 6/8";
"L6651a17acc" = "Puste D, E i F z krzyżykiem na strunie 4, potem skok do D na progu 3 struny 2 i w dół C z krzyżykiem, B i A.";
"L66573d54aa" = "Dwa skoki w górę";
"L6693552855" = "Kroczący blues w A";
"L66a2e1bb47" = "Cały śpiewnik w tonacjach na ukulele, od początku do końca";
"L66ae417c89" = "W dół na liczbę, w górę na „i”. Ręka schodzi i wraca raz na każde uderzenie pulsu.";
"L66ba679c70" = "Znajdź puls, licz do czterech i wystukuj w rytmie.";
"L66d9448f4d" = "Szum na kanale dziewiątym to punk: cztery power chordy, ósemki tłumione dłonią, 104 uderzenia na minutę. Zwrotka mruczy niskimi nutami; refren to grupowy okrzyk, więc daj mu moc.";
"L66fa22185a" = "Ósemka trwa pół uderzenia, więc w każdym mieszczą się dwie. Używaj małych, szybkich ruchów w pobliżu środka smyczka.";
"L66fbb37faf" = "Przechodzisz na nową parę na „i”. W którą stronę kostkujesz?";
"L670d6914c0" = "Akordy ustalają tonację, potem brzmi jeden dźwięk. Najpierw znajdź do, potem nazwij dźwięk. Każda tonacja działa tak samo.";
"L670e7fd853" = "Jesteś poniżej dźwięku, więc lekko podnieś wysokość.";
"L671c1ff474" = "Pierwsza fraza kończy się nutą z kropką. Jak to odczuwasz?";
"L67278e4178" = "Zwrotka i refren";
"L672fd54460" = "C-dur, druga oktawa: drugi palec gra F i górne C.";
"L6739b9a584" = "Przedtakt i pierwszy takt: puste G, A na progu 2, potem puste B, dwa razy D na progu 3 i puste E.";
"L67684dd3f9" = "„Mary miała małe jagnię” wymaga trzech nut: pusta struna 2 to B, próg 2 na strunie 3 to A, a pusta struna 3 to G. Dźwięk A grasz drugim palcem.";
"L67695d722e" = "Odpowiedz na riff";
"L676e1e1bc9" = "Uderzenie 3";
"L677297f490" = "Początek: D, G, B G, B, A. Puste struny 4, 3 i 2 oraz A.";
"L6776fd531f" = "Pchają trzy palce";
"L6777925e65" = "Połóż palec 1 przez struny 3, 2 i 1 na progu 2, potem sięgnij palcem 3 do struny 4, progu 4.";
"L67920ab8cb" = "O jeden próg niżej";
"L67a8f1045a" = "Stosując wzór od D, otrzymasz F♯ jako dźwięk 3 i C♯ jako dźwięk 7.";
"L67baf4caa8" = "Od D do F jest tercja mała, a od F do A wielka.";
"L67c3806843" = "D, DU, UDU";
"L67c948a825" = "Ile półtonów jest od D w górę do F?";
"L67d0dcf34e" = "Nuta trwająca dwa uderzenia";
"L67db55e61d" = "Dźwięk, na którym budujesz trójdźwięk, to jego pryma. Środkowy to tercja, a górny to kwinta; ich nazwy wynikają z odległości nad prymą.";
"L67ef0e743a" = "Graj głośniej";
"L67f0897e60" = "Postaw czubek pierwszego palca na strunie A przy pierwszej taśmie. To B, cały ton nad A; cały ton to dwa półtony. Dociskaj, aż struna dotknie podstrunnicy.";
"L67f2b8db53" = "C, p-i-m-a";
"L680e20c077" = "Znane wszystkim melodie od początku do końca";
"L6824a5dc37" = "Różne";
"L68262bf228" = "A w czwartej pozycji, puste A, A w czwartej pozycji. Niech zabrzmią tak samo.";
"L68275325bd" = "Której struny ta melodia w ogóle nie używa?";
"L6829fbcb04" = "Od do do do: od C w górę do następnego C.";
"L6854c89618" = "Jaki dźwięk jest na progu 3 struny 4?";
"L6859188a0b" = "Trzymaj akord, graj melodię";
"L686fe0d2fa" = "Połóż palec 1 przez struny 4, 3 i 2 na progu 2, a palec 2 na strunie 1, progu 3.";
"L688a376adc" = "Ile szesnastek mieści się w jednym uderzeniu?";
"L689041fa42" = "Niski 2 i wysoki 2 na strunie A, potem niski 2 i wysoki 2 na strunie E.";
"L68a5d9377b" = "Chór na dachu to hymn na miarę stadionu w tempie 92 uderzeń na minutę. Grasz refren w C, potem jeden takt A podnosi wszystko o cały ton i refren wraca w D.";
"L68a9c445ed" = "Palce z pazurkami szarpią w górę";
"L68b0c5bf55" = "Skąd pochodzi wysokie G w pierwszym takcie?";
"L68b2b09c89" = "A♭";
"L68d4c57c61" = "Jeśli potrafisz, zagraj pełne barré B-moll na progu 2. Jeśli nie, użyj czterech najcieńszych strun: próg 4 na strunach 4 i 3, próg 3 na strunie 2, próg 2 na strunie 1.";
"L68d4cfda41" = "B7 ciąży ku E. Jego napięcie znika w E-moll lub E.";
"L68d6126c37" = "Jaki akord tworzą razem D, F♯ i A?";
"L68d9990b7c" = "A7: ten sam sposób";
"L68dba3a68d" = "Ostatni wers idzie w górę od pustego D na strunie 4: E, F z krzyżykiem na progu 4, puste G, potem A.";
"L68fd09b287" = "Mocny chwyt lewej ręki";
"L68fd5ef7e1" = "Tempo rośnie. Jak powinny zmienić się stuknięcia?";
"L690a93e955" = "Mostek";
"L690aa0b88d" = "W czwartej pozycji pierwszy palec gra D na strunie A, czyli dźwięk grany czwartym palcem w pierwszej pozycji. Kciuk spoczywa tam, gdzie szyjka przechodzi w pudło.";
"L690ab2befe" = "Sąsiednie dźwięki";
"L6918767a98" = "Synkopa: między uderzeniami";
"L6918c2a4bb" = "Który dźwięk jest kwintą w trójdźwięku D F A?";
"L691f903820" = "Nie używa się go";
"L691f9c22d1" = "Same akordy";
"L693752b4ae" = "Graj dalej i złap następny akord";
"L6941e683a3" = "Ponieważ struna 4 to wysokie G, schemat idzie zygzakiem: wysoko, nisko, potem w górę. Ten blask to brzmienie ukulele granego palcami.";
"L694f5f09fe" = "Gdzie należy oddychać w tej piosence?";
"L6952d23be8" = "B5";
"L695d14c16d" = "Dwa progi nad G leży A. Nazwa akordu zmienia się wraz z jego prymą.";
"L696010416e" = "Septyma wielka";
"L696cd74a3d" = "Siedząc prosto, szarpnij D, potem G. Rozluźnij ramiona.";
"L6971957b55" = "Na początku każdego taktu liczenie zaczyna się znów od 1.";
"L6973e1fed9" = "Refren";
"L697ea8051a" = "Dzięki CAGED rzadko musisz skakać. W okolicy progu 5 G grasz chwytem D, C chwytem G, a D chwytem A. Trzy akordy, jedno miejsce.";
"L6980bcdcd2" = "Rondo alla Turca";
"L698eca6ecd" = "Pauza, potem stuknij na „i”";
"L69a3fc0ffb" = "Ruch prowadzi łokieć";
"L69acddb13a" = "Bez nowości: jeden palec na strunę, schemat tam i z powrotem, naprzemienny kciuk i melodia wewnątrz akordu.";
"L69ba79c271" = "Sprawdzian zmian pozycji";
"L69c68aba96" = "Speed, bonnie boat, like a bird on the wing: puste D, E, D, trzy puste G, potem A, B, A i w górę do D.";
"L69d4feab52" = "Skocz dużo wyżej";
"L69d6c14191" = "„Powolny stroboskop” to autorski utwór Timbre: synth-pop w A na molowym F z krzyżykiem, D, A i E. Pozycja przy progu 2 pasuje do całej pętli: pentatonika A-dur, a zarazem molowa od F z krzyżykiem. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
"L69db2318a3" = "Pieśń wędrownych handlarzy";
"L69dca66da6" = "Podziel każde uderzenie na dwa i licz „i”.";
"L69dd77610a" = "Struna 3: progi 2 i 4. Szarp raz, potem rób hammer-on i pull-off palcem 3.";
"L69e8d3e991" = "Która pusta struna daje najniższy dźwięk?";
"L69f444cda2" = "Trzy dźwięki tworzą akord";
"L6a0141eeb5" = "Zmiana akordu nie wychodzi w środku piosenki. Co teraz?";
"L6a04869038" = "Zmieniaj dźwięki basu";
"L6a06751695" = "Pierwsze akordy";
