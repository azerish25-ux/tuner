"L749ac2f07c" = "„Radio odpływu” to autorski utwór Timbre: spokojne reggae na E-moll i A. Gitara gra tylko na „i”. Ruszaj ręką dół-góra, omijając struny na liczby i trafiając na każde „i”. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
"L749bdaec42" = "E to biały klawisz tuż po prawej stronie grupy dwóch czarnych klawiszy.";
"L749c9d8d0e" = "Bez nowości: forma, wstępy, powtórki na zakończenie, faktura, wypełnienia i twoje „Down by the Riverside”. Zagraj całość bez przerwy, jak występ.";
"L74a62f2786" = "Rozpoznaj akordy durowe i molowe, potem zmniejszone, zwiększone i dominantowe septymowe.";
"L74b4fa7ea9" = "Jeden akord, jedna piosenka";
"L74c9c1f9c1" = "Od niskiej do wysokiej: G, D, A, E. Każda kolejna struna brzmi o kwintę wyżej: to piąty dźwięk, licząc nazwy literowe od poprzedniej struny. Zapamiętaj: Gosia dobrze akompaniuje Ewie.";
"L74d62bc627" = "Graj, graj, pauza, graj";
"L74e030bebc" = "Od C do D pomijamy czarny klawisz między nimi: to cały ton, czyli sekunda wielka.";
"L74e110372c" = "Nastrój wiolonczelę";
"L74e60d76a3" = "Ballada z gorączki złota";
"L74f0435d4b" = "„Shuffle z Pasa Rdzy” to autorski utwór Timbre: 12-taktowy blues w E, według znanego ci schematu, z melodią w swingowym rytmie. Zachowaj długo–krótko w obu rękach. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
