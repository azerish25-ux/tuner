"L8d6ce15313" = "Która tonacja durowa ma dwa krzyżyki?";
"L8d71201dce" = "Trzy schematy, pięć akordów";
"L8d7832013f" = "Bez zmiany struny, z cieplejszym brzmieniem";
"L8d8d13f6af" = "Teraz najcieńsza, struna 1.";
"L8da12619dc" = "Cztery piosenki z domeny publicznej, z melodią i akordami.";
"L8db1314ed2" = "Hammer-on i roll";
"L8dbf6541b6" = "Większość piosenki opiera się na G. D7 pojawia się na końcu drugiego wersu, a C barwi czwarty. Zmieniaj akord na słowie rozpoczynającym takt.";
"L8dd449787d" = "Struna G";
"L8dd8c19ce6" = "Puste E";
"L8dd93106de" = "Przed założeniem kapodastra: szarp puste struny 1 i 2. To E i B.";
"L8ddf603daf" = "Bas podpowiada uchu, który akord grasz. Pryma na raz wyraźnie zaznacza zmianę.";
"L8de501a36e" = "Zachowaj pierwszy dźwięk w głowie, gdy brzmi drugi. Potem porównaj je, jak dwie wysokości ustawione obok siebie.";
"L8de764a4cd" = "i, m, a: wskazujący na strunie 3, środkowy na 2, serdeczny na 1.";
"L8deaa20015" = "Timbre";
"L8df5dae6c0" = "Bardzo głośnym dźwiękiem";
"L8df938dc5d" = "Jaki wzór zabrzmiał?";
"L8e0159dfcd" = "Sezon hamakowy to łatwe reggae w C w tempie 76 uderzeń na minutę. Gitara gra tylko na dwa i cztery: jedno krótkie, jasne bicie w górę na cieńszych strunach, potem cisza.";
"L8e036dd4bf" = "Inne metra";
"L8e081d8487" = "Późne wymeldowanie";
"L8e0d30c372" = "Trzecia fraza, soft the drowsy hours, wznosi się do C, D i E. Pozostałe trzy frazy mają tę samą melodię.";
"L8e0fa6714e" = "Rozgrzewka: porównaj czwarty palec z pustymi strunami, najpierw A, potem E.";
"L8e12c51b85" = "Zacznij od D";
"L8e1f78c027" = "Akord septymowy dodaje dźwięk, który ciąży ku tonice. D7 chce przejść w G. Palce: 2 na strunie 3, progu 2; 1 na strunie 2, progu 1; 3 na strunie 1, progu 2.";
"L8e215e734a" = "Przenieś do D i E";
"L8e244d0df6" = "Półnuta trwa dwa uderzenia. Użyj dłuższego, wolniejszego pociągnięcia, aby dźwięk nie słabł na drugim uderzeniu.";
"L8e26078967" = "Krok, krok, przytrzymaj";
"L8e3537ea13" = "Zwroty w rytmie punktowanym";
"L8e372c61b9" = "Bum, pierwszą";
"L8e449bf03d" = "Dur czy moll?";
"L8e472761e0" = "E, półton w górę do F i z powrotem.";
"L8e48bd58a1" = "C, F, G7, C";
"L8e531fc324" = "Ćwierćnuty i pary";
"L8e58c29cec" = "Wyzwanie solowe";
"L8e5dc125b0" = "Cztery rytmy, jedna ręka";
"L8e63782e93" = "Każdy palec ma swój półton. Trzymanie wszystkich czterech na miejscu sprawia, że każdy dźwięk trafia za każdym razem w ten sam punkt.";
"L8e6a7ff4c1" = "Trzymaj G przez większość wersu, C na crib for a bed, a D7 niech prowadzi do domu. Na trzy bij w dół na raz i lekko na dwa i trzy.";
"L8e6d99d6d5" = "Zaczyna tę samą melodię później";
"L8e6f9b89fa" = "Dwie nuty na jedno uderzenie";
"L8e725a02c0" = "Trzy razy";
"L8e79e5f76b" = "Punk i rock na power chordach";
"L8e89a50f83" = "Wstęp: Travis na G i D7";
"L8e8a426d30" = "Nad końcem podstrunnicy";
"L8eb002c098" = "Ćwierćnuty na A";
"L8ebf8adb53" = "Marsz ponownie";
"L8ec6b597c8" = "Szarp strunę 1 na progu 2, potem zagraj pull-off do pustej.";
"L8ee74d56ef" = "Zacznij tę samą pętlę od vi, a otrzymasz vi–IV–I–V: A-moll, F, C, G. Akordy są identyczne, lecz molowy początek nadaje poważniejsze brzmienie.";
"L8ef1b53787" = "Pryma, kwinta, oktawa, potem powrót do kwinty. Na A: pusta struna 3, próg 2 struny 2, próg 2 struny 1. Pasuje do każdego akordu durowego lub molowego.";
"L8f0d715970" = "Pomiń stopień: tercja";
"L8f17a64c02" = "Struna 3: trzymaj próg 5 palcem 1 i szarp strunę, potem uderz palcem 3 na progu 7.";
"L8f23fdd1d8" = "Wyzwanie: twój występ na scenie";
"L8f320d87c0" = "Sześć znanych melodii, po jednej nucie na cieńszych strunach. Wolne tempo, wielka satysfakcja.";
"L8f339f02c0" = "Nadchodzą toreadorzy";
"L8f577a55a2" = "Melodia tradycyjna (druk z 1917)";
"L8f62ed5e67" = "Różne odległości";
"L8f89b8e0dc" = "Słowa Wesleya, melodia Mendelssohna";
"L8f8a2a2d84" = "Akordy schodzą F, E, D. Na czym ląduje pętla?";
"L8f8abdbe72" = "Długie dźwięki w górę";
"L8f921f64e0" = "D F A: tercja mała, potem wielka.";
"L8fb29d802d" = "Wypełniaj dźwiękami akordu brzmiącego pod długą nutą. Na G: G, B i D. Na D7: D, F z krzyżykiem, A i C. Nie będą zgrzytać z zespołem.";
"L8fc0138f5f" = "Jazzowy wzór na ride";
"L8fc16896c6" = "F i G";
"L8fd60484f5" = "D-dur ma dwa krzyżyki: F z krzyżykiem i C z krzyżykiem. Oba grasz wysoko ustawionym palcem 2.";
"L8fd6eb1491" = "Teoria muzyki";
"L8fd6fdc444" = "Takie same czy różne";
"L8fdd7370fb" = "Akcent to dźwięk zagrany mocniej niż sąsiednie. Przesuń akcenty, a charakter się zmieni, nawet jeśli wszystkie nuty pozostaną te same.";
"L8fe7658f81" = "Jest najgrubszą struną";
"L8fe8c8dd43" = "Między E i F oraz między B i C nie ma czarnego klawisza.";
"L8ff7342a88" = "Struna 5";
"L90027b2982" = "Dźwięk pomiędzy";
"L9023afb03a" = "Walijska kołysanka, pieśń łodzi ze szkockich wyżyn i trzy kolędy: po niemiecku, łacinie i angielsku.";
"L9027ae66b4" = "Offbeat to „i” między uderzeniami pulsu. Kiwaj głową na liczby i stukaj tylko na „i”, jak tłumione uderzenia gitary reggae.";
"L902977f90f" = "D i G";
"L9039459dc1" = "Zadaj ostre pytanie przy progu 5, potem słodko odpowiedz przy progu 2. Przesuń rękę na długim dźwięku i zakończ obie frazy na A.";
"L903c46b456" = "D, G, A, D";
"L905b5e6f9a" = "F na progu 1 struny 1, puste E, C na progu 1 struny 2, potem G na progu 3 struny 1, E i C.";
"L905ea4c423" = "Początek";
"L9076d517d1" = "Dopasuj wysokość";
"L9089c0361d" = "Poznaj pięć strun, nastrój do otwartego G, znajdź strunę burdonową i zagraj piosenkę.";
"L90a0efbc72" = "Narastanie i wyciszanie";
"L90c41c755e" = "Niemiecka pieśń ludowa";
"L90f0a50cbb" = "Struna burdonowa";
"L90f2df58e4" = "Od 3 do 4";
"L910ddb372b" = "Wielkości w półtonach";
"L91116aad75" = "W metrum na trzy uderzaj dół na 1, potem dół–góra na 2 i na 3: D, DU, DU. Podkreśl 1, aby kołysanie było wyraźne.";
"L91127b7945" = "Twój instrument nie ma progów, więc każdy dźwięk ustawiasz słuchem. Wiele osób podczas nauki nakleja na podstrunnicę cienkie paski taśmy jako wskazówki.";
"L9114298cd0" = "Dociskaj przy progu, od strony główki";
"L912d5a9390" = "Na którym progu leżą wszystkie trzy palce w A?";
"L9130b5f088" = "Pauza to liczona cisza";
"L913345befa" = "G-dur, dwie oktawy";
"L9138eef56a" = "E, G i B";
"L913cf6027b" = "Niech ciężar ręki dociska barré, jak przy delikatnym przyciąganiu gryfu do siebie. Kciuk tylko stabilizuje. Obróć palec 1 lekko na bok.";
"L91421d0780" = "Dawna angielska ballada";
"L914bfe3e36" = "Oktawa";
"L914f41e96b" = "Oh! Susanna, docelowe tempo";
"L9150ad10a0" = "Zagraj frazę dwa razy tak samo, potem zmień tylko zakończenie. Słuchacze rozpoznają powtórkę i czekają na niespodziankę.";
"L915a836cf9" = "Długo, krótko–krótko";
"L91625829f3" = "Kciuk, wskazujący, kciuk, środkowy: kciuk gra co drugi dźwięk, stąd nazwa tego rollu.";
"L916747f4b1" = "Łatwiejsze B-moll";
"L916a78d701" = "Pierwszy";
"L917c4a8a76" = "Ćwierćnuty i dłuższe wartości";
"L9196742b09" = "Pełne D7, jeśli chcesz";
"L91967d6e76" = "Vibrato sprawia, że dźwięki śpiewają";
"L919980cb85" = "Który palec gra B na strunie A?";
"L919c5a30be" = "Małe zmiany najszybciej trafiają w dźwięk. Delikatnie podnieś wysokość i pozwól jej się ustalić.";
"L919dcdc979" = "Przy zmianie G na C na progu 3 palec 1 utrzymuje barré. Zmieniają się tylko palce dalej od główki. To najpłynniejsza zmiana barré.";
"L91a9491bcd" = "Wyzwanie: dziesięć akordów";
"L91d307deab" = "D, E, F z krzyżykiem, G: pusta, 1, 3, 4.";
"L91d585db22" = "E D C B";
"L91f10a30af" = "Usiądź prosto, blisko brzegu";
"L91f6624ab0" = "Em: schodki";
"L91f8ed6b40" = "Tłumienie to połowa gry na basie. Oprzyj lekko palec na strunie, aby ją wyciszyć.";
"L92012f8afc" = "„Joy to the World”, w aranżacji Lowella Masona z 1839, zaczyna się skalą G-dur schodzącą prosto z góry. Znasz już każdy dźwięk.";
"L9204183bf9" = "C, E i G";
"L920df29d22" = "Trzy palce w rzędzie";
"L920f253fe7" = "Otwarte C przesunięte o siedem progów wyżej daje G. Palec 1 leży na strunach 3, 2 i 1 na progu 7, palec 2 gra strunę 2 na progu 8, a palce 3 i 4 sięgają do strun 4 i 5.";
"L9216734f89" = "Jeden dźwięk, dwa miejsca";
"L921bfa2279" = "Najwyższe dźwięki idą tu G, G, G, F z krzyżykiem: prawie stoją, gdy pod nimi zmieniają się akordy. Dźwięk należący do dwóch akordów to dźwięk wspólny. Dzięki niemu trójdźwięki brzmią tak płynnie.";
"L9222e335ff" = "Załóż kapodaster przy progu 2 od strony główki i szarp je znów: F z krzyżykiem i C z krzyżykiem.";
"L9225771ef7" = "Ta melodia pochodzi z IX Symfonii Beethovena. Używa C, D, E, F i G, zwykle przechodząc między sąsiednimi dźwiękami.";
"L9250446614" = "Migaj, migaj, gwiazdko mała, szybciej";
"L92535cab95" = "Od G C E A do nowych tonacji, gry palcami i występu";
"L9260bce5a2" = "Edvard Grieg napisał Poranek w 1875 roku do sztuki Peer Gynt. Flet gra temat, obój odpowiada, a muzyka wznosi się jak wschodzące słońce.";
"L9279caa296" = "Saint-Saëns, 1886";
"L927fb0237c" = "Tremolo w wolnej melodii";
"L9280fd4c84" = "Bum to pojedynczy dźwięk, di to przejazd po strunach, a ti to kciuk na piątej strunie.";
"L928ff94fbb" = "Barré i wielkie finały";
"L929175316b" = "Gama D-dur";
"L9295de93d1" = "Próg 5 czy pusta struna";
"L929634bca2" = "Progi mandoliny leżą blisko siebie, więc każdy palec obsługuje dwa. Pierwszy palec gra progi 1 i 2, drugi 3 i 4, trzeci 5 i 6, a mały 7.";
"L92c11c2622" = "Na jakim dźwięku kończy się melodia?";
"L92c629aecd" = "Na parze E próg 2 to F♯, próg 3 to G, a próg 5 to A. Pierwszy, drugi i trzeci palec, tak jak wcześniej.";
"L92d2225f42" = "Pauza na końcu";
"L92d40794f5" = "D7";
"L92dad30792" = "Ti";
"L92f0fedac4" = "G, B i D to dźwięki akordu G. Dlatego ten strój nazywa się otwartym G.";
"L92f74658a6" = "Dwie ósemki";
"L93063dfd83" = "Który wzór tworzy gamę durową? (W = cały ton, H = półton)";
"L9323296883" = "C na progach 9, 8 i 8";
"L93296e7508" = "Ta melodia zaczęła jako spiritual. W dekadzie zaczynającej się w 1890 roku kolejarze na Środkowym Zachodzie nadali jej nowe słowa, a Carl Sandburg wydrukował ją w 1927 roku. Wznosi się od niskiego B do D na strunie 2.";
"L932eaaf5a3" = "IV";
"L9339e8e2bf" = "ii–V–I w pętli";
"L93426e061a" = "Słuchaj góry";
"L93454789e3" = "Ballada w tonacji molowej";
"L934bc345a0" = "Równo czy swingowo";
"L93538583d4" = "Kanion echa gra E-moll, C, G i D w tempie 80 uderzeń na minutę. Mocne bicie na raz, pozwól mu brzmieć, potem buduj napięcie na trzy i cztery. Rytm half-time daje poczucie ogromnej przestrzeni.";
"L935817d90a" = "Ta tradycyjna melodia była już w druku w 1896. Każda linijka kończy się długim dźwiękiem, więc odlicz go do końca przed następną.";
"L937007d20f" = "Kroki i skoki";
"L937448906f" = "Cztery uderzenia";
"L937f7ac180" = "Trzy akordy, nieskończenie wiele piosenek";
"L938495b6b3" = "Pociągnij przez strunę";
"L939941777a" = "Stukaj mocniej na każde uderzenie";
"L93a54e0bca" = "Mikrostroiki do małych zmian";
"L93ad46cbed" = "Ballada w A-moll";
"L93afab8c9e" = "Jak liczymy melodię Jowisza?";
"L93b54ad89d" = "Pryma to dźwięk, od którego akord bierze nazwę. W A-moll jest nim pusta struna 5, więc zacznij uderzenie tam i pomiń strunę 6.";
"L93cfd1277b" = "Które struny zwykle gra kciuk?";
"L93d28e4aba" = "Wyzwanie: prymy w rytmie";
"L93d4e10adb" = "Zagraj lub zaśpiewaj prymy I–IV–V–I w G: G, C, D, G.";
"L93e1056ae2" = "Marsz turecki";
"L93e511e9a3" = "Walijska kołysanka";
"L940775a017" = "Końcowa odpowiedź";
"L940dc20aaa" = "Melodie";
"L941a010b08" = "W czwartej pozycji na strunie D pierwszy palec gra G, a trzeci A, ten sam dźwięk co pusta struna A. Zagraj je kolejno i dopasuj ich wysokość.";
"L94294abc71" = "E7: unieś jeden palec";
"L943747a24f" = "Stań i oddychaj";
"L9438d9677d" = "Interwały czyste";
"L943bb31214" = "Śpiewaj „a” z opuszczoną żuchwą i czubkiem języka opartym za dolnymi zębami. Dźwięk swobodnie wypływa, zamiast być ściskany.";
"L943f75c91e" = "Nisko na obu";
"L944e411624" = "W części środkowej E i F mieszczą się w jednym uderzeniu pulsu. Licz raz, dwa-i, trzy, cztery. Zagraj E na dwa, a F na i.";
"L944e60cb74" = "D, C";
"L9452f8c4c6" = "Który dźwięk prowadzi do D na końcu drugiego wersu?";
"L945a9f057a" = "Teraz para 2, czyli para A.";
"L9464d06605" = "Tym razem G. Opuść żuchwę i utrzymuj otwarte „a”.";
"L946d9e8e59" = "Ostatni dzwonek to punk-pop w tempie 152 uderzeń na minutę: C5, G5, A5 i F5, pętla czterech akordów w wersji z power chordami. Same bicia w dół, równe ósemki, dłoń oparta na strunach przy mostku.";
"L9471dc4971" = "Od do do mi i z powrotem: C, E, C.";
"L94739b8015" = "Puste G, F z krzyżykiem na progu 4 struny 4, G, A na progu 2 struny 3, G, C na progu 1 struny 2 dwa razy i puste B.";
"L947c6bdef2" = "A-moll na progu 5";
"L9482daee9c" = "Od E do F";
"L948ad5178d" = "Środkowa linia to B, jak „ballady” w zdaniu „Ewa gra ballady dla Filipa”.";
"L948c4988ab" = "Prymy i kwinty, jak przy pierwszym akompaniowaniu zespołowi na basie: pryma na początku akordu, kwinta pomiędzy, nisko w pierwszej pozycji. Piosenka pozostaje w A-moll, w którym gra ją zespół.";
"L948eb34feb" = "Tor wrotkarski";
"L949ec2d490" = "Tam, gdzie melodia trwa na dźwięku";
"L94a826abe3" = "Przetrzymane dźwięki";
"L94af6c4088" = "Gitara";
"L94b0431a32" = "6/8 kołysze się w dwóch dużych uderzeniach, każde podzielone na trzy: raz-dwa-trzy, cztery-pięć-sześć.";
"L94b5f3e508" = "1 i 2 i 3 i 4 i";
"L94cc4cc3bd" = "Cztery w dół, cztery w dół";
"L94cd1bcc15" = "Wyzwanie ze stopniami gamy";
"L94d71996f9" = "A na progu 2 struny 3, puste B, D na progu 3 struny 2, potem G na progu 3 struny 1, F z krzyżykiem, puste E.";
"L94e06d61d8" = "G, B i D to dźwięki akordu G-dur, więc melodia wspina się po samym akordzie.";
"L94f2c05f3d" = "Wyzwanie z krzyżykami i bemolami";
"L9503c95c17" = "Pokaż, co umiesz";
"L951f4e8f4d" = "Jak powinny się przemieszczać palce między akordami?";
"L95355fcd8e" = "Pierwsza część, zakończenie";
"L953a83999d" = "Od dud do Paryża";
"L953de1dfc6" = "Cały czas w dół";
"L953ef812aa" = "Struna 4: próg 1, próg 3, próg 5.";
"L953f5d261e" = "Beethoven napisał tę melodię do swojej Dziewiątej symfonii w 1824. Porusza się głównie krokami, więc palce spacerują.";
"L95499b43d8" = "E7, G7 i A7";
"L95795902e2" = "W rocku często buduje się napięcie tłumionymi ósemkami, a potem gra akord bez tłumienia. Unieś dłoń przy mocnym uderzeniu i pozwól mu wybrzmieć.";
"L957dc77c43" = "Pierwszy przykład";
"L95847c5f13" = "Ta pieśń wioślarska jest w metrum sześć ósmych: sześć szybkich ósemek w takcie, odczuwanych jako dwa duże kołysania. Licz 1 2 3, 4 5 6, podkreślając 1 i 4.";
"L9585f7c5d0" = "Relaks w stylu lo-fi";
"L958cd7f8b2" = "Kiedy gitara gra w „Radiu odpływu”?";
"L95ab7724b7" = "Wyciśnij resztkę powietrza";
"L95bc608d2b" = "Ten wzór trafia na 1, na „i” po 2 oraz na 4. Licz 1 i 2 i 3 i 4 i, a stukaj tylko w tych trzech miejscach.";
"L95c1c21193" = "Wyzwanie z akordami";
"L95cc58709f" = "W G dwa, pięć, jeden to Am7, D7 i Gmaj7. Am7 to chwyt E-moll z septymą małą i barré na progu 5; Gmaj7 omija strunę 5, z prymą na strunie 6, progu 3.";
"L95ce1c02d1" = "Usłysz, potem zaśpiewaj";
"L95d140dc9a" = "Prosto w górę, od struny";
"L95e175061b" = "Jedna piosenka, trzy miejsca";
"L95eb9cc861" = "Zmiana rolli";
"L95f5713a23" = "Szarp do rytmu";
"L96088d2f8d" = "Pauzy";
"L960980770a" = "D-moll to F z dodatkowym palcem na progu 2 struny 3.";
"L96108a5b85" = "Półton prowadzi do najbliższego klawisza. Cały ton pomija jeden klawisz, więc równa się dwóm półtonom. Oba brzmią jak krok, ale cały ton jest nieco szerszy.";
"L9615ca288f" = "Jedna melodia, dwa kraje";
