"L73601df885" = "„Piwniczna pogoda” to autorski utwór Timbre: garażowy rock w A. Otwiera go riff na niskich strunach, a power chordy odpowiadają na raz, „i” po dwa i cztery. Trzymaj dłoń przy mostku. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
"L7364993206" = "Usłysz miejsce każdego dźwięku w tonacji, od do, czyli toniki, po ti.";
"L7364a9324b" = "Triola mieści trzy równe nuty w jednym uderzeniu. Licz 1-ta-ka, 2-ta-ka, nadając każdej sylabie tę samą długość.";
"L737e9af907" = "Od struny 6 do struny 2";
"L7383cb2d2c" = "Cała dłoń, łącznie z kciukiem";
"L738524e244" = "A C E: tercja mała, potem wielka.";
