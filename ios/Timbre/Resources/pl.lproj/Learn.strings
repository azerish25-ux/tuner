"L742c5e9458" = "Asus4 to A z małym palcem dodanym na strunie 2, progu 3. Tak jak Dsus4 ciąży naprzód i chce wrócić do domu.";
"L743c7fa8cf" = "Dudy, walce i tańce";
"L7455504689" = "Pierwsze piosenki";
