"L36cd82a17d" = "G♯ na progu 6";
"L36de176a3e" = "Który akord wymaga tylko jednego palca?";
"L36decd572c" = "Brahms napisał tę kołysankę w 1868 roku. Kołysze się na trzy na strunach G i D. Prowadź smyczek długo i powoli, pozwalając każdej frazie odetchnąć.";
"L36e51acb70" = "Melodie skrzypcowe ożywają dzięki drobnym ozdobnikom. Tutaj dwa zwykłe dźwięki A na początku Old Joe Clark zmieniają się w A, B, A: hammer-on i pull-off.";
"L36ea475fc4" = "Każda fraza zaczyna nisko na strunach basowych i skacze o oktawę w górę. Spójrz na wysoką nutę, zanim zagrasz niskie, aby dłoń wiedziała, dokąd zmierza.";
"L371ab07a8b" = "Barré na progu 2, a chwyt E-moll po stronie korpusu od wskazującego palca: molowe F z krzyżykiem.";
"L373b53c523" = "Unieść palec 3";
"L373e4f02b7" = "Utrzymuj równe dźwięki, kształtuj głośność i dobrze się rozgrzewaj.";
"L373ec9b432" = "F♯, G i A na parze 1, progi 2, 3 i 5, potem D na parze 2, próg 5.";
"L374c3725ba" = "Od A do E";
