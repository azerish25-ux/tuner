"L798fb9b546" = "Refren sięga w górę: B, D, puste E, potem G na progu 3 struny 1. Z powrotem w dół: D, B B G.";
"L7999cb145d" = "Nad górną linią wzór biegnie dalej. G leży tuż nad górną linią, a A na pierwszej linii dodanej powyżej.";
"L799c178cf7" = "Puste A, próg 4 na strunie 5, progi 2 i 4 na strunie 4, potem puste G.";
"L799d8f14e5" = "Skąd pochodzi ten rytm?";
