"L72893aee6a" = "Słoneczny highlife";
"L728cd633f1" = "A-moll";
"L728e1822bf" = "Od E w górę do G♯ to...";
"L729b7425d6" = "Przejście ze struny 2 na strunę 1 to drobny ruch. Trzymaj rękę szarpiącą blisko strun, gotową na następną nutę.";
"L72a3d2b16e" = "Ta francuska melodia ze stulecia zaczynającego się w 1700 roku używa tylko znanych ci dźwięków: A, B, C z krzyżykiem, D na strunie A oraz E i F z krzyżykiem na strunie E.";
"L72b3117837" = "D zmniejszony";
"L72b38c6701" = "Stały nacisk podczas przesuwania";
"L72bab7e9c6" = "Twoje pierwsze solo";
"L72bd85eb5d" = "Solmizacja daje każdemu stopniowi gamy sylabę: do, re, mi, fa, sol, la, ti, do. Do to dom, niezależnie od tego, gdzie zaczyna się gama.";
"L72be45acb1" = "A, struna po strunie";
"L72c3752afb" = "Utwór tradycyjny (1852)";
"L72c4335ad6" = "Który z tych utworów to walc na trzy?";
"L72c4615523" = "Jacques Offenbach napisał ten galop do swojej operetki Orfeusz w piekle z 1858 roku. Później paryskie sale taneczne uczyniły z niego muzykę kankana.";
"L72cb6a906d" = "Refrenem";
"L72d49b8308" = "Swing: długo, krótko";
"L72e1d250aa" = "Johann Strauss II po raz pierwszy wykonał ten walc w Wiedniu w 1867 roku, a Wiedeń nadal gra go w każdy Nowy Rok. Melodia wspina się po akordzie, a potem odpowiada dwiema wysokimi nutami.";
"L72e2680c98" = "Zaczyna się na niższej strunie";
"L72e4578411" = "Do mi sol mi";
"L72e72669af" = "Środkowa linijka";
