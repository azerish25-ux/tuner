"L72f8829e7e" = "Co to jest akcent?";
"L730ecf2b62" = "Usłysz, znajdź, zaśpiewaj";
"L730fe38866" = "Ta wersja jest w D. Czwarta struna jest nastrojona wysoko, więc melodia pozostaje na strunach od 1 do 3, a każdy akord w schemacie ma chwyt na ukulele.";
"L732983c362" = "Przy dźwięku czujesz napięcie lub drapanie. Co robisz?";
"L7329d82bd9" = "Pierwszy palec";
"L7338864b70" = "Pusta struna 3, potem struna 2 próg 2.";
