"L5ba3d0bd26" = "Zwrotka zaczyna się o uderzenie wcześniej, przedtaktem. Długi ostatni dźwięk zostawia na niego miejsce.";
"L5bacba7e1d" = "Przejście o jedną literę w górę prowadzi z linii do następnego pola lub z pola na następną linię. Nuty na sąsiednich liniach są oddalone o dwie litery.";
"L5bb2c4c6f5" = "Sprawdzian ósemek";
"L5bb58088d4" = "Progresja trójdźwięków";
