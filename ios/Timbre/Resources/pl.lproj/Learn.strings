"L03016009de" = "Wyzwanie z dźwiękami i literami";
"L0301e70c80" = "C-moll";
"L0306da2b91" = "Bum, di, ti: ti to zawsze kciuk na krótkiej piątej strunie.";
"L030d0d05a0" = "G, D, E-moll, C";
