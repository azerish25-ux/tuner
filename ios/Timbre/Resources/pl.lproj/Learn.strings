"L5dd85395a1" = "Który dźwięk to pusta struna G?";
"L5de6270d77" = "Zanim zaśpiewasz, przez sekundę usłysz dźwięk w głowie. Ta pauza pozwala głosowi celować w wysokość, zamiast jej szukać.";
"L5ded105f41" = "Shenandoah";
"L5df3a182bb" = "Wiązanka melodii ludowych";
"L5df42cd32b" = "Gdy dłoń uderza, kciuk opiera się na piątej strunie. Na następne uderzenie pulsu przechodzi przez nią, gdy dłoń się unosi.";
"L5e0badd310" = "Pierwszy wers: puste D, E, cztery puste G, zejście do B na strunie 5, potem do domu, do G.";
"L5e31a53ca0" = "Chwyt D, struna po strunie";
"L5e46546af1" = "Gdzie przesuwa się smyczek, aby grać forte?";
