"L070e348de7" = "Palec 1 na strunie 3";
"L070fa0c272" = "A-dur używa G♯. Obniżenie go do G daje brzmienie miksolidyjskie, obecne w muzyce old-time i bluegrass.";
"L0712a01674" = "Od C do G";
"L0732398ea5" = "Żadna: ta sama wysokość";
"L07387ec03e" = "Trzymaj długie nuty";
"L073ebc6d51" = "Ta sama nazwa, ósmy dźwięk gamy";
