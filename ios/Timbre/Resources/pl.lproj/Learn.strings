"L78d00ac979" = "„Down by the Riverside”, po raz pierwszy wydrukowane w 1918, powstało do wspólnego śpiewania. Na ukulele jest w G, z G, C i D7 oraz gospelowym A z krzyżykiem na strunie 1, progu 1.";
"L78e0fbb58e" = "Próg 4";
"L78e3c7b022" = "Gdy kciuk jest nisko z tyłu gryfu, palce układają się łukiem i sięgają od struny 5 do struny 1 bez wysiłku.";
"L78f007754a" = "„Szklane satelity” to autorski utwór Timbre: rockowa ballada na A-moll, F, C i G. Drugi akord zagrasz pełnym F z barré, a pozycja 1 pasuje do całej pętli, więc ma tu swoje solo. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
"L79000b6379" = "W Da-vid's każda sylaba rozciąga się na dwie ósemki. Zagraj obie, ale zaśpiewaj je jako jeden płynny dźwięk.";
"L790e7c10be" = "W 6/8 każdy takt ma sześć ósemek w dwóch grupach po trzy. Czujesz dwa duże uderzenia, każde podzielone na trzy: 1 2 3, 4 5 6.";
"L7922e364ef" = "Najgłośniejszy dźwięk piosenki";
