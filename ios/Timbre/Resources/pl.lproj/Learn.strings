"L07ed48285a" = "Sekundy z melodią";
"L07f4a8e116" = "Melodie często schodzą poniżej do, do niższego ti, la lub sol. To te same dźwięki, tylko niżej. Wiele melodii zaczyna się na niższym sol i skacze w górę do do.";
"L07f8b44be5" = "Sekunda wielka";
"L080c0fdb23" = "Gamy i tonacje durowe";
"L0819310447" = "Struna 2, próg 3, trzeci palec. To D.";
"L0832428388" = "Bez nowości: E-moll, E, A-moll i A. Ułóż każdy chwyt czysto, a potem utrzymuj równy rytm zmian.";
"L0838660743" = "Czyste zmiany";
"L08397419f3" = "Jaki dźwięk dodajesz do A-moll, aby uzyskać Am7?";
