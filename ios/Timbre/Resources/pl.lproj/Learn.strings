"L0199b663ee" = "Zagrywka 1";
"L01a4a05447" = "Policz od C";
"L01aa1069e8" = "Ostatni temat";
"L01bda6585d" = "G-dur przez dwie oktawy przy progu 2, stopnie skali i akordy oraz skale dorycka i miksolidyjska.";
"L01c6956f6f" = "Kto gra co";
"L01cacb6e6a" = "Stukaj tylko na „i”";
