"L5eb3cba827" = "Podziel uderzenie na dwa";
"L5ebd5cc8aa" = "Cały ton to dwa półtony, a każdy próg to półton. C staje się D, a G staje się A.";
"L5edd62cd1e" = "Między dźwiękami 3 i 4 oraz 7 i 8";
"L5ee75a46ea" = "Chop to krótki akord na uderzeniach 2 i 4. Uderz w dół, potem zmniejsz nacisk palców na gryfie, nie odrywając ich od strun, aby dźwięk od razu ustał.";
"L5eeb230a51" = "Trzymaj kostkę między opuszkiem kciuka a bokiem zgiętego palca wskazującego. Niech wystaje tylko czubek. Rozluźnij nadgarstek, jak przy strząsaniu wody z dłoni.";
"L5ef37ace42" = "Na którym dźwięku melodia się zatrzymuje?";
"L5ef3f68e90" = "Tonacja to domowa baza piosenki. W tonacji G większość pracy wykonują akordy G, C i D. Niezliczone piosenki folkowe i rockowe używają tylko tych trzech.";
"L5f0aa6a4b7" = "Trzymaj każdy długi dźwięk i kołysz nim małym, równym podciąganiem i opuszczaniem. Ruch ma być wąski: wysokość powinna falować, a nie uciekać.";
"L5f17243700" = "Akcent dotyczy nacisku, nie długości. Dźwięk po prostu gra się mocniej.";
"L5f379602c3" = "Przechodzi między strunami 3 i 4";
"L5f380cb28f" = "Tryl";
"L5f3c33cec0" = "Od żabki do szpica";
"L5f46a3d91b" = "Długie, trzymane prymy";
"L5f5706be4a" = "Akompaniament bluegrassowy";
"L5f6d14e352" = "Jakie dźwięki tworzą E-dur?";
"L5f709f471f" = "Struny 1 i 2";
"L5f790c22cb" = "Linie basu z epoki Motown były ruchliwe: dźwięki akordów, dojścia do kolejnego akordu i akcenty poza pulsem. Ta linia jest nowa, napisana w tym duchu.";
"L5f8b0a6d18" = "D i D-moll";
"L5f940a5b65" = "Dm7 na progu 5. Gdzie jest jego pryma?";
"L5fa00666ea" = "Teraz D, potem A.";
"L5fb1db5278" = "Sekundy";
"L5fb4562659" = "Pięć dźwięków, urocza melodia";
"L5fbc8a707e" = "A czwartym palcem na D, puste A, potem znów czwarty palec. Dopasuj je dokładnie.";
"L5fbdb73163" = "Twój czwarty palec";
"L5fbe60e018" = "Szczyt: trzy A, w górę do F z krzyżykiem na progu 2 struny 1, potem E E D B D, A F z krzyżykiem D.";
"L5fc3444ce4" = "Kciuk, wskazujący, środkowy";
"L5fd07fade8" = "Sekundy na akord";
"L5fef0931cc" = "Pryma czy nie? Słuchaj najniższego dźwięku.";
"L5ff6946aec" = "„Dzień targowy” to autorski utwór Timbre: słoneczny pop w G z pulsem highlife, jasnej muzyki gitarowej Afryki Zachodniej. Motyw używa tylko dźwięków G-dur, więc mieści się w skali w drugiej pozycji. Cały utwór jest w Piosenkach, w sekcji „Autorskie piosenki”.";
"L600e2dce19" = "Struna 1, próg 3";
"L601d7efe00" = "Refren";
"L60229f5c78" = "Aby wykonać slide, szarp strunę i przesuwaj ten sam palec na nowy próg, cały czas dociskając. Nacisk podtrzymuje dźwięk; szarpiesz tylko pierwszy.";
"L6027a15546" = "Kroki i półtony";
"L6030ff6791" = "D na progu 3 struny 2, puste B i z powrotem, potem puste E i F z krzyżykiem na progu 2 struny 1.";
"L603a7315ae" = "Pozwól mu wybrzmieć";
