"L5b0918cfec" = "Policz w górę od G: dźwięk 1 to G, dźwięk 4 to C, dźwięk 5 to D.";
"L5b0e679c41" = "Nuta na linii przesuwa się o jedną literę w górę. Gdzie trafia?";
"L5b10c8407c" = "A-moll i twoja pierwsza zmiana";
"L5b11880954" = "Scotland the Brave";
"L5b1ad97ddf" = "Dyktando polega na usłyszeniu melodii i zapisaniu jej. Tutaj wybierasz ją z listy. Znajdź do na podstawie akordu, potem śledź każdy ruch: w górę czy w dół, krok czy skok.";
"L5b206df439" = "Który akord jest vi w C?";
"L5b2757c644" = "Od B do następnego dźwięku: jaki krok?";
"L5b3ab40010" = "Jedno uderzenie";
"L5b4d19a642" = "Tę melodię wydrukowano po raz pierwszy w zbiorze muzyki irlandzkiej George'a Petriego w 1855 roku. Słowa Danny Boy dopasowano do niej znacznie później, w 1913 roku.";
"L5b56b84455" = "Vibrato pojawia się, gdy głos jest swobodny i podparty. Wymuszanie go żuchwą lub brzuchem powoduje chwianie dźwięku.";
"L5b57dfbaff" = "Pominięty dźwięk";
