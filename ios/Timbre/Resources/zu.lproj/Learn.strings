"L0d08b4ee08" = "Dit, ephakathi";
"L0d09e295cd" = "Ivesi 2";
"L0d17bb1df3" = "Dlala imiculo ngenothi ngalinye ezintanjeni 1 kuya ku-3.";
"L0d19973a19" = "Khetha imiculo yokudlala";
"L0d1cefb9f1" = "Do, re, mi, fa, sol: izinyathelo ezinhlanu zokuqala zakha imiculo eminingi elula. Zicule ukhuphuke uphinde wehle ngomoya owodwa uma kulula kuwe.";
"L0d1d2365f7" = "Kusuka phansi kuya phezulu, amapheya angu-G, D, A no-E. Khumbula ngezinhlamvu zokuqala: Good Dogs Always Eat. I-violin ishunwa kanjalo, ngakho imiculo ye-fiddle idlaleka kalula ku-mandolin.";
"L0d2b6e73ca" = "Iliphi ipheya eliyi-interval yesithathu?";
"L0d2ce2c173" = "Engeza eminye iminwe";
"L0d2ebb6ad9" = "Umunwe wesithathu udlala u-D, uhhafu wethoni ngaphezu kuka-C ophakanyisiwe, ngakho uthintana nowesibili. Entanjeni ka-A, iphethini ithi 1, bese 2 no-3 bendawonye.";
"L0d3104ffd5" = "Hammock Season";
"L0d6aa1d01c" = "Ku-mandolin umunwe ngamunye unakekela ama-fret amabili, ngakho owesibili udlala ama-fret 3 no-4.";
"L0d772098ad" = "Inselelo yama-chord avulekile";
"L0d815d5b43" = "Manje thepha ku-1 no-3 kuphela. Ukuthepha ngakunye kuyinothi elinguhhafu, elithatha izigqi ezimbili. Qhubeka ubale zonke ezine; izigqi ozeqayo zisaqhubeka.";
"L0d94f2e27e" = "Dlala noma ucule u-C ophakathi, bese u-E, u-G, no-C osesikhaleni sesithathu.";
"L0d96530743" = "Kuncinzwa inothi lokuqala kuphela. Qhubeka ucindezela intambo lapho ushelela, noma inothi lizothula endleleni.";
"L0da3c0bfe0" = "C, indlela ka-Travis";
"L0daa2701cc" = "Eye-major inohhafu bethoni abayisishiyagalolunye; i-My Bonnie Lies Over the Ocean iqala ngayo. Eye-minor inabayisishiyagalombili, izwakala imnyama. I-The Entertainer igxuma ngayo ngemva nje kwamanothi ayo asheshayo okuqala.";
"L0db3144f34" = "I-Skip to My Lou yayingumdlalo wephathi ngeminyaka yawo-1840. Ku-clawhammer, inothi ngalinye lomculo lingu-bum, lilandelwe ukushaya izintambo nesithupha entanjeni 5.";
"L0dd28dc711" = "U-G usabalele: umunwe 2 entanjeni 6, ku-fret 3; umunwe 1 entanjeni 5, ku-fret 2; umunwe 3 entanjeni 1, ku-fret 3. Zonke izintambo eziyisithupha ziyakhala.";
"L0dd97ca1ba" = "Lo mculo ovela ku-Symphony Yesishiyagalolunye ka-Beethoven uhamba cishe wonke ngezinyathelo. Wugcine ushelela futhi ulingana, njengokukhuphuka nokwehla ngezitebhisi.";
"L0debbfc022" = "Intambo 5 kuqala, bese 1. Iyiphi ephakeme?";
"L0df973ffa2" = "I-vibrato ukunyakazela okuthambile nokulinganayo kuzungeze inothi, izikhathi ezimbalwa ngomzuzwana.";
"L0e03afecc0" = "Aphakeme kuphela";
"L0e09dfdc9c" = "G, A, B, C entanjeni ka-G kanye no-D, E, F ophakanyisiwe, G entanjeni ka-D benza i-scale ye-G major. Iminwe efanayo ezintanjeni zombili.";
"L0e12a0aaf0" = "U-Edmund Sears wabhala la mazwi eMassachusetts ngo-1849, u-Richard Storrs Willis wabhala umculo ngonyaka olandelayo. Unyakaza ngezigqi ezimbili ezinkulu kubha, ngasinye sihlukaniswe kathathu.";
"L0e22317022" = "Qala ngenothi le-pickup";
"L0e26c5f4fc" = "Ezigqini 1 no-3";
"L0e28fb76fb" = "I-doo-wop ihamba nge-swing ethambile. I-punk ne-surf kuqhubeka ngama-quaver aqondile, alinganayo.";
"L0e290fc064" = "U-Long uthatha amanothi amabili, ingxenye ethi a- ithathe amabili, ethi go ithathe elilodwa: amanothi amahlanu emalungeni amathathu.";
"L0e294ddaf1" = "Ama-power chord anyakazayo";
"L0e2b8a2286" = "Ku-boom-chick, kwenzekani esigqini sesibili nesesine?";
"L0e3584c6c8" = "G entanjeni 4 ku-fret 3, C entanjeni 3 ku-fret 3, bese D ovulekile.";
"L0e3d8c7eb1" = "Kukhuphukile noma kwehlile?";
"L0e3dbdf12e" = "Le nguqulo iku-G, endaweni yokuqala: iminwe ilandelana ngohhafu wethoni, owokuqala ube ithoni egcwele ngaphezu kwentambo evulekile, kanti ishadi lama-chord elomuntu odlala nawe.";
"L0e4a8a8ead" = "I-interval yesihlanu";
"L0e4e40eda7" = "Cula noma udlale do, mi, sol ku-G major: G, B, D.";
"L0e5e82e12e" = "U-G ngokuma kwe-D uku…";
"L0e648419ea" = "Siyama";
