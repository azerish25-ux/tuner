"Lfbef05e8be" = "C, D, E, F entanjeni ka-C kanye no-G, A, B, C entanjeni ka-G yi-scale ye-C major. Ayinama-sharp nhlobo.";
"Lfbeff7287b" = "C5";
"Lfc1c326681" = "Iyiphi iphethini yendlela ye-island?";
"Lfc2ce9963c" = "A ku-fret 2 entanjeni 3, bese C no-C ophakanyisiwe kuma-fret 1 no-2 entanjeni 2, bese E ovulekile.";
