"Lf38de4092a" = "U-bum ufika esigqini, ngakho umculo uya lapho. U-dit no-ty bagcina isigqi sigeleza.";
"Lf3949e8a3d" = "I-lick ekubuyisela ekuqaleni";
"Lf3ad8067b3" = "Cindezela zombili izintambo zepheya ngechopho lomunwe owodwa, ngemuva nje kwe-fret yensimbi. Izintambo ze-mandolin ziqinile, ngakho sebenzisa ichopho uqobo, ucindezele kuphela ngokwanele ukuze inothi licace.";
"Lf3cd4632fc" = "Kuthathu";
"Lf3d1999a5d" = "Bala izintambo uqale ohlangothini lwaphansi ukhuphuke: 1, 2, 3, 4.";
"Lf3d4a454a3" = "Umqondo ofanayo usebenza ngezansi: G ngokuma kwe-E ku-fret 3, C ngokuma kwe-A ku-fret 3, no-D ngokuma kwe-C ku-fret 2.";
