"Lfb7a8f8c98" = "Amagama amaningi afika kumanothi anguhhafu: ingxenye ethi -ter ku-mid-winter, nethi i-ron. Vumela ngalinye likhale izigqi ezimbili ezigcwele ngaphambi kokudlulela kwelilandelayo.";
"Lfb7cd5ca80" = "U-C7 uyi-chord engu-V ku-F. Inothi lakhe lesikhombisa lidonsela ngqo ekhaya.";
"Lfb8475e0a0" = "G, A, B, C entanjeni ka-G kanye no-D, E, F ophakanyisiwe, G entanjeni ka-D benza i-G major. Yi-octave yokuqala ye-scale yama-octave amabili ozoyiqeda esigabeni esilandelayo.";
"Lfb8821a720" = "Intambo ka-D";
"Lfb8a11d0ad" = "Dlala noma ucule i-scale ka-C major, ukhuphuke kusukela ku-C ophakathi.";
"Lfb8b4f13db" = "Lapho intambo evulekile ikhala, isandla sobunxele sikhululekile, ngakho ukushintsha indawo akuzwakali.";
"Lfb9434a874" = "A D F";
"Lfb9dacff61" = "Umunwe wesibili: C ophakanyisiwe";
