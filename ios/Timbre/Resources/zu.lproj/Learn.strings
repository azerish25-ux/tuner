"L0cb89c5c9d" = "C, G, A minor, F";
"L0cb91c8a27" = "Umugqa wokugcina: B C B A G, bese B C D, ukhuphukele ku-E ovulekile, wehle ngo-C B A G.";
"L0cc7f390a8" = "Bamba i-chord ngayinye ibha yonke ukuze inothi ngalinye likhale lingene kwelilandelayo. Phakamisa umunwe kuphela uma ukuma okulandelayo kuwudinga.";
"L0ccad15761" = "Ku-dit, ukushaya izintambo";
"L0ce2c0e596" = "Bala ukhuphuke usuka ku-do: C do, D re, E mi, F fa, G sol.";
"L0cee63f97a" = "Izimpawu zokhiye zine-sharp eyodwa, u-F♯. Yimuphi ukhiye we-major?";
"L0cf065e1f1" = "I-pickup ngamanothi ambalwa aholela esigqini sokuqala esinamandla. Lapha akhuphukela egameni elithi com-.";
"L0cf4d1d8eb" = "U-Christina Rossetti wabhala le nkondlo ngo-1872, u-Gustav Holst wayifakela umculo wencwadi yamahubo ngo-1906. Imigqa yayo mifushane futhi izolile, njengeqhwa eliwayo.";
"L0d04e7ac6c" = "Arkansas Traveler, ingxenye ephakeme";
