"L0c9a79d360" = "I-lo-fi, i-one-drop reggae, i-funk, umdanso ohamba kancane ku-6/8 ne-bedroom pop, ngama-chord esikhombisa akhanyisa isigqi.";
"L0ca2de5abc" = "Inselelo yezinhlobo zama-chord";
