"L0e78b3694c" = "Asus4 no-Asus2";
"L0e7c35d2b5" = "I-scale";
"L0e856e0a16" = "U-B kuya ku-D no-D kuya ku-F bobabili bangama-interval esithathu e-minor.";
"L0e87d7c69a" = "I-half cadence (iphela ku-V)";
"L0e8a5b56f7" = "Ushintsho oluthandwa yi-jazz: i-chord enothini lesibili lokhiye, bese eyesihlanu, bese ibuyela esisekelweni. Ku-C ngu-Dm7, G7 no-Cmaj7.";
"L0e8e204738" = "Izingoma eziningi zakudala zisebenzisa i-AABA: umculo, uphinde wona, ibhuloho elihlukile, bese umculo futhi. Ingxenye ngayinye ivame ukuthatha amabha ayisishiyagalombili; lapha ithatha amane.";
"L0e9ba7fa0f" = "Qala ngo-G ovulekile, ukhuphukele ku-G entanjeni ka-E: amanothi ayishumi nanhlanu, ama-octave amabili. U-2 ophakeme ezintanjeni eziphansi, 2 ophansi kweziphakeme.";
"L0e9e53c01b" = "Khombisa ukuthi sekuyaphela";
