"L5a4c7da42b" = "Inselelo yezinyathelo zokuqala";
"L5a59483173" = "I-punk-pop, riff rock, rock efiphele ku-6/8, iculo le-indie ne-desert rock, ngama-power chord nama-riff ezintanjeni eziphansi.";
"L5a5d733600" = "U-do, mi no-sol ngamanothi e-chord yasekhaya, ngakho azwakala ezinze futhi ephumule. U-mi uzwakala emnandi, u-sol enamandla futhi evulekile, u-do ephelele.";
"L5a5d8340b2" = "Shady Grove";
