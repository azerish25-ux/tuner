"L59c1350d23" = "Ingoma yesintu yaseFrance";
"L59d0bca33c" = "Kusukela ku-C, okhiye abamhlophe bathi C, D, E, F, G, A, B, bese kuba ngu-C futhi. Kulaba khiye abayisikhombisa, uhlamvu ngalunye lukhona kanye.";
"L59d89422db" = "Yimuphi u-G ophakeme?";
"L59efa0f9f5" = "Ama-sharp nama-flat";
"L59f912292e" = "Umugqa ophakeme: khuphukela ku-D ku-fret 3 entanjeni 2, bese B G, B A, G E D.";
