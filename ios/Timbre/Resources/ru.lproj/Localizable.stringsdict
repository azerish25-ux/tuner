		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Сегодня занятие выполнено. Лучшая серия: %lld дн.</string>
			<key>few</key>
			<string>Сегодня занятие выполнено. Лучшая серия: %lld дн.</string>
			<key>many</key>
