"L576324effd" = "Въпросът и отговорът";
"L576e04843f" = "Струна 3, после струна 5. Коя е по-висока?";
"L577bf8ee69" = "Изсвирете нота без дърпане";
"L57863d228f" = "A на прагче 2 на струна 3, отворена B, C диез на прагче 2 на струна 2, после отворена E и F диез на прагче 2.";
"L578de8709a" = "Пръсти, палец и мелодия";
"L578dfe3449" = "Половината от дълга гама";
"L5796a8f6bb" = "Какво прави палецът в този модел?";
"L579f548b6d" = "2–3 и 6–7";
"L57a6df6e88" = "Изсвирете малкия F, но оставете пръст 1 да притиска само струна 2. Отворена струна 1, E, е голямата септима на F.";
"L57ab1a031e" = "Преместете втория басов удар на друга струна: в G — струна 6, после струна 4. В C — струна 5, после 4. В D — струна 4, после отворена струна 5.";
"L57bc96d79f" = "Броите 1-три-ла, 2-три-ла. Какво изчуквате?";
"L57c32e7438" = "Първият ви акорд: G";
"L57dd24c894" = "Кой тон е сол в C мажор?";
"L57e2f80c73" = "Изсвирете E с първи пръст в първа позиция, после плъзнете същия пръст нагоре до G. Това са три полутона, същото разстояние като B до D на струна A.";
"L57f12775b1" = "Кой пръст свири C диез на струна A?";
"L57f172a006" = "A минор, редуващ се бас";
"L580399c15c" = "Засега палецът свири струни 3, 4 и 5, показалецът — струна 2, средният — струна 1. Опрете леко безименния и кутрето на мембраната.";
"L5806880abe" = "Смесете ги";
"L580fd54b57" = "Да, на прагче 2";
"L581cb35ea8" = "Формата A и отново в кръг";
"L5827b85ed8" = "Използва само акорди";
"L5838c9ec25" = "Започвайте всяка фраза със слайд";
"L5887ff3d74" = "Четвъртина нота";
"L588f8784f5" = "Първи пръст на прагче 1 на струна 2, втори на прагче 2 на струна 3, трети на прагче 2 на струна 1. Ударете и четирите.";
"L58a534af12" = "Поддържа виолончелото";
"L58b29e6cc0" = "A♯";
"L58bb52be10" = "Григ пише това за пиесата „Пер Гюнт“ през 1875. То изобразява троловете в залата на техния цар, започва тихо и непрекъснато се ускорява.";
"L58cb3fff31" = "Коя двойка бели клавиши е на полутон разстояние?";
"L58d40ef087" = "Angels from the Realms of Glory";
"L58d52b16c1" = "Допълнителната нота на D7 тегли към G. Когато дойде G, напрежението се освобождава.";
"L58d68468c9" = "Бройте нагоре от D: D, E, F диез, G, A. A е петата нота, затова A7 е акордът V.";
"L58e4cebcce" = "На всяко време";
"L58eedeebf8" = "Бавните, навременни смени изграждат навик. Скоростта идва сама.";
"L58f102ddae" = "Какво става в края на мелодията на тореадора?";
"L58fe8858cf" = "Завой към B минор";
"L59072f6149" = "Ролове";
"L590c267292" = "Свирене с лък";
"L59188c6d63" = "Намерете пулса";
"L5921a5b2b8" = "Изтеглете шипа, докато горният ръб на виолончелото докосне гръдната кост, а ключът C е близо до лявото ухо. Затегнете винта. Стопер или ремък го пази от плъзгане.";
"L592f4b6689" = "Песен отблизо: Две стъпки по чакъла";
"L5938c71ae6" = "C: три пръста";
"L594cfc45fd" = "Хенри Бишъп пише тази мелодия за лондонска опера през 1823 по думи на американския актьор Джон Хауърд Пейн. За няколко години тя става една от най-обичаните песни в света.";
"L5952f9b6a9" = "Филипс Брукс пише тези думи през 1868 за децата от своята църква във Филаделфия, а органистът ѝ Луис Реднър пише мелодията за коледната им служба.";
"L597b60da13" = "Нагоре до C, надолу до отворена B и обратно, после D, слизане до A и пак D.";
"L59814fa3ba" = "Останете на едно място";
"L5983fa3abd" = "Струна 3, прагче 2, втори пръст. Това е B.";
"L598a489b59" = "Кой размер се усеща като марш?";
"L598c2fd0e7" = "Изпейте или изсвирете тоновете на акорда от нисък към висок.";
"L599637a52a" = "Изсвирете или изпейте междулинията отдолу нагоре: F, A, C, E.";
"L599a010fb7" = "Големият скок: от G нагоре до високо C, после надолу по стъпки.";
"L59a890261d" = "Колко от перцето трябва да се вижда?";
"L59abc0da88" = "Потърсете местата без черен клавиш: от E до F и от B до C. Тези бели клавиши са непосредствено един до друг, затова разстоянието е само полутон.";
"L59bc865a46" = "Предизвикателство с баре";
"L59c12ec1c9" = "Отворени струни, дърпане с два пръста и първите ноти с притисната струна. Редувайте пръстите и оставяйте всяка нота да звучи.";
"L59c1350d23" = "Френска народна песен";
"L59d0bca33c" = "От C белите клавиши вървят C, D, E, F, G, A, B, после отново C. Седем бели клавиша съдържат по една от всяка буква.";
"L59d89422db" = "Коя G е по-висока?";
"L59efa0f9f5" = "Диези и бемоли";
"L59f912292e" = "Високият ред: нагоре до D на прагче 3 на струна 2, после B G, B A, G E D.";
"L5a0e299b6e" = "Колко удара трае половината нота с точка?";
"L5a14702747" = "Припевът върви C, A минор, D7 и G. Сменяйте на думата, която започва всяка половина на такта, и дръжте съпровода лек под високото E.";
"L5a4c7da42b" = "Предизвикателство: първи стъпки";
"L5a59483173" = "Пънк поп, риф рок, мрачен рок в 6/8, инди химн и пустинен рок с пауър акорди и рифове на ниските струни.";
"L5a5d733600" = "До, ми и сол са тоновете на основния акорд, затова звучат устойчиво и спокойно. Ми звучи сладко, сол — силно и открито, а до — завършено.";
"L5a5d8340b2" = "Shady Grove";
"L5a636e248d" = "Тоновете с еднаква буква звучат сродно, дори когато единият е по-висок. Разстоянието от едно C до следващото C е октава. По-високият тон трепти точно два пъти по-бързо.";
"L5a80ba0bea" = "Плъзнете нагоре в позиция 2";
"L5a9ac09da7" = "Струната C";
"L5a9e82f489" = "Нисък 2 във високия регистър";
"L5ab4b059e7" = "Традиционна (Франция, 18-и век)";
"L5ab72ee022" = "Добрите сола дишат. Изсвирете кратка фраза, починете приблизително толкова, колкото е траяла, после отговорете. Тишината придава тежест на следващите ноти.";
"L5acc606203" = "Куплет 4";
"L5acf76b488" = "От отпуснато гърло и устойчиво дишане";
"L5ad2994115" = "D, A, B минор, G";
"L5af071dd5b" = "Пет струни";
"L5af311b98c" = "Да оставите време 1 празно е най-трудната пауза. Кимнете на 1, за да го усетите без докосване, после влезте на 2.";
"L5b0918cfec" = "Бройте нагоре от G: тон 1 е G, тон 4 е C, тон 5 е D.";
"L5b0e679c41" = "Нота на линия се премества с една буква нагоре. Къде попада?";
"L5b10c8407c" = "A минор и първата ви смяна";
"L5b11880954" = "Scotland the Brave";
"L5b1ad97ddf" = "Диктовка означава да чуете мелодия и да я запишете. Тук я избирате от списък. Намерете до от акорда, после следете всяко движение: нагоре или надолу, стъпка или скок.";
"L5b206df439" = "Кой акорд е vi в C?";
"L5b2757c644" = "От B до следващата нота: каква стъпка?";
"L5b3ab40010" = "Един удар";
"L5b4d19a642" = "Тази мелодия е отпечатана за първи път в сборника с ирландска музика на Джордж Питри през 1855. Думите на Danny Boy са добавени много по-късно, през 1913.";
"L5b56b84455" = "Вибратото се появява, когато гласът е свободен и с опора. Насилването му от челюстта или корема създава клатене.";
"L5b57dfbaff" = "Пропусната нота";
"L5b5d9c7ca6" = "По-бързото темпо изисква по-малко усилие, не повече. Дръжте ръката отпусната и докосвайте с движение от кокалчето, не от китката или рамото.";
"L5b6055b519" = "Баре акорди и синкопиране";
"L5b72ac2ae5" = "Зигзаг, не стълба";
"L5b72f1cd00" = "Отворена E, обратно до C и D на струна 2, после E, F диез и G на струна 1.";
"L5b73319e44" = "The Skye Boat Song се люлее в шест осми. O Christmas Tree е на три, а All Through the Night — на четири.";
"L5b739425ea" = "Върху блус в A работят и двете позиции. Мажорната пентатоника на прагче 2 звучи сладко, минорната на прагче 5 — сурово. Добрите музиканти преминават между тях.";
"L5b7d0278c6" = "Четири интервала по всички начини";
"L5b809972b5" = "D, E и F диез";
"L5b90e239db" = "Пустинен рок";
"L5b9874ad31" = "Ключови знаци";
"L5b9f430ff6" = "Трети на струна D";
"L5ba0846c7d" = "Баре акордите са трудни в началото. Какво помага най-много?";
"L5ba3d0bd26" = "Куплетът започва един удар по-рано, със затакта си. Дългата последна нота оставя този удар свободен.";
"L5bacba7e1d" = "Преместването с една буква нагоре води от линия в следващото междулиние или от междулиние на следващата линия. Нотите на съседни линии са на две букви разстояние.";
"L5bb2c4c6f5" = "Проверка на осмините";
"L5bb58088d4" = "Тризвучия в последование";
"L5bb64c45c4" = "Шестнайсетини, две ноти";
"L5bd0ac44e7" = "Къде е второто докосване?";
"L5bd73fc956" = "W H W W H W W";
"L5bd822ea89" = "Коя септима е едно прагче под октавата на основния тон?";
"L5bdb895373" = "Семейството на D минор е D минор, G минор и A7. A7 тегли у дома към D минор, както E7 тегли към A минор.";
"L5bece8cfd8" = "Изсвирете D, E, F диез, G на струна D, после A, B, C диез, D на струна A. Същите пръсти два пъти: отворена, 1, 3, 4.";
"L5bef0ed765" = "Установете тоналността с каденца";
"L5bf5b6d904" = "Основни тонове по акордова схема";
"L5bff6b57d3" = "Пет ритъма";
"L5c023fea92" = "Ноти на струна A";
"L5c0543142b" = "Цялата нота трае всичките четири удара. Докоснете веднъж на 1 и тихо бройте 2, 3, 4, за да дойде следващото 1 навреме.";
"L5c067fec77" = "Арпежи в осмини";
"L5c08c48eb7" = "Втората линия отдолу е G, около която се извива сол ключът.";
"L5c1817f5a4" = "Октавови скокове";
"L5c1e7ffe61" = "Първо тон без вибрато";
"L5c228ef72c" = "G бекар е полутон над F диез, затова вторият пръст се прибира плътно до първия.";
"L5c295e30fb" = "Запознайте се с виолончелото";
"L5c2cb44d0b" = "Точки и паузи";
"L5c2fe433c0" = "Само хамър-он";
"L5c3ec26bbd" = "Лиги за удължаване";
"L5c47ff6ad3" = "За да изпеете един и същ тон два пъти, спрете въздуха за миг, после започнете отново с меко „да“. Не се плъзгайте между тях.";
"L5c49265a7a" = "A минор, p-i-m-a-m-i";
"L5c4bea20f2" = "Плъзнете ръката нагоре, така че пръст 1 да застане на прагче 3. Сега всеки пръст покрива по едно прагче: 3, 4, 5 и 6. Преместете нагоре и палеца, зад пръст 2.";
"L5c65302b62" = "D, E и F на струна 4, после G и A на струна 3.";
"L5c70a63a7d" = "Кратки модели като до-ре-ми-ре-до бързо развиват точност. Изпейте един, после го започнете една стъпка по-високо и оставете гамата да ви води.";
"L5c7d93a81b" = "Песен отблизо: Късно напускане";
"L5c8558d5d5" = "Тази фраза върви нагоре или надолу?";
"L5c93ebdb3e" = "Ниско, високо, ниско, високо";
"L5ca845ae96" = "G, C, D, G";
"L5cb0a0bffe" = "Плавно през три двойки";
"L5cc2c5012f" = "Отворената G на струна 5 не е част от D7. Засега палецът ви остава на струни 3 и 4.";
"L5cc3f9c6da" = "Завършете с мотива";
"L5ce294ca6f" = "Палец и среден заедно";
"L5cf2129767" = "Пет степени: от до до сол";
"L5cf7c86c4c" = "Проверка на контрола";
"L5cffb13f9a" = "Половини с по-бавен лък";
"L5d04369de5" = "Изпейте до, ре, ми на C, D, E.";
"L5d0ad0fc65" = "Ретро програма";
"L5d0e8c4208" = "От E до следващата нота: каква стъпка?";
"L5d0f30ba50" = "Цял тон, цял тон, после полутон от 3 до 4; цял тон, цял тон, цял тон, после полутон от 7 до 8.";
"L5d2826f313" = "Струна 3: G и A";
"L5d288a10b1" = "Кое трае колкото четвъртина с точка?";
"L5d28917df7" = "Балада с пръсти";
"L5d2b5b9774" = "Същата форма работи от струна 5. Пръст 1 на струна 5, прагче 3 дава C5. Докоснете струна 6 с върха на пръст 1, за да мълчи.";
"L5d2d5a00d5" = "B, C, D е терца от три полутона: малка.";
"L5d3468e2a0" = "Ако пръстите са притиснати, наклонете ги леко, така че всеки да е точно зад прагчето. Оставете струна 1 свободна да звучи.";
"L5d3c4cb4c4" = "Колко дълго трябва да звучи отсеченият реге акорд?";
"L5d43afb2a2" = "Пазарен ден";
"L5d4b37b67c" = "Тази мелодия се простира от струна 5 до струна 1. Какво държи всяка струна в обсег?";
"L5d538c9b62" = "„Солена неделя“ е авторска песен на Timbre — спокойно реге в A минор, където Am7 и D7 редуват тактове. И двете пентатонични позиции пасват. Правете хамър-он, пул-оф и слайд и започвайте всеки такт с тон от акорда. Цялата песен е в „Песни“, под „Авторски песни“.";
"L5d5cd8b1c4" = "2 и 4";
"L5d68b7e4ac" = "Изкачва се до дълго E";
"L5d7b2934d4" = "Отгласи от Хендел";
"L5d7cef323e" = "Sarah Josepha Hale (1830)";
"L5d89aa22bd" = "Силно на едно";
"L5d8eb567e2" = "Бетовен в ниския регистър";
"L5d9c113b57" = "Town („град“)";
"L5dab3832af" = "Каподастър, форми G и D с каподастър на 2 и аранжимент на Oh! Susanna с куплет и припев.";
"L5db362c3bc" = "Струна 3, прагче 3, трети пръст.";
"L5dc0bfe304" = "Кой тон е полутон над E?";
"L5dc6589c07" = "A, после C на струна 5, E и A. След това B, E, G диез на прагче 1 на струна 3 и B.";
"L5dd85395a1" = "Коя е отворената струна G?";
"L5de6270d77" = "Преди да запеете, чуйте тона в ума си за секунда. Тази пауза позволява на гласа да се прицели във височината, вместо да я търси.";
"L5ded105f41" = "Shenandoah";
"L5df3a182bb" = "Народна китка";
"L5df42cd32b" = "Когато ръката удря, палецът се опира на петата струна. На следващия удар я избутва, докато ръката се повдига.";
"L5e0badd310" = "Първият ред: отворена D, E, четири отворени G, слизане до B на струна 5, после у дома до G.";
"L5e31a53ca0" = "Формата D, струна по струна";
"L5e46546af1" = "Къде се мести лъкът за форте?";
"L5e61ddbe60" = "Коледна песен от Филаделфия";
"L5ea1e1b5db" = "Украшения в Old Joe Clark";
"L5eb3cba827" = "Разделете удара на две";
"L5ebd5cc8aa" = "Целият тон е два полутона, а всяко прагче е полутон. C става D, а G става A.";
"L5edd62cd1e" = "Между ноти 3 и 4, и 7 и 8";
"L5ee75a46ea" = "Отсеченият удар е кратък акорд на времена 2 и 4. Ударете надолу, после отпуснете натиска на пръстите върху струните, без да ги вдигате, за да спре звукът веднага.";
"L5eeb230a51" = "Дръжте перцето между възглавничката на палеца и страничната част на свития показалец. Нека се вижда само върхът. Отпуснете китката, сякаш изтръсквате вода от ръката.";
"L5ef37ace42" = "На коя нота се успокоява мелодията?";
"L5ef3f68e90" = "Тоналността е домът на песента. В тоналност G акордите G, C и D вършат основната работа. Безброй фолк и рок песни използват само тези три.";
"L5f0aa6a4b7" = "Задръжте всяка дълга нота и я поклащайте с леко, равномерно избутване и отпускане. Нека е тясно: височината трябва да трепти, не да се отклонява.";
"L5f17243700" = "Акцентът е въпрос на тежест, не на дължина. Нотата просто се свири по-силно.";
"L5f379602c3" = "Редува струни 3 и 4";
"L5f380cb28f" = "Трилер";
"L5f3c33cec0" = "От жабката към върха";
"L5f46a3d91b" = "Дълги, задържани основни тонове";
"L5f5706be4a" = "Блуграс съпровод";
"L5f6d14e352" = "Кои тонове образуват E мажор?";
"L5f709f471f" = "Струни 1 и 2";
"L5f790c22cb" = "Бас линиите от ерата на Motown се движат много: акордовите тонове, подходи към следващия акорд и тласъци между времената. Тази линия е нова, написана в този дух.";
"L5f8b0a6d18" = "D и D минор";
"L5f940a5b65" = "Dm7 на прагче 5. Къде е основният му тон?";
"L5fa00666ea" = "Сега D, после A.";
"L5fb1db5278" = "Секунди";
"L5fb4562659" = "Пет ноти, една сладка мелодия";
"L5fbc8a707e" = "A с четвърти пръст на D, отворена A, после пак четвърти пръст. Нека съвпадат точно.";
"L5fbdb73163" = "Вашият четвърти пръст";
"L5fbe60e018" = "Върхът: три A, нагоре до F диез на прагче 2 на струна 1, после E E D B D, A F диез D.";
"L5fc3444ce4" = "Палец, показалец, среден";
"L5fd07fade8" = "Секундите за акорд";
"L5fef0931cc" = "Основен тон или не? Чуйте най-ниската нота.";
"L5ff6946aec" = "„Пазарен ден“ е авторска песен на Timbre — слънчев поп в G с подскока на хайлайф, ярката китарна музика на Западна Африка. Мотивът използва само нотите на G мажор и влиза в гамата ви във втора позиция. Цялата песен е в „Песни“, под „Авторски песни“.";
"L600e2dce19" = "Струна 1, прагче 3";
"L601d7efe00" = "Припев";
"L60229f5c78" = "За слайд изсвирете нота и продължете да притискате, докато плъзгате същия пръст до ново прагче. Натискът пренася звука; дърпате струната само за първата нота.";
"L6027a15546" = "Стъпки и полутонове";
"L6030ff6791" = "D на прагче 3 на струна 2, отворена B и обратно, после отворена E и F диез на прагче 2 на струна 1.";
"L603a7315ae" = "Оставете я да звучи";
"L603b077f43" = "Основният тон на отворен D е отворена струна 4. Преместен нагоре, го държи пръст 1: G на прагче 5. Струна 2, прагче 8 също е G.";
"L60416d96dc" = "С каподастър още мислите G, C и D — познатите форми. Диаграмите тук назовават реално звучащия акорд, затова форма G с каподастър на 2 се показва като A.";
"L6046c05006" = "Home! е цяла нота: задръжте D на прагче 3 на струна 2 през целия такт.";
"L60486c0a4b" = "Септакорди по лесния начин";
"L6049def04f" = "Паузите се броят";
"L604ac866f0" = "Изправени, но отпуснати";
"L6053efe7e3" = "При свирене с пръсти се използват испански означения: p за палец, i за показалец, m за среден, a за безименен. Поставете i на струна 3, m на струна 2 и a на струна 1, готови да ги дръпнете.";
"L60567af0fd" = "C, A7, D7, G7, после у дома към C. Всеки септакорд тегли към следващия — малка верига от напрежение. Тя е движила безброй песни преди век.";
"L6063ec8dfa" = "Припевът с пръсти";
"L6065bcf219" = "Терци нагоре по гамата";
"L60715612f0" = "G мажор, нагоре и надолу";
"L608e8768cd" = "Трети пръст на струна D";
"L60948f8372" = "Черните клавиши, най-малката стъпка и тоновете с две имена.";
"L609651b67b" = "Обхваща осем буквени имена";
"L60db049169" = "G D A E";
"L60dea2df67" = "Прави я кратка и отделена";
"L60f61fb4e2" = "Няма нови понятия: E, F и G на струна 1, B, C и D на струна 2. Започнете бавно, после поддържайте равномерно темпо.";
"L60f6f7bc7e" = "Не спирайте махалото";
"L6128108d6c" = "Същият пръстов модел на две по-ниски струни, D мажор и три мелодии.";
"L6129f8fd2f" = "И четирите струни";
"L61378dcfa1" = "Когато акордът се смени, палецът стъпва на новия основен тон точно на първото време. Пръстите продължават да дърпат струни 2 и 3 както преди.";
"L613a306f82" = "Кой пръст свири прагче 5 в тази позиция?";
"L613b9483be" = "Интрото и солото";
"L6142dc5601" = "Отново втората тема";
"L614f875fca" = "Тази позиция на прагче 2 е и F диез минорна пентатоника, започната от F диез. Основният тон, който избирате, решава коя от двете свирите.";
"L6152642fb8" = "Двойка 2: отворена, прагче 2, прагче 4, прагче 5.";
"L6153371910" = "Прагче 3 е в зоната на втория пръст, прагчета 3 и 4.";
"L616a1bd784" = "Джаз музикантите обикновено добавят септими: Dm7, G7, Cmaj7. Допълнителните тонове правят всяко движение още по-плавно. Основните тонове и пътят към дома остават същите.";
"L616b46e903" = "Ода на радостта, втори ред";
"L6181145819" = "Дръжте перцето близо до струните, а ударите — равни. Скоростта идва по-късно, когато движението е отпуснато.";
"L6191fba215" = "Какво прави интрото?";
"L61992ffcfb" = "Струна 2, прагче 4";
"L61a7fd6fc3" = "Всяка мажорна гама следва една формула от стъпки: цял тон, цял тон, полутон, цял тон, цял тон, цял тон, полутон. Започнете от който и да е тон, следвайте я и ще построите мажорна гама.";
"L61ac361d21" = "Какво е смяна на позиция";
"L61b524f257" = "Височината спада, когато въздухът намалее. Малко по-ранният край запазва целия тон чист.";
"L61d442d352" = "Припевът започва високо: D на прагче 3 на струна 2, C диез на прагче 2, отворена B, после надолу до отворена D.";
"L61da910eb5" = "Angeline the Baker";
"L61e018ea94" = "Кратки удари и D9";
"L61e1dfe135" = "Пет опростени традиционни мелодии за общо свирене, от Boil Them Cabbage Down до Old Joe Clark.";
"L61ec307304" = "Сложете пръст 1 на прагче 2 и дайте на всеки пръст собствено прагче до прагче 5. От G на струна 6, прагче 3 гамата се изкачва през струни 6, 5 и 4.";
"L61ee1ab807" = "Къде спира пръстът след дърпане с опора?";
"L61f1c8da71" = "Номерирайте гамата от G: G е 1, A е 2 и така до F диез, 7. Музикантите използват тези номера, за да говорят за мелодии и акорди във всяка тоналност.";
"L61fc25fa4f" = "Първото време";
"L62137e8c2f" = "Шест песни наведнъж";
"L62175f3821" = "Няма нови понятия: G мажор в две октави, гамата на терци, A дорийски и D миксолидийски. По един пръст за всяко прагче.";
"L621c5e6bc0" = "Дълго, кратко на три";
"L621f8b64c0" = "Дванайсет такта";
"L622c702c21" = "Песнопойка за укулеле";
"L623729eeb4" = "Интервалът е разстоянието между два тона. При унисона няма никакво разстояние: един и същ тон два пъти. Октавата се простира от една буква до същата буква по-високо, например от C до C. Звучи като един тон, само че по-светъл.";
"L62490fbda1" = "Ниска част, втора половина";
"L625278775b" = "Същото начало, различен край. Вторият ред се връща у дома на C.";
"L625d141f7d" = "Пръст 4 на струна 1";
"L6271a044a6" = "Бетовен пише тази пиеса за пиано през 1810, но тя е публикувана едва през 1867, четирийсет години след смъртта му. Тази опростена версия запазва прочутото начало.";
"L62773cc1b4" = "Изсвирете струни 6, 5 и 4 една по една.";
"L62781903b0" = "Дръпнете струна 1 с палеца и я оставете да звучи.";
"L6281828c75" = "Първа мелодия за общо свирене";
"L628db1ad7e" = "Тактът е една група от удари. Тук всеки такт съдържа четири удара, записани като 4/4. Време 1 започва всеки такт, затова го подчертайте леко, докато броите.";
"L62ab25cde7" = "Чиста квинта";
"L62ba9ae8e4" = "Обръщения на G и D";
"L62bb50e1c3" = "Кой акорд е Cmaj7?";
"L62c4d6152c" = "Двойка 3, прагче 2, първи пръст.";
"L62d40dd812" = "Първият пръст е на прагче 1 на струна 2, а вторият — на прагче 2 на струна 3. Струни 4 и 1 звучат отворени. Пропуснете петата струна: нейният тон G се сблъсква с D7.";
"L62f0a6aab6" = "Една двойка трепти бавно. Какво не е наред?";
"L62fa3abe46" = "Две посоки";
"L62fb1d70f8" = "Пръст 1 държи струна 5 на прагче 3 и ляга напречно до струна 1. Пръст 3 поема струна 4, пръст 2 — струна 3, а пръст 4 — струна 2.";
"L630868a13b" = "Това предизвикателство смесва лиги за удължаване и точки. Бройте всяка осмина на глас; задържаната нота пак заема цялото си време.";
"L6311ef1e1f" = "Три удара: половина нота (2) плюс точката ѝ (1).";
"L63190e07e0" = "Преди звукозаписите семействата пеели тези песни около пианото у дома. Ето ги една след друга, с голямата мелодия на Холст за финал.";
"L632198cb87" = "Класически теми II";
"L63233a5412" = "Унисон, октава, квинта и кварта — всеки свързан с мелодия, която можете да изтананикате.";
"L6335412816" = "Кои пръсти свирят D мажор на всяка струна?";
"L634209dd7c" = "Всяка нота тук е четвъртина, половина или цяла. Бройте четири равномерни удара в такт и оставяйте дългите ноти да звънят.";
"L6355e11493" = "D, E, F: три букви.";
"L63881ab90d" = "I, IV и V";
"L638f400164" = "Синкопирането поставя акцента между ударите. В началото всяко C попада на „и“. Бройте едно-и-две-и и усетете как C тегли напред.";
"L639b70b19b" = "Планински минор";
"L63a15ae368" = "Прагче 1 на струна 2";
"L63a5f6c540" = "И двата акорда държат прагче 2 на струни 3 и 2. Променят се само външните струни.";
"L63abb5650f" = "Седем";
"L63b4995f45" = "Унисон и повторения";
"L63b5f26523" = "В шест осми четвъртина и осмина образуват един голям удар: дълго, кратко. Бройте едно-две-три, четири-пет-шест и свирете на едно, три, четири и шест.";
"L63bb4a431f" = "Допълнителният натиск често повишава тона, а много тихите тонове могат да спаднат под точната височина. Следете тона и в двата случая.";
"L63d01fe4fe" = "По средата между столчето и грифа";
"L63dcadbd78" = "Пет мелодии една след друга, по една фраза от всяка. Поемайте дъх на всяка пауза и започвайте повторените ноти наново.";
"L63e8cf2011" = "Кой тон е цял тон над B?";
"L63f358c905" = "Той е най-трудната част";
"L640134fefa" = "Двойката A работи така: отворена е A, прагче 2 е B, прагче 4 е C♯, прагче 5 е D. Ръката остава на място.";
"L640b18da1f" = "Класическа китка";
"L6416c8c03f" = "Слиза";
"L641a2740f3" = "Мелодията";
"L6425315084" = "На първо и трето време";
"L6439513619" = "Коя дума се задържа през две ноти в първия куплет?";
"L644b2e3eb5" = "Върху прагчетата";
"L6455adb054" = "Вашето соло";
"L6478bdaaa1" = "Китка от химни";
"L647e4d73c5" = "Нагоре и у дома";
"L648307a100" = "Кога се пада ударът нагоре?";
"L64846fd98f" = "Китарното соло";
"L648ac30e5c" = "Малък F, D7 и две традиционни песни с акорди и мелодия.";
"L648bfd8404" = "Островен ритъм със смени";
"L649b215476" = "Двойка 3: отворена, прагче 2, прагче 4, прагче 5.";
"L64afb60dbd" = "Какво правите при пауза?";
"L64e238b935" = "На 1 и 4";
"L64e6a5eeed" = "Тази версия е в E минор, в първа позиция: мелодията преминава през четирите струни с пръсти 1 до 4, а акордовата схема е за този, който ви акомпанира.";
"L64e9fb8ad9" = "Изсвирете или изпейте двата полутона на бели клавиши: от E до F, после от B до C.";
"L64f341465b" = "Отворена 3, струна 2 на прагче 1, отворена 1, струна 2 на прагче 3, струна 1 на прагчета 1 и 3.";
"L6501930589" = "Еднакви или различни ноти?";
"L650634caa9" = "На коя отворена струна съответства прагче 3 на струна 2?";
