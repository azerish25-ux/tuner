"L651aaf0899" = "Всяко докосване има име";
"L653eb46bda" = "Виолончелото се накланя назад към гърдите, а коленете леко го стабилизират отстрани.";
"L654648b7f9" = "Свири само на време 1";
"L655060742f" = "Вдигнете ненужния пръст и поставете новия, докато последният удар още звучи. Гледайте напред към следващия акорд.";
"L65572eaf06" = "Стивън Фостър пише тази песен за надбягване през 1850, две години след Oh! Susanna. Тя използва същите ноти и същите два акорда.";
"L656206b093" = "Колко такта A отварят 12-тактовия блус?";
"L65626dc943" = "Тази мелодия е отпечатана през 1582 в Piae Cantiones, песенник от Финландия, като песен за пролетта. Джон Мейсън Нийл ѝ дава коледен текст през 1853.";
"L65790ce0d0" = "12-тактовият блус";
"L658534e988" = "Осмини нагоре до A";
"L6586ce1f1f" = "Amazing Grace се движи с три удара в такт. Свирете тремоло през всяка дълга нота и сменяйте точно на времето. Две ноти са нови: A и B на двойката G.";
"L65a24ccc47" = "Втората половина започва високо: четвъртият пръст достига B на струна E. После трети, после нисък 2.";
"L65b5eedd25" = "Китка от първите ноти";
"L65da260ff1" = "Сега най-дебелата струна, C. Нека забучи.";
"L65dc0bc434" = "G, H";
"L65fc8eeea6" = "Приблизително още толкова";
"L66059b65aa" = "Обикновеният A минор има F. Дорийският запазва F диез от G мажор: светло петно в минорна гама.";
"L661b9e9f2e" = "Една позиция, целият цикъл";
"L661f67974f" = "Заменя припева";
"L66239be110" = "Унисон: същият тон";
"L6636558793" = "Седнете изправени с нагласен шип, мек захват на лъка и лък по средата между столчето и грифа. Сега изсвирете всичко от раздела.";
"L664305ffb2" = "От D до F се прескача E, затова е скок: терца.";
"L6643ee2897" = "F и C";
"L664688a0e9" = "Лад след лад";
"L6646d01d84" = "Поп в 6/8";
"L6651a17acc" = "Отворена D, E и F диез на струна 4, после скок до D на прагче 3 на струна 2 и надолу C диез, B и A.";
"L66573d54aa" = "Два скока нагоре";
"L6693552855" = "Ходещ блус в A";
"L66a2e1bb47" = "Целият песенник в тоналности за укулеле, от начало до край";
"L66ae417c89" = "Надолу на числото, нагоре на „и“. Ръката се движи надолу и нагоре веднъж на всяко време.";
"L66ba679c70" = "Намерете пулса, бройте до четири и изчуквайте в такт.";
"L66d9448f4d" = "„Шум по девети канал“ е пънк: четири пауър акорда, осмини с приглушаване с длан, 104 удара в минута. Куплетът мърмори на ниски тонове; припевът е общ вик, затова свирете смело.";
"L66fa22185a" = "Осмината трае половин удар, затова две се побират във всяко време. Използвайте малки, бързи движения около средата на лъка.";
"L66fbb37faf" = "Минавате на нова двойка на „и“. Кой удар?";
"L670d6914c0" = "Акордите установяват тоналността, после прозвучава един тон. Първо намерете до, после назовете тона. Във всяка тоналност принципът е един и същ.";
"L670e7fd853" = "Да сте под тона означава, че трябва леко да повишите височината.";
"L671c1ff474" = "Първата фраза завършва с нота с точка. Как се усеща?";
"L67278e4178" = "Куплет и припев";
"L672fd54460" = "C мажор, втора октава: втори пръст за F и за горната C.";
"L6739b9a584" = "Затактът и първият такт: отворена G, A на прагче 2, после отворена B, D на прагче 3 два пъти и отворена E.";
"L67684dd3f9" = "За Mary Had a Little Lamb трябват три ноти: отворена струна 2 е B, прагче 2 на струна 3 е A, а отворена струна 3 е G. Свирете A с втория пръст.";
