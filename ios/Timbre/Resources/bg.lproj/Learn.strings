"L01d1af9aef" = "Полутон или цял тон?";
"L01d8ca79df" = "Операта „Кармен“ на Жорж Бизе е представена за първи път в Париж през 1875. Прелюдията ѝ започва с този празничен марш, после свири мелодията на прочутата Песен на тореадора.";
"L01e269d40a" = "Секундите, терците, секстите и септимите биват големи и малки. Малкият интервал винаги е с един полутон по-тесен от големия.";
"L01e81b91bc" = "Домашна база";
"L01e9d574a3" = "Вибратото не може да спаси фалшива нота; само оцветява вече точния тон. Повечето музиканти го добавят, когато пръстите попадат точно без търсене.";
"L01ee5b3bac" = "Си е само полутон под до, затова силно се стреми към него.";
"L020232021d" = "Ускорете, докато се изглади";
"L0213925244" = "Отворената висока G принадлежи на акорда C, затова звучи без притискане. В тези уроци никога не я притискате.";
"L0213e2ea6e" = "Песните се връщат към акорда на своята тоналност. Във F това е F.";
"L022a274f11" = "Кой списък върви надолу?";
"L023748ecd0" = "Amazing Grace, първата половина";
"L023da003cb" = "Тактове 11 и 12 често съдържат обрат — кратка фраза, водеща към началото. Тази слиза от A до E по едно прагче.";
"L023e171007" = "С първи пръст: A и E";
"L023f7f5a8c" = "От G до B и обратно се сменят струни. Люлейте плавно от лакътя.";
"L0241523d12" = "Чуйте тон, изпейте го в отговор и се движете с малки стъпки.";
"L025497d15a" = "Групи по две";
"L025c45471b" = "Бройте нагоре по гамата от C: C, D, E, F. F е четвъртата нота, затова F е акордът IV.";
"L026036a0e5" = "На всяко „и“";
