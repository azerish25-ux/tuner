"L6f25a92f40" = "Едно и три";
"L6f2ac8800d" = "Удари надолу, осмини надолу-нагоре, акценти и ръка, която не спира.";
"L6f2b7fab42" = "Коя двойка звучи по-ниско?";
"L6f2c6204f8" = "Триолите разделят всеки удар на три равни части.";
"L6f2ef252d3" = "Нотни стойности от цяла до шестнайсетина, точки и паузи, както и размерите 4/4, 3/4 и 6/8.";
"L6f311d3822" = "Коя нота е на време 1 в модел основен тон–квинта?";
"L6f49985ada" = "A C D E G";
"L6f4f52cd93" = "Първият ви риф";
"L6f50fe9d19" = "Стъпки, скокове и размери";
"L6f7552e3f9" = "Формата G за C използва прагчета 5 и 8, точно до G с форма D и D с форма A.";
"L6f84cce07d" = "Много тактове тук се сменят по средата. Бройте куплета на половини от два удара с по един акорд и сменяйте на всяко второ щракване.";
"L6f9084b461" = "Harold Boulton (1884)";
"L6f97ae38f9" = "Кой акорд ви тегли обратно към G?";
"L6facc1d867" = "Плъзнете нагоре, обратно и пак нагоре с първи пръст. Уточнявайте всяка нота.";
"L6fb2e24cec" = "Вторият пръст свири C диез, цял тон над B, затова оставете разстояние след първия. Това място се нарича висок 2, защото е близо до мястото на третия пръст.";
"L6fbb27dbe1" = "Блусът";
"L6fc1b88b81" = "Четири коледни песни за пеене на свещи: Уесли и Менделсон, приспивна песен и две мелодии от Америка.";
"L6fd4d1a273" = "Нагоре, както при дръпване с пръст";
"L6fd822f16e" = "Високо и на двете";
"L6fe7b842e1" = "Мелодията Ar Hyd y Nos е отпечатана в Уелс през 1784, а Харолд Бултън пише този английски текст през 1884. Една фраза се появява три пъти, с по-висока в средата.";
"L6ffb9b4308" = "Върху всяка нота от мелодията";
"L700550f7a8" = "Първият ред с допълващи фрази";
"L7009b5c7ec" = "Следете лентата с нотите и пазете мястото си, дори да пропуснете нота. Ритъмът продължава, продължете и вие.";
"L700caf50a2" = "Основни тонове и квинти, както басистът започва да акомпанира на група: основният тон при началото на акорда, квинтата между смените, ниско в първа позиция. Песента остава в E, където я свири групата.";
"L7011b1a621" = "Отговорът";
"L7017315505" = "Задръжте цигулката на място и дръпнете струната D, струна 3.";
"L702168cf86" = "Усетете идващия удар и дръпнете по-рано";
"L703760e9d4" = "1, 2 и, 3, 4";
"L7052923693" = "Един бемол";
"L705b6fce44" = "Това завършва ли на основния акорд?";
"L705c9442a0" = "Виолончело";
"L705d82cb8e" = "По-високо или по-ниско";
"L707adcf2aa" = "Дръпнете следващата струна";
"L707e698331" = "Ако започнете от G, цял тон нагоре води до...";
"L7083894272" = "Винаги цял такт";
"L708f879c93" = "Квинтата на акорда е на следващата по-тънка струна, две прагчета над основния тон. За отворена A това е прагче 2 на струна 2: E.";
"L708fc99213" = "Всяка нота е едно прагче по-ниско на струна 3: прагче 2, прагче 1, отворена.";
"L7090f484fc" = "Понижава го с полутон";
"L70a425cada" = "Изсвирете или изпейте F мажор нагоре от F до C. Четвъртият тон е B♭.";
"L70a67c5399" = "Ми сол ла сол";
"L70acdc94e1" = "Изпейте D тихо, после коригирайте, докато се установи.";
"L70ad456aec" = "4 и 3";
"L70aebab32e" = "Frederic Weatherly (1913)";
"L70cf9ad2c0" = "Кой акорд споделя мястото на пръст 1 на струна 2 с B бемол?";
"L70dbb7607e" = "G B D: голяма терца, после малка терца.";
"L70e3112f7b" = "Изсвирете или изпейте основните тонове на I, IV, V, I в C: C, F, G, C.";
"L70f8bb9a8a" = "У дома";
"L70fea9b4e8" = "Изпейте или изсвирете по-ниския тон.";
"L70ffe4f1fc" = "Какво е вибрато?";
"L71009efbad" = "Тризвучия на дансинга";
"L7101505b22" = "Блус фрази в пълно темпо";
"L710b5cf962" = "Началото: E E F G, G F E D.";
"L710ffe8ce8" = "Фрази с чувство";
"L7113e58d7b" = "Мини F обхваща струни 4 до 1: пръст 1 лежи върху струни 2 и 1 на прагче 1, пръст 2 е на струна 3, прагче 2, пръст 3 — на струна 4, прагче 3.";
"L7122f02be1" = "Ниското дишане разширява ребрата и корема. Повдигането на раменете стяга врата и гърлото.";
"L712f15d2f4" = "Стъпка, после скок";
"L71327ca01d" = "Няма нови понятия: малкият F, D7 и двете песни от този раздел. Сменяйте акордите рано и оставете мелодиите да пеят.";
"L7140cafdab" = "The Entertainer";
"L7145911558" = "После надолу: G, E, D, D.";
"L71569ed4cc" = "Струна 5, прагче 5";
"L71570ee63d" = "B, полутон нагоре до C и обратно.";
"L7159acaaa1" = "Един полутон по-малко от октава.";
"L716191664d" = "Големият мажорен септакорд добавя нотата едно прагче под октавата на основния тон. Прави обикновения мажорен акорд мек и мечтателен. Отворен Cmaj7 е C с вдигнат пръст 1.";
"L71636302f6" = "Уилям Крофт пише тази мелодия, St Anne, през 1708, а думите на Айзък Уотс са отпечатани за първи път през 1719. Всеки куплет е четири кратки реда — най-простата форма на химн.";
"L716ad20305" = "Няма нови понятия: фънк шестнайсетини, реге отсичане, бум-чик и синкопиран поп ритъм. Движете ръката непрекъснато и променяйте само какво докосва.";
"L716d58f177" = "B♯ е полутон над B, тоест C.";
"L717b08457c" = "Затворете устните свободно и духайте, за да затрептят като моторница, после добавете глас. Това държи гърлото отпуснато, докато гласът се събужда.";
"L7182a2d375" = "Позиция 1, нагоре и надолу";
"L7187db723a" = "Септакорди със суинг";
"L71892e72a8" = "Тоналността D";
"L718c34796e" = "Светлина на верандата с пръсти";
"L7192859777" = "Струна 5: висока G.";
"L719804b507" = "G на прагче 3 на струна 1, F диез на прагче 2, D на прагче 3 на струна 2, после F диез, отворена E и D.";
"L71adeb9248" = "Техниката „Травис“, наречена на Мърл Травис, редува палеца на всяко време, докато пръстите дърпат между ударите, на „и“.";
"L71af01d18d" = "Мелодията спира на си. Как звучи?";
"L71b92bbea9" = "Първи, втори и трети пръст на прагчета 2, 4 и 5 с отворени двойки между тях. Свирете плавно и оставяйте всяка нота да звучи до следващата.";
"L71d8b81afd" = "F по лесния начин";
"L71e5b1f872" = "Пиано";
"L71e7b3982b" = "Петата струна е до струна 4, но започва при петото прагче с ключ отстрани на грифа.";
"L71e96e5d41" = "Само на първото време";
"L71ea378148" = "Спада с октава";
"L720eef1b61" = "Какво повдига припева тук?";
"L7212825ac8" = "A мажорна пентатоника";
"L721ac72fb9" = "На последния удар нагоре преди смяната вдигнете барето и продължете да свирите. Отворените струни прозвучават за миг, ритъмът не спира и пристигате навреме.";
"L72226fbc48" = "Сега приемете D за основен тон. Нотите на G мажор от D до D дават D миксолидийски: мажорна гама със седмата степен едно прагче по-ниско. Среща се навсякъде във фолк, рок и народни цигулкови мелодии.";
"L72243f52e2" = "Всичките осем степени";
"L723c86e297" = "D на прагче 3 на струна 2, отворена B, A на прагче 2 на струна 3, отворена G, после обратно нагоре A и B.";
"L72429b5e7d" = "Тази версия е в G, в първа позиция: по две прагчета на пръст върху четирите двойки, а всеки акорд в схемата е форма за мандолина.";
"L724b59aa0f" = "Хамър-он, пул-оф, слайд";
"L7258ad6ffb" = "Припев: мелодията";
"L7277fd97d8" = "Най-горната линия е струна 1, най-тънката. Числото показва прагчето.";
"L72856486dd" = "Две позиции, един блус";
"L72890bd1aa" = "G на прагче 3 на струна 1, надолу до D на прагче 3 на струна 2, после F диез на прагче 2 и пак D.";
"L72893aee6a" = "Хайлайф слънце";
"L728cd633f1" = "A минор";
"L728e1822bf" = "От E нагоре до G♯ е...";
"L729b7425d6" = "От струна 2 към струна 1 се минава с малко движение. Дръжте ръката с перцето близо до струните, готова за следващата нота.";
"L72a3d2b16e" = "Тази френска мелодия от столетието, започващо с 1700, използва само научени ноти: A, B, C диез, D на струна A и E и F диез на струна E.";
"L72b3117837" = "D умален";
"L72b38c6701" = "Постоянен натиск при плъзгането";
"L72bab7e9c6" = "Първото ви соло";
"L72bd85eb5d" = "При подвижното до всяка степен на гамата получава сричка: до, ре, ми, фа, сол, ла, си, до. До е домът, независимо откъде започва гамата.";
"L72be45acb1" = "A, струна по струна";
"L72c3752afb" = "Традиционна (1852)";
"L72c4335ad6" = "Коя от тези мелодии е валс на три?";
"L72c4615523" = "Жак Офенбах пише този галоп за оперетата си „Орфей в ада“ от 1858. По-късно парижките танцови зали го превръщат в музиката на канкана.";
"L72cb6a906d" = "Припев";
"L72d49b8308" = "Суинг: дълго, кратко";
"L72e1d250aa" = "Йохан Щраус-син изпълнява този валс за първи път във Виена през 1867, а Виена все още го свири всяка Нова година. Мелодията му се изкачва по акорд, после отговаря с два високи тона.";
"L72e2680c98" = "Започва на по-ниска струна";
"L72e4578411" = "До ми сол ми";
"L72e72669af" = "Средният ред";
"L72f31e7c85" = "Много времена започват с кратка тишина. Спрете струната с ръката на грифа, после влезте отново на следващата осмина.";
"L72f8829e7e" = "Какво е акцент?";
"L730ecf2b62" = "Чуйте, намерете, изпейте";
"L730fe38866" = "Тази версия е в D. Четвъртата ви струна е настроена високо, затова мелодията остава на струни 1 до 3, а всеки акорд в схемата е форма за укулеле.";
"L732983c362" = "При даден тон усещате стягане или дращене. Какво правите?";
"L7329d82bd9" = "Първи пръст";
"L7338864b70" = "Отворена струна 3, после струна 2 на прагче 2.";
"L734b1f0943" = "Ту-степ";
"L734d8b3e2c" = "Наслагване на терци";
"L7355696e60" = "E минор: вдигнете един пръст";
"L7359906dce" = "Над резонаторния отвор";
"L73601df885" = "„Времето в мазето“ е авторска песен на Timbre — гаражен рок в A. Започва с риф на ниските струни, после пауър акордите отговарят на едно, на „и“ след две и на четири. Дръжте дланта при магаренцето. Цялата песен е в „Песни“, под „Авторски песни“.";
"L7364993206" = "Чуйте мястото на всеки тон в тоналността — от до, основния тон, до си.";
"L7364a9324b" = "Триолата побира три равни ноти в един удар. Бройте 1-три-ла, 2-три-ла, с еднаква дължина на всяка сричка.";
"L737e9af907" = "От струна 6 до струна 2";
"L7383cb2d2c" = "Цялата ръка, включително палецът";
"L738524e244" = "A C E: малка терца, после голяма терца.";
"L73aa18f071" = "Цял тон, цял тон, полутон, цял тон, цял тон, цял тон, полутон.";
"L73b1f13160" = "Започнете с баса";
"L73b7c2973b" = "С колко диезът повишава нотата?";
"L73bdfff736" = "Какъв акорд образуват отворените струни?";
"L73d4ee99cc" = "На времена 1 и 3";
"L73f6ca5963" = "Къде свири китарата в реге?";
"L73fd26acc8" = "Отворена, 1, 3, 4 на струните D и A. Запазете формата на ръката, поставяйте всяка нота точно и оставете октавите да резонират.";
"L73ff0ae4b6" = "Дръпнете най-дебелата струна и я оставете да звучи.";
"L740428ff15" = "Тръпчиво, после сладко";
"L74140f4fbe" = "Надолу, надолу-нагоре";
"L741d9469c2" = "Пръст я докосва";
"L742c5e9458" = "Asus4 е A с добавено кутре на струна 2, прагче 3. Като Dsus4 той се накланя напред и иска да се върне у дома.";
"L743c7fa8cf" = "Гайди, валсове и танци";
"L7455504689" = "Първи песни";
"L7458302143" = "Изсвирете A, после вдигнете пръст 2 от струна 3. Зазвучава отворена G и A става A7.";
"L746d58eb28" = "При реентрантния строй C на струна 3 е най-ниската нота на укулелето.";
"L746d806e74" = "Двойно щипване или ноти една по една?";
"L749627803c" = "Заменете един удар надолу с приглушен";
"L749ac2f07c" = "„Радио при отлив“ е авторска песен на Timbre — спокойно реге с E минор и A. Китарата свири само на „и“. Движете ръката надолу и нагоре, пропускайте струните на всяко число и ги докосвайте на всяко „и“. Цялата песен е в „Песни“, под „Авторски песни“.";
"L749bdaec42" = "E е белият клавиш непосредствено вдясно от групата от два черни клавиша.";
"L749c9d8d0e" = "Няма нови понятия: форма, интро, повторен завършек, фактура, допълващи фрази и вашата Down by the Riverside. Изсвирете всичко без спиране, като концертна програма.";
"L74a62f2786" = "Чуйте мажорни и минорни акорди, после умалени, увеличени и доминантсептакорди.";
"L74b4fa7ea9" = "Един акорд, една песен";
"L74c9c1f9c1" = "От ниско към високо: G, D, A, E. Всяка струна е пет буквени имена над предишната — интервал, наречен квинта. Запомнете с английската фраза: Good Dogs Always Eat.";
"L74d62bc627" = "Нота, нота, пауза, нота";
"L74e030bebc" = "От C до D се прескача черният клавиш между тях: цял тон, следователно голяма секунда.";
"L74e110372c" = "Настройте виолончелото";
"L74e60d76a3" = "Балада от Златната треска";
"L74f0435d4b" = "„Шафъл от Ръждивия пояс“ е авторска песен на Timbre — 12-тактов блус в E по току-що изсвирената схема със суингирана мелодия отгоре. Запазете дълго-краткия ритъм и в двете ръце. Цялата песен е в „Песни“, под „Авторски песни“.";
"L74f4a6f380" = "G C E A, отворените струни";
"L74f91db36a" = "Маршова отсеченост";
"L74fa60e9dc" = "Пръст 3 на струна 3, прагче 7. Дръпнете, после плъзнете до прагче 9, без да вдигате пръста.";
"L7503f2131d" = "Има осем диеза";
"L7515b995d9" = "Половина нота";
"L75227e00b7" = "„Светлина на верандата“ е авторска песен на Timbre — бавна балада в D. Свирете с пръсти: палец на основния тон на всеки акорд, после i, m и a нагоре по струни 3, 2 и 1. Оставяйте нотите да се преливат. Цялата песен е в „Песни“, под „Авторски песни“.";
"L75313a75b6" = "Коя струна се пропуска при D7?";
"L7564d208fb" = "Лоу-фай в цикъл";
"L75651a09d2" = "Всяка мажорна тоналност следва един модел: I, ii, iii, IV, V, vi, vii°. В C мажор това са C, D минор, E минор, F, G, A минор и B умален.";
"L756a84dff3" = "Пул-оф";
"L756b13efd3" = "Приглушете, после ударете";
"L757ab23746" = "„Две стъпки по чакъла“ е авторска песен на Timbre — танцувално кънтри в A с A, D и E. Сложете каподастър на прагче 2 и свирете с форми G, C и D, които знаете най-добре. Цялата песен е в „Песни“, под „Авторски песни“.";
"L75855335d0" = "C♯ и D♯";
"L759ca6682b" = "По-късно, на последната нота от триолата";
"L75a2941efc" = "A7: два пръста";
"L75ae4744f4" = "Нека всеки пръст покрива едно прагче: показалец на 2, среден на 3, безименен на 4, кутре на 5. Палецът почива зад грифа срещу средния пръст.";
"L75b46647b7" = "Задръжте F: отворена струна 3, струна 2 на прагче 1, отворена струна 1. Така започва Amazing Grace.";
"L75b727a923" = "Цял тон над третия";
"L75ba5c8a40" = "3/4 съдържа три удара; 1 + 1 = 2, затова остава един удар.";
"L75c8e227cb" = "И петте струни";
"L75cc572d55" = "G5";
"L75cdb21b5a" = "Струна 1, под пръст 3";
"L75dd0c550b" = "Бройте 1-три-ла и докосвайте само на „1“ и „ла“. Разстоянието по средата е суингът.";
"L75dead00c2" = "Лиги за легато";
"L7602fa4687" = "2 и 1";
"L760d963f68" = "Бърз, после бавен";
"L761695b22b" = "Секвенция";
"L761dcbbefc" = "Акорди и отсечени удари";
"L762ee32125" = "От D до E и от A до B";
"L763cf003eb" = "Отпускайте между акордите";
"L764f650ee8" = "Палец, показалец, среден пръст — и пак";
"L7653b6c98c" = "„Халоген“ е авторска песен на Timbre — пустинен рок в D минор. Рифът използва току-що научените ноти: отворена D, F на прагче 3, отворена G и C на струна 5, прагче 3. Цялата песен е в „Песни“, под „Авторски песни“.";
"L7659355836" = "Чуйте резонанса";
"L76775d6156" = "Две стъпки по чакъла";
"L768ad272b1" = "Традиционна (Англия, 1580-те)";
"L769a21a4b6" = "Чуйте F в ума си, после го изпейте.";
"L76a60ba092" = "Повечето песни имат няколко части: куплети, разказващи историята, припев с повтарящ се мотив и понякога бридж за контраст. Познаването на схемата ви пази от объркване.";
"L76ac577e04" = "На лявото рамо";
"L76b5c122da" = "Този ритъм движи безброй песни. На третото време ръката слиза, без да докосва струните, после ги удря нагоре.";
"L76b8e0aefa" = "Колко четвъртини времена има в такт 4/4?";
"L76bdd8e96f" = "E минор, p-i-m-a";
"L76ec2a9418" = "G звучи като дом, а D7 тегли обратно към него. Куплетът е три такта G, един D7, два G, после D7 и G.";
"L76f05876f1" = "For the Beauty of the Earth";
"L770925fb1d" = "Суинг усещане";
"L7713766279" = "Леко настрани, дръпвайки струната";
"L772060f80c" = "Средното C е C4. Кое е C една октава над него?";
"L773199c55a" = "Какво прави басовата линия ходеща?";
"L7734925a70" = "Незавършено, като въпрос";
"L774303f5af" = "Мелодията следва бум";
"L7749e45f77" = "Позиция 2 и връзката";
"L7750c6982d" = "Това предизвикателство смесва триоли, равни осмини и суинг. Дръжте пулса равномерен, докато начинът на разделяне се променя.";
"L77510a1916" = "Последното A";
"L7755242089" = "Пауър акордът съдържа само основния тон и квинтата — нотата пет букви нагоре. Нито мажорен, нито минорен, той остава плътен и при силно свирене. E5 е ниската част на E минор.";
"L775c034932" = "Мажор и минор навсякъде";
"L777cf155db" = "Дръпнете струните една по една от дебелата към тънката. Глухият звук значи, че пръст докосва струната. Наместете го и опитайте пак.";
"L77834a9822" = "Отворена A, после B с първи пръст. Задръжте B, докато тонът стане точен.";
"L7790a9bcca" = "Коледни певци на вратата";
"L77afc8a8ff" = "Бързият обрат: F, нагоре до A, обратно до F.";
"L77c8e74c56" = "Сменете при удара с палеца";
"L77cf24ec08" = "Както при отворен C, основният тон на формата C е на…";
"L77dd8f60bb" = "Баладата";
"L77e4a6e837" = "Като броим и двата края, колко тона от гамата има от до до сол?";
"L77e7ffc749" = "D на прагче 3 на струна 2, B на прагче 4 на струна 3, пак D, E на прагче 5 с пръст 4, после D и B.";
"L77ebaa5664" = "Рифове, пауър акорди и ретро звучене";
"L77f22a7a1f" = "Мелодия, която вече знаете";
"L77f34acf11" = "Защо да сменяте акорда на „и“ след четири?";
"L77f82dbfe9" = "Пет акорда, една ръка";
"L77fce1a6ed" = "Нона";
"L78040a6350" = "Бройте нагоре по струна 6: отворена E, F на 1, G на 3, A на 5.";
"L7831336036" = "Удряйте надолу на всяко време и нагоре на „и“ между тях. Ръката се люлее като махало: надолу, нагоре, надолу, нагоре, дори когато нотата чака.";
"L783598aa9b" = "The Last Rose of Summer и „Юпитер“";
"L783f1dbb24" = "Ритъм с първите ноти";
"L784171a46b" = "A минор, F, C, G7";
"L784f56f7aa" = "Това последование се изкачва стъпка по стъпка от A минор и стига до новия F. Удряйте два пъти на акорд и сменяйте рано.";
"L7850157ffa" = "Плагална";
"L785ae9fde1" = "Това е десният клавиш от двойката, непосредствено над D: D♯.";
"L78633b9ee3" = "Акорд, изсвирен нота по нота";
"L78748d3e3e" = "Трети пръст: F диез";
"L78771a5863" = "Отворена, 1, 3, 4";
"L787ad3e57d" = "Притиснете, свирете рол, сменете";
"L78843288d8" = "Уцелете и се придвижете";
"L78854cbe8a" = "Бавен трилер";
"L788cce8f6d" = "Малка секста";
"L7893d45a81" = "D минорна пентатоника";
"L78a15b5503" = "Първият такт: C, E, G, после B бемол, водеща към A.";
"L78a252be29" = "Басовите удари в G";
"L78a58336aa" = "Табулатурата е карта";
"L78ad15f28c" = "Най-ниската струна";
"L78ad8f08fc" = "Късен автобус към дома";
"L78d00ac979" = "Down by the Riverside, отпечатана за пръв път през 1918, е създадена за общо пеене. На укулеле е в G, с G, C и D7 и госпъл A диез на струна 1, прагче 1.";
"L78e0fbb58e" = "Прагче 4";
"L78e3c7b022" = "С палец ниско зад грифа пръстите се извиват и достигат от струна 5 до струна 1 без напрежение.";
"L78f007754a" = "„Стъклени спътници“ е авторска песен на Timbre — рок балада с A минор, F, C и G. Пълното баре F е вторият акорд, а позиция 1 пасва върху целия цикъл и получава соло. Цялата песен е в „Песни“, под „Авторски песни“.";
"L79000b6379" = "Da-vid's разпределя всяка сричка върху две осмини ноти. Изсвирете и двете, но ги изпейте като един плавен звук.";
"L790e7c10be" = "В 6/8 всеки такт съдържа шест осмини в две групи по три. Усеща се като два големи удара, всеки разделен на три: 1 2 3, 4 5 6.";
"L7922e364ef" = "Най-силната нота в песента";
"L794a2fe83f" = "„Изгрев със спрей“ е инди поп при 124 удара в минута: E, B, C диез минор и A — цикълът с четири акорда и две барета. Поддържайте настойчиви равни осмини и го оставете да тече.";
"L794e67d981" = "Две прагчета над G е A. Формата остава G, а звукът се вдига с каподастъра.";
"L795606787b" = "Вълна върху G";
"L797d46da49" = "E с първи пръст, после слайд до G с първи пръст. Нека и палецът се премести.";
"L798fb9b546" = "Припевът стига нагоре: B, D, отворена E, после G на прагче 3 на струна 1. Обратно надолу: D, B B G.";
"L7999cb145d" = "Над най-горната линия моделът продължава. G е непосредствено над нея, а A е на първата допълнителна линия отгоре.";
"L799c178cf7" = "Отворена A, прагче 4 на струна 5, прагчета 2 и 4 на струна 4, после отворена G.";
"L799d8f14e5" = "Откъде идва";
"L79c2909968" = "Изсвирете или изпейте средното C, после C една октава по-високо.";
"L79e96a01f4" = "Хамър-они, пул-офи, слайдове";
"L79ea537c97" = "Кой акорд тегли към G?";
"L79edc518ec" = "Дъжд по капандурата";
"L79f440e719" = "Струни 4 и 1";
"L7a0178640d" = "Предизвикателство с отворени струни";
"L7a0d002f86" = "Преместете пръст 3 на струна 5, прагче 3, и сложете кутрето на струна 4, прагче 3. Звучат пет струни и F е по-плътен.";
"L7a11f282e7" = "Остава на струни 3 и 4";
"L7a37110f72" = "На следващия удар";
"L7a3a4a4221" = "Кварта";
"L7a488412f4" = "Отворена 3, прагче 4; после струна 2, прагчета 2 и 4.";
"L7a6cca45fb" = "Отворена B два пъти, A на прагче 2, струна 3, отворена G, после D на прагче 3 и E на струна 1, обратно през D и C до B.";
"L7a85496646" = "Пет химна";
"L7a94cc7e8b" = "Преди първия удар пребройте на глас в темпото на песента: едно, две, три, четири. Всички започват заедно с темпото, което зададете.";
"L7a9a2a3172" = "G на прагче 3 на струна 1 и отворена E, два пъти. После пак G и D на прагче 3 на струна 2, два пъти.";
"L7aa1bfc90c" = "Басът и бас барабанът звучат заедно. Целете точния миг на щракването, не просто близо до него. Timbre показва дали избързвате или закъснявате.";
"L7aa9032141" = "Още един притеглящ акорд";
"L7ac2aa3ed2" = "The Water Is Wide";
"L7ac6eb4e66" = "Не, очаква се продължение";
"L7ac946053a" = "Здравей, укулеле";
"L7ad16b9d12" = "Мелодия от „Планетите“";
"L7aeab8183d" = "E, F и G";
"L7af2d04324" = "Мандолина";
"L7b16481fcd" = "Отворена струна 6 два пъти, G на прагче 3, отворена E, отворена струна 5, пак G, после отворена E.";
"L7b3b95c47e" = "Очертайте акордите";
"L7b4579eb6a" = "2 + 2 + 2 + 2";
"L7b54d7c50d" = "В D мажор";
"L7b56ed522a" = "Au clair de la lune е френска народна песен от столетието, започващо с 1700. Тя е на струните G и D, с C под четвъртия пръст.";
"L7b5d00b025" = "Бързата смяна";
"L7b646518c9" = "Плъзнете се до точния тон";
"L7b6e740eb2" = "Скок (терца)";
"L7b7b5e982c" = "Отсечени удари в G, C и D";
"L7b84294da2" = "Шест броя, две полюшвания";
"L7b9006e026" = "Отворена B два пъти, C на прагче 1 и D на прагче 3 на струна 2, после обратно надолу B, A и G.";
"L7b96529d60" = "Нагоре по струна E";
"L7b972cb63e" = "Тази стара американска цигулкова мелодия следва ритъма от отворените струни: дълго, кратко-кратко, дълго, дълго. Цигуларите я свирят на музикални сбирки навсякъде.";
"L7bc07f1c51" = "Какво е затакт?";
"L7bcb899472" = "Предизвикателство с ролове";
"L7bd8097a38" = "G и A на струна 3, D, E и F на струна 4, гамата C мажор и две традиционни мелодии.";
"L7be45b6fa8" = "Отворена струна 4 е D. Прагче 2 е E, а прагче 3 е F. Дръжте палеца ниско зад грифа, за да достигат пръстите.";
"L7be8ead7d9" = "В тоналност G кой акорд е V?";
"L7be9004c2e" = "D, F♯ и A са трите ноти на D мажор. Народните цигулкови мелодии често очертават така акордите си.";
"L7bfa664ab2" = "Високата част: от отворена B до D на прагче 3, после надолу през B, G и A.";
"L7c10b1802d" = "Аутро";
"L7c17747dec" = "Фразирайте като певец";
"L7c1d430e25" = "G: три пръста";
"L7c2ec91d74" = "Палец на баса";
"L7c61bafa47" = "Силно и тихо";
"L7c678174ce" = "Цели тонове и полутонове";
"L7c69162628" = "Перцето е твърде дебело";
"L7c796e01f6" = "0 на втората линия означава…";
"L7c7dccf8a8" = "Между кои две степени има полутон?";
"L7c8910de43" = "Продължавате да задържате, без ново докосване";
"L7c9b3dfe11" = "G7 звучи незавършено. Изсвирете C след него и напрежението изчезва. Заради това притегляне толкова песни поставят G7 преди C.";
"L7ca0aa3c1a" = "Основи на фа ключа";
"L7caafe5ece" = "B бемол, D7, B минор и G минор, тоналностите G, F и D и пренасяне на песен във всяка тоналност.";
"L7cbe9df99e" = "4 + 4";
"L7cd7cf4d00" = "The Last Rose of Summer и „Юпитер“ са на три. Home! Sweet Home! и Hard Times се броят на четири.";
"L7cda0092d2" = "Най-известният марш на Суза";
"L7cf184f4c6" = "H";
"L7cfee748e2" = "Целият тон е равен на два полутона: прескача точно един клавиш. От C до D е цял тон, с C♯ между тях. От E до F♯ също.";
"L7d052af42d" = "Интрота и финали";
"L7d0f3c3f18" = "Тризвучия на високите струни";
"L7d106663f4" = "Каподастър на прагче 2. Формата C звучи като…";
"L7d14b6371f" = "Застанете изправени, дишайте ниско, задръжте първия си устойчив тон и изпейте песен.";
"L7d188e15c9" = "Схемата";
"L7d19e2dbc8" = "Песен отблизо: Хълмът на фенерите";
"L7d2121e467" = "Точно един удар";
"L7d35795799" = "Септакорди, sus и суинг";
"L7d52788ad8" = "Малки високи форми";
"L7d596ac488" = "E на отворена струна 1";
"L7d5a055e37" = "Каньонът на ехото";
"L7d69f3e22c" = "Когато мелодията задържа дълга нота, соло китаристът запълва пространството: една-две басови ноти от акорда, после навреме обратно към мелодията.";
"L7d6b0a3fdf" = "На „и“";
"L7d6ba1832b" = "Октавата е същото име на нота, по-високо. От основен тон на струна 4 или 3 минете две струни към тънките и две прагчета нагоре. Отворена A става прагче 2 на струна 1.";
"L7d6c1cd2a4" = "Friedrich Schiller (1785)";
"L7d73221cd1" = "Три удара в такт";
"L7d8c480c83" = "G мажор използва F♯. Понижаването му до F създава миксолидийското звучене, характерно за старинната американска музика и блуграс.";
"L7da8a71881" = "Линии, междулиния, допълнителни линии и двата ключа. Използвайте изреченията за запомняне, после опитайте да разпознавате всяка нота от пръв поглед.";
"L7dab99667b" = "Една басова нота";
"L7db3d33bc4" = "Какво означава да пеете над тона?";
"L7db42c8944" = "Традиционна (отпечатана през 1927)";
"L7db4bd1048" = "Хамър-он и пул-оф";
"L7db6bb8ffa" = "Кой тон е цял тон под F?";
"L7dce4b7666" = "She'll Be Coming 'Round the Mountain";
"L7debe232fa" = "Номерът на октавата се сменя при C, затова следващата нота нагоре от B3 е C4.";
"L7df7b523ad" = "Леко тананикане";
"L7dfc34025a" = "Изсвирете всяка мелодия докрай с равномерно темпо. Ако изпуснете нота, движете ръката с перцето и хванете следващото време. Така протича истинското общо свирене.";
"L7e0448d5ad" = "На време 1 има едно докосване, на времена 2 и 3 — по две, а на време 4 — едно.";
"L7e1e38b1e4" = "Това е основният тон на E";
"L7e2e5973e7" = "Авторски песни";
"L7e327ea06c" = "Диминуендо";
"L7e41044b8c" = "Четвъртина с точка, после осмина";
"L7e6a077cdf" = "I, V, vi, IV";
"L7e7e7f9183" = "Багрите на акордите";
"L7e8736c9eb" = "„Град в снежно кълбо“ е бърз валс в G при 120 удара в минута, като музикална кутия: един силен удар, два леки. G, D, E минор и C с B7 в бриджа.";
"L7e8bcfbfd8" = "Fly започва на C и се плъзга надолу до дълго A. Певците наричат изпяването на една сричка върху няколко ноти мелизма.";
"L7e8c92c878" = "От ниско към високо: G, D, A, E.";
"L7e8d3d1635" = "Валс в D минор";
"L7e90bc9187" = "Има един ключов бемол — B♭. Коя е мажорната тоналност?";
"L7e98b4a84e" = "Техника за сола";
"L7ea0083c67" = "Традиционна";
"L7ea1a3dd0e" = "Дванадесет такта по ваш начин";
"L7ec06a6447" = "Част A";
"L7ec3fd5bd8" = "Без приложението изберете два акорда и ги редувайте една минута с по един удар. Бройте чистите смени и утре подобрете резултата. Започнете с D и D минор.";
"L7eeafd430e" = "Азбуката, октавите и картата на клавиатурата — всичко заедно. Използвайте групите черни клавиши, за да се ориентирате.";
"L7eed15e9d5" = "От E нагоре до C е...";
"L7eed8c9e72" = "От E до A на една струна";
"L7ef3fb65e1" = "Кой е основният тон в тризвучието F A C?";
