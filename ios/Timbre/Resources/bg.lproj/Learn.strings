"L0009cb1a16" = "Една струна звучи глухо. Защо най-вероятно?";
"L00130a44b5" = "Допирът без натиск спира звъненето на струните. Ударът се превръща в ясно перкусионно щракване.";
"L0015244e3f" = "G7 запазва ниската G, но отгоре слага F: пръст 3 на струна 6, прагче 3; пръст 2 на струна 5, прагче 2; пръст 1 на струна 1, прагче 1.";
"L0017247d59" = "Кой е G7, акордът с повече напрежение?";
"L001a8a4e76" = "Пръст 1 на струна 3, прагче 1 дава единствената нота, която прави акорда E мажор.";
"L0024a55a06" = "Шафълът";
"L002ba346f7" = "Струна 3: прагче 2, прагче 3, прагче 5.";
"L002e2c331d" = "Очертайте контура";
"L002fe27c72" = "„Медна жица“ е изградена върху риф: кратка, запомняща се линия на ниските струни, към която цялата група се прикрепя. Върви при 112 удара в минута в E, с пауър акорди в припева.";
"L00398ce342" = "Направете баре на струни 5 до 1 на прагче 10 и поставете пръст 3 напречно на струни 4, 3 и 2 на прагче 12. Това е барето с форма A и отново е G.";
"L00573ce6a3" = "Каподастърът";
"L006392a6a7" = "Терца";
"L0074f77ab6" = "Седмият тон на G мажор е F♯.";
"L0077cab0a8" = "Суза пише маршовете си за военен духов оркестър. „Пролет“ е за цигулка и струнни, а рондото — за пиано.";
"L007b8bf14c" = "Бройте 1 2 3, 1 2 3 с тежест на 1. Това е валсов размер. „Clementine“, отпечатана за пръв път през 1884, се полюшва в три.";
"L008b7d6e79" = "D диез е едно прагче под E. Този полутон силно тегли към дома и затова Greensleeves го използва във всяка каденца.";
"L008b914131" = "Програма с отворени акорди";
"L008ec0fe41" = "Пеете малко по-ниско";
"L00b1aaa1ac" = "Джон Филип Суза пише този марш в края на 1896, а той е публикуван през 1897. Това е официалният национален марш на Съединените щати. Тук е голямата му мелодия от триото.";
"L00b6eb7b38" = "„Време за хвърчила“ е светъл, лесен поп: четири акорда в цикъл — G, D, E минор и C — при спокойни 88 удара в минута. Чуйте как основният мотив скача до F диез във втория си такт.";
"L00db96471b" = "Задръжте го в ума си";
"L00f131a2fc" = "Шест еднакви удара";
"L00f1e4a733" = "D на прагче 3 на струна 2 и отворена струна 4 са все D. На какво разстояние са?";
"L00f5a8d2df" = "Рагтайм, маршове и сцена";
"L0100ebed8a" = "Дървената пръчка върви от жабката, където го държите, до върха. Между тях са опънати конски косми. Затегнете винта, докато молив едва се побира между космите и пръчката.";
"L0101b7221e" = "Ходещ бас в D и E";
"L010a5a3a68" = "Под frost-y wind made moan акордите преминават от A минор към D7 — притегляне, което връща реда към G.";
"L011468ba58" = "Две ноти с един лък означава по половин лък за всяка. Планирайте и започвайте легатото с достатъчно лък и за двете ноти.";
"L011d756661" = "C E G, F A C и G B D имат голяма терца отдолу.";
"L0124abba92" = "Куплетът изпява няколко думи на един тон. Дръжте всяко F диез кратко и равно и оставете думите да носят реда.";
"L0129c1441b" = "На 1, 3 и 5";
"L013fea348d" = "G, A";
"L015e6a69e5" = "Два пъти в секунда";
"L016652736c" = "Коя степен на гамата е последният тон?";
