<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- cs plural forms (CLDR categories used: one, few, other). Keys match en.lproj/Localizable.stringsdict; wording follows this locale's Localizable.strings. -->
<plist version="1.0">
<dict>
	<key>%lld cents flat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>O %lld¢ níže</string>
			<key>few</key>
			<string>O %lld¢ níže</string>
			<key>other</key>
			<string>O %lld¢ níže</string>
		</dict>
	</dict>
	<key>%lld cents sharp</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>O %lld¢ výše</string>
			<key>few</key>
			<string>O %lld¢ výše</string>
			<key>other</key>
			<string>O %lld¢ výše</string>
		</dict>
	</dict>
	<key>%lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld min</string>
			<key>few</key>
			<string>%lld min</string>
			<key>other</key>
			<string>%lld min</string>
		</dict>
	</dict>
	<key>%lld sessions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Relace: %lld</string>
			<key>few</key>
			<string>Relace: %lld</string>
			<key>other</key>
			<string>Relace: %lld</string>
		</dict>
	</dict>
	<key>Every %lld bars</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Každý takt</string>
			<key>few</key>
			<string>Každé %lld takty</string>
			<key>other</key>
			<string>Každých %lld taktů</string>
		</dict>
	</dict>
	<key>Practised on %lld days in the last twelve weeks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Dnů s cvičením za posledních dvanáct týdnů: %lld</string>
			<key>few</key>
			<string>Dnů s cvičením za posledních dvanáct týdnů: %lld</string>
			<key>other</key>
			<string>Dnů s cvičením za posledních dvanáct týdnů: %lld</string>
		</dict>
	</dict>
	<key>Practised today. Best run %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Dnes odcvičeno. Nejlepší série: %lld d.</string>
			<key>few</key>
			<string>Dnes odcvičeno. Nejlepší série: %lld d.</string>
			<key>other</key>
			<string>Dnes odcvičeno. Nejlepší série: %lld d.</string>
		</dict>
	</dict>
</dict>
</plist>
