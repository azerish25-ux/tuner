"timbre_about_local_history_body" = "സെഷൻ തീയതികൾ, തിരഞ്ഞെടുത്ത ഉപകരണങ്ങൾ, പരിശീലന സംഗ്രഹങ്ങൾ എന്നിവ ലോക്കലായി സംഭരിക്കുന്നു. ഒരു ഉപകരണത്തിലേക്ക് തിരികെ പോകാനും നിങ്ങളുടെ പരിശീലനം അവലോകനം ചെയ്യാനും ഇത് സഹായിക്കുന്നു. ആൻഡ്രോയിഡ് ക്രമീകരണങ്ങളിൽ ഈ ആപ്പിന്റെ സ്റ്റോറേജ് ക്ലിയർ ചെയ്യുന്നത് ലോക്കൽ ചരിത്രവും മുൻഗണനകളും നീക്കം ചെയ്യും.";
"timbre_about_microphone_heading" = "നിങ്ങളുടെ മൈക്രോഫോൺ";
"timbre_about_on_device_microphone_body" = "പിച്ച് കണക്കാക്കാൻ മൈക്രോഫോൺ ശബ്ദം നിങ്ങളുടെ ഉപകരണത്തിൽ വിശകലനം ചെയ്യുന്നു. ഓഡിയോ സേവ് ചെയ്യുകയോ അപ്‌ലോഡ് ചെയ്യുകയോ ചെയ്യുന്നില്ല. സജീവമായ ട്യൂണിംഗ് അല്ലെങ്കിൽ പരിശീലന സ്ക്രീനിൽ നിന്ന് പുറത്തുകടക്കുമ്പോൾ മൈക്രോഫോൺ ആക്‌സസ് നിർത്തലാക്കപ്പെടും. ആൻഡ്രോയിഡ് ക്രമീകരണങ്ങളിൽ നിങ്ങൾക്ക് ആക്‌സസ് റദ്ദാക്കാവുന്നതാണ്.";
"timbre_about_open_browser" = "നിങ്ങളുടെ ബ്രൗസറിൽ timbre-privacy-shahrad.timbre.workers.dev തുറക്കുക.";
"timbre_about_permanent_purchase_body" = "പൂർണ്ണമായ ഇൻസ്ട്രുമെന്റ് ശേഖരം, സിംഗിംഗ് പ്രാക്ടീസ്, സ്റ്റുഡിയോ എന്നിവ ഒറ്റത്തവണ പേയ്‌മെന്റിലൂടെ ലഭ്യമാണ്, ആവർത്തിച്ചുള്ള ചാർജുകളൊന്നുമില്ല. ഗൂഗിൾ പ്ലേ വഴിയാണ് പേയ്‌മെന്റും വാങ്ങൽ പുനസ്ഥാപിക്കലും കൈകാര്യം ചെയ്യുന്നത്. നിങ്ങളുടെ ആക്സസ് വീണ്ടെടുക്കാൻ ക്രമീകരണങ്ങളിൽ (Settings) 'Purchase and restore' തുറക്കുക. നിങ്ങൾക്ക് ഇതിനകം പഴയ സബ്‌സ്‌ക്രിപ്‌ഷൻ ഉണ്ടെങ്കിൽ, അത് ഗൂഗിൾ പ്ലേ വഴി തുടർന്നും മാനേജ് ചെയ്യാം.";
