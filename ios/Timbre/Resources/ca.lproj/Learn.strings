"L5c8558d5d5" = "Aquesta frase va amunt o avall?";
"L5c93ebdb3e" = "Greu, agut, greu, agut";
"L5ca845ae96" = "G, C, D, G";
"L5cb0a0bffe" = "Un flux per tres parells";
