"L5c08c48eb7" = "La segona línia començant per baix és G, on s’enrosca la clau de sol.";
"L5c1817f5a4" = "Salts d’octava";
"L5c1e7ffe61" = "Primer, so sense vibrato";
"L5c228ef72c" = "G natural és un semitò per sobre de F sostingut: el segon dit es posa just al costat del primer.";
"L5c295e30fb" = "Coneix el teu violoncel";
"L5c2cb44d0b" = "Puntets i silencis";
"L5c2fe433c0" = "Només els lligats ascendents";
"L5c3ec26bbd" = "Lligadures";
"L5c47ff6ad3" = "Per cantar la mateixa nota dos cops, atura l’aire un moment i torna a començar amb un «da» suau. No llisquis entre les notes.";
"L5c49265a7a" = "A menor, p-i-m-a-m-i";
"L5c4bea20f2" = "Llisca la mà amunt fins a posar el dit 1 al trast 3. Ara cada dit cobreix un trast: 3, 4, 5 i 6. Puja també el polze, darrere el dit 2.";
"L5c65302b62" = "D, E i F a la corda 4, després G i A a la corda 3.";
"L5c70a63a7d" = "Els patrons curts com do-re-mi-re-do milloren de pressa la precisió. Canta’n un, comença’l un pas més amunt i deixa que l’escala et guiï.";
