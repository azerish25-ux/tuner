"L594cfc45fd" = "Henry Bishop va escriure aquesta melodia per a una òpera londinenca el 1823, amb lletra de l’actor americà John Howard Payne. En pocs anys va ser una de les cançons més estimades del món.";
"L5952f9b6a9" = "Phillips Brooks va escriure aquesta lletra el 1868 per als infants de la seva església de Filadèlfia, i l’organista Lewis Redner va escriure la melodia per a l’ofici de Nadal.";
"L597b60da13" = "Puja a C, baixa a B a l’aire i torna, després D, baixa a A i torna a D.";
"L59814fa3ba" = "Queda’t al mateix lloc";
"L5983fa3abd" = "Corda 3, trast 2, segon dit. És B.";
"L598a489b59" = "Quin compàs té aire de marxa?";
"L598c2fd0e7" = "Canta o toca les notes de l’acord, de greu a agut.";
"L599637a52a" = "Toca o canta els espais de baix a dalt: F, A, C, E.";
"L599a010fb7" = "El gran salt: de G amunt fins a C agut i després baixa per passos.";
"L59a890261d" = "Quanta pua ha de sobresortir?";
"L59abc0da88" = "Busca els espais sense tecla negra: d’E a F i de B a C. Aquestes tecles blanques són l’una al costat de l’altra, així que només les separa un semitò.";
"L59bc865a46" = "Repte de celletes";
"L59c12ec1c9" = "Cordes a l’aire, polsació amb dos dits i primeres notes amb trasts. Alterna els dits i deixa ressonar cada nota.";
"L59c1350d23" = "Una cançó popular francesa";
"L59d0bca33c" = "Des de C, les tecles blanques fan C, D, E, F, G, A, B i altre cop C. Set tecles blanques tenen una de cada lletra.";
"L59d89422db" = "Quin G és més agut?";
"L59efa0f9f5" = "Sostinguts i bemolls";
"L59f912292e" = "La línia aguda: puja a D al trast 3 de la corda 2, després B G, B A, G E D.";
"L5a0e299b6e" = "Quin és el nombre de pulsacions d’una blanca amb puntet?";
"L5a14702747" = "La tornada recorre C, A menor, D7 i G. Canvia a la paraula que comença cada mig compàs i rasca lleuger sota l’E agut.";
"L5a4c7da42b" = "Repte dels primers passos";
"L5a59483173" = "Punk-pop, rock de riffs, rock fosc en 6/8, un himne indie i rock del desert, amb quintes i riffs greus.";
"L5a5d733600" = "Do, mi i sol són les notes de l’acord de tònica, així que sonen estables i en repòs. Mi sona dolç, sol sona fort i obert, i do sona conclusiu.";
"L5a5d8340b2" = "Shady Grove";
"L5a636e248d" = "Les notes amb la mateixa lletra s’assemblen encara que una sigui més aguda. La distància d’un C al C següent és una octava. La nota més aguda vibra exactament el doble de ràpid.";
"L5a80ba0bea" = "Llisca fins a la posició 2";
"L5a9ac09da7" = "La corda C";
"L5a9e82f489" = "2 baix al registre agut";
"L5ab4b059e7" = "Tradicional (França, segle 18)";
"L5ab72ee022" = "Els grans solos respiren. Toca una frase curta, fes un silenci de durada semblant i respon. El silenci dona pes a les notes següents.";
"L5acc606203" = "Estrofa 4";
"L5acf76b488" = "Gola relaxada i respiració regular";
"L5ad2994115" = "D, A, B menor, G";
"L5af071dd5b" = "Cinc cordes";
"L5af311b98c" = "Deixar buit el temps 1 és el silenci més difícil. Fes un gest amb el cap a l’1 per sentir-lo sense picar i entra al 2.";
"L5b0918cfec" = "Compta amunt des de G: la nota 1 és G, la nota 4 és C, la nota 5 és D.";
"L5b0e679c41" = "Una nota en una línia puja una lletra. On arriba?";
"L5b10c8407c" = "A menor i el primer canvi";
"L5b11880954" = "Scotland the Brave";
"L5b1ad97ddf" = "Fer un dictat vol dir escoltar una melodia i escriure-la. Aquí la tries d’una llista. Troba do a partir de l’acord i segueix cada moviment: amunt o avall, pas o salt.";
"L5b206df439" = "Quin acord és el vi en C?";
"L5b2757c644" = "De B a la nota següent: quin tipus de pas és?";
"L5b3ab40010" = "Una pulsació";
"L5b4d19a642" = "Aquesta melodia es va imprimir per primer cop al recull de música irlandesa de George Petrie el 1855. La lletra de «Danny Boy» s’hi va posar molt més tard, el 1913.";
"L5b56b84455" = "El vibrato apareix quan la veu és lliure i té suport. Forçar-lo amb la mandíbula o el ventre crea una oscil·lació.";
"L5b57dfbaff" = "Una nota omesa";
"L5b5d9c7ca6" = "Els tempos més ràpids demanen menys esforç, no més. Mantén la mà relaxada i pica des de l’artell, no des del canell o l’espatlla.";
"L5b6055b519" = "Acords amb celleta i síncopes";
"L5b72ac2ae5" = "Un zig-zag, no una escala";
"L5b72f1cd00" = "E a l’aire, torna a C i D a la corda 2, després E, F sostingut i G a la corda 1.";
"L5b73319e44" = "«The Skye Boat Song» es gronxa en sis per vuit. «O Christmas Tree» és en tres i «All Through the Night», en quatre.";
"L5b739425ea" = "Sobre un blues en A, funcionen totes dues posicions. La pentatònica major al trast 2 sona dolça; la menor al trast 5, aspra. Els bons músics les alternen.";
"L5b7d0278c6" = "Quatre intervals de totes les maneres";
"L5b809972b5" = "D, E i F sostingut";
"L5b90e239db" = "Rock del desert";
"L5b9874ad31" = "Armadures";
"L5b9f430ff6" = "Tercer, a la corda D";
"L5ba0846c7d" = "Les celletes costen al principi. Què ajuda més?";
"L5ba3d0bd26" = "L’estrofa comença una pulsació abans, amb l’anacrusi. Una última nota llarga deixa lliure aquella pulsació.";
"L5bacba7e1d" = "Pujar una lletra vol dir passar d’una línia a l’espai següent o d’un espai a la línia següent. Les notes de línies veïnes estan separades per dos passos de lletra.";
