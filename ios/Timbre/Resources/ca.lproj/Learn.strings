"L5fb4562659" = "Cinc notes, una melodia dolça";
"L5fbc8a707e" = "A amb el quart dit a la corda D, A a l’aire i de nou quart dit. Fes-los coincidir exactament.";
"L5fbdb73163" = "El quart dit";
"L5fbe60e018" = "El punt més agut: tres A, puja a F sostingut al trast 2 de la corda 1, E E D B D, A F sostingut D.";
"L5fc3444ce4" = "Polze, índex, dit del mig";
"L5fd07fade8" = "Segons per acord";
"L5fef0931cc" = "És la fonamental? Escolta la nota més greu.";
"L5ff6946aec" = "Dia de mercat és un original de Timbre: pop lluminós en G amb ritme highlife, la música de guitarra brillant de l’Àfrica occidental. El motiu només usa notes de G major: encaixa a l’escala en segona posició. La cançó sencera és a Cançons, dins d’Originals.";
"L600e2dce19" = "Corda 1, trast 3";
"L601d7efe00" = "Tornada";
"L60229f5c78" = "Per lliscar, polsa una nota i mantén la pressió mentre mous el mateix dit fins a un altre trast. La pressió manté el so: només es polsa la primera nota.";
"L6027a15546" = "Passos i semitons";
"L6030ff6791" = "D al trast 3 de la corda 2, B a l’aire i torna, E a l’aire i F sostingut al trast 2 de la corda 1.";
"L603a7315ae" = "Deixant-la ressonar";
"L603b077f43" = "La fonamental de D obert és la corda 4 a l’aire. En pujar, la prem el dit 1: G al trast 5. La corda 2, trast 8, també és G.";
"L60416d96dc" = "Amb celleta continues pensant en G, C i D, les posicions que coneixes. Els diagrames indiquen l’acord que sents: una posició de G amb celleta al 2 hi apareix com A.";
"L6046c05006" = "«Home!» és una rodona: mantén D al trast 3 de la corda 2 tot el compàs.";
"L60486c0a4b" = "Setenes de manera fàcil";
"L6049def04f" = "Els silencis es compten";
"L604ac866f0" = "Dreça’t sense tensió";
"L6053efe7e3" = "El punteig pren noms del castellà: p per al polze, i per a l’índex, m per al dit del mig, a per a l’anular. Recolza i a la corda 3, m a la corda 2 i a a la corda 1, a punt per polsar.";
"L60567af0fd" = "C, A7, D7, G7 i tornada a C. Cada acord de setena atreu cap al següent, una petita cadena de tensió. Va impulsar moltíssimes cançons fa un segle.";
"L6063ec8dfa" = "La tornada, puntejada";
"L6065bcf219" = "Terceres amunt per l’escala";
"L60715612f0" = "G major, amunt i avall";
"L608e8768cd" = "Tercer dit a la corda D";
"L60948f8372" = "Les tecles negres, el pas més petit i les notes amb dos noms.";
"L609651b67b" = "Abasta vuit noms de lletra";
"L60db049169" = "G D A E";
"L60dea2df67" = "La fa curta i separada";
"L60f61fb4e2" = "Res de nou: E, F i G a la corda 1; B, C i D a la corda 2. Comença a poc a poc i després mantén un tempo constant.";
"L60f6f7bc7e" = "Que el pèndol no s’aturi";
"L6128108d6c" = "El mateix patró de dits en dues cordes més greus, D major i tres melodies.";
"L6129f8fd2f" = "Totes quatre cordes";
"L61378dcfa1" = "Quan canvia l’acord, el polze arriba a la nova fonamental just al primer temps. Els altres dits continuen polsant les cordes 2 i 3 com abans.";
"L613a306f82" = "En aquesta posició, quin dit toca el trast 5?";
"L613b9483be" = "La introducció i el solo";
"L6142dc5601" = "Torna el segon tema";
"L614f875fca" = "Aquesta posició al trast 2 també és la pentatònica de F sostingut menor si parteix de F sostingut. La nota que fas servir de tònica decideix quina toques.";
"L6152642fb8" = "Parell 2: a l’aire, trast 2, trast 4, trast 5.";
"L6153371910" = "El trast 3 és a la zona del segon dit, els trasts 3 i 4.";
"L616a1bd784" = "Els músics de jazz solen afegir setenes: Dm7, G7, Cmaj7. Les notes afegides fan cada moviment encara més fluid. Les fonamentals i el viatge cap a casa no canvien.";
"L616b46e903" = "Oda a l’alegria, segona frase";
"L6181145819" = "Mantén la pua a prop de les cordes i fes cops regulars. La velocitat vindrà després, quan el moviment sigui relaxat.";
"L6191fba215" = "Què fa una introducció?";
"L61992ffcfb" = "Corda 2, trast 4";
"L61a7fd6fc3" = "Totes les escales majors segueixen una recepta de passos: to, to, semitò, to, to, to, semitò. Comença en qualsevol nota, segueix-la i construiràs una escala major.";
"L61ac361d21" = "Què és un canvi de posició";
"L61b524f257" = "L’altura baixa quan et queda poc aire. Acabar una mica abans manté tota la nota afinada.";
"L61d442d352" = "La tornada comença aguda: D al trast 3 de la corda 2, C sostingut al trast 2, B a l’aire i baixa a D a l’aire.";
"L61da910eb5" = "Angeline the Baker";
"L61e018ea94" = "Cops curts i D9";
"L61e1dfe135" = "Cinc melodies tradicionals de sessió, simplificades, de «Boil Them Cabbage Down» a «Old Joe Clark».";
"L61ec307304" = "Posa el dit 1 al trast 2 i dona un trast a cada dit, fins al trast 5. Des de G a la corda 6, trast 3, l’escala puja per les cordes 6, 5 i 4.";
"L61ee1ab807" = "On s’atura el dit després d’una polsació recolzada?";
"L61f1c8da71" = "Numera l’escala des de G: G és 1, A és 2, i així fins a F sostingut, 7. Els músics fan servir aquests números per parlar de melodies i acords en qualsevol tonalitat.";
"L61fc25fa4f" = "El primer temps";
"L62137e8c2f" = "Sis cançons d’una tirada";
"L62175f3821" = "Res de nou: G major en dues octaves, l’escala per terceres, A dòric i D mixolidi. Mantén un dit per trast.";
"L621c5e6bc0" = "Llarg, curt en tres";
"L621f8b64c0" = "Dotze compassos";
"L622c702c21" = "Cançoner d’ukelele";
"L623729eeb4" = "Un interval és la distància entre dues notes. Un uníson no té cap distància: la mateixa nota dos cops. Una octava va d’una lletra a la mateixa lletra més amunt, com de C a C. Sona com una sola nota, però més brillant.";
"L62490fbda1" = "Part greu, segona meitat";
"L625278775b" = "Mateix inici, final diferent. La segona frase torna a C, la tònica.";
"L625d141f7d" = "Dit 4 a la corda 1";
"L6271a044a6" = "Beethoven va escriure aquesta peça per a piano el 1810, però no es va publicar fins al 1867, quaranta anys després de morir. Aquesta versió simplificada en conserva el famós inici.";
"L62773cc1b4" = "Toca les cordes 6, 5 i 4, d’una en una.";
