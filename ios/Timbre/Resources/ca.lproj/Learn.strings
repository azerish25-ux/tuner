"L5dc6589c07" = "A, C a la corda 5, E i A. Després B, E, G sostingut al trast 1 de la corda 3 i B.";
"L5dd85395a1" = "Quina és la corda de G a l’aire?";
"L5de6270d77" = "Abans de cantar, sent la nota dins el cap un segon. Aquesta pausa deixa que la veu apunti a l’altura en lloc d’anar-la buscant.";
"L5ded105f41" = "Shenandoah";
"L5df3a182bb" = "Popurri folk";
"L5df42cd32b" = "Quan la mà colpeja, el polze es recolza a la cinquena corda. Al temps següent, l’empeny i la deixa anar mentre aixeques la mà.";
"L5e0badd310" = "La primera línia: D a l’aire, E, quatre G a l’aire, baixa a B a la corda 5 i torna a G.";
"L5e31a53ca0" = "La posició de D, corda per corda";
"L5e46546af1" = "Per tocar forte, cap on es mou l’arc?";
"L5e61ddbe60" = "Una nadala de Filadèlfia";
"L5ea1e1b5db" = "Ornaments a Old Joe Clark";
"L5eb3cba827" = "Divideix la pulsació en dues";
"L5ebd5cc8aa" = "Un to són dos semitons i cada trast és un semitò. C passa a D i G passa a A.";
"L5edd62cd1e" = "Entre les notes 3 i 4, i 7 i 8";
"L5ee75a46ea" = "El cop apagat és un acord curt als temps 2 i 4. Rasca avall i afluixa els dits del mànec sense separar-los de les cordes, perquè el so s’aturi de seguida.";
"L5eeb230a51" = "Agafa la pua entre el tou del polze i el costat de l’índex corbat. Deixa’n sortir només la punta. Mantén el canell relaxat, com si t’espolsessis aigua de la mà.";
"L5ef37ace42" = "On reposa la melodia?";
"L5ef3f68e90" = "La tonalitat és la llar d’una cançó. En G, els acords G, C i D fan gairebé tota la feina. Moltíssimes cançons folk i rock només fan servir aquests tres.";
"L5f0aa6a4b7" = "Sostén cada nota llarga i fes-la oscil·lar empenyent i afluixant poc i regularment. Fes-ho estret: l’altura ha d’oscil·lar, no desviar-se.";
"L5f17243700" = "Un accent té a veure amb la força, no amb la durada. Simplement toques la nota més fort.";
"L5f379602c3" = "Alterna les cordes 3 i 4";
"L5f380cb28f" = "Un refilet";
"L5f3c33cec0" = "De la nou cap a la punta";
"L5f46a3d91b" = "Fonamentals llargues i sostingudes";
"L5f5706be4a" = "Acompanyament de bluegrass";
"L5f6d14e352" = "Quines notes formen E major?";
"L5f709f471f" = "Cordes 1 i 2";
"L5f790c22cb" = "Les línies de baix de l’època Motown es movien molt: notes de l’acord, aproximacions al següent i accents fora de la pulsació. Aquesta línia és nova, escrita amb aquell esperit.";
"L5f8b0a6d18" = "D i D menor";
