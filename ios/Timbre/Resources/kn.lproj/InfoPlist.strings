"CFBundleDisplayName" = "Timbre";
"NSMicrophoneUsageDescription" = "ಪಿಚ್ ಅಳೆಯಲು Timbre ನಿಮ್ಮ ವಾದ್ಯ ಅಥವಾ ಧ್ವನಿಯನ್ನು ಆಲಿಸುತ್ತದೆ. ಆಡಿಯೊವನ್ನು ನಿಮ್ಮ ಸಾಧನದಲ್ಲೇ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಲಾಗುತ್ತದೆ ಮತ್ತು ಅದನ್ನು ಎಂದಿಗೂ ಉಳಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ.";
"NSAppleMusicUsageDescription" = "Timbre ನೀವು ಆಯ್ಕೆಮಾಡಿದ Apple Music ಹಾಡುಗಳನ್ನು ನುಡಿಸುತ್ತದೆ. ಹೀಗಾಗಿ ನಿಮ್ಮ ಸ್ವರಮೇಳದ ಚಾರ್ಟ್‌ಗಳನ್ನು ನೋಡುತ್ತಾ ಅವುಗಳನ್ನು ಕೇಳಬಹುದು.";
