"timbre_about_local_history_body" = "ಸೆಷನ್ ದಿನಾಂಕಗಳು, ಆಯ್ಕೆಮಾಡಿದ ವಾದ್ಯಗಳು ಮತ್ತು ಅಳತೆ ಮಾಡಿದ ಅಭ್ಯಾಸದ ಸಾರಾಂಶಗಳನ್ನು ಸ್ಥಳೀಯವಾಗಿ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ. ಇವು ನೀವು ವಾದ್ಯಕ್ಕೆ ಹಿಂತಿರುಗಲು ಮತ್ತು ನಿಮ್ಮ ಅಭ್ಯಾಸವನ್ನು ಪರಿಶೀಲಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ. Android ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಈ ಆ್ಯಪ್‌ನ ಸಂಗ್ರಹಣೆಯನ್ನು ತೆರವುಗೊಳಿಸುವುದರಿಂದ ಸ್ಥಳೀಯ ಇತಿಹಾಸ ಮತ್ತು ಆದ್ಯತೆಗಳು ಅಳಿಸಲ್ಪಡುತ್ತವೆ.";
"timbre_about_microphone_heading" = "ನಿಮ್ಮ ಮೈಕ್ರೊಫೋನ್";
"timbre_about_on_device_microphone_body" = "ಪಿಚ್ ಅನ್ನು ಅಂದಾಜು ಮಾಡಲು ಮೈಕ್ರೊಫೋನ್ ಧ್ವನಿಯನ್ನು ನಿಮ್ಮ ಸಾಧನದಲ್ಲಿ ವಿಶ್ಲೇಷಿಸಲಾಗುತ್ತದೆ. ಆಡಿಯೊವನ್ನು ಉಳಿಸಲಾಗುವುದಿಲ್ಲ ಅಥವಾ ಅಪ್‌ಲೋಡ್ ಮಾಡಲಾಗುವುದಿಲ್ಲ. ನೀವು ಸಕ್ರಿಯ ಟ್ಯೂನಿಂಗ್ ಅಥವಾ ಅಭ್ಯಾಸದ ಪರದೆಯನ್ನು ತೊರೆದಾಗ ಮೈಕ್ರೊಫೋನ್ ಪ್ರವೇಶ ನಿಲ್ಲುತ್ತದೆ. ನೀವು Android ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ ಪ್ರವೇಶವನ್ನು ಹಿಂತೆಗೆದುಕೊಳ್ಳಬಹುದು.";
"timbre_about_open_browser" = "ನಿಮ್ಮ ಬ್ರೌಸರ್‌ನಲ್ಲಿ timbre-privacy-shahrad.timbre.workers.dev ತೆರೆಯಿರಿ.";
"timbre_about_permanent_purchase_body" = "ಸಂಪೂರ್ಣ ವಾದ್ಯಗಳ ಸಂಗ್ರಹ, ಹಾಡುವ ಅಭ್ಯಾಸ ಮತ್ತು ಸ್ಟುಡಿಯೋ ಒಂದು ಶಾಶ್ವತ ಖರೀದಿಯ ಮೂಲಕ ಲಭ್ಯವಿವೆ, ಯಾವುದೇ ಮರುಕಳಿಸುವ ಶುಲ್ಕವಿಲ್ಲ. Google Play ಪಾವತಿ ಮತ್ತು ಖರೀದಿಯ ಮರುಸ್ಥಾಪನೆಯನ್ನು ನಿರ್ವಹಿಸುತ್ತದೆ. ನಿಮ್ಮ ಪ್ರವೇಶವನ್ನು ಮರುಸ್ಥಾಪಿಸಲು ಸೆಟ್ಟಿಂಗ್‌ಗಳಲ್ಲಿ 'ಖರೀದಿ ಮತ್ತು ಮರುಸ್ಥಾಪನೆ' ತೆರೆಯಿರಿ. ನೀವು ಈಗಾಗಲೇ ಹಳೆಯ ಚಂದಾದಾರಿಕೆಯನ್ನು ಹೊಂದಿದ್ದರೆ, ಅದರ ನಿರ್ವಹಣೆಯು Google Play ಮೂಲಕ ಲಭ್ಯವಿರುತ್ತದೆ.";
