"L6153371910" = "3 skirsnis priklauso antro piršto sričiai – 3 ir 4 skirsniams.";
"L616a1bd784" = "Džiazo muzikantai paprastai prideda septimas: Dm7, G7, Cmaj7. Papildomos natos dar labiau sušvelnina kiekvieną perėjimą. Pagrindiniai tonai ir kelias namo lieka tie patys.";
"L616b46e903" = "Ode to Joy, antroji eilutė";
"L6181145819" = "Laikykite mediatorių arti stygų, o kirčius – tolygius. Greitis ateis vėliau, kai judesys bus laisvas.";
"L6191fba215" = "Ką daro įžanga?";
"L61992ffcfb" = "2 styga, 4 skirsnis";
"L61a7fd6fc3" = "Visos mažorinės gamos laikosi vienos žingsnių formulės: tonas, tonas, pustonis, tonas, tonas, tonas, pustonis. Pradėkite bet kuria nata, sekite ją ir sudarysite mažorinę gamą.";
"L61ac361d21" = "Kas yra pozicijos keitimas";
"L61b524f257" = "Aukštis smunka trūkstant oro. Baigdami kiek anksčiau visą natą išlaikysite tikslią.";
"L61d442d352" = "Priedainis aukštai: D ties 2 stygos 3 skirsniu, C diezas ties 2, laisva B, tada žemyn į laisvą D.";
"L61da910eb5" = "Angeline the Baker";
"L61e018ea94" = "Trumpi kirčiai ir D9";
"L61e1dfe135" = "Penkios supaprastintos tradicinės bendro grojimo melodijos: nuo „Boil Them Cabbage Down“ iki „Old Joe Clark“.";
"L61ec307304" = "1 pirštą dėkite ties 2 skirsniu, kiekvienam pirštui skirkite po skirsnį iki 5. Nuo G 6 stygoje ties 3 skirsniu gama kyla per 6, 5 ir 4 stygas.";
"L61ee1ab807" = "Kur po atraminio užgavimo sustoja pirštas?";
"L61f1c8da71" = "Numeruokite gamą nuo G: G yra 1, A – 2 ir taip iki F diezo, 7. Muzikantai šiais skaičiais aptaria melodijas ir akordus bet kurioje tonacijoje.";
"L61fc25fa4f" = "Pirmasis dūžis";
"L62137e8c2f" = "Šešios dainos vienu prisėdimu";
"L62175f3821" = "Nieko naujo: dviejų oktavų G mažoras, gama tercijomis, A dorinė ir D miksolydinė dermės. Kiekvienam skirsniui skirkite po pirštą.";
"L621c5e6bc0" = "Ilga, trumpa po tris";
"L621f8b64c0" = "Dvylika taktų";
"L622c702c21" = "Ukulėlės dainynas";
"L623729eeb4" = "Intervalas – atstumas tarp dviejų natų. Unisonas neturi atstumo: ta pati nata dukart. Oktava veda nuo vienos raidės iki tos pačios aukščiau, kaip nuo C iki C. Skamba kaip viena nata, tik šviesiau.";
"L62490fbda1" = "Žema dalis, antra pusė";
"L625278775b" = "Ta pati pradžia, kita pabaiga. Antroji eilutė grįžta namo į C.";
"L625d141f7d" = "4 pirštas ant 1 stygos";
"L6271a044a6" = "Beethoven sukūrė šią pjesę pianinui 1810 metais, bet ji išleista tik 1867 metais, praėjus keturiasdešimčiai metų po jo mirties. Ši supaprastinta versija išlaiko garsiąją pradžią.";
"L62773cc1b4" = "Pagrokite 6, 5 ir 4 stygas po vieną.";
"L62781903b0" = "Nykščiu užgaukite 1 stygą ir leiskite jai skambėti.";
"L6281828c75" = "Pirma bendro grojimo melodija";
"L628db1ad7e" = "Taktas – viena dūžių grupė. Čia kiekviename takte keturi dūžiai, žymimi 4/4. 1 dūžis pradeda kiekvieną taktą, tad skaičiuodami jį truputį pabrėžkite.";
"L62ab25cde7" = "Grynoji kvinta";
"L62ba9ae8e4" = "G ir D apvertimai";
"L62bb50e1c3" = "Kuris akordas yra Cmaj7?";
"L62c4d6152c" = "3 pora, 2 skirsnis, pirmas pirštas.";
"L62d40dd812" = "Pirmas pirštas ties 2 stygos 1 skirsniu, antras ties 3 stygos 2 skirsniu. 4 ir 1 stygos skamba laisvos. Penktos negrokite; jos G kertasi su D7.";
"L62f0a6aab6" = "Viena pora lėtai pulsuoja. Kas negerai?";
"L62fa3abe46" = "Dvi kryptys";
"L62fb1d70f8" = "1 pirštas spaudžia 5 stygą ties 3 skirsniu ir guli skersai iki 1 stygos. 3 pirštas spaudžia 4 stygą, 2 pirštas – 3, 4 pirštas – 2.";
"L630868a13b" = "Šis iššūkis jungia lygas ir taškus. Kiekvieną aštuntinę skaičiuokite garsiai; laikoma nata vis tiek užima visą savo laiką.";
"L6311ef1e1f" = "Trys dūžiai: pusinė (2) ir jos taškas (1).";
"L63190e07e0" = "Iki įrašų šeimos dainuodavo šias dainas namie prie fortepijono. Čia jos eina viena po kitos, o baigia didinga Holst melodija.";
"L632198cb87" = "Klasikinės temos II";
"L63233a5412" = "Unisonas, oktava, kvinta ir kvarta – kiekvienas intervalas siejamas su niūniuojama melodija.";
"L6335412816" = "Kuriais pirštais grojamas D mažoras ant kiekvienos stygos?";
"L634209dd7c" = "Kiekviena nata čia yra ketvirtinė, pusinė arba sveikoji. Skaičiuokite keturis lygius dūžius takte ir leiskite ilgoms natoms skambėti.";
"L6355e11493" = "D, E, F: trys raidės.";
"L63881ab90d" = "I, IV ir V";
"L638f400164" = "Sinkopė perkelia akcentą tarp dūžių. Pradžioje kiekviena C tenka „ir“. Skaičiuokite vienas-ir-du-ir ir pajuskite, kaip C traukia pirmyn.";
"L639b70b19b" = "Kalnų minoras";
"L63a15ae368" = "2 stygos 1 skirsnį";
"L63a5f6c540" = "Abu akordai spaudžia 3 ir 2 stygų 2 skirsnį. Keičiasi tik išorinės stygos.";
"L63abb5650f" = "Septyni";
"L63b4995f45" = "Unisonas ir kartojimai";
"L63b5f26523" = "Šešių aštuntinių metre ketvirtinė ir aštuntinė sudaro vieną didelį dūžį: ilga, trumpa. Skaičiuokite vienas-du-trys, keturi-penki-šeši ir grokite ties vienu, trimis, keturiais bei šešiais.";
"L63bb4a431f" = "Didesnis spaudimas linkęs kelti aukštį, o labai tylios natos gali nusmukti per žemai. Abiem atvejais stebėkite natą.";
"L63d01fe4fe" = "Per vidurį tarp tiltelio ir grifo";
"L63dcadbd78" = "Penkios melodijos iš eilės, po vieną frazę. Įkvėpkite per kiekvieną pauzę, kartojamas natas pradėkite iš naujo.";
"L63e8cf2011" = "Kas yra tonu aukščiau už B?";
"L63f358c905" = "Tai sunkiausia dalis";
"L640134fefa" = "A pora veikia taip pat: laisva – A, 2 skirsnis – B, 4 skirsnis – C♯, 5 skirsnis – D. Ranka lieka vietoje.";
"L640b18da1f" = "Klasikos popuri";
"L6416c8c03f" = "Leidžiasi";
"L641a2740f3" = "Melodija";
"L6425315084" = "Su pirmu ir trečiu dūžiu";
"L6439513619" = "Kuris žodis pirmame posme tęsiasi per dvi natas?";
"L644b2e3eb5" = "Ant skirsnių";
"L6455adb054" = "Jūsų solo";
"L6478bdaaa1" = "Giesmių popuri";
"L647e4d73c5" = "Aukštyn ir namo";
"L648307a100" = "Kada braukiama aukštyn?";
"L64846fd98f" = "Gitaros solo";
"L648ac30e5c" = "Mažasis F, D7 ir dvi tradicinės dainos su akordais ir melodija.";
"L648bfd8404" = "Salų ritmas keičiant akordus";
"L649b215476" = "3 pora: laisva, 2 skirsnis, 4 skirsnis, 5 skirsnis.";
"L64afb60dbd" = "Ką darote per pauzę?";
"L64e238b935" = "Ties 1 ir 4";
"L64e6a5eeed" = "Ši versija yra E minoro tonacijoje, pirmoje pozicijoje: melodija juda per keturias stygas 1–4 pirštais, o akordų schema skirta tam, kas groja kartu su jumis.";
"L64e9fb8ad9" = "Pagrokite ar padainuokite du baltų klavišų pustonius: E į F, tada B į C.";
"L64f341465b" = "Laisva 3, 2 stygos 1 skirsnis, laisva 1, 2 stygos 3 skirsnis, 1 stygos 1 ir 3 skirsniai.";
"L6501930589" = "Natos sutampa ar skiriasi?";
"L650634caa9" = "Kurią laisvą stygą atitinka 2 stygos 3 skirsnis?";
"L6509372805" = "Daina: Halogen";
"L6512fd6029" = "Pagrindinis tonas, tercija, kvinta";
"L651aaf0899" = "Kiekvienas bakstelėjimas turi vardą";
"L653eb46bda" = "Violončelė palinkusi atgal į krūtinę, o keliai lengvai prilaiko ją iš šonų.";
"L654648b7f9" = "Groja tik per 1 dūžį";
"L655060742f" = "Nereikalingą pirštą pakelkite ir naują dėkite, kol dar skamba paskutinis braukimas. Žvilgsnį nukreipkite į kitą akordą.";
"L65572eaf06" = "Stephen Foster sukūrė šią lenktynių dainą 1850 metais, dvejais metais po „Oh! Susanna“. Naudojamos tos pačios natos ir tie patys du akordai.";
"L656206b093" = "Kiek A taktų pradeda 12 taktų bliuzą?";
"L65626dc943" = "Ši melodija išspausdinta 1582 metais Suomijos dainyne „Piae Cantiones“ kaip daina apie pavasarį. John Mason Neale suteikė jai kalėdinius žodžius 1853 metais.";
"L65790ce0d0" = "12 taktų bliuzas";
"L658534e988" = "Aštuntinėmis aukštyn iki A";
"L6586ce1f1f" = "„Amazing Grace“ takte yra trys dūžiai. Kiekvieną ilgą natą grokite tremolo, o natas keiskite tiksliai su dūžiu. Dvi natos naujos: A ir B ant G poros.";
"L65a24ccc47" = "Antra pusė prasideda aukštai: ketvirtas pirštas siekia B ant E stygos. Tada trečias, tada žemas 2.";
"L65b5eedd25" = "Pirmųjų natų pynė";
"L65da260ff1" = "Dabar storiausia styga, C. Leiskite jai gausti.";
"L65dc0bc434" = "G, H";
"L65fc8eeea6" = "Maždaug tiek pat";
"L66059b65aa" = "Paprastame A minore yra F. Dorinė dermė išlaiko G mažoro F diezą – šviesų tašką minorinėje gamoje.";
"L661b9e9f2e" = "Viena pozicija visai sekai";
"L661f67974f" = "Ji pakeičia priedainį";
"L66239be110" = "Unisonas – ta pati nata";
"L6636558793" = "Sėdėkite tiesiai, kojelė nustatyta, stryką laikote laisvai, jis per vidurį tarp tiltelio ir grifo. Dabar sugrokite viską iš šio skyriaus.";
"L664305ffb2" = "Nuo D iki F praleidžiama E, tad tai šuolis – tercija.";
"L6643ee2897" = "F ir C";
"L664688a0e9" = "Dermė po dermės";
"L6646d01d84" = "Popmuzika 6/8 metru";
"L6651a17acc" = "Laisva D, E ir F diezas 4 stygoje, tada šuolis iki D 2 stygos 3 skirsnyje ir žemyn C diezas, B ir A.";
"L66573d54aa" = "Dviem šuoliais aukštyn";
"L6693552855" = "Vaikštantis bliuzas A tonacijoje";
"L66a2e1bb47" = "Visas dainynas ukulėlės tonacijomis nuo pradžios iki galo";
"L66ae417c89" = "Ties skaičiumi – žemyn, ties „ir“ – aukštyn. Per dūžį ranka po kartą juda žemyn ir aukštyn.";
"L66ba679c70" = "Raskite pulsą, skaičiuokite iki keturių ir stuksenkite laiku.";
"L66d9448f4d" = "„Static on Channel Nine“ – pankrokas: keturi jėgos akordai, delnu slopintos aštuntinės, 104 dūžiai per minutę. Posmas murma žemomis natomis, priedainis – minios šūksnis, tad grokite drąsiai.";
"L66fa22185a" = "Aštuntinė nata trunka pusę dūžio, tad į dūžį telpa dvi. Grokite mažais, greitais judesiais ties stryko viduriu.";
"L66fbb37faf" = "Pereinate prie kitos poros ties „ir“. Kokia kryptimi braukiate?";
"L670d6914c0" = "Akordai nustato tonaciją, tada skamba viena nata. Pirma raskite do, tada įvardykite natą. Visos tonacijos veikia taip pat.";
"L670e7fd853" = "Per žemai reiškia žemiau natos, tad truputį pakelkite aukštį.";
"L671c1ff474" = "Pirma frazė baigiasi nata su tašku. Koks pojūtis?";
"L67278e4178" = "Posmas ir priedainis";
"L672fd54460" = "C mažoras, antra oktava: antras pirštas F ir viršutinei C.";
"L6739b9a584" = "Prieštaktis ir pirmas taktas: laisva G, A ties 2 skirsniu, tada laisva B, D ties 3 skirsniu dukart ir laisva E.";
"L67684dd3f9" = "Dainai Mary Had a Little Lamb reikia trijų natų: laisva 2 styga yra B, 3 stygos 2 skirsnis – A, o laisva 3 styga – G. A grojate antruoju pirštu.";
"L67695d722e" = "Atsakykite rifui";
"L676e1e1bc9" = "3 dūžis";
"L677297f490" = "Pradžia: D, G, B G, B, A. Laisvos 4, 3 ir 2 stygos ir dar A.";
"L6776fd531f" = "Stumia trys pirštai";
"L6777925e65" = "1 pirštą dėkite skersai 3, 2 ir 1 stygų ties 2 skirsniu, tada 3 pirštu pasiekite 4 stygos 4 skirsnį.";
"L67920ab8cb" = "Vienu skirsniu žemiau";
"L67a8f1045a" = "Sekant formulę nuo D, 3 nata yra F♯, o 7 – C♯.";
"L67baf4caa8" = "Nuo D iki F – mažoji tercija; nuo F iki A – didžioji.";
"L67c3806843" = "Ž, ŽA, AŽA";
"L67c948a825" = "Kiek pustonių nuo D aukštyn iki F?";
"L67d0dcf34e" = "Dviejų dūžių nata";
"L67db55e61d" = "Nata, nuo kurios sudaromas trigarsis, yra pagrindinis tonas. Vidurinė – tercija, viršutinė – kvinta, pavadintos pagal atstumą virš pagrindinio tono.";
"L67ef0e743a" = "Grokite garsiau";
"L67f0897e60" = "Pirmo piršto galiuką dėkite ant A stygos ties pirma juostele. Tai B, tonu aukščiau už A; tonas – du pustoniai. Spauskite, kol styga palies grifą.";
"L67f2b8db53" = "C, p-i-m-a";
"L680e20c077" = "Visiems žinomos melodijos nuo pradžios iki galo";
"L6824a5dc37" = "Skiriasi";
"L68262bf228" = "A ketvirtoje pozicijoje, laisva A, A ketvirtoje pozicijoje. Tegu skamba vienodai.";
"L68275325bd" = "Kurios stygos ši melodija visai nenaudoja?";
"L6829fbcb04" = "Nuo do iki do: nuo C aukštyn iki kitos C.";
"L6854c89618" = "Kokia nata yra 4 stygos 3 skirsnyje?";
"L6859188a0b" = "Laikykite akordą, grokite melodiją";
"L686fe0d2fa" = "1 pirštą dėkite skersai 4, 3 ir 2 stygų ties 2 skirsniu, 2 pirštą – ant 1 stygos ties 3 skirsniu.";
"L688a376adc" = "Kiek šešioliktinių telpa į vieną dūžį?";
"L689041fa42" = "Žemas 2 ir aukštas 2 ant A stygos, tada žemas 2 ir aukštas 2 ant E stygos.";
"L68a5d9377b" = "„Rooftop Choir“ – stadiono masto himnas, 92 dūžiai per minutę. Grojate priedainį C tonacijoje, tada vienas A taktas pakelia viską tonu, ir priedainis grįžta D tonacijoje.";
"L68a9c445ed" = "Pirštai su mediatoriais užgauna aukštyn";
"L68b0c5bf55" = "Iš kur atsiranda aukšta G pirmame takte?";
"L68b2b09c89" = "A♭";
"L68d4c57c61" = "Jei galite, grokite visą B minoro barė 2 skirsnyje. Jei ne, naudokite keturias aukščiausiai skambančias stygas: 4 skirsnį 4 ir 3 stygose, 3 skirsnį 2 stygoje, 2 skirsnį 1 stygoje.";
"L68d4cfda41" = "B7 traukia į E. Jo įtampa ištirpsta E minore arba E.";
"L68d6126c37" = "Kokį akordą kartu sudaro D, F♯ ir A?";
"L68d9990b7c" = "A7: tas pats triukas";
"L68dba3a68d" = "Paskutinė eilutė kyla nuo laisvos D ant 4 stygos: E, F diezas ties 4 skirsniu, laisva G, tada A.";
"L68fd09b287" = "Stiprus kairės rankos suėmimas";
"L68fd5ef7e1" = "Tempas didėja. Kokie turėtų būti bakstelėjimai?";
"L690a93e955" = "Jungiamoji dalis";
"L690aa0b88d" = "Ketvirtoje pozicijoje pirmas pirštas ant A stygos groja D – natą, kurią pirmoje pozicijoje grojo ketvirtas pirštas. Nykštys nusistovi ten, kur kaklelis lenkiasi į korpusą.";
"L690ab2befe" = "Gretimos natos";
"L6918767a98" = "Sinkopė: tarp dūžių";
"L6918c2a4bb" = "Kuri trigarsio D F A nata yra kvinta?";
"L691f903820" = "Jis nenaudojamas";
"L691f9c22d1" = "Patys akordai";
"L693752b4ae" = "Braukti toliau ir pagauti kitą akordą";
"L6941e683a3" = "Kadangi 4 styga yra aukšta G, eiga zigzaginė: aukštai, žemai, tada kylant. Tas žėrėjimas būdingas pirštais grojamai ukulėlei.";
"L694f5f09fe" = "Kur šioje dainoje reikėtų įkvėpti?";
"L6952d23be8" = "B5";
"L695d14c16d" = "Dviem skirsniais aukščiau G yra A. Akordo pavadinimas keičiasi kartu su pagrindiniu tonu.";
"L696010416e" = "Didžioji septima";
"L696cd74a3d" = "Sėdėdami tiesiai, užgaukite D, tada G. Pečius laikykite laisvus.";
"L6971957b55" = "Kiekvieno takto pradžioje vėl skaičiuojama nuo 1.";
"L6973e1fed9" = "Priedainis";
"L697ea8051a" = "Su CAGED retai reikia šokinėti. Apie 5 skirsnį G grojamas D forma, C – G forma, D – A forma. Trys akordai, viena vieta.";
"L6980bcdcd2" = "Rondo alla Turca";
"L698eca6ecd" = "Pauzė, tada bakstelėjimas ties „ir“";
"L69a3fc0ffb" = "Judinkite nuo alkūnės";
"L69acddb13a" = "Nieko naujo: po pirštą stygai, eiga pirmyn ir atgal, kaitaliojantis nykštys ir melodija akordo viduje.";
"L69ba79c271" = "Pozicijų keitimo patikra";
"L69c68aba96" = "„Speed, bonnie boat, like a bird on the wing“: laisva D, E, D, trys laisvos G, tada A, B, A ir aukštyn iki D.";
"L69d4feab52" = "Šokti gerokai aukštyn";
"L69d6c14191" = "Slow Motion Strobe – Timbre originalus synth-pop A tonacijoje su F diezo minoru, D, A ir E. Pozicija ties 2 skirsniu tinka visai sekai: A mažorinė pentatonika kartu yra F diezo minorinė. Visa daina – „Dainos“, „Originalios dainos“.";
"L69db2318a3" = "Prekeivių daina";
"L69dca66da6" = "Padalykite kiekvieną dūžį į dvi dalis ir skaičiuokite „ir“.";
"L69dd77610a" = "3 styga: 2 ir 4 skirsniai. Užgaukite kartą, tada 3 pirštu užkalkite ir nuplėškite.";
"L69e8d3e991" = "Kuri laisva styga groja žemiausią natą?";
"L69f444cda2" = "Trys natos sudaro akordą";
"L6a0141eeb5" = "Dainos viduryje suklydote keisdami akordą. Ką daryti?";
"L6a04869038" = "Kaitaliokite bosą";
"L6a06751695" = "Pirmieji akordai";
"L6a09029e91" = "V į I – muzikos taškas.";
"L6a1333dc6b" = "Brahms' Lullaby";
"L6a266df3b3" = "Šis keturių akordų ratas skamba daugybėje popdainų. C mažore tai C, G, A minoras, F. Minorinis vi prideda truputį šešėlio, prieš IV vėl pakylėjant namų link.";
"L6a3f43a116" = "Atvirieji ir perkeliami jėgos akordai, slopinimas delnu ir savas rifas.";
"L6a44f899d9" = "Kuris akordas 12 taktų bliuze skamba 9 takte?";
"L6a4544fbab" = "Pirštai, suspausdami";
"L6a490b5529" = "F – apatinė nata, nuo kurios sudarytas trigarsis.";
