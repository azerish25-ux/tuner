"L6be91b6851" = "Lặp âm gốc";
"L6c09947fc9" = "Nốt nào thuộc G trưởng?";
"L6c0db1e116" = "Cả hai đặt âm ba dưới cùng: dây 3 cao hơn một ngăn, hai dây kia ngang nhau. Cùng thế, cách năm ngăn.";
"L6c0e1d8958" = "2 cao trên dây D";
"L6c116fd3ab" = "Đoạn trio";
"L6c33fc06dc" = "Nhấn dây và rung";
"L6c3a5b85c6" = "E trưởng: thêm một ngón";
"L6c3e7e3c76" = "Tay phải quyết định vĩ chơi dây nào. Mỗi dây có độ cao tay riêng như bậc thang. Chuyển cả cánh tay, không chỉ bàn tay.";
"L6c491db365" = "Ốc nhỏ trên đuôi đàn để chỉnh tinh. Vặn thuận chiều kim đồng hồ nâng cao độ, ngược chiều hạ xuống. Một phần tư vòng là đủ.";
"L6c5383ef15" = "Bụng và phần sườn dưới";
"L6c5d28d3ad" = "Đu quay lúc đóng cửa xoay trong nhịp ba, như vòng quay hội chợ chậm dần: oom-pah-pah ở 96 phách mỗi phút. Đếm một, hai, ba, nhấn vào một.";
"L6c65dbe5e7" = "Cecil Frances Alexander (1848)";
"L6c65f3cae3" = "Một phách chứa bao nhiêu nốt liên ba?";
"L6c6c38ee17" = "Nửa sau";
"L6c79a5739e" = "Khám phá: Shuffle miền công nghiệp";
"L6caa2001f9" = "Nhấc thẳng chỉ làm nốt tắt. Móc nhẹ sang bên gảy dây buông.";
"L6cc385b2c8" = "Dây E và A";
"L6cca5c6c7d" = "Bum-ditty trên C";
"L6ccca6a2ed" = "Ô bốn phách có một trắng, một đen. Điền gì vào chỗ trống?";
"L6ce6fb0543" = "Xuống về phía sàn";
