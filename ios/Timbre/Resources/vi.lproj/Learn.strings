"L6e1bf8743d" = "Khóa fa là khóa F: hai chấm ôm dòng F.";
"L6e293cb133" = "Các nửa cung";
"L6e2d3f0b55" = "Dây 5 đếm từ A: B ở 2, C ở 3, C thăng ở 4.";
"L6e4a00070b" = "Khám phá: Trời đẹp thả diều";
"L6e5c726d4d" = "Mẫu ba nốt lặp qua ô tám nốt làm điểm nhấn đổi mỗi lần. Đó là cảm giác cuốn.";
"L6e6a60a89b" = "Do re do";
"L6e7163b180" = "Quạt valse";
"L6e7ab92ea9" = "Nốt móc đơn dài nửa phách, nên mỗi phách có hai nốt. Tám nốt móc đơn lấp đầy một ô nhịp 4/4.";
"L6e7ad389a8" = "G buông, E ở ngăn 2 trên dây 4, A ở ngăn 2 trên dây 3, G, rồi C ở ngăn 1 trên dây 2, C, B buông và C.";
"L6e7c200b38" = "Giữ thế E thứ, thêm ngón thứ nhất vào dây 3, ngăn 1. Chỉ một nốt ấy biến thứ thành trưởng.";
