"L0009cb1a16" = "Một dây nghe đục. Nguyên nhân thường là gì?";
"L00130a44b5" = "Chạm mà không bấm xuống sẽ ngăn dây ngân. Lần quạt biến thành tiếng gõ sắc, gọn.";
"L0015244e3f" = "G7 giữ G trầm nhưng đặt F trên cùng: ngón 3 trên dây 6, ngăn 3; ngón 2 trên dây 5, ngăn 2; ngón 1 trên dây 1, ngăn 1.";
"L0017247d59" = "Âm nào là G7, hợp âm căng hơn?";
"L001a8a4e76" = "Nốt do ngón 1 bấm trên dây 3, ngăn 1 chính là nốt giúp hợp âm trở thành E trưởng.";
"L0024a55a06" = "Điệu shuffle";
"L002ba346f7" = "Dây 3: ngăn 2, ngăn 3, ngăn 5.";
"L002e2c331d" = "Phác đường nét";
"L002fe27c72" = "Dây đồng được xây trên một câu riff: nét nhạc ngắn, bắt tai trên dây thấp mà cả ban nhạc bám theo. Bài ở 112 phách mỗi phút, giọng E, với hợp âm power trong điệp khúc.";
"L00398ce342" = "Chặn dây 5 đến 1 ở ngăn 10, đặt ngón 3 ngang dây 4, 3 và 2 ở ngăn 12. Đó là thế A chặn, lại là G.";
"L00573ce6a3" = "Kẹp capo";
"L006392a6a7" = "Quãng ba";
"L0074f77ab6" = "Nốt thứ bảy G trưởng là F♯.";
"L0077cab0a8" = "Sousa viết hành khúc cho dàn quân nhạc. Mùa xuân dành cho violin và dàn dây, còn rondo dành cho piano.";
"L007b8bf14c" = "Đếm 1 2 3, 1 2 3, nhấn vào 1. Đây là nhịp valse. “Clementine”, in lần đầu năm 1884, đung đưa nhịp ba.";
"L008b7d6e79" = "D thăng nằm dưới E một ngăn. Nửa cung ấy hút mạnh về âm chủ, nên Greensleeves dùng nó ở mỗi chỗ kết.";
"L008b914131" = "Loạt bài hợp âm mở";
"L008ec0fe41" = "Hát thấp hơn một chút";
"L00b1aaa1ac" = "John Philip Sousa viết hành khúc này cuối năm 1896, xuất bản năm 1897. Đây là hành khúc quốc gia chính thức của Hoa Kỳ. Phần này là giai điệu trio rộng lớn của bài.";
"L00b6eb7b38" = "Trời đẹp thả diều là pop tươi sáng, dễ chơi: vòng bốn hợp âm G, D, E thứ và C, ở tốc độ thư thái 88 phách mỗi phút. Nghe câu nhạc chủ đạo nhảy lên F thăng ở ô thứ hai.";
"L00db96471b" = "Giữ trong đầu";
"L00f131a2fc" = "Sáu phách bằng nhau";
"L00f1e4a733" = "D ở ngăn 3 trên dây 2 và dây 4 buông đều là D. Chúng cách nhau bao xa?";
"L00f5a8d2df" = "Ragtime, hành khúc và sân khấu";
"L0100ebed8a" = "Thân gỗ chạy từ gốc vĩ, nơi cầm, đến đầu vĩ. Lông đuôi ngựa căng giữa hai đầu. Vặn ốc đến khi vừa lọt bút chì giữa lông và thân.";
"L0101b7221e" = "Bass bước trong D và E";
"L010a5a3a68" = "Dưới câu “frost-y wind made moan”, hợp âm chuyển A thứ sang D7, tạo sức hút đưa câu về G.";
"L011468ba58" = "Hai nốt trong một vĩ nghĩa là mỗi nốt nửa vĩ. Tính trước, bắt đầu luyến khi còn đủ vĩ cho cả hai nốt.";
"L011d756661" = "C E G, F A C, G B D đều có quãng ba trưởng dưới.";
"L0124abba92" = "Đoạn hát đặt nhiều từ trên cùng một nốt. Giữ mỗi F thăng ngắn và đều, để lời dẫn câu.";
"L0129c1441b" = "Ở 1, 3 và 5";
"L013fea348d" = "G, A";
"L015e6a69e5" = "Hai lần mỗi giây";
"L016652736c" = "Nốt cuối ở bậc âm giai nào?";
"L018f21ccb1" = "Quạt hợp âm hai lần";
"L0191c4f678" = "Lại ở A";
"L019766279b" = "Các nửa cung nằm ở đâu trong âm giai trưởng?";
"L0199b663ee" = "Câu nhạc 1";
"L01a4a05447" = "Đếm từ C";
"L01aa1069e8" = "Chủ đề cuối";
"L01bda6585d" = "G trưởng hai quãng tám ở ngăn 2, bậc âm giai và hợp âm, điệu thức Dorian và Mixolydian.";
"L01c6956f6f" = "Ngón nào chơi gì";
"L01cacb6e6a" = "Chỉ gõ vào những tiếng “và”";
"L01d1af9aef" = "Nửa cung hay một cung?";
"L01d8ca79df" = "Opera Carmen của Georges Bizet ra mắt ở Paris năm 1875. Khúc dạo đầu mở bằng hành khúc rộn ràng này, rồi chơi giai điệu Bài ca đấu sĩ bò tót nổi tiếng.";
"L01e269d40a" = "Quãng hai, ba, sáu, bảy có cỡ trưởng, thứ. Thứ luôn nhỏ hơn trưởng một nửa cung.";
"L01e81b91bc" = "Điểm tựa";
"L01e9d574a3" = "Rung không cứu được nốt sai; chỉ thêm màu cho nốt đúng. Đa số người chơi thêm rung khi ngón vào đúng cao độ không cần dò.";
"L01ee5b3bac" = "Ti chỉ thấp hơn do nửa cung nên hướng mạnh tới nó.";
"L020232021d" = "Tăng tốc cho đến khi đều";
"L0213925244" = "G cao buông thuộc hợp âm C nên để ngân. Trong các bài này không bấm dây ấy.";
"L0213e2ea6e" = "Bài hát trở về hợp âm chủ. Trong F, đó là F.";
"L022a274f11" = "Danh sách nào đi xuống?";
"L023748ecd0" = "Ân điển diệu kỳ, nửa đầu";
"L023da003cb" = "Ô nhịp 11 và 12 thường có đoạn quay vòng, câu ngắn dẫn về đầu. Câu này đi từ A xuống E, mỗi lần một ngăn.";
"L023e171007" = "Những ngón đầu: A và E";
"L023f7f5a8c" = "G đến B rồi về phải đổi dây. Đưa khuỷu mượt mà.";
"L0241523d12" = "Nghe một nốt, hát lại và di chuyển từng bậc nhỏ.";
"L025497d15a" = "Nhóm hai";
"L025c45471b" = "Đếm lên âm giai từ C: C, D, E, F. F là nốt thứ tư, nên F là hợp âm IV.";
"L026036a0e5" = "Ở mọi tiếng và";
"L0268cd2c6e" = "Một ngón, hai ngăn";
"L028703cd0b" = "Còn âm này?";
"L028ca831a9" = "Trong câu ấy, C vang một phách rưỡi và D chen vào ở tiếng “và” của bốn. Đếm một, hai, ba, bốn-và.";
"L0297ac2321" = "Xuống-lên, lên âm giai";
"L029fad523d" = "Ngón thứ tư cao hơn thứ ba một cung. Trên dây D là A, cùng nốt với A buông. Giữ ngón cong, để tay nghiêng về phía ngón.";
"L02bc9eff1a" = "Ở giọng B thứ";
"L02c33b1967" = "Thả lực bấm, ngón vẫn trên dây. Nốt dừng không rè.";
"L02ed0975aa" = "Mỗi hợp âm xây trên một nốt, âm gốc. Âm gốc của hợp âm A là A. Bass chơi âm gốc để ban nhạc biết điểm tựa.";
"L03016009de" = "Thử thách nốt và chữ";
"L0301e70c80" = "C thứ";
"L0306da2b91" = "Bum, dit, ty: ty luôn là ngón cái trên dây thứ năm ngắn.";
"L030d0d05a0" = "G, D, E thứ, C";
"L032ccbe9b9" = "Phách là nhịp đập đều đặn mà bạn nhịp chân theo. Nó không vội cũng không chậm lại, như bước chân đi dạo thong thả. Mọi tiết tấu đều dựa trên phách.";
"L0335a6785b" = "Âm gốc trên dây 5";
"L0345d17207" = "Gảy dây 3 buông. Đó là G.";
"L035e66b640" = "Thấp hơn D một cung là gì?";
"L0371438f82" = "C3";
"L037f025d31" = "Ánh đèn ma là ballad chậm, tối ở giọng A thứ, 70 phách mỗi phút. Đoạn hát chìm từ A thứ qua F và C tới E trưởng, rồi bị hút mạnh về A thứ.";
"L038dcfc2fa" = "Hỡi các tín hữu, hãy đến";
"L03909ad236" = "Không hợp âm nào";
"L03bb0a5896" = "Dây 3: ngăn 2, 3 và 5.";
"L03c23e6b0b" = "Câu nhạc ngọt ngào";
"L03c936bf04" = "E tới F là một nửa cung.";
"L03e4b8ba68" = "Mỗi câu có cặp dài-ngắn: nốt đen chấm dôi rồi móc đơn nhanh, như ở “-er, my” và “God, to”. Để nốt dài hướng vào nốt ngắn.";
"L0406d13e7a" = "Nằm ngang trên thân vĩ";
"L040c7ac884" = "Bài yêu thích của dàn kèn túi";
"L04178c0873" = "Dây dày nhất có âm thấp nhất. Khi chơi, dây này gần mặt bạn nhất. Ta gọi đó là dây 4.";
"L042dc4512f" = "i";
"L04304099ff" = "Làm quen với ukulele";
"L043e57dc85" = "E ở ngăn 2 trên dây 4, G thăng ở ngăn 1 trên dây 3 ba lần, F thăng ở ngăn 4 trên dây 4, E, rồi B buông.";
"L04444fb012" = "Đoạn điệp hát “O come, let us adore him” mấy lần?";
"L044767a8b1" = "Do ti do";
"L044a177de9" = "Giai điệu nào mở đầu thế này?";
"L044d7dcdd8" = "Nhóm ba";
"L045c1b7cc0" = "Nốt trên cùng đi lên hay xuống?";
"L045f70eda3" = "Chậm lại và đếm thành tiếng";
"L04677e71b2" = "C tới B♭ gồm mười nửa cung.";
"L046a35ba3a" = "Bài nào sau đây ở nhịp 3/4?";
"L0472142819" = "Ngón thứ hai ở ngăn 2 dây 4, ngón thứ nhất ở ngăn 1 dây 3. Dây 2 và 1 ngân buông.";
"L047687398f" = "Tăng tốc";
"L04784737ff" = "Phiên bản này ở giọng F. Dây thứ tư được lên cao, nên giai điệu nằm trên dây 1 đến 3, và mọi hợp âm trong bảng đều dùng thế ukulele.";
"L047f059e7a" = "C thay C♯";
"L0488810a08" = "Nốt kéo dài một phách là nốt đen. Bốn nốt đen lấp đầy một ô nhịp 4/4, nên gõ mỗi phách nghĩa là gõ nốt đen.";
"L048e4dae0c" = "Ngồi cùng cello";
"L04a44d6f06" = "Blues 12 ô nhịp là một khung hợp âm dài mười hai ô nhịp, làm nền cho vô số bài blues, rock và jazz. Nó dùng I, IV và V, thường đều là hợp âm bảy át để tạo màu blues.";
"L04b6e2feff" = "C tới D và F tới G";
"L04ba3fc545" = "Gảy trước";
"L04cd34e7dd" = "A thứ là thế E dịch sang dây mảnh hơn: ngón 2 và 3 ở ngăn 2, ngón 1 trên dây 2, ngăn 1.";
"L04df911481" = "Hợp âm bảy át";
"L04e51c7ae2" = "Thử thách nốt đầu";
"L04e8a55b79" = "Ngón thứ ba: D";
"L04f8cd7955" = "Gõ theo tiếng click";
"L051485fbea" = "Một phím, hai tên";
"L051d8c7d10" = "Quãng bảy trưởng";
"L051e1dcbb4" = "Blues 12 ô nhịp mở đầu bằng bao nhiêu ô I?";
"L0521b1782d" = "Radio lúc triều xuống là reggae thư thái ở 80 phách mỗi phút. Guitar chỉ chơi ở tiếng “và” của mỗi phách, một tiếng chặn ngắn gọi là skank, trong khi bass và trống giữ phách.";
"L0532d7cb1e" = "Giai điệu trên dây 3 và 4";
"L0538d50d6e" = "Ba bài từng được gia đình hát quanh piano, rồi Sao Mộc của Holst.";
"L0548676f4d" = "Âm gốc, âm năm, quãng tám";
"L05496b6432" = "E tới F chỉ nửa cung";
"L0561798932" = "Làm sao ngắt rõ nốt bấm?";
"L05652cf34f" = "F thăng bằng ngón 4";
"L0567c9ef33" = "Giai điệu Anh này đã hơn 400 năm tuổi. Các hợp âm đều quen thuộc: A thứ, C, G, E thứ, F và E. Bài có nhịp ba: quạt mỗi ô nhịp một lần, rồi mỗi phách một lần.";
"L0572eb5f3f" = "Bạn nghe thấy vòng hợp âm nào?";
"L059dd7492f" = "Loạt bài kể chuyện";
"L05a0c1c0fd" = "Ballad gảy ngón";
"L05a2271256" = "A giảm";
"L05b1593cdf" = "C, A, G, E và D: năm thế mở mọi hợp âm trưởng có thể mượn ở bất kỳ đâu trên cần.";
"L05ba0eb344" = "Một-và, hai-và";
"L05cc7ef8cf" = "Bài ca lửa trại và dân ca với bảng hợp âm dễ, để chơi hoặc đệm hát.";
"L05ccceedd1" = "Luôn to hơn";
"L05ccf6d485" = "Ô thứ hai giữ tiết tấu ô đầu nhưng đổi một nốt. Vì sao?";
"L05d69233ea" = "Ca Giáng sinh dân gian";
"L05e740748b" = "Sang dây tiếp theo";
"L0602e15d9e" = "Đều đặn và ổn định";
"L06057c47cb" = "Bạn nghe quãng nào?";
"L0617b17c54" = "C7: một ngón";
"L061a989771" = "F chỉ là khởi đầu";
"L0620855030" = "Nốt mới: F thăng";
"L062484b438" = "Hợp âm ba dọc cần";
"L062787aa32" = "Cao hơn";
"L0656355e15" = "Trong D trưởng, ngón nào chơi C thăng?";
"L065919aae8" = "C trưởng từ dây 5, lên G trên dây 1.";
"L065dc33b0f" = "A buông, B, chuyển ngón thứ nhất lên D, rồi E bằng ngón thứ ba.";
"L066423f08b" = "Leo từ dây 6 buông: F thăng ở ngăn 2, G ở ngăn 3, A buông, B ở ngăn 2.";
"L0674eef56c" = "Quãng ba bốn nửa cung là trưởng, như C tới E. Ba nửa cung là thứ, như C tới E♭ hoặc A tới C.";
"L068982656c" = "F nhỏ";
"L06aa39bbd4" = "Bài mới với hợp âm mở: pop bên lửa trại, ballad, folk giậm chân, reggae và country.";
"L06aa3b37b8" = "Ngăn 5, ngăn 8 trên dây 6, rồi ngăn 5, ngăn 7 trên dây 5.";
"L06b2310e15" = "Các nốt bấm của bạn: D, F, B, C.";
"L06b832525f" = "Đổi giọng lên một cung nâng mọi nốt lên…";
"L06cd2c603c" = "Dây 4 phá quy luật";
"L06d272f076" = "Kiểm tra D và G";
"L06e461da5a" = "Bỏ capo: dạo đầu";
"L06e5c2a776" = "Chủ nhật biển mặn là reggae giọng A thứ ở 76 phách mỗi phút. Guitar chơi hai tiếng chặn ở hai và bốn, chk-a, chk-a, trong khi trống dồn sức vào ba.";
"L06e8a4031a" = "Greensleeves, đoạn hát";
"L06ed945364" = "Mỗi cặp phải khớp máy chỉnh âm và khớp nhau. Nếu hai dây lệch, bạn nghe dao động chậm. Chỉnh một dây rồi đưa dây kia tới cùng nốt.";
"L06f797893d" = "Bài nào đếm theo nhóm ba?";
"L0709783dc0" = "Cường độ: to và nhỏ";
"L070e348de7" = "Ngón 1 trên dây 3";
"L070fa0c272" = "A trưởng dùng G♯. Hạ xuống G tạo âm sắc Mixolydian phổ biến trong nhạc cổ truyền và bluegrass.";
"L0712a01674" = "C tới G";
"L0732398ea5" = "Không cách: cùng cao độ";
"L07387ec03e" = "Giữ những nốt dài";
"L073ebc6d51" = "Cùng tên, cao hơn một quãng tám";
"L0749856ea5" = "Cặp 4, ngăn 2 bằng ngón thứ nhất, ngăn 4 bằng ngón thứ hai.";
"L0784f2a75e" = "Giữa các nốt ngón cái, ngón nào gảy dây 3?";
"L078f873444" = "Chia vĩ đều";
"L079265d880" = "Ngón thứ nhất ở ngăn 2 dây 1, ngón thứ hai ở ngăn 3 dây 2, ngón thứ ba ở ngăn 4 dây 3. Dây 4 ngân buông.";
"L0798e85c74" = "Trường độ nốt";
"L079b0c5c75" = "Mary Had a Little Lamb cần ba nốt: dây 2 buông B, ngăn 2 dây 3 A, dây 3 buông G. Ngón thứ hai bấm A; ngón cái gảy dây 3.";
"L07a46d953b" = "Từ đầu tới gốc vĩ";
"L07aec77f36" = "Nốt đen trên D và A";
"L07b574a082" = "Đệm swing";
"L07be9b9784" = "Ở giọng A";
"L07c33b35a8" = "Lắc hàm";
"L07c74c4f57" = "Mỗi giọng định vị ngón thứ hai. Trước khi chơi, tự hỏi: 2 cao hay 2 thấp, trên dây nào?";
"L07c90e906b" = "Nốt ở giữa";
"L07c9e258fe" = "Kiểm tra từng dây";
"L07cd0ccf75" = "Henry Francis Lyte (1847)";
"L07d8522005" = "2 và 3";
"L07e1dc41ae" = "B, G cao, D thấp, D cao, G. Tìm dây theo nốt.";
"L07ed48285a" = "Quãng hai gắn giai điệu";
"L07f4a8e116" = "Giai điệu thường xuống dưới do tới ti, la, sol. Vẫn các nốt ấy, chỉ thấp hơn. Nhiều bài bắt đầu sol dưới rồi nhảy lên do.";
"L07f8b44be5" = "Quãng hai trưởng";
"L080c0fdb23" = "Âm giai và giọng trưởng";
"L0819310447" = "Dây 2, ngăn 3, ngón thứ ba. Đó là D.";
"L0832428388" = "Không có kiến thức mới: E thứ, E, A thứ và A. Bấm rõ từng thế, rồi giữ chuyển hợp âm đều đặn.";
