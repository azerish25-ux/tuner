"L6acfb01639" = "Giờ cặp cao nhất, cặp 1.";
"L6ad11e23fa" = "Ở dấu lặng giữa các câu";
"L6adc0545bd" = "Đoạn hát đầu";
"L6afe128204" = "Ngược lại: ngón ở ngăn 2, gảy rồi kéo ngón hơi sang bên khi nhấc. Cú móc làm nốt buông bên dưới vang.";
"L6b0d31c0d5" = "m";
"L6b21c99836" = "Chỉ rê dây";
