"L5eeb230a51" = "Cầm miếng gảy giữa bụng ngón cái, cạnh ngón trỏ cong. Chỉ để lộ đầu. Thả cổ tay như vẩy nước khỏi tay.";
"L5ef37ace42" = "Giai điệu dừng ở đâu?";
"L5ef3f68e90" = "Giọng là chỗ dựa của bài hát. Trong giọng G, hợp âm G, C và D đảm nhiệm phần lớn. Vô số bài folk và rock chỉ dùng ba hợp âm này.";
"L5f0aa6a4b7" = "Giữ mỗi nốt dài, nhấn-thả nhỏ và đều để rung. Giữ biên độ hẹp: cao độ chỉ dao động, không trôi lệch.";
"L5f17243700" = "Dấu nhấn nói về độ mạnh, không phải độ dài. Nốt chỉ đơn giản được chơi mạnh hơn.";
"L5f379602c3" = "Luân phiên dây 3 và 4";
"L5f380cb28f" = "Láy rền";
"L5f3c33cec0" = "Từ gốc tới đầu vĩ";
"L5f46a3d91b" = "Âm gốc dài, ngân giữ";
"L5f5706be4a" = "Đệm bluegrass";
"L5f6d14e352" = "Nốt nào tạo E trưởng?";
"L5f709f471f" = "Dây 1 và 2";
"L5f790c22cb" = "Bass thời Motown di chuyển nhiều: nốt hợp âm, nốt hướng tới hợp âm sau, nhấn lệch phách. Câu này mới viết theo tinh thần ấy.";
"L5f8b0a6d18" = "D và D thứ";
"L5f940a5b65" = "Dm7 ở ngăn 5. Âm gốc ở đâu?";
"L5fa00666ea" = "Giờ D rồi A.";
"L5fb1db5278" = "Các quãng hai";
"L5fb4562659" = "Năm nốt, một giai điệu ngọt";
"L5fbc8a707e" = "A ngón thứ tư trên D, A buông, rồi lại ngón thứ tư. Khớp chính xác.";
"L5fbdb73163" = "Ngón thứ tư của bạn";
"L5fbe60e018" = "Đỉnh cao: ba nốt A, lên F thăng ở ngăn 2 trên dây 1, rồi E E D B D, A F thăng D.";
"L5fc3444ce4" = "Cái, trỏ, giữa";
"L5fd07fade8" = "Số giây mỗi hợp âm";
"L5fef0931cc" = "Âm gốc hay không? Nghe nốt thấp nhất.";
"L5ff6946aec" = "Ngày chợ là nhạc gốc Timbre: pop tươi sáng giọng G, nhịp nảy highlife, nhạc guitar rạng rỡ Tây Phi. Câu chủ đạo chỉ dùng nốt G trưởng nên nằm trong thế âm giai vị trí thứ hai. Bài đầy đủ ở mục Bài hát, phần Nhạc gốc.";
"L600e2dce19" = "Dây 1, ngăn 3";
"L601d7efe00" = "Đoạn điệp";
"L60229f5c78" = "Để vuốt, gảy nốt và giữ lực bấm khi trượt cùng ngón sang ngăn mới. Lực bấm duy trì âm; chỉ gảy nốt đầu.";
"L6027a15546" = "Bậc liền và nửa cung";
"L6030ff6791" = "D ở ngăn 3 trên dây 2, B buông rồi trở lại, tiếp đến E buông và F thăng ở ngăn 2 trên dây 1.";
"L603a7315ae" = "Để ngân hết";
"L603b077f43" = "Âm gốc D mở là dây 4 buông. Khi dịch lên, ngón 1 giữ nó: G ở ngăn 5. Dây 2, ngăn 8 cũng là G.";
"L60416d96dc" = "Với capo, bạn vẫn nghĩ G, C, D, những thế quen thuộc. Sơ đồ ở đây ghi hợp âm thực nghe, nên thế G với capo 2 hiện là A.";
"L6046c05006" = "“Home!” là nốt tròn: giữ D ở ngăn 3 trên dây 2 suốt ô.";
"L60486c0a4b" = "Hợp âm bảy theo cách dễ";
"L6049def04f" = "Dấu lặng cũng được đếm";
"L604ac866f0" = "Đứng thẳng, thả lỏng";
"L6053efe7e3" = "Gảy ngón mượn tên tiếng Tây Ban Nha: p là ngón cái, i trỏ, m giữa, a áp út. Đặt i lên dây 3, m lên dây 2, a lên dây 1, sẵn sàng gảy.";
"L60567af0fd" = "C, A7, D7, G7 rồi về C. Mỗi hợp âm bảy kéo sang hợp âm kế, thành chuỗi căng thẳng nhỏ. Vô số bài một thế kỷ trước dùng vòng này.";
"L6063ec8dfa" = "Điệp khúc, gảy ngón";
"L6065bcf219" = "Quãng ba đi lên âm giai";
"L60715612f0" = "G trưởng, lên và xuống";
"L608e8768cd" = "Ngón thứ ba trên dây D";
"L60948f8372" = "Phím đen, bước nhỏ nhất và nốt có hai tên.";
"L609651b67b" = "Trải qua tám tên chữ cái";
"L60db049169" = "G D A E";
"L60dea2df67" = "Làm nốt ngắn và tách rời";
"L60f61fb4e2" = "Không có kiến thức mới: E, F và G trên dây 1, B, C và D trên dây 2. Bắt đầu chậm rồi giữ tốc độ đều.";
"L60f6f7bc7e" = "Giữ con lắc tiếp tục";
"L6128108d6c" = "Cùng thế ngón trên hai dây thấp hơn, D trưởng và ba giai điệu.";
"L6129f8fd2f" = "Cả bốn dây";
"L61378dcfa1" = "Khi hợp âm đổi, ngón cái vào âm gốc mới đúng phách một. Các ngón khác vẫn gảy dây 2 và 3 như trước.";
"L613a306f82" = "Ở vị trí này, ngón nào chơi ngăn 5?";
"L613b9483be" = "Dạo đầu và solo";
"L6142dc5601" = "Trở lại chủ đề thứ hai";
"L614f875fca" = "Thế này ở ngăn 2 cũng là ngũ cung F thăng thứ nếu bắt đầu từ F thăng. Nốt bạn coi là chủ quyết định đang chơi loại nào.";
"L6152642fb8" = "Cặp 2: buông, ngăn 2, ngăn 4, ngăn 5.";
"L6153371910" = "Ngăn 3 thuộc vùng ngón thứ hai, ngăn 3 và 4.";
"L616a1bd784" = "Người chơi jazz thường thêm âm bảy: Dm7, G7, Cmaj7. Những nốt thêm vào khiến mỗi lần chuyển hợp âm càng mượt mà. Các âm gốc và hành trình trở về âm chủ vẫn không đổi.";
"L616b46e903" = "Khúc ca niềm vui, câu thứ hai";
"L6181145819" = "Giữ miếng gảy sát dây, động tác đều. Tốc độ đến sau khi cử động đã thả lỏng.";
"L6191fba215" = "Dạo đầu làm gì?";
"L61992ffcfb" = "Dây 2, ngăn 4";
"L61a7fd6fc3" = "Mọi âm giai trưởng theo một công thức: cung, cung, nửa, cung, cung, cung, nửa. Từ nốt bất kỳ, theo nó sẽ dựng âm giai trưởng.";
"L61ac361d21" = "Chuyển thế là gì";
"L61b524f257" = "Cao độ tụt khi hơi gần hết. Dứt sớm một chút giúp cả nốt giữ đúng cao độ.";
"L61d442d352" = "Điệp khúc bắt đầu cao: D ở ngăn 3 trên dây 2, C thăng ở ngăn 2, B buông, rồi xuống D buông.";
"L61da910eb5" = "Angeline the Baker";
"L61e018ea94" = "Đánh ngắn và D9";
"L61e1dfe135" = "Năm bài hòa tấu dân gian đơn giản hóa, từ Boil Them Cabbage Down đến Old Joe Clark.";
"L61ec307304" = "Đặt ngón 1 ở ngăn 2, mỗi ngón phụ trách một ngăn đến ngăn 5. Từ G trên dây 6, ngăn 3, âm giai đi lên qua dây 6, 5 và 4.";
"L61ee1ab807" = "Sau cú gảy tựa, ngón dừng ở đâu?";
"L61f1c8da71" = "Đánh số âm giai từ G: G là 1, A là 2, rồi tiếp tục đến F thăng là 7. Nhạc công dùng số này để nói về giai điệu, hợp âm trong mọi giọng.";
"L61fc25fa4f" = "Phách một";
"L62137e8c2f" = "Sáu bài trong một lượt";
"L62175f3821" = "Không có kiến thức mới: G trưởng hai quãng tám, âm giai quãng ba, A Dorian, D Mixolydian. Giữ mỗi ngón một ngăn.";
"L621c5e6bc0" = "Dài, ngắn trong nhịp ba";
"L621f8b64c0" = "Mười hai ô nhịp";
"L622c702c21" = "Tuyển tập ukulele";
"L623729eeb4" = "Quãng là khoảng giữa hai nốt. Đồng âm không có khoảng cách: cùng nốt hai lần. Quãng tám từ một tên tới cùng tên cao hơn, như C tới C. Nghe như một nốt, chỉ sáng hơn.";
"L62490fbda1" = "Phần trầm, nửa sau";
"L625278775b" = "Cùng mở đầu, khác kết. Câu thứ hai về âm chủ C.";
"L625d141f7d" = "Ngón 4 trên dây 1";
"L6271a044a6" = "Beethoven viết bản piano này năm 1810, nhưng mãi đến 1867, bốn mươi năm sau khi ông mất, nó mới được xuất bản. Phiên bản giản lược này giữ phần mở đầu nổi tiếng.";
"L62773cc1b4" = "Chơi lần lượt dây 6, 5 và 4.";
"L62781903b0" = "Gảy dây 1 bằng ngón cái, để âm ngân.";
"L6281828c75" = "Bài hòa tấu đầu tiên";
"L628db1ad7e" = "Ô nhịp là một nhóm phách. Ở đây mỗi ô có bốn phách, viết là 4/4. Phách 1 mở đầu mỗi ô, nên hãy nhấn nhẹ khi đếm đến nó.";
"L62ab25cde7" = "Một quãng năm đúng";
"L62ba9ae8e4" = "Các thế đảo của G và D";
"L62bb50e1c3" = "Hợp âm nào là Cmaj7?";
"L62c4d6152c" = "Cặp 3, ngăn 2, ngón thứ nhất.";
"L62d40dd812" = "Ngón thứ nhất ở ngăn 1 dây 2, thứ hai ngăn 2 dây 3. Dây 4, 1 ngân buông. Bỏ dây thứ năm; G chọi với D7.";
"L62f0a6aab6" = "Một cặp dao động chậm. Có gì sai?";
"L62fa3abe46" = "Hai hướng";
"L62fb1d70f8" = "Ngón 1 giữ dây 5 ở ngăn 3, chặn ngang đến dây 1. Ngón 3 giữ dây 4, ngón 2 dây 3, ngón 4 dây 2.";
"L630868a13b" = "Thử thách này kết hợp dấu nối và chấm dôi. Đếm thành tiếng từng nốt móc đơn; nốt được giữ vẫn chiếm trọn thời gian của nó.";
"L6311ef1e1f" = "Ba phách: nốt trắng (2) thêm chấm (1).";
"L63190e07e0" = "Trước thời đĩa nhạc, các gia đình hát những bài này quanh piano ở nhà. Đây là các bài nối tiếp nhau, khép lại bằng giai điệu lớn của Holst.";
"L632198cb87" = "Chủ đề cổ điển II";
"L63233a5412" = "Đồng âm, tám, năm, bốn, mỗi quãng gắn với giai điệu có thể ngân.";
"L6335412816" = "Ngón nào chơi D trưởng trên mỗi dây?";
"L634209dd7c" = "Mỗi nốt ở đây là nốt đen, trắng hoặc tròn. Đếm bốn phách đều mỗi ô và để các nốt dài ngân vang.";
"L6355e11493" = "D, E, F: ba chữ.";
"L63881ab90d" = "I, IV và V";
"L638f400164" = "Đảo phách đặt dấu nhấn giữa các phách. Trong phần mở đầu, mỗi C rơi vào tiếng “và”. Đếm một-và-hai-và và cảm nhận C kéo về phía trước.";
"L639b70b19b" = "Âm thứ miền núi";
"L63a15ae368" = "Ngăn 1 dây 2";
"L63a5f6c540" = "Cả hai giữ ngăn 2 trên dây 3 và 2. Chỉ các dây ngoài đổi.";
"L63abb5650f" = "Bảy";
"L63b4995f45" = "Đồng âm và nốt lặp";
"L63b5f26523" = "Trong nhịp sáu tám, nốt đen và móc đơn tạo một phách lớn: dài, ngắn. Đếm một-hai-ba, bốn-năm-sáu và chơi ở một, ba, bốn, sáu.";
"L63bb4a431f" = "Đẩy hơi thêm thường làm cao độ tăng, còn nốt rất nhỏ có thể tụt thấp. Hãy theo dõi nốt trong cả hai trường hợp.";
"L63d01fe4fe" = "Giữa ngựa đàn và mặt cần";
"L63dcadbd78" = "Năm giai điệu nối tiếp, mỗi bài một câu. Lấy hơi ở mọi dấu lặng và bắt đầu lại rõ ràng với nốt lặp.";
"L63e8cf2011" = "Cao hơn B một cung là gì?";
"L63f358c905" = "Đó là phần khó nhất";
"L640134fefa" = "Cặp A cũng vậy: buông A, ngăn 2 B, ngăn 4 C♯, ngăn 5 D. Tay giữ nguyên vị trí.";
"L640b18da1f" = "Liên khúc cổ điển";
"L6416c8c03f" = "Đi xuống";
"L641a2740f3" = "Giai điệu";
"L6425315084" = "Phách một và ba";
"L6439513619" = "Từ nào được hát qua hai nốt trong đoạn hát đầu?";
"L644b2e3eb5" = "Trên các phím đàn";
"L6455adb054" = "Đoạn solo của bạn";
"L6478bdaaa1" = "Liên khúc thánh ca";
"L647e4d73c5" = "Đi lên rồi trở về";
"L648307a100" = "Quạt lên rơi vào đâu?";
"L64846fd98f" = "Đoạn guitar solo";
"L648ac30e5c" = "F nhỏ, D7 và hai bài truyền thống có cả hợp âm lẫn giai điệu.";
"L648bfd8404" = "Điệu đảo với chuyển hợp âm";
"L649b215476" = "Cặp 3: buông, ngăn 2, ngăn 4, ngăn 5.";
"L64afb60dbd" = "Bạn làm gì ở dấu lặng?";
"L64e238b935" = "Ở 1 và 4";
"L64e6a5eeed" = "Phiên bản này ở giọng E thứ, thế thứ nhất: giai điệu đi qua bốn dây với ngón 1 đến 4, còn bảng hợp âm dành cho người chơi cùng bạn.";
"L64e9fb8ad9" = "Chơi hoặc hát hai nửa cung phím trắng: E tới F, B tới C.";
"L64f341465b" = "Dây 3 buông, dây 2 ngăn 1, dây 1 buông, dây 2 ngăn 3, dây 1 ngăn 1 và 3.";
"L6501930589" = "Cùng nốt hay khác?";
"L650634caa9" = "Ngăn 3 trên dây 2 khớp dây buông nào?";
"L6509372805" = "Khám phá: Halogen";
"L6512fd6029" = "Âm gốc, ba, năm";
"L651aaf0899" = "Mỗi lần gõ đều có tên";
"L653eb46bda" = "Cello tựa về ngực, đầu gối giữ nhẹ hai bên.";
"L654648b7f9" = "Chỉ chơi ở phách 1";
"L655060742f" = "Nhấc ngón không cần, đặt ngón mới khi lần quạt cuối còn ngân. Nhìn trước tới hợp âm tiếp theo.";
"L65572eaf06" = "Stephen Foster viết bài ca đua ngựa này năm 1850, hai năm sau Oh! Susanna. Bài dùng cùng các nốt và cùng hai hợp âm.";
"L656206b093" = "Blues 12 ô mở đầu bằng mấy ô A?";
"L65626dc943" = "Giai điệu này được in năm 1582 trong Piae Cantiones, một tập bài hát từ Phần Lan, với lời về mùa xuân. John Mason Neale viết lời Giáng sinh cho nó năm 1853.";
"L65790ce0d0" = "Blues 12 ô nhịp";
"L658534e988" = "Móc đơn lên A";
"L6586ce1f1f" = "Ân điển diệu kỳ có ba phách mỗi ô. Rê suốt từng nốt dài, đổi nốt đúng phách. Hai nốt mới: A và B trên cặp G.";
"L65a24ccc47" = "Nửa sau bắt đầu cao: ngón thứ tư vươn tới B trên dây E. Rồi ngón thứ ba, rồi 2 thấp.";
"L65b5eedd25" = "Liên khúc các nốt đầu";
"L65da260ff1" = "Giờ dây dày nhất, C. Để âm trầm vang.";
"L65dc0bc434" = "G, H";
"L65fc8eeea6" = "Khoảng thời gian tương đương";
"L66059b65aa" = "A thứ thường có F. Dorian giữ F thăng của G trưởng: điểm sáng trong âm giai thứ.";
"L661b9e9f2e" = "Một thế cho cả vòng";
"L661f67974f" = "Nó thay điệp khúc";
"L66239be110" = "Đồng âm: cùng một nốt";
"L6636558793" = "Ngồi thẳng, chân chống đã chỉnh, cầm vĩ mềm, vĩ giữa ngựa và mặt cần. Giờ chơi mọi thứ trong phần này.";
"L664305ffb2" = "D tới F bỏ qua E nên cách bậc: quãng ba.";
"L6643ee2897" = "F và C";
"L664688a0e9" = "Từng điệu thức";
"L6646d01d84" = "Pop nhịp 6/8";
"L6651a17acc" = "D buông, E và F thăng trên dây 4, rồi nhảy lên D ở ngăn 3 trên dây 2, và xuống C thăng, B, A.";
"L66573d54aa" = "Hai bước cách bậc lên";
"L6693552855" = "Bass bước blues giọng A";
"L66a2e1bb47" = "Toàn bộ tuyển tập ở giọng phù hợp ukulele, từ đầu đến cuối";
"L66ae417c89" = "Xuống ở số đếm, lên ở tiếng và. Mỗi phách, tay bạn xuống rồi lên một lần.";
"L66ba679c70" = "Tìm phách, đếm đến bốn và gõ đúng nhịp.";
"L66d9448f4d" = "Nhiễu sóng kênh Chín là punk: bốn hợp âm power, móc đơn chặn bằng cạnh bàn tay, 104 phách mỗi phút. Đoạn hát thì thầm ở nốt thấp; điệp khúc là tiếng hô tập thể, nên hãy chơi mạnh.";
"L66fa22185a" = "Móc đơn dài nửa phách, mỗi phách có hai nốt. Dùng lượt vĩ nhỏ, nhanh gần giữa vĩ.";
"L66fbb37faf" = "Bạn sang cặp mới ở tiếng và. Gảy hướng nào?";
"L670d6914c0" = "Hợp âm xác định giọng, rồi một nốt vang. Tìm do trước, gọi tên nốt sau. Mọi giọng đều vậy.";
"L670e7fd853" = "Thấp hơn chuẩn nghĩa là ở dưới nốt cần hát, nên hãy nâng cao độ lên nhẹ.";
"L671c1ff474" = "Câu đầu kết thúc với một nốt chấm dôi. Nó cho cảm giác thế nào?";
"L67278e4178" = "Đoạn hát và điệp khúc";
"L672fd54460" = "C trưởng, quãng tám thứ hai: ngón thứ hai cho F và C trên cùng.";
"L6739b9a584" = "Lấy đà và ô nhịp đầu: G buông, A ở ngăn 2, rồi B buông, D ở ngăn 3 hai lần, E buông.";
"L67684dd3f9" = "Mary Had a Little Lamb cần ba nốt: dây 2 buông là B, ngăn 2 trên dây 3 là A, dây 3 buông là G. Ngón thứ hai chơi nốt A.";
"L67695d722e" = "Đáp lại câu riff";
"L676e1e1bc9" = "Phách 3";
"L677297f490" = "Mở đầu: D, G, B G, B, A. Dây 4, 3 và 2 buông, thêm A.";
"L6776fd531f" = "Ba ngón cùng đẩy";
"L6777925e65" = "Đặt ngón 1 ngang dây 3, 2 và 1 ở ngăn 2, vươn ngón 3 tới dây 4, ngăn 4.";
"L67920ab8cb" = "Thấp hơn một ngăn";
"L67a8f1045a" = "Theo công thức từ D, nốt 3 là F♯, nốt 7 là C♯.";
"L67baf4caa8" = "D tới F là quãng ba thứ; F tới A là quãng ba trưởng.";
"L67c3806843" = "D, DU, UDU";
"L67c948a825" = "D lên F có mấy nửa cung?";
"L67d0dcf34e" = "Nốt kéo dài hai phách";
"L67db55e61d" = "Nốt dựng hợp âm ba là âm gốc. Nốt giữa là âm ba, trên cùng âm năm, đặt theo khoảng trên gốc.";
"L67ef0e743a" = "Chơi lớn hơn";
"L67f0897e60" = "Đặt đầu ngón thứ nhất trên dây A ở vạch băng đầu. Đó là B, cao hơn A một cung; một cung bằng hai nửa cung. Bấm đến khi dây chạm mặt cần.";
"L67f2b8db53" = "C, p-i-m-a";
"L680e20c077" = "Những giai điệu ai cũng biết, từ đầu đến cuối";
"L6824a5dc37" = "Khác nhau";
"L68262bf228" = "A thế thứ tư, A buông, A thế thứ tư. Làm chúng cùng âm.";
"L68275325bd" = "Bài này không dùng dây nào?";
"L6829fbcb04" = "Do đến do: từ C lên C kế tiếp.";
"L6854c89618" = "Ngăn 3 trên dây 4 là nốt gì?";
"L6859188a0b" = "Giữ hợp âm, gảy giai điệu";
"L686fe0d2fa" = "Đặt ngón 1 ngang dây 4, 3 và 2 ở ngăn 2, đặt ngón 2 trên dây 1, ngăn 3.";
"L688a376adc" = "Một phách vừa mấy móc kép?";
"L689041fa42" = "2 thấp, 2 cao trên dây A, rồi 2 thấp, 2 cao trên dây E.";
"L68a5d9377b" = "Dàn đồng ca trên mái là bài ca tầm sân vận động ở 92 phách mỗi phút. Bạn chơi điệp khúc ở C, rồi một ô A nâng tất cả lên một cung, và điệp khúc trở lại ở D.";
"L68a9c445ed" = "Ngón gảy lên bằng móng gảy";
"L68b0c5bf55" = "G cao ở ô đầu đến từ đâu?";
"L68b2b09c89" = "A♭";
"L68d4c57c61" = "Chơi thế chặn B thứ đầy đủ ở ngăn 2 nếu có thể. Nếu chưa, dùng bốn dây cao: ngăn 4 trên dây 4 và 3, ngăn 3 trên dây 2, ngăn 2 trên dây 1.";
"L68d4cfda41" = "B7 kéo về E. Sự căng thẳng tan vào E thứ hoặc E.";
"L68d6126c37" = "D, F♯, A cùng tạo hợp âm nào?";
"L68d9990b7c" = "A7: cùng một mẹo";
"L68dba3a68d" = "Câu cuối leo từ D buông trên dây 4: E, F thăng ở ngăn 4, G buông, rồi A.";
"L68fd09b287" = "Tay trái nắm chặt";
"L68fd5ef7e1" = "Tốc độ tăng lên. Bạn nên gõ thế nào?";
"L690a93e955" = "Đoạn chuyển tiếp";
"L690aa0b88d" = "Ở thế thứ tư, ngón thứ nhất chơi D trên A, nốt ngón thứ tư từng chơi ở thế đầu. Ngón cái ở chỗ cần cong vào thân.";
"L690ab2befe" = "Các nốt liền kề";
"L6918767a98" = "Đảo phách: nhấn ngoài phách";
"L6918c2a4bb" = "Trong D F A, nốt nào là âm năm?";
"L691f903820" = "Không dùng ngón đó";
"L691f9c22d1" = "Bản thân các hợp âm";
"L693752b4ae" = "Tiếp tục quạt, bắt hợp âm sau";
"L6941e683a3" = "Vì dây 4 là G cao, mẫu đi zích zắc: cao, thấp rồi lên dần. Sự lấp lánh ấy là âm của ukulele gảy ngón.";
"L694f5f09fe" = "Bạn nên lấy hơi ở đâu trong bài này?";
"L6952d23be8" = "B5";
"L695d14c16d" = "Cao hơn G hai ngăn là A. Tên hợp âm đổi theo âm gốc.";
"L696010416e" = "Quãng bảy trưởng";
"L696cd74a3d" = "Ngồi thẳng, gảy D rồi G. Thả lỏng vai.";
"L6971957b55" = "Đầu mỗi ô nhịp, bạn lại đếm từ 1.";
"L6973e1fed9" = "Điệp khúc";
"L697ea8051a" = "Với CAGED, bạn ít phải nhảy xa. Quanh ngăn 5, G dùng thế D, C thế G, D thế A. Ba hợp âm, một vị trí.";
"L6980bcdcd2" = "Rondo kiểu Thổ Nhĩ Kỳ";
"L698eca6ecd" = "Lặng, rồi gõ vào “và”";
"L69a3fc0ffb" = "Chuyển bằng khuỷu tay";
"L69acddb13a" = "Không có kiến thức mới: mỗi ngón một dây, mẫu gảy đi-về, ngón cái luân phiên và giai điệu trong hợp âm.";
"L69ba79c271" = "Kiểm tra chuyển thế";
"L69c68aba96" = "Speed, bonnie boat, like a bird on the wing: D buông, E, D, ba nốt G buông, rồi A, B, A và lên D.";
"L69d4feab52" = "Nhảy lên thật cao";
"L69d6c14191" = "Đèn chớp chậm là nhạc gốc Timbre: synth-pop giọng A với F thăng thứ, D, A, E. Thế ngăn 2 hợp cả vòng: ngũ cung A trưởng, cũng là ngũ cung F thăng thứ. Bài đầy đủ ở mục Bài hát, phần Nhạc gốc.";
"L69db2318a3" = "Bài ca người bán hàng rong";
"L69dca66da6" = "Chia mỗi phách làm hai và đếm “và”.";
"L69dd77610a" = "Dây 3: ngăn 2 và 4. Gảy một lần, rồi hammer-on và pull-off bằng ngón 3.";
"L69e8d3e991" = "Dây buông nào phát nốt thấp nhất?";
"L69f444cda2" = "Ba nốt thành hợp âm";
"L6a0141eeb5" = "Bạn chuyển vấp giữa bài. Giờ làm gì?";
"L6a04869038" = "Luân phiên bass";
"L6a06751695" = "Những hợp âm đầu tiên";
"L6a09029e91" = "V sang I là dấu chấm hết trong âm nhạc.";
"L6a1333dc6b" = "Khúc ru của Brahms";
"L6a266df3b3" = "Vòng bốn hợp âm này xuất hiện trong rất nhiều bài pop. Ở giọng C trưởng, đó là C, G, A thứ, F. Hợp âm vi thứ thêm chút trầm lắng trước khi IV nâng lên để trở về âm chủ.";
"L6a3f43a116" = "Hợp âm power mở và di chuyển được, chặn bằng cạnh bàn tay và câu riff của riêng bạn.";
"L6a44f899d9" = "Trong blues 12 ô nhịp, ô 9 là hợp âm nào?";
"L6a4544fbab" = "Các ngón siết lại";
"L6a490b5529" = "F là nốt dưới cùng để dựng hợp âm ba.";
"L6a6239acaf" = "E thứ và G đều để dây nào buông?";
"L6a6a771c43" = "Là phím cao nhất nhóm ba, ngay dưới B: A♯, cũng gọi B♭.";
"L6a6f0851c4" = "Năm bài thánh ca lớn với nốt dài ngân nga, từ 1708 đến 1861.";
