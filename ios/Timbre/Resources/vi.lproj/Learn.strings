"Lf66bbc5b7c" = "Ở giọng E";
"Lf698ed242e" = "Hợp âm nào dùng cả bốn ngón?";
"Lf6b136534d" = "Nâng nhẹ rồi giữ";
"Lf6b456d043" = "Đoạn trio";
"Lf6bcc1d6e8" = "Tuyển tập cello";
"Lf6ce724330" = "Bài ca hòa bình";
"Lf6d0f6ee4d" = "Ở giọng D: I là D, V là A, vi là B thứ, IV là G.";
"Lf6d6d4ae3e" = "Trăng bên máy hát là nhạc gốc Timbre: điệu nhảy chậm thập niên năm mươi dạng AABA, đoạn hát, lặp lại, chuyển tiếp trên F, rồi đoạn hát lần nữa. Quạt mỗi phách, thêm quạt lên swing nhanh để dẫn vào mỗi ô mới. Bài đầy đủ ở mục Bài hát, phần Nhạc gốc.";
"Lf6e069190a" = "Ca Giáng sinh mùa đông";
