"Lf02792e9e5" = "Quạt một lần, rồi dùng thời gian còn lại của ô nhịp để chuyển. Đặt hợp âm mới đúng phách một. Tốc độ sẽ tự đến sau.";
"Lf0292a943f" = "A tới C là quãng ba thứ, ba nửa cung.";
"Lf02cabc5b6" = "Henry Francis Lyte viết lời năm 1847, và William Henry Monk viết giai điệu Eventide cho lời ấy năm 1861. Khán giả bóng đá Anh đã hát bài này trước trận chung kết cúp từ 1927.";
"Lf02f101c07" = "Ngăn 7";
"Lf036171c29" = "Âm gốc đều đặn";
"Lf03a831605" = "Ngăn 5";
"Lf0407dd043" = "Bạn vẫn tiếp tục đếm";
"Lf048e06f81" = "Nhựa ruồi và thường xuân ở nhịp ba. Hai bài còn lại đếm theo nhóm bốn.";
"Lf04e8a09c2" = "Ở A";
"Lf0647309b4" = "Cách bậc trong giai điệu";
"Lf068a34024" = "Hợp âm sus thay nốt quyết định trưởng hay thứ bằng nốt bên cạnh. Âm nghe thoáng, chưa giải quyết cho đến khi về điểm tựa.";
"Lf0714231ef" = "Ngồi gần mép trước ghế, bàn chân đặt phẳng, đầu gối mở như có thể dễ đứng dậy. Cello nằm giữa hai gối.";
"Lf0914244f3" = "Qua lại hai bên";
"Lf09abc15d8" = "Âm gốc và âm năm, như người chơi bass mới đệm ban nhạc: âm gốc khi hợp âm bắt đầu, âm năm xen giữa, ở âm vực thấp trong thế thứ nhất. Bài giữ giọng D thứ, như ban nhạc chơi.";
"Lf0baa74e41" = "Bình an trên mặt đất";
"Lf0bbc1d6e7" = "Đổi dây bằng đổi độ cao khuỷu, không phải cổ tay. Đến độ cao mới ngay trước khi vĩ đổi hướng.";
"Lf0db57fe3e" = "Nốt móc kép";
"Lf0e20b63de" = "Xuống ở 1, xuống-lên ở 2, xuống ở 3, xuống-lên ở 4. Tay vẫn đi lên sau 1 và 3, chỉ tránh dây.";
"Lf0f611c748" = "A thăng nằm ở đâu trên dây 5?";
"Lf0f7458ee6" = "Chưa sẵn sàng chặn? Chỉ chơi bốn dây cao: ngăn 4 trên dây 4 và 3, ngăn 3 trên dây 2, ngăn 2 trên dây 1.";
"Lf0fd6576f2" = "Au clair, phần hai";
"Lf109defb30" = "Giọng này có hai dấu thăng, F thăng và C thăng. C thăng nằm ở ngăn 2 trên dây 2.";
"Lf115cd0d4d" = "Hammer-on phát nốt thứ hai chỉ bằng tay bấm. Gảy một nốt, rồi đặt mạnh ngón khác xuống sát sau phím cao hơn. Dây tiếp tục ngân.";
"Lf11be4708d" = "Chậm nhất là vào thập niên 1580, Greensleeves đã được hát ở Anh, và Shakespeare nhắc tới nó trong Những bà vợ vui vẻ ở Windsor. Ở đây bài ở giọng E thứ, trầm và tối.";
"Lf149dab787" = "Ngồi, chỉnh chân chống, cầm vĩ, chơi dây buông và bài đầu tiên.";
"Lf14bcf9b91" = "Mười hai";
"Lf155ce04bf" = "Hợp âm dưới đoạn hát";
"Lf160cb4eda" = "Giọng";
"Lf16f6a6b45" = "Cho nốt dài cất tiếng";
"Lf179bbea59" = "Âm gốc đặt tên hợp âm";
"Lf182217aca" = "Khởi động đổi dây";
"Lf185b408d3" = "Quãng sáu trưởng";
"Lf192d656d8" = "Thêm âm bảy";
"Lf19797ad4a" = "Thử thách G mở";
"Lf1ab4a3306" = "Giai điệu đi lên hay xuống?";
"Lf1abce53b1" = "Tăng dần, đừng nhảy vọt";
"Lf1bdbc66eb" = "Blues 12 ô dùng được ở mọi giọng. Trong E, hợp âm là E, A, B. Đi bước bằng gốc, ba, năm, sáu, tiếp cận mỗi lần chuyển.";
"Lf1c6f16910" = "Hai ngăn";
"Lf1cc990354" = "Giai điệu thiếu nhi này đi qua C, D và E, rồi nhảy lên G. Bước nhảy là từ dây 1 buông lên ngăn 3.";
"Lf1d459f7d7" = "G ngón thứ ba, G buông, G ngón thứ ba. Nghe cộng hưởng.";
"Lf1da2082b9" = "E tới G♯ là quãng ba trưởng; G♯ tới B là quãng ba thứ.";
"Lf1e96e9a2e" = "Không có kiến thức mới: 12 ô nhịp trong A và E, chuyển sớm, boogie, quay vòng và các câu nhạc. Giữ shuffle đung đưa.";
"Lf1ed699d9f" = "Công thức cần một cung từ nốt 6 tới 7, rồi nửa cung từ 7 lên G.";
"Lf1ee7fc29d" = "Âm gốc của D là dây 4 buông, cũng là dây bắt đầu quạt hợp âm D.";
"Lf1f2c89442" = "Mỗi ô nhịp ở đây có bao nhiêu phách?";
"Lf1f7abf176" = "Phiên bản này ở giọng A. Dây thứ tư được lên cao, nên giai điệu nằm trên dây 1 đến 3, và mọi hợp âm trong bảng đều dùng thế ukulele.";
"Lf1f91d70ac" = "A E C G";
"Lf205ad6518" = "Xuống C thấp";
"Lf210cbbe01" = "Soldier's Joy đã có bản in ở Scotland chậm nhất vào năm 1780, từ đó phổ biến trong hòa tấu Mỹ. Phần đầu nảy giữa D, F♯, A.";
"Lf21d5f21a2" = "Chỉ các số đếm";
"Lf237c6e813" = "Sương giá đầu mùa";
"Lf23c32ed91" = "Chấm dôi thêm một nửa độ dài nốt. Ở ô thứ hai, F thăng vang một phách rưỡi, G chen vào tiếng “và” của hai, và A rơi vào ba.";
"Lf23cc17a3e" = "Giảm lực nhưng vẫn chạm dây";
"Lf246d5ffdd" = "Giờ đến E. Vẫn thở xuống bụng, vẫn âm “a” thoải mái.";
"Lf2475e34a0" = "Ngón thứ nhất trên dây A";
"Lf253337468" = "D buông, E bằng ngón thứ nhất. Giữ E đến khi ổn định đúng cao độ.";
"Lf2535255bd" = "Dân ca, ca Giáng sinh và chủ đề cổ điển ở giọng phù hợp mandolin";
"Lf253e82edc" = "Trong D, ngón cái chơi dây nào?";
"Lf25c3da65a" = "John Howard Payne (1823)";
"Lf26babdf48" = "A thứ bắt đầu A ngón thứ nhất trên dây G. Ngón thứ hai cao trên G để chơi B, rồi thấp trên D để chơi F bình.";
"Lf26ecaaa90" = "Bỏ nốt đó";
"Lf26f659729" = "Vì sao ngón thứ hai giữ trên đúng chỗ?";
"Lf27727d913" = "Đầu ngắn giúp kiểm soát, âm rõ. Lộ quá nhiều dễ mắc dây đôi.";
"Lf27b4287d6" = "Nốt tiếp cận nửa cung";
"Lf284772600" = "Lần đầu bạn hát thấp hơn chuẩn. Tiếp theo làm gì?";
"Lf28ef6a501" = "Tên khác của E♭ là gì?";
"Lf2a23bbd56" = "Thử thách đọc khuông";
"Lf2b380c306" = "Tay bấm ngắt hợp âm. Thả lực nhưng giữ đầu ngón trên dây.";
"Lf2c31c38b7" = "Ngón cái giữ nhịp";
"Lf2ceb7212c" = "Gảy từng nốt";
"Lf2d0250794" = "Ngăn 3 trên dây 2, rồi dây 1 buông. Nhấc ngón tay khi gảy.";
"Lf2e3dcb7b0" = "G, A, B, C, D, E, F, G: tám chữ, quãng tám.";
"Lf2e8c49236" = "A đặt ngón 1, 2 và 3 cạnh nhau ở ngăn 2, trên dây 4, 3 và 2. Quạt từ dây 5.";
"Lf2ecba4f27" = "Đu quay lúc đóng cửa";
"Lf2f8952faa" = "Thế A dùng khắp cần. Trượt lên ba ngăn cho C, năm ngăn cho D. Giữ cả bốn ngón đúng chỗ khi di chuyển.";
"Lf30e266da0" = "Nốt đen kéo dài một phách. Quạt xuống mỗi phách và đếm thành tiếng: một, hai, ba, bốn.";
"Lf3162ad5ad" = "C thăng, B, A, B, rồi C thăng ba lần.";
"Lf319af35dc" = "Đêm thánh vô cùng";
"Lf33aa81082" = "Phần lớn giai điệu chạy bằng móc đơn. Gảy với động tác nhỏ và luân phiên xuống, lên để không bị chậm nhịp.";
"Lf33c98e78a" = "Kiểm tra dây buông";
"Lf34302e375" = "Các nốt móc đơn của bạn không đều. Cách nào hữu ích nhất?";
"Lf355697145" = "Hát hoặc chơi quãng năm xuống: G về C.";
"Lf3627bff2c" = "Kéo vĩ, bấm, chơi đúng cao độ, từ dây buông đến nhạc fiddle";
"Lf36c5f296a" = "Quạt mười ô đầu với kiểu chuyển sớm, rồi chơi câu nhạc ở ô 11 và 12. Đó là cách ban nhạc blues kết mỗi vòng.";
