<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- pa plural forms (CLDR categories used: one, other). Keys match en.lproj/Localizable.stringsdict; wording follows this locale's Localizable.strings. -->
<plist version="1.0">
<dict>
	<key>%lld cents flat</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਸੈਂਟ ਘੱਟ</string>
			<key>other</key>
			<string>%lld ਸੈਂਟ ਘੱਟ</string>
		</dict>
	</dict>
	<key>%lld cents sharp</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਸੈਂਟ ਉੱਚਾ</string>
			<key>other</key>
			<string>%lld ਸੈਂਟ ਉੱਚਾ</string>
		</dict>
	</dict>
	<key>%lld minutes</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਮਿੰਟ</string>
			<key>other</key>
			<string>%lld ਮਿੰਟ</string>
		</dict>
	</dict>
	<key>%lld sessions</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld ਸੈਸ਼ਨ</string>
			<key>other</key>
			<string>%lld ਸੈਸ਼ਨ</string>
		</dict>
	</dict>
	<key>Every %lld bars</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਹਰ %lld ਬਾਰ ਬਾਅਦ</string>
			<key>other</key>
			<string>ਹਰ %lld ਬਾਰ ਬਾਅਦ</string>
		</dict>
	</dict>
	<key>Practised on %lld days in the last twelve weeks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਪਿਛਲੇ ਬਾਰਾਂ ਹਫ਼ਤਿਆਂ ਵਿੱਚ %lld ਦਿਨ ਅਭਿਆਸ ਕੀਤਾ</string>
			<key>other</key>
			<string>ਪਿਛਲੇ ਬਾਰਾਂ ਹਫ਼ਤਿਆਂ ਵਿੱਚ %lld ਦਿਨ ਅਭਿਆਸ ਕੀਤਾ</string>
		</dict>
	</dict>
	<key>Practised today. Best run %lld days.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@n@</string>
		<key>n</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>ਅੱਜ ਅਭਿਆਸ ਹੋ ਗਿਆ। ਸਭ ਤੋਂ ਲੰਮਾ ਸਿਲਸਿਲਾ %lld ਦਿਨ।</string>
			<key>other</key>
			<string>ਅੱਜ ਅਭਿਆਸ ਹੋ ਗਿਆ। ਸਭ ਤੋਂ ਲੰਮਾ ਸਿਲਸਿਲਾ %lld ਦਿਨ।</string>
		</dict>
	</dict>
</dict>
</plist>
