"L0009cb1a16" = "Jedna žica zvuči tupo. Što je vjerojatan uzrok?";
"L00130a44b5" = "Dodir bez pritiska sprečava žice da zvone. Potez postaje jasan udaraljkaški klik.";
"L0015244e3f" = "G7 zadržava niski G, ali stavlja F na vrh: prst 3 na žicu 6, prag 3; prst 2 na žicu 5, prag 2; prst 1 na žicu 1, prag 1.";
"L0017247d59" = "Koji je G7, onaj s većom napetošću?";
"L001a8a4e76" = "Prst 1 na žici 3, pragu 1 daje jedini ton koji stvara E-dur.";
"L0024a55a06" = "Shuffle ritam";
"L002ba346f7" = "Žica 3: prag 2, prag 3, prag 5.";
"L002e2c331d" = "Ocrtaj oblik";
"L002fe27c72" = "Bakrena žica temelji se na rifu: kratkoj, zaraznoj liniji na niskim žicama uz koju se cijeli sastav usklađuje. Ide pri 112 doba u minuti u E, s power-akordima u refrenu.";
"L00398ce342" = "Prekrij žice od 5 do 1 na pragu 10 i položi prst 3 preko žica 4, 3 i 2 na pragu 12. To je tvoj bare u hvatu A, a opet je G.";
"L00573ce6a3" = "Kapodaster";
"L006392a6a7" = "Terca";
"L0074f77ab6" = "Sedmi ton G-dura je F♯.";
"L0077cab0a8" = "Sousa je svoje koračnice pisao za vojni orkestar. Proljeće je za violinu i gudače, a rondo za klavir.";
"L007b8bf14c" = "Broji 1 2 3, 1 2 3, s naglaskom na 1. To je mjera valcera. „Clementine”, prvi put tiskana 1884., njiše se u tri dobe.";
"L008b7d6e79" = "Povišeni D je prag ispod E. Taj poluton snažno vuče prema uporištu, zato ga Greensleeves koristi u svakoj kadenci.";
"L008b914131" = "Program otvorenih akorda";
"L008ec0fe41" = "Pjevaj malo niže";
"L00b1aaa1ac" = "John Philip Sousa napisao je ovu koračnicu krajem 1896., a objavljena je 1897. Službena je nacionalna koračnica Sjedinjenih Država. Ovo je njezina velika melodija trija.";
"L00b6eb7b38" = "Vrijeme za zmajeve vedar je, lagan pop: četiri akorda u petlji, G, D, E-mol i C, pri opuštenih 88 doba u minuti. Slušaj kako upečatljivi motiv u drugom taktu skače do povišenog F.";
"L00db96471b" = "Drži ga u glavi";
"L00f131a2fc" = "Šest jednakih doba";
"L00f1e4a733" = "D na pragu 3 žice 2 i prazna žica 4 oboje su D. Koliko su udaljeni?";
"L00f5a8d2df" = "Ragtime, koračnice i pozornica";
"L0100ebed8a" = "Drveni štap ide od žabice, gdje ga držiš, do vrha. Između je napeta konjska dlaka. Zategni vijak dok olovka jedva stane između dlake i štapa.";
"L0101b7221e" = "Hodajući bas u D i E";
"L010a5a3a68" = "Ispod „frost-y wind made moan” akordi prelaze iz A-mola u D7, stvarajući težnju koja vraća redak na G.";
"L011468ba58" = "Dva tona u jednom potezu znače da svaki dobiva polovicu. Planiraj i počni legato s dovoljno gudala za oba tona.";
"L011d756661" = "C E G, F A C i G B D svi imaju veliku tercu dolje.";
"L0124abba92" = "Strofa pjeva nekoliko riječi na jednom tonu. Neka svaki povišeni F bude kratak i jednak, a riječi neka nose redak.";
"L0129c1441b" = "Na 1, 3 i 5";
"L013fea348d" = "G, A";
"L015e6a69e5" = "Dvaput u sekundi";
"L016652736c" = "Koji je stupanj ljestvice posljednji ton?";
"L018f21ccb1" = "Akord odsviran dvaput";
"L0191c4f678" = "Opet na A";
"L019766279b" = "Gdje su polutonovi u durskoj ljestvici?";
"L0199b663ee" = "Fraza 1";
"L01a4a05447" = "Broji od C";
"L01aa1069e8" = "Posljednja tema";
"L01bda6585d" = "G-dur u dvije oktave na pragu 2, stupnjevi ljestvice i akordi te dorski i miksolidijski modus.";
"L01c6956f6f" = "Tko svira što";
"L01cacb6e6a" = "Tapkaj samo na i";
"L01d1af9aef" = "Poluton ili cijeli ton?";
"L01d8ca79df" = "Opera Carmen Georgesa Bizeta premijerno je izvedena u Parizu 1875. Preludij počinje ovom svečanom koračnicom, pa svira melodiju poznate Toreadorove pjesme.";
"L01e269d40a" = "Sekunde, terce, sekste i septime mogu biti velike ili male. Mali interval uvijek je poluton manji od velikog.";
"L01e81b91bc" = "Polazište i odredište";
"L01e9d574a3" = "Vibrato ne spašava nečist ton; samo boji onaj koji je pogođen. Većina ga dodaje kad prsti nalaze čiste tonove bez traženja.";
"L01ee5b3bac" = "Ti je samo poluton ispod do, pa snažno teži prema njemu.";
"L020232021d" = "Ubrzaj dok se ne ujednače";
"L0213925244" = "Prazni visoki G pripada akordu C, pa zvoni takav kakav jest. U ovim lekcijama nikad ga ne pritišćeš na pragu.";
"L0213e2ea6e" = "Pjesme se vraćaju toničkom akordu. U F to je F.";
"L022a274f11" = "Koji niz ide naniže?";
"L023748ecd0" = "Amazing Grace, prva polovica";
"L023da003cb" = "Taktovi 11 i 12 često imaju povratni završetak, kratku frazu koja vodi na početak. Ova se spušta od A do E, prag po prag.";
"L023e171007" = "Prvi prsti: A i E";
"L023f7f5a8c" = "Od G do B i natrag prelaziš s jedne žice na drugu. Njiši ruku glatkim pokretom iz lakta.";
"L0241523d12" = "Čuj ton, ponovi ga pjevanjem i kreći se malim koracima.";
"L025497d15a" = "Skupine od dva";
"L025c45471b" = "Broji uz ljestvicu od C: C, D, E, F. F je četvrti ton, pa je F akord IV.";
"L026036a0e5" = "Na svako i";
"L0268cd2c6e" = "Jedan prst, dva praga";
"L028703cd0b" = "A ovaj primjer?";
"L028ca831a9" = "U toj frazi C zvoni dobu i pol, a D ulazi na i nakon četiri. Broji jedan, dva, tri, četiri-i.";
"L0297ac2321" = "Dolje-gore, uz ljestvicu";
"L029fad523d" = "Četvrti prst doseže cijeli ton iznad trećeg. Na žici D to je A, isti ton kao prazna žica A. Drži prst savijenim i nagni ruku prema njemu.";
"L02bc9eff1a" = "U B-molu";
"L02c33b1967" = "Otpusti pritisak dok prst ostaje na žici. Ton staje bez zujanja.";
"L02ed0975aa" = "Svaki akord gradi se na jednom tonu, osnovnom tonu. Osnovni ton akorda A je A. Basisti sviraju osnovne tonove da sastav zna gdje je dom.";
"L03016009de" = "Izazov s tonovima i slovima";
"L0301e70c80" = "C-mol";
"L0306da2b91" = "Bum, di, ti: ti je uvijek palac na kratkoj petoj žici.";
"L030d0d05a0" = "G, D, E-mol, C";
"L032ccbe9b9" = "Doba je ravnomjeran puls uz koji tapkaš stopalom. Ne žuri niti zaostaje, poput koraka u laganoj šetnji. Svaki ritam počiva na njemu.";
"L0335a6785b" = "Osnovni ton na žici 5";
"L0345d17207" = "Trzni praznu žicu 3. To je G.";
"L035e66b640" = "Koji je ton cijeli ton ispod D?";
"L0371438f82" = "C3";
"L037f025d31" = "Svjetlo za duhove spora je, tamna balada u A-molu pri 70 doba u minuti. Strofa tone od A-mola preko F i C do E-dura, koji snažno vuče natrag prema A-molu.";
"L038dcfc2fa" = "Pristupite vjerni";
"L03909ad236" = "Nijedan";
"L03bb0a5896" = "Žica 3: pragovi 2, 3 i 5.";
"L03c23e6b0b" = "Slatka fraza";
"L03c936bf04" = "Od E do F samo je jedan poluton.";
"L03e4b8ba68" = "Svaki redak ima par dugo-kratko: četvrtinku s točkom, pa brzu osminku, kao u „-er, my” i „God, to”. Neka duga nota vodi u kratku.";
"L0406d13e7a" = "Položen odozgo na štap";
"L040c7ac884" = "Miljenica gajdaških sastava";
"L04178c0873" = "Najdeblja žica daje najniži ton. Dok sviraš, najbliža je tvom licu. Zovemo je žica 4.";
"L042dc4512f" = "i";
"L04304099ff" = "Upoznaj ukulele";
"L043e57dc85" = "E na pragu 2 žice 4, povišeni G na pragu 1 žice 3 triput, povišeni F na pragu 4 žice 4, E, pa prazni B.";
"L04444fb012" = "Koliko puta pripjev pjeva „O come, let us adore him”?";
"L044767a8b1" = "Do ti do";
"L044a177de9" = "Koja melodija ovako počinje?";
"L044d7dcdd8" = "Skupine od tri";
"L045c1b7cc0" = "Je li najviši ton išao gore ili dolje?";
"L045f70eda3" = "Uspori i broji naglas";
"L04677e71b2" = "Od C do B♭ ima deset polutonova.";
"L046a35ba3a" = "Koja je od ovih pjesama u 3/4?";
"L0472142819" = "Drugi prst na pragu 2 žice 4, prvi prst na pragu 1 žice 3. Žice 2 i 1 zvone prazne.";
"L047687398f" = "Ubrzati";
"L04784737ff" = "Ovo je izdanje u F. Četvrta ti je žica ugođena visoko, pa melodija ostaje na žicama 1 do 3, a svaki je akord u shemi oblik za ukulele.";
"L047f059e7a" = "C umjesto C♯";
"L0488810a08" = "Nota koja traje jednu dobu je četvrtinka. Četiri ispunjavaju takt u 4/4, pa tapkanje na svaku dobu znači tapkanje četvrtinki.";
"L048e4dae0c" = "Sjedni s violončelom";
"L04a44d6f06" = "Blues od 12 taktova akordski je plan dug dvanaest taktova, temelj brojnih blues, rock i jazz melodija. Koristi I, IV i V, često sve kao dominantne septakorde za bluesovski prizvuk.";
"L04b6e2feff" = "Od C do D i od F do G";
"L04ba3fc545" = "Prvo trzaj";
"L04cd34e7dd" = "A-mol je hvat E pomaknut za jednu žicu prema tanjima: prsti 2 i 3 na pragu 2, prst 1 na žici 2, pragu 1.";
"L04df911481" = "Dominantni septakord";
"L04e51c7ae2" = "Izazov prvih tonova";
"L04e8a55b79" = "Treći prst: D";
"L04f8cd7955" = "Tapkaj uz klik";
"L051485fbea" = "Jedna tipka, dva naziva";
"L051d8c7d10" = "Velika septima";
"L051e1dcbb4" = "Koliko taktova I otvara blues od 12 taktova?";
"L0521b1782d" = "Radio za oseke opušteni je reggae pri 80 doba u minuti. Gitara svira samo na i svake dobe, kratkim udarom zvanim skank, dok bas i bubnjevi drže dobu.";
"L0532d7cb1e" = "Melodije na žicama 3 i 4";
"L0538d50d6e" = "Tri pjesme koje su obitelji pjevale uz klavir, pa Holstov Jupiter.";
"L0548676f4d" = "Osnovni ton, kvinta, oktava";
"L05496b6432" = "Od E do F samo je poluton";
"L0561798932" = "Kako čisto zaustavljaš ton na pragu?";
"L05652cf34f" = "Povišeni F prstom 4";
"L0567c9ef33" = "Ova engleska melodija starija je od 400 godina. Sve akorde znaš: A-mol, C, G, E-mol, F i E. U trodobnoj je mjeri: sviraj jednom po taktu, zatim na svaku dobu.";
"L0572eb5f3f" = "Koji akordski slijed čuješ?";
"L059dd7492f" = "Program pjesama s pričom";
"L05a0c1c0fd" = "Balada, prstima";
"L05a2271256" = "Smanjeni A";
"L05b1593cdf" = "C, A, G, E i D: pet otvorenih hvatova koje svaki durski akord može posuditi bilo gdje na vratu.";
"L05ba0eb344" = "Jedan-i, dva-i";
"L05cc7ef8cf" = "Pjesme uz vatru i narodne pjesme s jednostavnim akordskim shemama, za sviranje ili pjevanje uz pratnju.";
"L05ccceedd1" = "Uvijek je glasniji";
"L05ccf6d485" = "Drugi takt zadržava ritam prvoga, ali mijenja jedan ton. Zašto?";
"L05d69233ea" = "Narodna božićna pjesma";
"L05e740748b" = "Na sljedeću žicu";
"L0602e15d9e" = "Stalno i ravnomjerno";
"L06057c47cb" = "Koji interval čuješ?";
"L0617b17c54" = "C7: jedan prst";
"L061a989771" = "F je tek početak";
"L0620855030" = "Novi ton: povišeni F";
"L062484b438" = "Trozvuci uz vrat";
"L062787aa32" = "Više";
"L0656355e15" = "Koji prst u D-duru svira povišeni C?";
"L065919aae8" = "C-dur od žice 5 do G na žici 1.";
"L065dc33b0f" = "Prazni A, B, klizni prvim prstom do D, pa E trećim.";
"L066423f08b" = "Penji se od prazne žice 6: povišeni F na pragu 2, G na pragu 3, prazni A, B na pragu 2.";
"L0674eef56c" = "Terca od četiri polutona je velika terca, poput C do E. Terca od tri je mala terca, poput C do E♭ ili A do C.";
"L068982656c" = "Mali F";
"L06aa39bbd4" = "Nove pjesme s otvorenim akordima: pop uz vatru, balada, folk uz udarce nogama, reggae i country.";
"L06aa3b37b8" = "Prag 5, prag 8 na žici 6, pa prag 5, prag 7 na žici 5.";
"L06b2310e15" = "Tvoji tonovi na pragovima: D, F, B, C.";
"L06b832525f" = "Promjena tonaliteta za cijeli ton naviše pomiče svaki ton za…";
"L06cd2c603c" = "Žica 4 prekida niz";
"L06d272f076" = "Provjera D i G";
"L06e461da5a" = "Bez kapodastera: uvod";
"L06e5c2a776" = "Slana nedjelja reggae je u A-molu pri 76 doba u minuti. Gitara svira dvostruki kratki udar na dva i četiri, čk-a, čk-a, dok bubnjevi naglasak spuštaju na tri.";
"L06e8a4031a" = "Greensleeves, strofa";
"L06ed945364" = "Svaki par mora odgovarati štimeru i samome sebi. Ako dvije žice nisu usklađene, čuješ sporo pulsiranje zvuka. Ugodi jednu, pa drugu dovedi na isti ton.";
"L06f797893d" = "Koja se od ovih pjesama broji u tri?";
"L0709783dc0" = "Dinamika: glasno i tiho";
"L070e348de7" = "Prst 1 na žici 3";
"L070fa0c272" = "A-dur koristi G♯. Spuštanje na G daje miksolidijski zvuk koji se provlači kroz starinsku i bluegrass glazbu.";
"L0712a01674" = "Od C do G";
"L0732398ea5" = "Nimalo: ista visina";
"L07387ec03e" = "Drži duge note";
"L073ebc6d51" = "Isti naziv, osam tonova naviše";
"L0749856ea5" = "Par 4, prag 2 prvim prstom, pa prag 4 drugim.";
"L0784f2a75e" = "Koji prst između tonova palca trza žicu 3?";
"L078f873444" = "Ravnomjerno rasporedi gudalo";
"L079265d880" = "Prvi prst na pragu 2 žice 1, drugi na pragu 3 žice 2, treći na pragu 4 žice 3. Žica 4 zvoni prazna.";
"L0798e85c74" = "Notne vrijednosti";
"L079b0c5c75" = "„Meri ima malo janje” traži tri tona: prazna žica 2 je B, prag 2 na žici 3 je A, a prazna žica 3 je G. Drugi prst pritišće A; palac trza žicu 3.";
"L07a46d953b" = "Od vrha prema žabici";
"L07aec77f36" = "Četvrtinke na D i A";
"L07b574a082" = "Pratnja u swingu";
"L07be9b9784" = "U A";
"L07c33b35a8" = "Iz tresenja čeljusti";
"L07c74c4f57" = "Svaki tonalitet određuje drugi prst. Prije sviranja pitaj: visoki 2 ili niski 2, i na kojoj žici?";
"L07c90e906b" = "Ton između";
"L07c9e258fe" = "Provjeri svaku žicu";
"L07cd0ccf75" = "Henry Francis Lyte (1847)";
"L07d8522005" = "2 i 3";
"L07e1dc41ae" = "B, visoki G, niski D, visoki D, G. Pronađi svaku žicu po tonu.";
"L07ed48285a" = "Sekunde uz melodiju";
"L07f4a8e116" = "Melodije često silaze ispod do do nižih ti, la ili sol. To su isti tonovi, samo niže. Mnoge melodije počinju na nižem sol i skaču naviše do do.";
"L07f8b44be5" = "Velika sekunda";
"L080c0fdb23" = "Durske ljestvice i tonaliteti";
"L0819310447" = "Žica 2, prag 3, treći prst. To je D.";
"L0832428388" = "Ništa novo: E-mol, E, A-mol i A. Postavi svaki hvat čisto pa drži ujednačene promjene.";
"L0838660743" = "Čiste promjene";
"L08397419f3" = "Am7 je A-mol uz koji dodani ton?";
"L084aa60332" = "Triler treperi između dvaju tonova: jedan trzaj, pa hammer-on i pull-off ukrug. Neka bude ravnomjeran prije nego što ga ubrzaš.";
"L0858349791" = "Akordi pjesme stupnjevi su tonaliteta: I, IV i V. Promijeni tonalitet, brojevi ostaju. U C to su C, F i G7; u G su G, C i D7; u F su F, sniženi B i C7.";
"L08787177f9" = "Pjesma o abecedi";
"L087956136f" = "Izazov usklađivanja visine";
"L0884e05b19" = "D trećim prstom, E četvrtim na žici A, pa prazni E. Slušaj podudaranje.";
"L08879d2e2b" = "Akordska shema oslanja se na A-mol, F i G7. „God, our” je na A-molu, a „a-ges past” prelazi iz G7 u C.";
"L088933bed2" = "Jedna razina po žici";
"L0895458a5d" = "Palac nisko iza vrata";
"L08b35d8fe7" = "Usporavanje ti daje vrijeme da svako „i” smjestiš u sredinu. Brojanje ga ondje zadržava.";
"L08b3bd0b98" = "Svira dvostruko jače";
"L08b90ad7cf" = "E♭";
"L08bc967946" = "Velška novogodišnja melodija";
"L08be0247dc" = "Taktovi od 5 do 8";
"L08c1f1d011" = "„For the” počinje dvjema osminkama na „the”: povišeni F i G, jedan slog otpjevan preko oba tona. Odsviraj ih ravnomjerno unutar jedne dobe.";
"L08e947b299" = "Na C, tonici";
"L08f08e985c" = "Neonska praonica izvorna je pjesma Timbre: funk koji se drži jednog akorda, A7. Motiv klizi s C na povišeni C, s istim trenjem kao tvoje blues fraze, a refren pada na E7. Cijela je pjesma u Pjesmama, pod Izvorne pjesme.";
"L08f46eb59c" = "Obrazac naprijed, polako";
"L090369bc10" = "Shuffle dijeli svaku dobu nejednako: dug potez dolje, kratak gore. To je puls bluesa. Zamisli duu-ba, duu-ba.";
"L09054f67ac" = "Zvončići";
"L0907c52560" = "Od E gore do F je...";
"L09126510ac" = "Prekrij prag 5 na žicama 3, 2 i 1 i dobivaš A-mol s C na dnu. Jedan prst, tri tona.";
"L09197799bd" = "Prazni B, D na pragu 3, prazni E, pa naniže do praznog G i A na pragu 2.";
"L0922b8af84" = "Akordi prstima";
"L09305f28c5" = "Prvo broj, pa veličina";
"L0936b94844" = "Swing dijeli svaku dobu nejednako: dugo dolje, pa kratko gore. Izgovaraj duu-ba, duu-ba dok sviraš. To je njihanje starih melodija za ukulele.";
"L0938f25e07" = "Prazni D, povišeni D na pragu 1, E na pragu 2 žice 4, pa skok do C na pragu 1 žice 2 i natrag, triput.";
"L096cd1a591" = "Jednu oktavu";
"L0975f3a9aa" = "Povisilica i snizilica";
"L097fa0a14b" = "Četvrti takt drži Dsus4: akord D s malim prstom na žici 1, pragu 3. Ostaje visjeti u zraku. Osmi takt spušta se na obični D i pjesma slijeće.";
"L0987ab3025" = "Blues u A";
"L0995a331f6" = "Šum na devetom kanalu";
"L09a5833cec" = "Za E-mol stavi dva prsta na prag 2, na žice 5 i 4. Sve žice zvone.";
"L09ccba787a" = "Ništa novo: kvintni akordi, otvoreni i pomični, prigušivanje dlanom i tvoj rif. Prati klik i precizno prigušuj.";
"L09ccd34cd2" = "Sada klizni prstom 3 po žici 3 s praga 4 do praga 6, iz B u povišeni C, pa se vrati u obrazac.";
"L09d6838d36" = "Ako fini ugađač dođe do kraja, koristi čiviju. Malo je okreni i guraj unutra da drži. Ako je žica jako raštimana, zamoli učitelja; čivije mogu kliznuti.";
"L09da34c321" = "Žica dalje, dva praga više";
"L09f494cac5" = "Polovinu njezine vrijednosti";
