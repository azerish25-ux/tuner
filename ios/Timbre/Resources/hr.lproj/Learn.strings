"L5ff6946aec" = "Sajmeni dan izvorna je pjesma Timbre: sunčani pop u G uz polet highlifea, vedre gitarske glazbe zapadne Afrike. Motiv koristi samo tonove G-dura, pa stane u ljestvicu druge pozicije. Cijela je pjesma u Pjesmama, pod Izvorne pjesme.";
"L600e2dce19" = "Žica 1, prag 3";
"L601d7efe00" = "Pripjev";
"L60229f5c78" = "Za klizanje trzni ton i nastavi pritiskati dok isti prst klizi do novog praga. Pritisak nosi zvuk; trzaš samo prvi ton.";
"L6027a15546" = "Koraci i polutonovi";
"L6030ff6791" = "D na pragu 3 žice 2, prazni B i natrag, pa prazni E i povišeni F na pragu 2 žice 1.";
"L603a7315ae" = "Pusti ga da odzvoni";
"L603b077f43" = "Osnovni ton otvorenog D daje prazna žica 4. Nakon pomaka drži ga prst 1: G na pragu 5. Žica 2, prag 8 također daje G.";
"L60416d96dc" = "S kapodasterom i dalje misliš G, C i D, poznate hvatove. Dijagrami ovdje imenuju akord koji čuješ, pa je hvat G uz kapodaster 2 označen A.";
"L6046c05006" = "„Home!” je cijela nota: drži D na pragu 3 žice 2 cijeli takt.";
"L60486c0a4b" = "Septakordi na lak način";
"L6049def04f" = "I pauze se broje";
"L604ac866f0" = "Uspravi se i opusti se";
"L6053efe7e3" = "Sviranje prstima posuđuje španjolske oznake: p za palac, i za kažiprst, m za srednji prst, a za prstenjak. Nasloni i na žicu 3, m na žicu 2 i a na žicu 1, spremne za trzaj.";
"L60567af0fd" = "C, A7, D7, G7, pa kući na C. Svaki septakord vuče prema sljedećem, mali lanac napetosti. Prije stoljeća pokretao je bezbroj pjesama.";
"L6063ec8dfa" = "Refren, prstima";
"L6065bcf219" = "Terce uz ljestvicu";
"L60715612f0" = "G-dur, gore i dolje";
"L608e8768cd" = "Treći prst na žici D";
"L60948f8372" = "Crne tipke, najmanji korak i tonovi s dva naziva.";
"L609651b67b" = "Obuhvaća osam slovnih naziva";
"L60db049169" = "G D A E";
"L60dea2df67" = "Čini je kratkom i odvojenom";
"L60f61fb4e2" = "Ništa novo: E, F i G na žici 1, B, C i D na žici 2. Počni polako, a zatim drži ujednačen tempo.";
"L60f6f7bc7e" = "Neka se njihalo kreće";
"L6128108d6c" = "Isti prstomet na dvije niže žice, D-dur i tri melodije.";
"L6129f8fd2f" = "Sve četiri žice";
"L61378dcfa1" = "Kad se akord promijeni, palac stiže na novi osnovni ton točno na prvu dobu. Prsti nastavljaju trzati žice 2 i 3 kao prije.";
"L613a306f82" = "Koji prst u ovoj poziciji svira prag 5?";
"L613b9483be" = "Uvod i solo";
"L6142dc5601" = "Opet druga tema";
"L614f875fca" = "Ovaj je obrazac na pragu 2 i molska pentatonika na povišenom F, počneš li od povišenog F. Ton koji smatraš domom određuje koju sviraš.";
"L6152642fb8" = "Par 2: prazni, prag 2, prag 4, prag 5.";
"L6153371910" = "Prag 3 je u području drugog prsta, pragovima 3 i 4.";
"L616a1bd784" = "Jazz-glazbenici obično dodaju septime: Dm7, G7, Cmaj7. Dodatni tonovi čine svaki prijelaz još glađim. Osnovni tonovi i povratak uporištu ostaju isti.";
"L616b46e903" = "Oda radosti, drugi redak";
"L6181145819" = "Drži trzalicu blizu žica, a poteze ravnomjernima. Brzina dolazi poslije, kad pokret postane opušten.";
"L6191fba215" = "Čemu služi uvod?";
"L61992ffcfb" = "Žica 2, prag 4";
"L61a7fd6fc3" = "Svaka durska ljestvica slijedi isti obrazac koraka: cijeli, cijeli, poluton, cijeli, cijeli, cijeli, poluton. Kreni od bilo kojeg tona, slijedi ga i dobit ćeš dursku ljestvicu.";
"L61ac361d21" = "Što je promjena pozicije";
"L61b524f257" = "Visina pada kad ponestaje zraka. Malo raniji završetak održava cijeli ton čistim.";
"L61d442d352" = "Refren počinje visoko: D na pragu 3 žice 2, povišeni C na pragu 2, prazni B, pa naniže do praznog D.";
"L61da910eb5" = "Angeline the Baker";
"L61e018ea94" = "Kratki udari i D9";
"L61e1dfe135" = "Pet pojednostavljenih tradicijskih melodija za svirku, od Boil Them Cabbage Down do Old Joe Clark.";
"L61ec307304" = "Stavi prst 1 na prag 2 i daj svakom prstu svoj prag, do praga 5. Od G na žici 6, pragu 3, ljestvica se penje preko žica 6, 5 i 4.";
"L61ee1ab807" = "Gdje se prst zaustavlja nakon trzaja s osloncem?";
"L61f1c8da71" = "Numeriraj ljestvicu od G: G je 1, A je 2 i tako do povišenog F, 7. Glazbenici tim brojevima govore o melodijama i akordima u svakom tonalitetu.";
"L61fc25fa4f" = "Prva doba";
"L62137e8c2f" = "Šest pjesama odjednom";
"L62175f3821" = "Ništa novo: G-dur u dvije oktave, ljestvica u tercama, A dorski i D miksolidijski. Drži jedan prst po pragu.";
"L621c5e6bc0" = "Dugo, kratko u tri";
"L621f8b64c0" = "Dvanaest taktova";
"L622c702c21" = "Pjesmarica za ukulele";
"L623729eeb4" = "Interval je udaljenost između dvaju tonova. Unisono nema razmaka: isti ton dvaput. Oktava ide od jednog slova do istog slova iznad, primjerice od C do C. Zvuči kao jedan ton, samo svjetlije.";
"L62490fbda1" = "Niski dio, druga polovica";
"L625278775b" = "Isti početak, drugi kraj. Drugi redak vraća se kući na C.";
"L625d141f7d" = "Prst 4 na žici 1";
"L6271a044a6" = "Beethoven je ovu klavirsku skladbu napisao 1810., ali objavljena je tek 1867., četrdeset godina nakon njegove smrti. Ova pojednostavljena inačica zadržava poznati početak.";
"L62773cc1b4" = "Sviraj žice 6, 5 i 4, jednu po jednu.";
"L62781903b0" = "Trzni žicu 1 palcem i pusti je da zvoni.";
"L6281828c75" = "Prva melodija za zajedničku svirku";
"L628db1ad7e" = "Takt je jedna skupina doba. Ovdje svaki takt ima četiri dobe, zapisano 4/4. Doba 1 započinje svaki takt, pa je malo naglasi dok brojiš.";
"L62ab25cde7" = "Čista kvinta";
"L62ba9ae8e4" = "Obrati G i D";
"L62bb50e1c3" = "Koji je akord Cmaj7?";
"L62c4d6152c" = "Par 3, prag 2, prvi prst.";
"L62d40dd812" = "Prvi prst na pragu 1 žice 2, drugi prst na pragu 2 žice 3. Žice 4 i 1 zvone prazne. Izostavi petu žicu; njezin G sukobljava se s D7.";
"L62f0a6aab6" = "Zvuk jednog para sporo pulsira. Što nije u redu?";
"L62fa3abe46" = "Dva smjera";
"L62fb1d70f8" = "Prst 1 drži žicu 5 na pragu 3 i leži sve do žice 1. Prst 3 uzima žicu 4, prst 2 žicu 3, a prst 4 žicu 2.";
"L630868a13b" = "Ovaj izazov miješa ligature i točke. Broji svaku osminku naglas; držana nota i dalje zauzima svoje puno vrijeme.";
"L6311ef1e1f" = "Tri dobe: polovinka (2) i njezina točka (1).";
"L63190e07e0" = "Prije gramofonskih ploča obitelji su ove pjesme pjevale kod kuće uz klavir. Ovdje su jedna za drugom, s velikom Holstovom melodijom za kraj.";
"L632198cb87" = "Klasične teme II";
"L63233a5412" = "Unisono, oktava, kvinta i kvarta, svaki uz melodiju koju možeš pjevušiti.";
"L6335412816" = "Kojim prstima sviraš D-dur na svakoj žici?";
"L634209dd7c" = "Svaka je nota ovdje četvrtinka, polovinka ili cijela nota. Broji četiri ravnomjerne dobe po taktu i pusti duge note da zvone.";
"L6355e11493" = "D, E, F: tri slova.";
"L63881ab90d" = "I, IV i V";
"L638f400164" = "Sinkopa smješta naglasak između doba. Na početku svaki C pada na i. Broji jedan-i-dva-i i osjeti kako C vuče naprijed.";
"L639b70b19b" = "Planinski mol";
"L63a15ae368" = "Prag 1 žice 2";
"L63a5f6c540" = "Oba akorda drže prag 2 na žicama 3 i 2. Mijenjaju se samo vanjske žice.";
"L63abb5650f" = "Sedam";
"L63b4995f45" = "Unisono i ponavljanja";
"L63b5f26523" = "U šestosminskoj mjeri četvrtinka i osminka čine jednu veliku dobu: dugo, kratko. Broji jedan-dva-tri, četiri-pet-šest i sviraj na jedan, tri, četiri i šest.";
"L63bb4a431f" = "Dodatni potisak obično podiže visinu, a vrlo tihi tonovi mogu pasti prenisko. U oba slučaja prati ton.";
"L63d01fe4fe" = "Na pola puta između kobilice i hvataljke";
"L63dcadbd78" = "Pet melodija zaredom, po jedna fraza iz svake. Udahni u svakoj pauzi i svaki ponovljeni ton započni iznova.";
"L63e8cf2011" = "Koji je ton cijeli ton iznad B?";
"L63f358c905" = "To je najteži dio";
"L640134fefa" = "Par A radi jednako: prazni je A, prag 2 daje B, prag 4 C♯, a prag 5 D. Ruka ostaje na mjestu.";
"L640b18da1f" = "Splet klasičnih tema";
"L6416c8c03f" = "Pada";
"L641a2740f3" = "Melodija";
"L6425315084" = "Na prvu i treću dobu";
"L6439513619" = "Koja se riječ proteže kroz dva tona u prvoj strofi?";
"L644b2e3eb5" = "Na pragovima";
"L6455adb054" = "Tvoj solo";
"L6478bdaaa1" = "Splet himni";
"L647e4d73c5" = "Naviše i natrag do uporišta";
"L648307a100" = "Kada dolazi potez gore?";
"L64846fd98f" = "Gitarski solo";
"L648ac30e5c" = "Mali F, D7 i dvije tradicijske pjesme s akordima i melodijom.";
"L648bfd8404" = "Otočki obrazac s promjenama";
"L649b215476" = "Par 3: prazni, prag 2, prag 4, prag 5.";
"L64afb60dbd" = "Što radiš tijekom pauze?";
"L64e238b935" = "Na 1 i 4";
"L64e6a5eeed" = "Ovo je izdanje u E-molu, u prvoj poziciji: melodija prelazi preko četiriju žica prstima 1 do 4, a akordska shema služi onome tko svira uz tebe.";
"L64e9fb8ad9" = "Odsviraj ili otpjevaj dva polutona na bijelim tipkama: od E do F, zatim od B do C.";
"L64f341465b" = "Prazna 3, žica 2 prag 1, prazna 1, žica 2 prag 3, žica 1 pragovi 1 i 3.";
"L6501930589" = "Isti ton ili različit?";
"L650634caa9" = "Prag 3 na žici 2 odgovara kojoj praznoj žici?";
"L6509372805" = "Pjesma u fokusu: Halogen";
"L6512fd6029" = "Osnovni ton, terca, kvinta";
"L651aaf0899" = "Svaki dodir ima naziv";
"L653eb46bda" = "Violončelo se naginje na tvoja prsa, a koljena ga lagano stabiliziraju sa strana.";
"L654648b7f9" = "Svira samo na dobu 1";
"L655060742f" = "Podigni prst koji ne trebaš i postavi novi dok zadnji potez još zvoni. Gledaj unaprijed prema sljedećem akordu.";
"L65572eaf06" = "Stephen Foster napisao je ovu pjesmu o utrkama 1850., dvije godine nakon Oh! Susanna. Koristi iste tonove i ista dva akorda.";
"L656206b093" = "Koliko taktova A otvara blues od 12 taktova?";
"L65626dc943" = "Ova je melodija tiskana 1582. u Piae Cantiones, pjesmarici iz Finske, kao pjesma o proljeću. John Mason Neale dao joj je božićne stihove 1853.";
"L65790ce0d0" = "Blues od 12 taktova";
"L658534e988" = "Osminke do A";
"L6586ce1f1f" = "Amazing Grace ide u tri dobe po taktu. Sviraj tremolo kroz svaki dugi ton i mijenjaj tonove točno na dobu. Dva su tona nova: A i B na paru G.";
"L65a24ccc47" = "Druga polovica počinje visoko: četvrti prst doseže B na žici E. Zatim treći, pa niski 2.";
"L65b5eedd25" = "Splet prvih tonova";
"L65da260ff1" = "Sada najdeblju žicu, C. Pusti je da zagrmi.";
"L65dc0bc434" = "G, H";
"L65fc8eeea6" = "Otprilike jednako dugo";
"L66059b65aa" = "Obični A-mol ima F. Dorski zadržava povišeni F iz G-dura: svijetlu točku u molskoj ljestvici.";
"L661b9e9f2e" = "Jedan obrazac, cijela petlja";
"L661f67974f" = "Zamjenjuje refren";
"L66239be110" = "Unisono: isti ton";
"L6636558793" = "Sjedni uspravno s postavljenom nožicom, opuštenim hvatom gudala i gudalom na pola puta između kobilice i hvataljke. Sada odsviraj sve iz ove cjeline.";
"L664305ffb2" = "Od D do F preskače se E, pa je to skok: terca.";
"L6643ee2897" = "F i C";
"L664688a0e9" = "Modus po modus";
"L6646d01d84" = "Pop u 6/8";
"L6651a17acc" = "Prazni D, E i povišeni F na žici 4, pa skok do D na pragu 3 žice 2 i naniže povišeni C, B i A.";
"L66573d54aa" = "Dva skoka naviše";
"L6693552855" = "Hodajući blues u A";
"L66a2e1bb47" = "Cijela pjesmarica u tonalitetima za ukulele, od početka do kraja";
"L66ae417c89" = "Dolje na broj, gore na i. Ruka ide dolje i gore jednom po dobi.";
"L66ba679c70" = "Pronađi puls, broji do četiri i tapkaj u ritmu.";
"L66d9448f4d" = "Šum na devetom kanalu je punk: četiri power-akorda, osminke prigušene dlanom, 104 dobe u minuti. Strofa mrmlja niskim tonovima, a refren je zajednički povik, pa zasviraj odlučno.";
"L66fa22185a" = "Osminka traje pola dobe, pa dvije stanu u svaku dobu. Koristi male, brze poteze blizu sredine gudala.";
"L66fbb37faf" = "Na i prelaziš na novi par. Koji potez?";
"L670d6914c0" = "Akordi uspostavljaju tonalitet, a zatim se čuje jedan ton. Prvo pronađi do, pa imenuj ton. Svaki tonalitet funkcionira jednako.";
"L670e7fd853" = "Prenisko znači ispod tona, pa malo podigni visinu.";
"L671c1ff474" = "Prva fraza završava notom s točkom. Kakav je osjećaj?";
"L67278e4178" = "Strofa i refren";
"L672fd54460" = "C-dur, druga oktava: drugi prst za F i za gornji C.";
"L6739b9a584" = "Predtakt i prvi takt: prazni G, A na pragu 2, pa prazni B, D na pragu 3 dvaput i prazni E.";
"L67684dd3f9" = "Za „Meri ima malo janje” trebaju tri tona: prazna žica 2 daje B, prag 2 na žici 3 daje A, a prazna žica 3 daje G. Ton A sviraš drugim prstom.";
"L67695d722e" = "Odgovori na rif";
"L676e1e1bc9" = "Doba 3";
"L677297f490" = "Početak: D, G, B G, B, A. Prazne žice 4, 3 i 2, uz A.";
"L6776fd531f" = "Tri prsta guraju";
"L6777925e65" = "Položi prst 1 preko žica 3, 2 i 1 na pragu 2, pa dosegni prstom 3 žicu 4, prag 4.";
"L67920ab8cb" = "Jedan prag niže";
"L67a8f1045a" = "Slijedeći obrazac od D, dolaziš do F♯ kao tona 3 i C♯ kao tona 7.";
"L67baf4caa8" = "Od D do F je mala terca, a od F do A velika.";
"L67c3806843" = "D, DU, UDU";
"L67c948a825" = "Koliko je polutonova od D naviše do F?";
"L67d0dcf34e" = "Nota koja traje dvije dobe";
"L67db55e61d" = "Ton na kojem se trozvuk gradi njegov je osnovni ton. Srednji ton je terca, a najviši kvinta, nazvani po udaljenosti iznad osnovnog tona.";
"L67ef0e743a" = "Sviraj glasnije";
"L67f0897e60" = "Stavi vrh prvog prsta na žicu A kod prve trakice. To je B, cijeli ton iznad A; cijeli ton su dva polutona. Pritisni dok žica ne dotakne hvataljku.";
"L67f2b8db53" = "C, p-i-m-a";
"L680e20c077" = "Poznate melodije koje svi znaju, od početka do kraja";
"L6824a5dc37" = "Različito";
"L68262bf228" = "A u četvrtoj poziciji, prazni A, A u četvrtoj poziciji. Neka zvuče isto.";
"L68275325bd" = "Koju žicu ova melodija nikad ne koristi?";
"L6829fbcb04" = "Od do do do: od C naviše do sljedećeg C.";
"L6854c89618" = "Koji je ton na pragu 3 žice 4?";
"L6859188a0b" = "Drži akord, trzaj melodiju";
"L686fe0d2fa" = "Položi prst 1 preko žica 4, 3 i 2 na pragu 2 i stavi prst 2 na žicu 1, prag 3.";
"L688a376adc" = "Koliko šesnaestinki stane u jednu dobu?";
"L689041fa42" = "Niski 2 i visoki 2 na žici A, pa niski 2 i visoki 2 na žici E.";
"L68a5d9377b" = "Krovni zbor himna je stadionskih razmjera pri 92 dobe u minuti. Sviraš refren u C, pa jedan takt A sve podiže za cijeli ton, a refren se vraća u D.";
"L68a9c445ed" = "Prsti trzaju gore trzalicama";
"L68b0c5bf55" = "Odakle dolazi visoki G u prvom taktu?";
"L68b2b09c89" = "A♭";
"L68d4c57c61" = "Sviraj puni barre B-mola na pragu 2 ako možeš. Ako ne, koristi četiri najviše žice: prag 4 na žicama 4 i 3, prag 3 na žici 2, prag 2 na žici 1.";
"L68d4cfda41" = "B7 vuče prema E. Njegova se napetost topi u E-molu ili E.";
"L68d6126c37" = "Koji akord zajedno čine D, F♯ i A?";
"L68d9990b7c" = "A7: isti trik";
"L68dba3a68d" = "Posljednji redak penje se od praznog D na žici 4: E, povišeni F na pragu 4, prazni G, pa A.";
"L68fd09b287" = "Čvrst stisak lijeve ruke";
"L68fd5ef7e1" = "Tempo raste. Kakvi trebaju biti tvoji dodiri?";
"L690a93e955" = "Most";
"L690aa0b88d" = "U četvrtoj poziciji prvi prst svira D na žici A, ton koji je četvrti svirao u prvoj poziciji. Palac sjeda gdje se vrat savija prema tijelu.";
"L690ab2befe" = "Susjedni tonovi";
"L6918767a98" = "Sinkopa: između doba";
"L6918c2a4bb" = "Koji je ton kvinta u trozvuku D F A?";
"L691f903820" = "Ne koristi se";
"L691f9c22d1" = "Sami akordi";
"L693752b4ae" = "Nastavi svirati i uhvati sljedeći akord";
"L6941e683a3" = "Budući da je žica 4 visoki G, obrazac ide cik-cak: visoko, nisko, pa uspon. Taj sjaj zvuk je ukulelea sviranog prstima.";
"L694f5f09fe" = "Gdje treba udahnuti u ovoj pjesmi?";
"L6952d23be8" = "B5";
"L695d14c16d" = "Dva praga iznad G je A. Ime akorda pomiče se s osnovnim tonom.";
"L696010416e" = "Velika septima";
"L696cd74a3d" = "Sjedni uspravno i trzni D, pa G. Opusti ramena.";
"L6971957b55" = "Brojanje ponovno počinje od 1 na početku svakog takta.";
"L6973e1fed9" = "Refren";
"L697ea8051a" = "Uz CAGED rijetko moraš skakati. Oko praga 5 G je hvat D, C je hvat G, a D je hvat A. Tri akorda, jedno mjesto.";
"L6980bcdcd2" = "Turski rondo";
"L698eca6ecd" = "Pauza, pa dodir na i";
"L69a3fc0ffb" = "Pokreni iz lakta";
"L69acddb13a" = "Ništa novo: prst po žici, obrazac tamo-natrag, izmjenični palac i melodija unutar akorda.";
"L69ba79c271" = "Provjera promjena pozicije";
"L69c68aba96" = "Uz „Speed, bonnie boat, like a bird on the wing”: prazni D, E, D, tri prazna G, pa A, B, A i naviše do D.";
"L69d4feab52" = "Skoči puno više";
"L69d6c14191" = "Usporeni stroboskop izvorna je pjesma Timbre: synth-pop u A uz mol na povišenom F, D, A i E. Obrazac na pragu 2 pristaje cijeloj petlji: A-durska pentatonika, ujedno molska pentatonika na povišenom F. Cijela je pjesma u Pjesmama, pod Izvorne pjesme.";
"L69db2318a3" = "Pjesma putujućih trgovaca";
"L69dca66da6" = "Podijeli svaku dobu na dva dijela i broji „i”.";
"L69dd77610a" = "Žica 3: pragovi 2 i 4. Trzni jednom, pa radi hammer-on i pull-off prstom 3.";
"L69e8d3e991" = "Koja prazna žica daje najniži ton?";
