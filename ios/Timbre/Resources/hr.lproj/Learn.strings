"L8ba11c58da" = "Zvuk treba biti kratak";
"L8ba2a07385" = "6/8";
"L8bbca3e54a" = "Nota s točkom i brza nota daju koračnici oštrinu: dugo, pa kratko. U prvom taktu drugi D je dug, a E ulazi neposredno prije druge dobe.";
"L8be1dd6d7f" = "Oba odjednom";
"L8be2f0040b" = "Kad prijeđeš na drugi par, ruka zadržava njihanje dolje-gore. Podlaktica te prenosi, zapešće drži ritam.";
"L8bf51bccc9" = "Broji 1 i 2 i";
"L8bffd0e29a" = "Koji se trozvuk gradi na D koristeći samo tonove C-dura?";
"L8c00bae676" = "Osnovni ton akorda B7 peti je po redu kad slova brojiš od E. Kad brojiš od A, peti je E, pa E7 preuzima njegovu ulogu.";
"L8c1a14f104" = "Interval je udaljenost između dvaju tonova. Preskoči jedan stupanj ljestvice i dobiješ tercu, poput do do mi. Čuj mi u glavi prije nego što napustiš do.";
"L8c1ce802ec" = "Aranžman određuje što sviraš i kada. Tvoj: uvod u Travisovu stilu, strofa kao melodija, refren u bum-čik stilu, pa melodija refrena za kraj.";
"L8c21826a55" = "Drži žice ugođenima";
"L8c2a569978" = "Po jedan takt: A-mol, F, C, G, pa A-mol, F, E, A-mol. Palac nalazi svaki novi osnovni ton: žice 5, 4, 5 i 6.";
"L8c44f7422f" = "U 3/4 svaki takt ima tri četvrtinske dobe. Broji 1, 2, 3, s naglaskom na 1. To je njihanje valcera.";
"L8c49b6c18f" = "Naglasak je malo glasnije odsviran ton. Odsviraj prvu dobu jače od ostalih. Tako svi znaju gdje počinje takt.";
"L8c57590db7" = "Menuet je ples u tri. Većina taktova počinje dugom dobom, pa brzim parovima: jedan, dva-i, tri-i.";
"L8c78b4d5a4" = "Tiho otpjevaj E, pa ga prilagođavaj dok se ne ustali.";
