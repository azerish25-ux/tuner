"L8aa2514408" = "Toreadorova pjesma";
"L8ab2f23db2" = "Tabulatura ima šest crta, po jednu za svaku žicu, sa žicom 1 na vrhu. Broj na crti označava prag koji pritišćeš. 0 znači svirati praznu žicu.";
"L8aceef3430" = "Da, udaljeni oktavu";
"L8ae6e236df" = "Oktava je skok od do do sljedećeg do: obuhvaća osam tonova ljestvice, računajući oba kraja. Oba tona dijele naziv i tako se dobro stapaju da gotovo zvuče kao jedan.";
"L8afae1aebf" = "Reginald Heber napisao je ove stihove, tiskane 1826., a John Bacchus Dykes napisao je melodiju 1861. Prvi se redak penje kroz tonove akorda G-dura.";
"L8b242ab2a9" = "Dva zaredom";
"L8b259aba31" = "Funk-vamp";
"L8b33eb04a4" = "Melodije u G vraćaju se kući na G, ovdje praznu treću žicu.";
"L8b33fe392c" = "Folliott Pierpoint napisao je ove stihove 1864., proljetnog dana na engleskom selu. Pjevaju se uz Dix, njemačku melodiju iz 1838.";
"L8b370ad96d" = "Spusti tercu";
"L8b3ccea2a5" = "Do, mi, sol";
"L8b3fd24a46" = "G B♭ D F";
